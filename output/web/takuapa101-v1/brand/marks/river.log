for p in sorted(root.glob('river-0*.svg')):
    text = p.read_text(encoding='utf-8')
    ET.fromstring(text)
    assert 'viewBox=\"0 0 64 64\"' in text, p
    assert 'width=' not in text and 'height=' not in text
    assert not any(c >= '\\u0e00' and c <= '\\u0e7f' for c in text)
    colors = set()
    import re
    colors.update(re.findall(r'#[0-9a-fA-F]{6}', text))
    assert colors <= allowed, (p, colors)
    assert len(colors) <= 3, (p, colors)
    print(p.name, 'XML OK;', 'colors=', sorted(colors))
