"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, re, xml.etree.ElementTree as ET
from pathlib import Path
root = Path(r'D:\\Siwaracafeweb\\output\\web\\takuapa101-v1\\brand\\marks')
allowed = {'#203f39','#f6f1e6','#a3492f','#e8a931','#fffdf7'}
for p in sorted(root.glob('river-0*.svg')):
    text = p.read_text(encoding='utf-8')
    ET.fromstring(text)
    assert 'viewBox=\"0 0 64 64\"' in text
    assert 'width=' not in text and 'height=' not in text
    assert not any('\\u0e00' <= c <= '\\u0e7f' for c in text)
    colors = set(re.findall(r'#[0-9a-fA-F]{6}', text))
    assert colors <= allowed and len(colors) <= 3, (p.name, colors)
    print(p.name, 'XML OK; colors=', sorted(colors))
data = json.loads((root/'river.json').read_text(encoding='utf-8'))
assert isinstance(data, list) and len(data) == 3
assert [x['file'] for x in data] == ['river-01.svg','river-02.svg','river-03.svg']
print('river.json JSON OK; entries=', len(data))
