stories/kuapapoh/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><script src="/assets/trip.js" defer></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.pages.dev/stories/kuapapoh/"><link rel="alternate" hreflang="en" href="https://takuapa101.pages.dev/en/stories/kuapapoh/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.pages.dev/stories/kuapapoh/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/stories/" aria-current="page">เรื่องเล่าตะกั่วป่า</a><a href="/places/">สถานที่</a><a href="/news/">ความเคลื่อนไหว</a><a href="/map/">แผนที่</a><a href="/traditions/">ประเพณี</a><a href="/eat/">กินและของฝาก</a><a href="/rest/">กินเที่ยว</a><a href="/routes/">เส้นทางเดิน</a><a href="/trip/">ทริปของคุณ</a><a href="/about/">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/stories/kuapapoh/" hreflang="en" lang="en">EN</a><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="story-article-v2"><header class="story-hero-v2"><div class="breadcrumbs"><a href="/">หน้าแรก</a><span>/</span><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><span>/</span><span>กระทู้เมือง</span></div><span class="eyebrow">เรื่องเล่าตะกั่วป่า · กระทู้เมือง</span><h1>กั่วป่าโพ้: วันที่บ้านเก่าลุกขึ้นมาเล่าเรื่องตัวเอง</h1><p class="lead">โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา</p><p class="story-meta">ปรับปรุงเมื่อ 2026-09-07 · เวลาอ่าน 6 นาที</p></header><figure class="hero-photo-v2"><img src="/assets/photos/kuapapoh-brand.jpg" alt="กั่วป่าโพ้ · แบรนด์ของโครงการเมืองเก่าตะกั่วป่า" loading="eager"><figcaption><span>กั่วป่าโพ้ · แบรนด์ของโครงการเมืองเก่าตะกั่วป่า</span><span class="credit">โครงการกั่วป่าโพ้</span></figcaption></figure><div class="story-layout-v2"><div class="story-main-v2"><div class="story-lede-v2"><p>คุณลองจินตนาการถึงการเดินทอดน่องไปตามถนนศรีตะกั่วป่า ถนนที่สองข้างทางเต็มไปด้วยอาคารเรือนแถวเก่าแก่ที่ยืนหยัดข้ามกาลเวลา อาคารหลายหลังถูกปิดประตูไม้เงียบเชียบ หลับใหลไปพร้อมกับยุคทองของการทำเหมืองแร่ที่ผ่านพ้นไปนานแล้ว แต่ภายใต้ความเงียบสงบนั้น มีความทรงจำของเมือง ผู้คน และการค้าขายซุกซ่อนอยู่มากมายรอวันถูกเล่าขาน</p><p>ในช่วงไม่กี่ปีที่ผ่านมา โครงการพื้นที่สร้างสรรค์ที่ชื่อว่า “กั่วป่าโพ้ จีโชว์เมือง” ได้พยายามก้าวเข้ามาเปิดประตูบ้านเก่าที่เคยถูกทิ้งร้าง ให้กลับมามีลมหายใจอีกครั้ง พวกเขาไม่ได้แค่ทาสีใหม่หรือซ่อมแซมหลังคา แต่กำลังนำเรื่องราวของตะกั่วป่ากลับมาจัดแสดงให้คนรุ่นหลังได้เห็น</p><p>การเคลื่อนไหวนี้สะท้อนภาพเมืองที่พยายามลุกขึ้นมาเล่าเรื่องตัวเอง ผ่านมุมมองของคนท้องถิ่น ศิลปิน และการทำงานร่วมกับชุมชน อย่างไรก็ตาม ในการอ่านความเปลี่ยนแปลงนี้ เรายังคงต้องแยกแยะระหว่างเรื่องเล่าที่สร้างสรรค์ขึ้นใหม่เพื่อการท่องเที่ยว กับข้อเท็จจริงทางประวัติศาสตร์ที่ยังต้องตรวจสอบด้วยความระมัดระวัง</p></div><section class="story-section-v2"><h2 id="section-0">พื้นที่ที่เคยหลับใหล กลับมาเป็นของเมือง</h2><figure class="section-photo-v2"><img src="/assets/photos/shophouse-109.webp" alt="ตึกแถวเลขที่ 109 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>ตึกแถวเลขที่ 109 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</span><span class="credit">คลังภาพโครงการกั่วป่าโพ้</span></figcaption></figure><p>เรามักจดจำภาพของตะกั่วป่าผ่านยุคเหมืองแร่ดีบุกอันรุ่งเรือง แต่เมื่ออุตสาหกรรมนั้นซาลง อาคารหลายแห่งก็ถูกทิ้งไว้เบื้องหลัง หนึ่งในนั้นคือบ้านเลขที่ 78 ซึ่งอดีตเคยเป็นบ้านของนายเหมืองและเป็นที่ตั้งของบริษัทเหมืองแร่ดีบุก วันนี้พื้นที่ที่เคยว่างเปล่าถูกปรับเปลี่ยนให้เป็น “กั่วป่าเหมืองมิวเซียม” ที่จัดแสดงอุปกรณ์การทำเหมือง แผนที่เก่า และเอกสารสำคัญ เพื่อให้ผู้มาเยือนได้สัมผัสร่องรอยของอดีต</p><p>ถัดไปไม่ไกลบนเส้นทางเดียวกัน คือบ้านเลขที่ 109 อาคารของศาลเจ้ากังตั้งโหยกวน หรือหวุ่ยกุ่น ซึ่งเป็นสมาคมของชาวจีนฮากก้าหรือจีนแคะ บริเวณชั้นสองของอาคารยังคงประดิษฐานองค์พระท่ามกุงหย่าให้ผู้คนได้กราบไหว้เคารพ แต่พื้นที่ชั้นล่างที่เคยว่างเปล่าไร้การใช้งาน ได้ถูกเปลี่ยนเป็น “กั่วป่าโพ้แกลอรี่” สำหรับจัดนิทรรศการและแสดงภูมิปัญญาของชาวเมืองเก่าตะกั่วป่า</p><p>อีกหนึ่งอาคารสำคัญที่โครงการนำกลับมาปัดฝุ่นคืออาคารหมายเลข 305 หรือ “โรงเรียนเต้าหมิง” โรงเรียนจีนที่เคยเป็นศูนย์กลางการศึกษาในยุคเหมืองแร่รุ่งเรือง ทีมงานมีแนวคิดฟื้นคืนพื้นที่นี้ภายใต้ชื่อ “เต้าหมิง ประกายแสงแห่งการเรียนรู้” โดยใช้เป็นสถานที่จัดแสดงองค์ความรู้ด้านสถาปัตยกรรม วัฒนธรรม และประเพณีที่เกี่ยวข้องกับตะกั่วป่า</p><p>ความพยายามในการนำพื้นที่ทั้งสามแห่งนี้กลับมาใช้งาน เป็นการริเริ่มที่เต็มไปด้วยความมุ่งมั่นของเจ้าของโครงการในการเพิ่มมูลค่าทางเศรษฐกิจและสร้างคุณค่าให้เมือง แต่เราต้องเข้าใจร่วมกันว่า นี่เป็นคำอธิบายและการดำเนินการระดับโครงการชุมชน ไม่ใช่การประกาศสถานะโบราณสถานหรือการรับรองทางประวัติศาสตร์จากหน่วยงานภาครัฐ</p></section><blockquote class="pull-quote-v2"><p>การทำงานกับเรื่องเล่าของชุมชน คือการรักษาสมดุลระหว่างความทรงจำที่งดงามกับข้อเท็จจริงที่ต้องตรวจทาน</p></blockquote><section class="story-section-v2"><h2 id="section-1">กั่วป่าโพ้ คำเรียกขานที่พัดพามาจากสายน้ำ</h2><figure class="section-photo-v2"><img src="/assets/photos/tao-ming-school.jpg" alt="อาคารโรงเรียนเต้าหมิง ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>อาคารโรงเรียนเต้าหมิง ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</span><span class="credit">คลังภาพโครงการกั่วป่าโพ้</span></figcaption></figure><p>ทันทีที่คุณได้ยินชื่อ “กั่วป่าโพ้” คำถามแรกที่มักตามมาคือคำนี้มาจากไหน ข้อมูลจดหมายเหตุของโครงการอธิบายว่า คำนี้คือคำที่ชาวจีนฮกเกี้ยนในอดีตใช้เรียกเมืองตะกั่วป่า โดยแบ่งการแปลออกเป็นสองส่วนคือ “กั่วป่า” ที่หมายถึงตะกั่วป่า และ “โพ้” ที่แปลว่าตลาดหรือท่าเรือ</p><p>เมื่อนำมารวมกัน คำนี้จึงสื่อถึง “ตลาดท่าเรือตะกั่วป่า” ซึ่งสะท้อนภาพในวันวานที่ชาวจีนโล้สำเภาข้ามน้ำข้ามทะเลเข้ามาค้าขายและทำเหมืองดีบุก โดยใช้ท่าน้ำเป็นศูนย์กลางในการแลกเปลี่ยนทั้งสินค้าและวัฒนธรรม นอกจากนี้ ในความเชื่อของชุมชน คำว่ากั่วป่าโพ้ยังแฝงอยู่ในการประกอบพิธีกรรมตามศาลเจ้าต่างๆ ในช่วงเทศกาลกินผัก จนกลายเป็นคำที่มีความหมายลึกซึ้งในใจชาวเมือง</p><p>แม้นี่จะเป็นเรื่องเล่าที่งดงามและเชื่อมโยงรากเหง้าของชุมชนได้เป็นอย่างดี แต่ในแวดวงวิชาการ เรื่องที่มาของชื่อเมืองตะกั่วป่านั้นยังคงเป็นข้อถกเถียงที่มีหลายสมมติฐาน บ้างก็อ้างถึงชื่อโบราณอย่างตะโกลา บ้างก็อิงกับคำว่าตะกั่วและป่า</p><p>ดังนั้น คำอธิบายของโครงการจึงถือเป็นบันทึกความทรงจำและการตีความผ่านบริบทของชุมชนชาวจีนฮกเกี้ยน มากกว่าที่จะเป็นข้อยุติทางวิชาการประวัติศาสตร์ที่ฟันธงได้เพียงทางเดียว นี่คือเหตุผลที่เราต้องอ่านเรื่องนี้ด้วยความเปิดกว้างและระมัดระวัง</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">ยังไม่มีข้อยุติทางวิชาการ</span></div></section><section class="story-section-v2"><h2 id="section-2">มนต์เสน่ห์เปอรานากันผ่านปลายพู่กัน</h2><figure class="section-photo-v2"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" loading="lazy"><figcaption><span>โรงเรียนเต้าหมิง</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>ความมีชีวิตชีวาของย่านเมืองเก่ากลับมาปรากฏให้เห็นอย่างเป็นรูปธรรมในเดือนกันยายน พ.ศ. 2569 เมื่อ 78 สตูดิโอ บนถนนวัฒนธรรมตะกั่วป่า ได้เปิดพื้นที่จัดแสดงนิทรรศการศิลปะเดี่ยวภายใต้ชื่อ “มนต์เสน่ห์เปอรานากัน · Still Becoming”</p><p>ศิลปินผู้อยู่เบื้องหลังผลงานเหล่านี้คือ ติณณภพ งานสถิร หรือ ช่างป๋อง เขาเป็นชาวตลาดเก่าตะกั่วป่าโดยกำเนิด เติบโตมากับภาพวาดการ์ตูน ซูเปอร์ฮีโร่ และเทพเจ้าจีนที่คุ้นเคยในวัฒนธรรมท้องถิ่น หลังจากสั่งสมประสบการณ์ทางศิลปะมาอย่างยาวนาน เขาได้เลือกใช้ปลายพู่กันมาถ่ายทอดเรื่องราวของเมืองที่เขาผูกพัน</p><p>ผลงานในนิทรรศการเน้นไปที่การดึงเอาสีสัน ลวดลาย และเครื่องแต่งกายแบบเปอรานากันมาจัดแสดง เพื่อเป็นสะพานเชื่อมโยงอดีตอันรุ่งเรืองเข้ากับผู้คนในยุคปัจจุบัน ภาพวาดแต่ละชิ้นไม่ใช่แค่ความสวยงามทางสายตา แต่เป็นบันทึกทางอารมณ์ของศิลปินที่มีต่อเมือง</p><p>แม้ว่าเอกสารโครงการจะบันทึกถึงการจัดนิทรรศการและการเปิดพื้นที่ให้ศิลปินได้แสดงออกอย่างชัดเจน แต่สิ่งที่เรายังไม่เห็นในรายงานคือตัวเลขผู้เข้าร่วมงานหรือการประเมินผลกระทบทางเศรษฐกิจที่เป็นทางการ กิจกรรมเหล่านี้จึงทำหน้าที่เป็นแรงกระเพื่อมทางวัฒนธรรมมากกว่าจะเป็นสถิติทางราชการ</p></section><section class="story-section-v2"><h2 id="section-3">มองเมืองผ่านแว่นตาแห่งมรดกทั้งหก</h2><figure class="section-photo-v2"><img src="/assets/photos/kuapapoh-pattern.jpg" alt="ลายกระเบื้องเปอรานากันที่ยังเห็นได้ในเมืองเก่า" loading="lazy"><figcaption><span>ลายกระเบื้องเปอรานากันที่ยังเห็นได้ในเมืองเก่า</span><span class="credit">โครงการกั่วป่าโพ้</span></figcaption></figure><p>เพื่อให้ผู้มาเยือนเข้าใจอัตลักษณ์ของเมืองเก่าตะกั่วป่าได้ลึกซึ้งขึ้น โครงการไม่ได้หยุดอยู่แค่การจัดนิทรรศการ แต่ได้รวบรวมและนำเสนอแนวคิด “6 อ.” เพื่อใช้เป็นกรอบในการมองมรดกของเมืองที่ซ่อนอยู่ในชีวิตประจำวัน</p><p>แนวคิดนี้เริ่มต้นที่ “อาภรณ์” หรือเครื่องแต่งกายเฉพาะถิ่น ไม่ว่าจะเป็นผ้าลูกไม้ ผ้าถุงปาเต๊ะ และเครื่องประดับต่างๆ ตามมาด้วย “อาศัย” ที่ครอบคลุมวิถีชีวิต การค้าขาย และความเป็นอยู่ที่สอดคล้องกับยุคสมัย ส่วน “อาหาร” คือสิ่งที่ขาดไม่ได้ มันคือรสชาติดั้งเดิมที่สืบทอดกันมาจากรุ่นสู่รุ่น และร้านอาหารเก่าแก่ที่ยังคงเปิดเตาไฟอยู่จนถึงทุกวันนี้</p><p>ในมิติของจิตใจ เมืองถูกขับเคลื่อนด้วย “อารมณ์” ที่แสดงออกผ่านงานศิลปะ เสียงเพลง และเสียงกลองในเทศกาลกินผัก ขณะเดียวกัน “อาราม” ก็เป็นศูนย์รวมศรัทธา ทั้งวัด ศาลเจ้า และโหย่กวนที่กระจายตัวอยู่ในย่านเมืองเก่า และสุดท้ายคือ “อาคาร” สถาปัตยกรรมที่ยืนหยัดเป็นประจักษ์พยานของการเปลี่ยนแปลง</p><p>แนวคิดทั้งหมดนี้ยังถูกนำไปต่อยอดในการออกแบบสินค้าของที่ระลึก เช่น เสื้อยืดของโครงการโพ้ช็อป ซึ่งรายได้จากการจำหน่ายจะถูกนำกลับมาสมทบทุนเพื่อใช้ฟื้นฟูและขับเคลื่อนกิจกรรมของเมืองต่อไป เป็นการหมุนเวียนคุณค่ากลับคืนสู่ชุมชนอย่างแท้จริง</p></section><section class="story-section-v2"><h2 id="section-4">สิ่งที่เมืองเล่าและสิ่งที่เราต้องตรวจสอบ</h2><figure class="section-photo-v2"><img src="/assets/culture-street.webp" alt="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>โครงการกั่วป่าโพ้ ทำให้เราได้เห็นความมุ่งมั่นของคนรุ่นใหม่และคนในพื้นที่ที่ต้องการจะรักษาและต่อยอดเรื่องราวของตะกั่วป่า พวกเขาสร้างพื้นที่สร้างสรรค์ ดึงเอาศิลปะเข้ามาเป็นสื่อกลาง และเปลี่ยนบ้านที่เคยปิดตายให้กลายเป็นจุดหมายใหม่ของการเดินทาง</p><p>สิ่งที่ถูกบันทึกไว้ในเว็บไซต์และเอกสารของโครงการ เป็นเสมือนจดหมายเหตุร่วมสมัยที่ชุมชนเลือกที่จะเล่าถึงตัวเอง มันคือความทรงจำที่เปี่ยมไปด้วยชีวิตชีวาและความภาคภูมิใจของผู้อยู่อาศัย</p><p>แต่ในขณะเดียวกัน การอ่านเรื่องราวเหล่านี้ก็เรียกร้องให้เรารักษาความสมดุลระหว่างความชื่นชมกับข้อเท็จจริงทางประวัติศาสตร์ ข้อมูลหลายส่วนเป็นคำอธิบายที่ไม่ได้ผ่านการรับรองจากหน่วยงานรัฐ และไม่สามารถใช้แทนปฏิทินหรือเอกสารทางวิชาการได้</p><p>นี่คือความท้าทายและความสนุกของการเดินชมเมืองเก่าตะกั่วป่าในวันนี้ เรามีหน้าที่รับฟังเรื่องเล่าที่งดงามเหล่านั้น พร้อมๆ ไปกับการตั้งคำถามและค้นหาคำตอบตามแหล่งข้อมูลที่เชื่อถือได้ เพื่อให้การเดินทางของเราไม่ได้จบลงแค่การดูรูปภาพ แต่เป็นการทำความเข้าใจเมืองในทุกมิติอย่างแท้จริง</p></section><section class="story-places-v2"><h2>ไปดูของจริงได้ที่ไหน</h2><div class="mini-cards-v2"><div class="place-card-mini"><div><h4>โรงเรียนเต้าหมิง</h4><button class="button button-outline" data-trip-add="tao-ming">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h4>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</h4><button class="button button-outline" data-trip-add="culture-street">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h4>ตลาดริมน้ำตะกั่วป่า</h4><button class="button button-outline" data-trip-add="riverwalk">เพิ่มลงทริป</button></div></div></div></section><details class="unknowns-box-v2"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>จำนวนผู้เข้าร่วมงานหรือผลกระทบทางเศรษฐกิจที่เกิดจากโครงการอย่างเป็นทางการ</li><li>สถานะทางกฎหมายหรือการรับรองจากหน่วยงานรัฐของบ้านทั้งสามหลัง</li><li>ที่มาที่ชัดเจนและยุติแล้วของชื่อเมืองตะกั่วป่าในหน้าประวัติศาสตร์</li></ul></details><section class="story-sources-v2"><h2>แหล่งข้อมูล</h2><ol><li><cite>กั่วป่าโพ้ · จดหมายเหตุโครงการ</cite> · โครงการกั่วป่าโพ้ · content.json · ส่วน origin, events, openings · <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li></ol></section></div><div class="story-sidebar-v2"><aside class="evidence-box-v2"><h3>หลักฐานอยู่ตรงไหน</h3><ul class="ev-items-v2"><li><div class="ev-claim">การนิยามพื้นที่บ้านเลขที่ 78, 109 และ 305 เป็นพื้นที่สร้างสรรค์</div><div class="ev-status qualified">QUALIFIED</div><div class="ev-explain">ข้อนี้เป็นคำอธิบายจากเจ้าของโครงการ ไม่ใช่การประกาศสถานะโบราณสถานหรือพื้นที่จากหน่วยงานรัฐ <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">ที่มาของคำว่ากั่วป่าโพ้แปลว่าตลาดท่าเรือตะกั่วป่า</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">เรื่องที่มาของชื่อเมืองตะกั่วป่าในงานประวัติศาสตร์ยังมีหลายสมมติฐาน จึงไม่ควรใช้คำอธิบายโครงการแทนข้อยุติทางวิชาการ <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">การจัดนิทรรศการมนต์เสน่ห์เปอรานากัน โดย ติณณภพ งานสถิร ในเดือนกันยายน 2569</div><div class="ev-status qualified">QUALIFIED</div><div class="ev-explain">อ้างอิงจากข้อมูลโครงการ แต่ไม่ได้เป็นปฏิทินราชการย้อนหลังที่ยืนยันจำนวนผู้เข้าร่วมหรือผลกระทบทางเศรษฐกิจ <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li></ul></aside><nav class="story-toc-v2 scrollspy" id="story-toc"><h2>เนื้อหาในบทความ</h2><ul class="scrollspy-nav"><li><a href="#section-0">พื้นที่ที่เคยหลับใหล กลับมาเป็นของเมือง</a></li><li><a href="#section-1">กั่วป่าโพ้ คำเรียกขานที่พัดพามาจากสายน้ำ</a></li><li><a href="#section-2">มนต์เสน่ห์เปอรานากันผ่านปลายพู่กัน</a></li><li><a href="#section-3">มองเมืองผ่านแว่นตาแห่งมรดกทั้งหก</a></li><li><a href="#section-4">สิ่งที่เมืองเล่าและสิ่งที่เราต้องตรวจสอบ</a></li></ul></nav></div></div></div><section class="research-section" id="project-gallery"><h2>ภาพจากคลังโครงการกั่วป่าโพ้</h2><div data-gallery><div class="gallery-tabs" hidden><button type="button" data-tab="today">ภาพวันนี้</button><button type="button" data-tab="archive">ภาพเก่า</button></div><div id="gallery-today" data-panel="today"><h3>ภาพวันนี้</h3><div class="photo-grid"><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-brand.jpg" aria-label="ขยายภาพ · กั่วป่าโพ้ แบรนด์เมืองเก่าตะกั่วป่า"><img src="/assets/photos/kuapapoh-brand.jpg" alt="กั่วป่าโพ้ แบรนด์เมืองเก่าตะกั่วป่า" loading="lazy"></a><figcaption>กั่วป่าโพ้ แบรนด์เมืองเก่าตะกั่วป่า<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-pattern.jpg" aria-label="ขยายภาพ · ลายกระเบื้องเปอรานากันเมืองเก่า"><img src="/assets/photos/kuapapoh-pattern.jpg" alt="ลายกระเบื้องเปอรานากันเมืองเก่า" loading="lazy"></a><figcaption>ลายกระเบื้องเปอรานากันเมืองเก่า<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure></div></div><div id="gallery-archive" data-panel="archive"><h3>ภาพเก่า</h3><div class="photo-grid"><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-history.jpg" aria-label="ขยายภาพ · แผ่นเล่าประวัติกั่วป่าโพ้"><img src="/assets/photos/kuapapoh-history.jpg" alt="แผ่นเล่าประวัติกั่วป่าโพ้" loading="lazy"></a><figcaption>แผ่นเล่าประวัติกั่วป่าโพ้<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-wuikun.jpg" aria-label="ขยายภาพ · หวุ่ยกุ่น"><img src="/assets/photos/kuapapoh-wuikun.jpg" alt="หวุ่ยกุ่น" loading="lazy"></a><figcaption>หวุ่ยกุ่น<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-doc-1.jpg" aria-label="ขยายภาพ · เอกสารเก่าเมืองตะกั่วป่า 1"><img src="/assets/photos/kuapapoh-doc-1.jpg" alt="เอกสารเก่าเมืองตะกั่วป่า 1" loading="lazy"></a><figcaption>เอกสารเก่าเมืองตะกั่วป่า 1<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-doc-2.jpg" aria-label="ขยายภาพ · เอกสารเก่าเมืองตะกั่วป่า 2"><img src="/assets/photos/kuapapoh-doc-2.jpg" alt="เอกสารเก่าเมืองตะกั่วป่า 2" loading="lazy"></a><figcaption>เอกสารเก่าเมืองตะกั่วป่า 2<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure></div></div></div></section></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
.\site\en\stories\kuapapoh\index.html:1:<!doctype html><html lang="en" data-base="" data-news-api="https://takuapa101-news.siwatid-99.workers.dev"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>กั่วป่าโพ้: วันที่บ้านเก่าลุกขึ้นมาเล่าเรื่องตัวเอง · ตะกั่วป่า 101</title><meta name="description" content="โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา"><meta name="robots" content="noindex,follow"><meta property="og:title" content="กั่วป่าโพ้: วันที่บ้านเก่าลุกขึ้นมาเล่าเรื่องตัวเอง"><meta property="og:description" content="โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา"><meta property="og:url" content="https://takuapa101.pages.dev/stories/kuapapoh/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.pages.dev/assets/og/default.png"><meta property="og:locale" content="en_US"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.pages.dev/assets/og/default.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.pages.dev/en/stories/kuapapoh/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "inLanguage": "en", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.pages.dev/"}, {"@type": "ListItem", "position": 2, "name": "กั่วป่าโพ้: วันที่บ้านเก่าลุกขึ้นมาเล่าเรื่องตัวเอง", "item": "https://takuapa101.pages.dev/stories/kuapapoh/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><script src="/assets/trip.js" defer></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.pages.dev/stories/kuapapoh/"><link rel="alternate" hreflang="en" href="https://takuapa101.pages.dev/en/stories/kuapapoh/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.pages.dev/stories/kuapapoh/"></head><body class="inner-page"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/en/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">101</span><span>Takua Pa<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/en/stories/" aria-current="page">Takua Pa Stories</a><a href="/en/places/">Places</a><a href="/en/news/">Updates</a><a href="/en/map/">Map</a><a href="/en/traditions/">Traditions</a><a href="/en/eat/">Eat & Souvenirs</a><a href="/en/rest/">กินเที่ยว</a><a href="/en/routes/">Walking Routes</a><a href="/en/trip/">Your trip</a><a href="/en/about/">About</a></nav><div class="header-tools"><a class="lang-switch" href="/stories/kuapapoh/" hreflang="th" lang="th">ไทย</a><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/en/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/en/map/">Open map ↗</a></div></header><main id="main"><div class="story-article-v2"><header class="story-hero-v2"><div class="breadcrumbs"><a href="/en/">Home</a><span>/</span><a href="/en/stories/">Takua Pa Stories</a><span>/</span><span>City topics</span></div><span class="eyebrow">เรื่องเล่าตะกั่วป่า · กระทู้เมือง</span><h1>Kuapapoh: The Day Old Houses Stand Up to Tell Their Stories</h1><p class="lead">A creative space project that revived houses number 78, 109, and 305 · What the new generation tells about the town, and what history still needs to uncover</p><p class="story-meta">Updated on 2026-09-07 · 6-minute read</p></header><figure class="hero-photo-v2"><img src="/assets/photos/kuapapoh-brand.jpg" alt="กั่วป่าโพ้ · แบรนด์ของโครงการเมืองเก่าตะกั่วป่า" loading="eager"><figcaption><span>Kuapapoh, the identity of the old town project</span><span class="credit">โครงการกั่วป่าโพ้ (The Kuapapoh project)</span></figcaption></figure><div class="story-layout-v2"><div class="story-main-v2"><div class="story-lede-v2"><p>Imagine strolling along Sri Takua Pa Road, a street lined with old shophouses that have stood the test of time. Many of these buildings have their wooden doors quietly shut, sleeping away alongside the long-gone golden age of tin mining. Underneath that quietness, however, lie countless memories of the town, its people, and its trade, waiting to be told.</p><p>In recent years, a creative space project called 'Kuapapoh Ji Show Mueang' has stepped in to open the doors of these once-abandoned old houses and bring them back to life. They did not just repaint or repair the roofs, but are bringing the stories of Takua Pa back on display for the newer generations to see.</p><p>This movement reflects a town trying to stand up and tell its own story through the perspectives of locals, artists, and community collaboration. However, in reading these changes, we must still distinguish between newly created narratives for tourism and historical facts that still need careful verification.</p></div><section class="story-section-v2"><h2 id="section-0">The Once Sleeping Spaces Return to the Town</h2><figure class="section-photo-v2"><img src="/assets/photos/shophouse-109.webp" alt="ตึกแถวเลขที่ 109 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>Shophouse number 109 on the old town culture street</span><span class="credit">Kuapapoh project archive</span></figcaption></figure><p>We often remember Takua Pa through its prosperous tin mining era. When that industry declined, many buildings were left behind. One of them is house number 78, formerly a mine owner's residence and a tin mining company office. Today, this once-empty space has been transformed into the 'Kuapa Mueang Museum', exhibiting mining equipment, old maps, and important documents for visitors to experience the traces of the past.</p><p>Not far away on the same route is house number 109, the building of the Kang Tang Yui Kuan or Wui Kun shrine, an association of the Hakka Chinese. The second floor of the building still houses the deity Tham Kung Ya for people to pay their respects. But the ground floor space, which used to be empty and unused, has been turned into the 'Kuapapoh Gallery' to host exhibitions and showcase the wisdom of the Takua Pa old town residents.</p><p>Another significant building that the project has dusted off is building number 305, or 'Tao Ming School' (the town's first Chinese school), which was an educational center during the prosperous mining era. The team came up with the idea to revive this space under the name 'Tao Ming: The Spark of Learning', using it as a venue to exhibit knowledge on architecture, culture, and traditions related to Takua Pa.</p><p>The effort to bring these three spaces back into use is an initiative filled with the project owners' determination to add economic value and create worth for the town. We must collectively understand, however, that this is an explanation and operation at the community project level, not an official declaration of historical site status or historical endorsement from government agencies.</p></section><blockquote class="pull-quote-v2"><p>Working with community narratives is about balancing beautiful memories with facts that must be verified.</p></blockquote><section class="story-section-v2"><h2 id="section-1">Kuapapoh: A Moniker Carried by the River</h2><figure class="section-photo-v2"><img src="/assets/photos/tao-ming-school.jpg" alt="อาคารโรงเรียนเต้าหมิง ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>Tao Ming School seen from the front, on the old town culture street</span><span class="credit">Kuapapoh project archive</span></figcaption></figure><p>As soon as you hear the name 'Kuapapoh', the first question that usually follows is where this word comes from. The project's archival information explains that this was the term Hokkien Chinese used in the past to call Takua Pa town, dividing the translation into two parts: 'Kuapa' meaning Takua Pa, and 'Poh' meaning market or port.</p><p>When combined, the word conveys 'Takua Pa port market', reflecting the past image of Chinese people sailing across the sea to trade and mine tin, using the pier as a center for exchanging both goods and culture. In addition, in the community's belief, the word Kuapapoh is also embedded in the rituals performed at various shrines during the vegetarian festival, becoming a word with deep meaning in the hearts of the townspeople.</p><p>While this is a beautiful story that connects well with the community's roots, in academic circles, the origin of the Takua Pa town name is still debated with several suggested, not settled hypotheses. Some refer to the ancient name Takola, while others base it on the words takua (lead) and pa (forest).</p><p>Therefore, the project's explanation is considered a record of memory and interpretation through the context of the Hokkien Chinese community, rather than a single, settled historical academic conclusion. This is the reason we must read this story with an open mind and caution.</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">not settled academically</span></div></section><section class="story-section-v2"><h2 id="section-2">Peranakan Charm Through the Brush Tip</h2><figure class="section-photo-v2"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" loading="lazy"><figcaption><span>Tao Ming School</span><span class="credit">Illustration</span></figcaption></figure><p>The liveliness of the old town district reappeared concretely in September 2026 (2569 BE) when 78 Studio on Takua Pa Culture Street opened its space to host a solo art exhibition titled 'Peranakan Charm · Still Becoming'.</p><p>The artist behind these works is Tinnaphop Ngansathir, or Chang Pong. He is a native of Takua Pa old market, growing up with cartoon drawings, superheroes, and Chinese deities familiar in the local culture. After accumulating artistic experience for a long time, he chose to use his brush tip to convey the stories of the town he is attached to.</p><p>The artworks in the exhibition focus on extracting Peranakan colors, patterns, and clothing for display, serving as a bridge connecting the glorious past with people in the present era. Each painting is not just visually beautiful, but an emotional record of the artist towards the town.</p><p>Even though the project documents clearly record the exhibition hosting and the opening of space for artists to express themselves, what we still do not see in the reports are the number of attendees or a formal economic impact assessment. These activities thus serve as cultural ripples rather than official government statistics.</p></section><section class="story-section-v2"><h2 id="section-3">Viewing the Town Through the Lens of Six Heritages</h2><figure class="section-photo-v2"><img src="/assets/photos/kuapapoh-pattern.jpg" alt="ลายกระเบื้องเปอรานากันที่ยังเห็นได้ในเมืองเก่า" loading="lazy"><figcaption><span>Peranakan tile patterns still visible in the old town</span><span class="credit">โครงการกั่วป่าโพ้ (The Kuapapoh project)</span></figcaption></figure><p>To help visitors understand the identity of Takua Pa old town more deeply, the project did not stop at organizing exhibitions. They also compiled and presented the '6 Or' concept to use as a framework for viewing the town's heritage hidden in daily life.</p><p>This concept starts with 'Aphon' (Apparel) or local clothing, whether it is lace fabrics, batik sarongs, and various accessories. Followed by 'Asai' (Abode) which covers the way of life, trading, and living in accordance with the times. As for 'Ahan' (Food), it is indispensable. It is the traditional flavors passed down from generation to generation, and the old restaurants that still keep their stoves on to this day.</p><p>In the dimension of the mind, the town is driven by 'Arom' (Emotion) expressed through art, music, and the sound of drums in the vegetarian festival. Meanwhile, 'Aram' (Temples and Shrines) is the center of faith, including temples, shrines, and Yui Kuan scattered around the old town district. And finally, 'Akhan' (Architecture), the structures that stand as witnesses to change.</p><p>All these concepts were also further developed in the design of souvenirs, such as the Poh Shop project's t-shirts. The revenue from the sales is brought back to fund the restoration and drive the town's activities forward, truly circulating value back to the community.</p></section><section class="story-section-v2"><h2 id="section-4">What the Town Tells and What We Must Verify</h2><figure class="section-photo-v2"><img src="/assets/culture-street.webp" alt="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>Takua Pa Old Town Cultural Street</span><span class="credit">Illustration</span></figcaption></figure><p>The Kuapapoh project allows us to see the determination of the new generation and locals who want to preserve and build upon the stories of Takua Pa. They created creative spaces, brought in art as a medium, and turned once-closed houses into new travel destinations.</p><p>What is recorded on the project's website and documents serves as a contemporary archive that the community chose to tell about itself. It is a memory full of life and the pride of the residents.</p><p>At the same time, however, reading these stories also calls for us to maintain a balance between appreciation and historical facts. Many parts of the information are explanations that have not been endorsed by government agencies and cannot replace calendars or academic documents.</p><p>This is the challenge and fun of walking around Takua Pa old town today. We have the task of listening to those beautiful stories while simultaneously asking questions and finding answers from reliable sources, so that our journey does not end with just looking at pictures, but truly understanding the town in all dimensions.</p></section><section class="story-places-v2"><h2>Where to visit in person</h2><div class="mini-cards-v2"><div class="place-card-mini"><div><h4>Tao Ming School</h4><button class="button button-outline" data-trip-add="tao-ming">Add to trip</button></div></div><div class="place-card-mini"><div><h4>Takua Pa Old Town Cultural Street</h4><button class="button button-outline" data-trip-add="culture-street">Add to trip</button></div></div><div class="place-card-mini"><div><h4>Takuapa Riverwalk</h4><button class="button button-outline" data-trip-add="riverwalk">Add to trip</button></div></div></div></section><details class="unknowns-box-v2"><summary>Missing data</summary><ul><li>The number of attendees or the official economic impact generated by the project</li><li>The legal status or endorsement from government agencies of the three houses</li><li>The clear and settled origin of the Takua Pa town name in history</li></ul></details><section class="story-sources-v2"><h2>Sources</h2><ol><li><cite>กั่วป่าโพ้ · จดหมายเหตุโครงการ</cite> · โครงการกั่วป่าโพ้ · content.json · ส่วน origin, events, openings · <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">View sources</a> (Accessed 2026-09-07)</li></ol></section></div><div class="story-sidebar-v2"><aside class="evidence-box-v2"><h3>Where is the evidence?</h3><ul class="ev-items-v2"><li><div class="ev-claim">Defining houses number 78, 109, and 305 as creative spaces</div><div class="ev-status qualified">QUALIFIED</div><div class="ev-explain">This is an explanation from the project owner, not a declaration of historical site or space status from a government agency. <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">References ↗</a></div></li><li><div class="ev-claim">The origin of the word Kuapapoh translates to Takua Pa port market</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">The origin of the Takua Pa town name in historical work still has several suggested, not settled hypotheses, thus the project's explanation should not be used as a settled academic conclusion. <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">References ↗</a></div></li><li><div class="ev-claim">The hosting of the Peranakan Charm exhibition by Tinnaphop Ngansathir in September 2026 (2569 BE)</div><div class="ev-status qualified">QUALIFIED</div><div class="ev-explain">Referenced from project data, but not a retrospective official calendar confirming attendee numbers or economic impact. <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">References ↗</a></div></li></ul></aside><nav class="story-toc-v2 scrollspy" id="story-toc"><h2>In this article</h2><ul class="scrollspy-nav"><li><a href="#section-0">The Once Sleeping Spaces Return to the Town</a></li><li><a href="#section-1">Kuapapoh: A Moniker Carried by the River</a></li><li><a href="#section-2">Peranakan Charm Through the Brush Tip</a></li><li><a href="#section-3">Viewing the Town Through the Lens of Six Heritages</a></li><li><a href="#section-4">What the Town Tells and What We Must Verify</a></li></ul></nav></div></div></div><section class="research-section" id="project-gallery"><h2>ภาพจากคลังโครงการกั่วป่าโพ้</h2><div data-gallery><div class="gallery-tabs" hidden><button type="button" data-tab="today">Present photos</button><button type="button" data-tab="archive">Historical photos</button></div><div id="gallery-today" data-panel="today"><h3>Present photos</h3><div class="photo-grid"><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-brand.jpg" aria-label="ขยายภาพ · กั่วป่าโพ้ แบรนด์เมืองเก่าตะกั่วป่า"><img src="/assets/photos/kuapapoh-brand.jpg" alt="กั่วป่าโพ้ แบรนด์เมืองเก่าตะกั่วป่า" loading="lazy"></a><figcaption>กั่วป่าโพ้ แบรนด์เมืองเก่าตะกั่วป่า<small>Credit · Kua Pa Pho / Takua Pa Old Town Project image archive</small><small>License · Image from the project archive, cleared for this website</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-pattern.jpg" aria-label="ขยายภาพ · ลายกระเบื้องเปอรานากันเมืองเก่า"><img src="/assets/photos/kuapapoh-pattern.jpg" alt="ลายกระเบื้องเปอรานากันเมืองเก่า" loading="lazy"></a><figcaption>ลายกระเบื้องเปอรานากันเมืองเก่า<small>Credit · Kua Pa Pho / Takua Pa Old Town Project image archive</small><small>License · Image from the project archive, cleared for this website</small></figcaption></figure></div></div><div id="gallery-archive" data-panel="archive"><h3>Historical photos</h3><div class="photo-grid"><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-history.jpg" aria-label="ขยายภาพ · แผ่นเล่าประวัติกั่วป่าโพ้"><img src="/assets/photos/kuapapoh-history.jpg" alt="แผ่นเล่าประวัติกั่วป่าโพ้" loading="lazy"></a><figcaption>แผ่นเล่าประวัติกั่วป่าโพ้<small>Credit · Kua Pa Pho / Takua Pa Old Town Project image archive</small><small>License · Image from the project archive, cleared for this website</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-wuikun.jpg" aria-label="ขยายภาพ · หวุ่ยกุ่น"><img src="/assets/photos/kuapapoh-wuikun.jpg" alt="หวุ่ยกุ่น" loading="lazy"></a><figcaption>หวุ่ยกุ่น<small>Credit · Kua Pa Pho / Takua Pa Old Town Project image archive</small><small>License · Image from the project archive, cleared for this website</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-doc-1.jpg" aria-label="ขยายภาพ · เอกสารเก่าเมืองตะกั่วป่า 1"><img src="/assets/photos/kuapapoh-doc-1.jpg" alt="เอกสารเก่าเมืองตะกั่วป่า 1" loading="lazy"></a><figcaption>เอกสารเก่าเมืองตะกั่วป่า 1<small>Credit · Kua Pa Pho / Takua Pa Old Town Project image archive</small><small>License · Image from the project archive, cleared for this website</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-doc-2.jpg" aria-label="ขยายภาพ · เอกสารเก่าเมืองตะกั่วป่า 2"><img src="/assets/photos/kuapapoh-doc-2.jpg" alt="เอกสารเก่าเมืองตะกั่วป่า 2" loading="lazy"></a><figcaption>เอกสารเก่าเมืองตะกั่วป่า 2<small>Credit · Kua Pa Pho / Takua Pa Old Town Project image archive</small><small>License · Image from the project archive, cleared for this website</small></figcaption></figure></div></div></div></section></main><footer class="site-footer"><div class="footer-top"><a href="/en/" class="footer-name">Takua Pa <em>101</em></a><p>One city<br>Stories to get to know</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">Created by Baan Siwara, Takua Pa</a><span>Old Town Guide · Phang Nga Province</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">Original Brochure ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/en/"><span class="tb-glyph" aria-hidden="true">⌂</span>Home</a><a href="/en/map/"><span class="tb-glyph" aria-hidden="true">◈</span>Map</a><a href="/en/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>Eat</a><a href="/en/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>Trip<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
