ttps://takuapa101.pages.dev/places/guan-yu/", "image": "https://takuapa101.pages.dev/assets/guan-yu.webp", "description": "ศาลเจ้าที่สัมพันธ์กับความเชื่อในเทพกวนอูและชุมชนการค้า", "address": {"@type": "PostalAddress", "streetAddress": "บริเวณถนนอุดมธาราตัดถนนศรีตะกั่วป่า ย่านตลาดใหญ่ ตำบลตะกั่วป่า อำเภอตะกั่วป่า จังหวัดพังงา", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "postalCode": "82110", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.82945, "longitude": 98.36518}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "เทศบาลระบุว่าศาลเจ้าเกิดจากศรัทธาของชาวจีนฮกเกี้ยนในตะกั่วป่า มีอายุนับร้อยปี และเป็นที่ยึดเหนี่ยวจิตใจผ่านความเชื่อในกวนอูและเจ้าแม่กวนอิม เทศบาลระบุศาลเจ้าแห่งนี้เป็นต้นกำเนิดเทศกาลกินผักตะกั่วป่า"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "สิ่งสักการะสำคัญที่เทศบาลระบุไว้สำหรับศาลเจ้าแห่งนี้ จีเพลสระบุว่ามีเกี้ยวสำหรับใช้ในขบวนแห่ ต้องตรวจสอบหน้างานว่าเปิดให้ชมในวันเดินทางหรือไม่"}}, {"@type": "Question", "name": "เอกสารเทศบาลกล่าวถึงที่นี่อย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "ศาลเจ้าที่สัมพันธ์กับความเชื่อในเทพกวนอูและชุมชนการค้า"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><script src="/assets/trip.js" defer></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.pages.dev/places/guan-yu/"><link rel="alternate" hreflang="en" href="https://takuapa101.pages.dev/en/places/guan-yu/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.pages.dev/places/guan-yu/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><a href="/places/" aria-current="page">สถานที่</a><a href="/news/">ความเคลื่อนไหว</a><a href="/map/">แผนที่</a><a href="/traditions/">ประเพณี</a><a href="/eat/">กินและของฝาก</a><a href="/rest/">กินเที่ยว</a><a href="/routes/">เส้นทางเดิน</a><a href="/trip/">ทริปของคุณ</a><a href="/about/">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/places/guan-yu/" hreflang="en" lang="en">EN</a><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/">หน้าแรก</a> / <a href="/places/">สถานที่</a> / ศาลเจ้าและโรงเจ</div><header class="place-hero full-place-hero"><div><span class="chapter">บันทึกสถานที่ · ศาลเจ้าและโรงเจ</span><h1>ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</h1><p class="english">Guan Yu / Sin Chai Tung Shrine</p><span class="fact-status confirmed">ยืนยันแล้ว 4 ข้อ</span><p><a class="text-link" href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้ ↓</a></p></div><div class="place-hero-art"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>ข้อมูลใช้จริง</h2><dl><div><dt>พิกัด</dt><dd>8.82945, 98.36518 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.82945,98.36518" target="_blank" rel="noopener">นำทางด้วย Google Maps ↗</a><a href="https://mapcarta.com/W816145901" target="_blank" rel="noopener">แหล่งพิกัด ↗</a></div><div><dt>เวลาเปิด</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ค่าเข้า</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ที่จอดรถ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ห้องน้ำ</dt><dd>มีรีวิวกล่าวถึงห้องน้ำสาธารณะใกล้ศาลเจ้า แต่ยังไม่ยืนยันการเปิดใช้ปัจจุบันและสิ่งอำนวยความสะดวกภายใน <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div><dt>รถเข็น</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>การแต่งกาย</dt><dd>แหล่งข้อมูลชุมชนระบุว่าผู้ร่วมเทศกาลกินผักแต่งชุดขาว; ไม่พบข้อบังคับการแต่งกายในวันปกติ <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div><dt>โทรศัพท์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เพจ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เว็บไซต์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ไลน์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><a href="https://mgronline.com/south/detail/9670000093105" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a><a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a><a href="https://wanderlog.com/place/details/10219897/sin-chai-tueng-shrine" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">ในบันทึกหน้านี้</span><a href="#visit">ข้อมูลใช้จริง</a><a href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้</a><a href="#timeline">เส้นเวลาแบบจุด</a><a href="#highlights">จุดเด่นที่ควรดู</a><a href="#news">ข่าวและความเคลื่อนไหว</a><a href="#did_you_know">รู้หรือไม่</a><a href="#getting_there">วิธีเดินทาง</a><a href="#nearby">ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</a><a href="#faq">คำถามที่พบบ่อย</a><a href="#sources">ที่มาของข้อมูล</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>ตอนนั้น · ก่อนหน้า · ตอนนี้</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">ตอนนั้น</span><h3>ศรัทธากวนอูในเมืองเหมือง: จุดตั้งต้นของโรงพระตลาดใต้</h3><p class="era-years">พ.ศ. 2386 (เรื่องเล่า; ยังไม่ยืนยัน)</p><span class="fact-status disputed">ข้อมูลขัดแย้ง</span><p>เรื่องเล่าที่บันทึกโดย Gplace ระบุว่า ชาวจีนฮกเกี้ยนที่เข้ามาทำเหมืองแร่ในชุมชนคลองปีรวมตัวกันสร้างศาลกวนอู โดยมีเถ้าแก่หลิม บุน ตึกเกี่ยวข้องกับการก่อตั้ง และเริ่มพิธีกินผัก 9 วัน 9 คืนใน พ.ศ. 2386 แต่แหล่งเดียวกันสะกดชื่อบุคคลไม่สม่ำเสมอ และยังไม่พบหลักฐานปฐมภูมิ จึงควรอ่านเป็นตำนานกำเนิด ไม่ใช่ปีที่ยืนยันแล้ว</p><p>ฉากหลังของตะกั่วป่าในเวลานั้นคือเมืองชายฝั่งที่เติบโตจากเหมืองดีบุกและเครือข่ายพ่อค้าจีนฮกเกี้ยน ศาลจึงน่าจะทำหน้าที่ทั้งเป็นที่ประดิษฐานเทพผู้คุ้มครองชุมชนและเป็นศูนย์กลางพิธีกรรมของคนงานเหมืองกับพ่อค้า ข้อนี้สอดคล้องกับคำอธิบายของเทศบาลที่ระบุว่าศาลเกิดจากศรัทธาชาวจีนฮกเกี้ยนและเป็นต้นกำเนิดเทศกาลกินผักตะกั่วป่า แต่รายละเอียดปีและผู้สร้างยังไม่ถูกยืนยันในเอกสารวิชาการ.</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://www.gplace.com/972712" target="_blank" rel="noopener">Gplace</a> · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า</a> · <a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">ศูนย์มานุษยวิทยาสิรินธร: เมืองตะกั่วป่า</a></div></article><article class="era-card" data-era="before"><span class="chapter">ก่อนหน้า</span><h3>จากศาลชุมชนสู่โรงพระตลาดใต้ในเมืองเก่า</h3><p class="era-years">พ.ศ. 2445 (เรื่องเล่า; ยังไม่ยืนยัน) · ก่อน พ.ศ. 2567</p><span class="fact-status unverified">ยังไม่ยืนยัน</span><p>Gplace เล่าว่าศาลถูกย้ายจากชุมชนคลองปีไปตั้งถาวรที่บ้านแช่หลิมในตลาดใหญ่ และมีการระดมทุนซื้อบ้านใน พ.ศ. 2445 โดยหลิม เอ๋ง เช่ง หรือเถ้าแก่พ่อแดง อย่างไรก็ตาม ยังไม่พบหลักฐานยืนยันปีสร้างอาคารหรือการเปลี่ยนมือ จึงไม่ควรสรุปว่าปีดังกล่าวคือปีสร้างศาลปัจจุบัน</p><p>หลักฐานที่พบอธิบายบทบาทของสถานที่ต่อเนื่องมากกว่าการเปลี่ยนหน้าที่: ศาลยังผูกกับพิธีกินผักของชุมชนตะกั่วป่า ซึ่งสืบทอดในหมู่ชาวไทยเชื้อสายจีนฝั่งอันดามัน และต่อมากลายเป็นส่วนหนึ่งของภูมิทัศน์เมืองเก่าตลาดใหญ่ ขณะเดียวกันยังไม่พบหลักฐานออนไลน์ที่ยืนยันการบูรณะครั้งใด การถูกทิ้งร้าง ผลกระทบโดยตรงจากสึนามิ พ.ศ. 2547 หรือการขึ้นทะเบียนเป็นโบราณสถานของศาลแห่งนี้.</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://www.gplace.com/972712" target="_blank" rel="noopener">Gplace</a> · <a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">ศูนย์มานุษยวิทยาสิรินธร: เมืองตะกั่วป่า</a> · <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">ศูนย์มานุษยวิทยาสิรินธร: ตลาดใหญ่</a></div></article><article class="era-card" data-era="now"><span class="chapter">ตอนนี้</span><h3>ศาลที่ยังหายใจไปพร้อมเทศกาลกินผัก</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>หลักฐานข่าวล่าสุดที่พบยืนยันการใช้งานศาลในฐานะโรงพระตลาดใต้: วันที่ 2 ตุลาคม 2567 มีพิธียกเสาโกเต้งที่ศาลเจ้าเพื่อเริ่มเทศกาลถือศีลกินผัก การแขวนตะเกียง 9 ดวงและพิธีต่อเนื่องทำให้ศาลยังเป็นศูนย์กลางศรัทธาและกิจกรรมร่วมของชุมชน ไม่ใช่เพียงอาคารเก่าในย่านตลาด</p><p>สำหรับปี 2569 ยังไม่มีแหล่งที่ยืนยันเวลาเปิด ผู้ดูแล ค่าเข้าชม สภาพอาคารล่าสุด หรือโครงการบูรณะเฉพาะศาล จึงควรติดต่อชุมชน/เทศบาลก่อนเดินทาง เท่าที่มีข้อมูล ศาลตั้งอยู่บริเวณถนนอุดมธาราตัดถนนศรีตะกั่วป่าในย่านตลาดใหญ่ และกิจกรรมที่ยืนยันได้คือเทศกาลถือศีลกินผักกับพิธียกเสาโกเต้ง.</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://mgronline.com/south/detail/9670000093105" target="_blank" rel="noopener">ผู้จัดการออนไลน์</a> · <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">ศูนย์มานุษยวิทยาสิรินธร: ตลาดใหญ่</a></div></article></div></section><section class="research-section" id="timeline"><h2>เส้นเวลาแบบจุด</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status unverified">ยังไม่ยืนยัน</span><p class="era-years">พ.ศ. 2386</p><h3>เรื่องเล่าการก่อตั้งศาลและเริ่มกินผัก</h3><p>Gplace ระบุว่ามีการก่อตั้งศาลกวนอูและเริ่มพิธีกินผัก 9 วัน 9 คืนในชุมชนคลองปี แต่ยังไม่มีหลักฐานปฐมภูมิยืนยัน</p><a href="https://www.gplace.com/972712" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status unverified">ยังไม่ยืนยัน</span><p class="era-years">พ.ศ. 2445</p><h3>เรื่องเล่าการย้ายมาตั้งถาวรที่ตลาดใหญ่</h3><p>Gplace ระบุการระดมทุนซื้อบ้านเพื่อย้ายศาลมาตั้งในตลาดใหญ่ แต่ไม่ยืนยันว่าเป็นปีสร้างอาคารปัจจุบัน</p><a href="https://www.gplace.com/972712" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">2 ตุลาคม 2567</p><h3>ยกเสาโกเต้งที่โรงพระตลาดใต้</h3><p>ข่าวรายงานพิธียกเสาโกเต้งเพื่อเริ่มเทศกาลถือศีลกินผักของชาวตะกั่วป่า</p><a href="https://mgronline.com/south/detail/9670000093105" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li></ol></section><p class="missing-photo">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่</p><section class="research-section" id="highlights"><h2>จุดเด่นที่ควรดู</h2><div class="research-cards"><article class="research-note"><h3>องค์กวนอูและเจ้าแม่กวนอิม</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>สิ่งสักการะสำคัญที่เทศบาลระบุไว้สำหรับศาลเจ้าแห่งนี้</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>อาคารสองรูปแบบ</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>จีเพลสระบุอาคารชิโน-โปรตุกีสและอาคารศาลเจ้าจีนคนละฝั่งถนน ข้อมูลรูปแบบยังไม่ยืนยันจากการสำรวจสถาปัตยกรรม</p><a href="https://www.gplace.com/972712" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>เกี้ยวอัญเชิญเทพเจ้า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>จีเพลสระบุว่ามีเกี้ยวสำหรับใช้ในขบวนแห่ ต้องตรวจสอบหน้างานว่าเปิดให้ชมในวันเดินทางหรือไม่</p><a href="https://www.gplace.com/972712" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="news"><h2>ข่าวและความเคลื่อนไหว</h2><div class="research-cards"><article class="research-note"><p class="muted">2024-10-02 · ผู้จัดการออนไลน์</p><h3>ศาลเจ้าเก่าแก่ในพื้นที่ อ.ตะกั่วป่า จ.พังงา ประกอบพิธียกเสาโกเต้งแล้ว</h3><p>รายงานพิธียกเสาโกเต้งที่ศาลเจ้าพ่อกวนอู ซิ่นใช่ตึ๋ง โรงพระตลาดใต้ เพื่อเริ่มเทศกาลถือศีลกินผัก</p><a href="https://mgronline.com/south/detail/9670000093105" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>รู้หรือไม่</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>เทศบาลเมืองตะกั่วป่าระบุว่าศาลแห่งนี้เป็นต้นกำเนิดเทศกาลกินผักตะกั่วป่า</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ชื่อที่ใช้เรียกศาลอีกชื่อหนึ่งคือ โรงพระตลาดใต้</p><a href="https://mgronline.com/south/detail/9670000093105" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>วิธีเดินทาง</h2><div class="research-cards"><article class="research-note"><h3>ตัวเมืองตะกั่วป่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ปลายทางอยู่ในย่านตลาดใหญ่ บริเวณถนนอุดมธาราตัดถนนศรีตะกั่วป่า; ยังไม่พบเส้นทางรถโดยสารจากตัวเมืองใหม่ถึงหน้าศาลเจ้าที่ตรวจสอบได้</p><a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ภูเก็ต</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>เว็บข้อมูลการเดินรถระบุรถสาย 436 ภูเก็ต·ตะกั่วป่า ผ่านโคกกลอย ท้ายเหมือง และเขาหลัก ไปยังสถานีขนส่งตะกั่วป่า ข้อมูลนี้ยังไม่ยืนยันเที่ยวรถปัจจุบันหรือการต่อรถถึงศาลเจ้า</p><a href="https://gogo.town/route/phuket-takuapa-bus-436/" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>เขาหลัก</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>เขาหลักอยู่บนเส้นทางรถสาย 436 ภูเก็ต·ตะกั่วป่าตามเว็บข้อมูลการเดินรถ ต้องตรวจสอบจุดขึ้นรถและเที่ยวที่รับผู้โดยสารระหว่างทาง; ยังไม่พบข้อมูลต่อรถจากสถานีขนส่งถึงศาลเจ้า</p><a href="https://gogo.town/route/phuket-takuapa-bus-436/" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="nearby"><h2>ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</h2><ul class="nearby-links"><li>กำแพงเมืองเก่า <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://mapcarta.com/W816145901" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li>วัดหน้าเมือง <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://mapcarta.com/W816145901" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a> <span class="fact-status unknown">ยังไม่ยืนยัน</span></li><li>วัดเสนานุชรังสรรค์ <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://mapcarta.com/W816145901" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><a href="/places/pun-thao/">ศาลเจ้าปุนเถ่ากงอ๊า</a></li><li><a href="/places/rong-jae/">โรงเจในสวน</a></li></ul></section><section class="research-section" id="faq"><h2>คำถามที่พบบ่อย</h2><details><summary>สถานที่นี้มีประวัติความเป็นมาอย่างไร</summary><p>เทศบาลระบุว่าศาลเจ้าเกิดจากศรัทธาของชาวจีนฮกเกี้ยนในตะกั่วป่า มีอายุนับร้อยปี และเป็นที่ยึดเหนี่ยวจิตใจผ่านความเชื่อในกวนอูและเจ้าแม่กวนอิม เทศบาลระบุศาลเจ้าแห่งนี้เป็นต้นกำเนิดเทศกาลกินผักตะกั่วป่า</p></details><details><summary>มีจุดเด่นอะไรให้ชม</summary><p>สิ่งสักการะสำคัญที่เทศบาลระบุไว้สำหรับศาลเจ้าแห่งนี้ จีเพลสระบุว่ามีเกี้ยวสำหรับใช้ในขบวนแห่ ต้องตรวจสอบหน้างานว่าเปิดให้ชมในวันเดินทางหรือไม่</p></details><details><summary>เอกสารเทศบาลกล่าวถึงที่นี่อย่างไร</summary><p>ศาลเจ้าที่สัมพันธ์กับความเชื่อในเทพกวนอูและชุมชนการค้า</p></details></section><section class="research-section" id="sources"><h2>ที่มาของข้อมูล</h2><div class="source-table"><table><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>วันที่เข้าถึง</th><th>ลิงก์</th></tr></thead><tbody><tr><th scope="row">เทศบาลเมืองตะกั่วป่า: แผนการดำเนินงานด้านสิ่งแวดล้อม หน้าเอกสาร 14</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ศูนย์มานุษยวิทยาสิรินธร: ฐานข้อมูลชุมชน ตลาดใหญ่</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ผู้จัดการออนไลน์: พิธียกเสาโกเต้ง 2 ตุลาคม 2567</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://mgronline.com/south/detail/9670000093105" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">แมปคาร์ตา: ศาลเจ้าซิ่นไช่ตึ๋ง</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://mapcarta.com/W816145901" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">จีเพลส: ศาลเจ้าพ่อกวนอู ซินใช่ตึ๋ง</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://www.gplace.com/972712" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">วันเดอร์ล็อก: ศาลเจ้าซิ่นไช่ตึ๋ง</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://wanderlog.com/place/details/10219897/sin-chai-tueng-shrine" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">โกโกทาวน์: รถสาย 436 ภูเก็ต·ตะกั่วป่า</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://gogo.town/route/phuket-takuapa-bus-436/" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ศูนย์มานุษยวิทยาสิรินธร: เมืองตะกั่วป่า</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ศูนย์มานุษยวิทยาสิรินธร: ตลาดใหญ่</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ผู้จัดการออนไลน์</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://mgronline.com/south/detail/9670000093105" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">Gplace</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://www.gplace.com/972712" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">1672 TravelBuddy</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://1672travelbuddy.com/" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>พิกัดใช้จุดสถานที่จากแมปคาร์ตาที่อ้างโอเพนสตรีตแมป ยังไม่ยืนยันว่าเป็นทางเข้าหรืออาคารส่วนใด จึงให้ความมั่นใจปานกลาง</li><li>ที่อยู่ในวันเดอร์ล็อกระบุตำบลบางไทร ต่างจากจีเพลสและฐานข้อมูลชุมชนของศูนย์มานุษยวิทยาสิรินธร จึงเลือกตำบลตะกั่วป่าตามแหล่งหลัง; ไม่พบเลขที่อาคาร</li><li>เวลาเปิด·ปิดและค่าเข้าชมเป็น null เพราะไม่พบประกาศที่ยืนยันได้</li><li>เบอร์โทรเป็น null: วันเดอร์ล็อกแสดง +66 82 652 9164 แต่ยังไม่พบแหล่งศาลเจ้าหรือหน่วยงานยืนยันว่าเป็นเบอร์ติดต่อปัจจุบัน</li><li>เฟซบุ๊กเป็น null: จีเพลสมีลิงก์ที่ตัดขาดหรือเสียหาย เปิดตรวจสอบเพจไม่ได้; ไม่พบเว็บไซต์และไลน์ทางการ</li><li>ปีสร้างและผู้สร้างที่ยืนยันได้ยังไม่พบ ปี 2386 และ 2445 เป็นเรื่องเล่าจากจีเพลส ไม่ควรใช้เป็นปีสร้างอาคารโดยตรง</li><li>ความเกี่ยวข้องกับโรงถลุงดีบุกพบเฉพาะเรื่องเล่า ยังยืนยันบทบาทต่อแรงงานเหมืองหรือเครือข่ายการค้าโดยตรงไม่ได้</li><li>ยังไม่พบเอกสารกรมศิลปากรหรือประกาศราชกิจจานุเบกษาที่ระบุการขึ้นทะเบียนโบราณสถานของศาลนี้; การกล่าวถึงการจดทะเบียนสังกัดมหาดไทยในจีเพลสไม่ใช่หลักฐานขึ้นทะเบียนโบราณสถาน</li><li>ไม่พบข้อมูลที่จอดรถ ทางลาด ความกว้างประตู ขั้นบันได หรือห้องน้ำสำหรับรถเข็น จึงไม่ประเมินความสะดวกสำหรับผู้สูงอายุ</li><li>ไม่พบเวลาที่แนะนำสำหรับการชมทั่วไปและระยะเวลาเยี่ยมชมที่มีหลักฐานรองรับ</li><li>ยังไม่มีระยะทางจากต้นทางถึงศาลเจ้า เส้นทางต่อรถ และเวลาเดินถึงสถานที่ใกล้เคียงที่ตรวจสอบได้; รายการใกล้เคียงมาจากแผนที่ ไม่ใช่การสำรวจทางเท้า</li><li>ยังไม่พบกำหนดเทศกาลปี 2569 ที่อ่านและยืนยันได้</li><li>ไม่พบลิงก์ไฟล์รูปภาพทางการของศาลเจ้าที่ตรวจสอบตัวภาพและที่มาได้ จึงเว้น photos เป็นรายการว่าง</li><li>คำค้น SEO เป็นข้อเสนอจากชื่อและเนื้อหาที่พบ ไม่ใช่ข้อมูลปริมาณการค้นหาจริง</li><li>ชื่ออังกฤษใช้ตามโจทย์ และมีชื่อสะกดต่างกันในจีเพลสกับแมปคาร์ตา ยังไม่พบชื่ออังกฤษที่ประกาศโดยศาลเจ้า</li><li>ปี พ.ศ. ที่ก่อตั้งศาลและปีสร้างอาคารปัจจุบันยังไม่มีหลักฐานปฐมภูมิ</li><li>ชื่อผู้ก่อตั้งและผู้ดูแลในแต่ละยุคยังไม่ยืนยัน</li><li>ไม่พบหลักฐานยืนยันการบูรณะ การถูกทิ้งร้าง หรือการใช้ทำหน้าที่อื่น</li><li>ไม่พบหลักฐานยืนยันว่าศาลได้รับผลกระทบโดยตรงจากสึนามิ พ.ศ. 2547</li><li>ไม่พบหลักฐานว่าศาลขึ้นทะเบียนโบราณสถาน</li><li>ยังไม่ยืนยันเวลาเปิด สภาพอาคาร ผู้ดูแล และกำหนดเทศกาลปี 2569</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
.\site\places\phra-narai\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api="https://takuapa101-news.siwatid-99.workers.dev"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>สวนสาธารณะพระนารายณ์ · ตะกั่วป่า 101</title><meta name="description" content="พื้นที่พักกับเรื่องราวความเชื่อ · สวนสาธารณะในเขตเทศบาลที่มีเรื่องราวขององค์พระนารายณ์ ชวนรู้จักเมืองผ่านพื้นที่พักผ่อนและศรัทธา"><meta name="robots" content="noindex,follow"><meta property="og:title" content="สวนสาธารณะพระนารายณ์"><meta property="og:description" content="พื้นที่พักกับเรื่องราวความเชื่อ · สวนสาธารณะในเขตเทศบาลที่มีเรื่องราวขององค์พระนารายณ์ ชวนรู้จักเมืองผ่านพื้นที่พักผ่อนและศรัทธา"><meta property="og:url" content="https://takuapa101.pages.dev/places/phra-narai/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.pages.dev/assets/og/phra-narai.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.pages.dev/assets/og/phra-narai.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.pages.dev/places/phra-narai/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.pages.dev/"}, {"@type": "ListItem", "position": 2, "name": "สวนสาธารณะพระนารายณ์", "item": "https://takuapa101.pages.dev/places/phra-narai/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "สวนสาธารณะพระนารายณ์", "url": "https://takuapa101.pages.dev/places/phra-narai/", "image": "https://takuapa101.pages.dev/assets/phra-narai.webp", "description": "สวนในพื้นที่เทศบาลที่มีเรื่องราวเกี่ยวกับองค์พระนารายณ์", "address": {"@type": "PostalAddress", "streetAddress": "หมู่ชุมชนศรีเมือง ถนนเพชรเกษม", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "postalCode": "82110", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8696046, "longitude": 98.3445279}, "telephone": "076 421 750"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "อยู่ตรงข้ามสำนักงานเทศบาลเมืองตะกั่วป่าและที่ว่าการเทศบาลเมืองตะกั่วป่า บนถนนเพชรเกษม"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "สวนอยู่ภายใต้การดูแลบริหารจัดการของเทศบาลเมืองตะกั่วป่า สวนเป็นสถานที่พักผ่อนหย่อนใจและเป็นที่ประดิษฐานองค์เทวรูปพระนารายณ์กับเทพบริวารจำลอง"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "ประติมากรรมรูปเคารพพระนารายณ์สำหรับให้ประชาชนสักการะบูชา ภายในสวนมีองค์พระนารายณ์และเทพบริวารจำลองตามข้อมูลแหล่งราชการ พื้นที่ส่วนหนึ่งของสวนจัดเป็นสนามเด็กเล่น"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><script src="/assets/trip.js" defer></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.pages.dev/places/phra-narai/"><link rel="alternate" hreflang="en" href="https://takuapa101.pages.dev/en/places/phra-narai/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.pages.dev/places/phra-narai/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><a href="/places/" aria-current="page">สถานที่</a><a href="/news/">ความเคลื่อนไหว</a><a href="/map/">แผนที่</a><a href="/traditions/">ประเพณี</a><a href="/eat/">กินและของฝาก</a><a href="/rest/">กินเที่ยว</a><a href="/routes/">เส้นทางเดิน</a><a href="/trip/">ทริปของคุณ</a><a href="/about/">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/places/phra-narai/" hreflang="en" lang="en">EN</a><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/">หน้าแรก</a> / <a href="/places/">สถานที่</a> / สวนและพื้นที่สาธารณะ</div><header class="place-hero full-place-hero"><div><span class="chapter">บันทึกสถานที่ · สวนและพื้นที่สาธารณะ</span><h1>สวนสาธารณะพระนารายณ์</h1><p class="english">Phra Narai Park</p><span class="fact-status confirmed">ยืนยันแล้ว 5 ข้อ</span><p><a class="text-link" href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้ ↓</a></p></div><div class="place-hero-art"><img src="/assets/phra-narai.webp" alt="สวนสาธารณะพระนารายณ์" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>ข้อมูลใช้จริง</h2><dl><div><dt>พิกัด</dt><dd>8.8696046, 98.3445279 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.8696046,98.3445279" target="_blank" rel="noopener">นำทางด้วย Google Maps ↗</a><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">แหล่งพิกัด ↗</a></div><div><dt>เวลาเปิด</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ค่าเข้า</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ที่จอดรถ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ห้องน้ำ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>รถเข็น</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>การแต่งกาย</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>โทรศัพท์</dt><dd>076 421 750 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div><dt>เพจ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เว็บไซต์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ไลน์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">แหล่งข้อมูลติดต่อ ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">ในบันทึกหน้านี้</span><a href="#visit">ข้อมูลใช้จริง</a><a href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้</a><a href="#timeline">เส้นเวลาแบบจุด</a><a href="#highlights">จุดเด่นที่ควรดู</a><a href="#news">ข่าวและความเคลื่อนไหว</a><a href="#did_you_know">รู้หรือไม่</a><a href="#getting_there">วิธีเดินทาง</a><a href="#nearby">ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</a><a href="#faq">คำถามที่พบบ่อย</a><a href="#sources">ที่มาของข้อมูล</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>ตอนนั้น · ก่อนหน้า · ตอนนี้</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">ตอนนั้น</span><h3>จุดเริ่มต้นของสวนยังอยู่หลังม่านหลักฐาน</h3><p class="era-years"></p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>สำหรับสวนสาธารณะพระนารายณ์โดยตรง ยังไม่พบเอกสารที่ระบุปีจัดสร้าง ผู้ริเริ่ม หรือเหตุผลในการจัดตั้งสวน จึงไม่ควรสรุปว่าสวนเกิดขึ้นในยุคเหมืองแร่ดีบุกหรือในสมัยเจ้าเมืองเพียงเพราะเมืองตะกั่วป่ารุ่งเรืองในช่วงนั้น</p><p>สิ่งที่ยืนยันได้คือ สวนตั้งอยู่หน้าสำนักงานเทศบาลเมืองตะกั่วป่า และเป็นพื้นที่ประดิษฐานเทวรูปพระนารายณ์กับเทพบริวารจำลอง องค์พระนารายณ์มีความหมายต่อเมืองจนถูกใช้เป็นตราสัญลักษณ์เทศบาล แต่หลักฐานนี้อธิบายความสำคัญขององค์เทวรูปและเมือง ไม่ใช่วันกำเนิดสวน</p><p>บริบทเมืองตะกั่วป่าในเอกสารเทศบาลสะท้อนเมืองเก่าที่มีการค้า เหมืองดีบุก อาคารชิโน·โปรตุกีส และชุมชนชาวจีนจำนวนมาก อย่างไรก็ตาม ยังไม่มีหลักฐานเชื่อมองค์ประกอบเหล่านี้เข้ากับการสร้างสวนโดยตรง</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า แผนการดำเนินงานด้านสิ่งแวดล้อม</a> · <a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">ศูนย์ข้อมูลกลางวัฒนธรรม</a></div></article><article class="era-card" data-era="before"><span class="chapter">ก่อนหน้า</span><h3>จากพื้นที่ศักดิ์สิทธิ์สู่เวทีกิจกรรมเมือง</h3><p class="era-years">ไม่พบลำดับปีที่ยืนยันได้</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>หลักฐานที่ค้นพบไม่ได้บันทึกการเปลี่ยนมือ การถูกทิ้งร้าง หรือการบูรณะสวนเป็นช่วงเวลา จึงยังตอบไม่ได้ว่าสวนผ่านเหตุการณ์เหล่านั้นหรือไม่ เช่นเดียวกับผลกระทบจากสึนามิ พ.ศ. 2547 ซึ่งไม่พบรายงานเฉพาะเจาะจงถึงสวนแห่งนี้</p><p>ในช่วงที่มีข้อมูล สวนทำหน้าที่กว้างขึ้นจากจุดสักการะเป็นพื้นที่สาธารณะของเมือง ใช้จัดกิจกรรมวัฒนธรรม สันทนาการ งานประเพณี งานวันเด็ก และเป็นสนามเด็กเล่น โดยเทศบาลเมืองตะกั่วป่าดูแลบริหารจัดการ</p><p>เอกสารเมืองเก่าระบุสถานที่และโบราณสถานหลายแห่งในเขตเทศบาล แต่ไม่พบประกาศกรมศิลปากรที่ขึ้นทะเบียน “สวนสาธารณะอุทยานพระนารายณ์” เป็นโบราณสถานโดยตรง จึงแยกสวนออกจากโบราณสถานใกล้เคียงอย่างระมัดระวัง</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">ศูนย์ข้อมูลกลางวัฒนธรรม</a> · <a href="https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf" target="_blank" rel="noopener">โครงการกำหนดขอบเขตพื้นที่เมืองเก่าตะกั่วป่า</a></div></article><article class="era-card" data-era="now"><span class="chapter">ตอนนี้</span><h3>สวนหน้าศาลากลางใจเมืองที่ยังมีชีวิต</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ข้อมูลล่าสุดที่เปิดเผยยืนยันว่า สวนยังเป็นพื้นที่สาธารณะและอยู่ภายใต้การดูแลของเทศบาลเมืองตะกั่วป่า ภายในมีเทวรูปพระนารายณ์และเทพบริวารสำหรับสักการะ รวมทั้งสนามเด็กเล่นและพื้นที่พักผ่อนของชุมชน</p><p>สวนยังทำหน้าที่เป็นเวทีกลางของเมือง งานบวงสรวงพระนารายณ์และของดีเมืองตะกั่วป่าจัดที่นี่ใน พ.ศ. 2568 และมีข่าวกิจกรรมของดีเมืองตะกั่วป่าที่เวทีกลางสวน ส่วนงานประจำปี พ.ศ. 2566 จัดระหว่าง 27 มีนาคม·5 เมษายน</p><p>ยังไม่มีข้อมูลทางการที่ยืนยันเวลาเปิด·ปิด ค่าเข้า สภาพกายภาพล่าสุด หรือโครงการก่อสร้างที่เสร็จแล้ว สำหรับแนวคิดพัฒนา “Narai Hub &amp; Commercial Center” พบเพียงข่าวนโยบาย/แนวทางของผู้บริหารเทศบาล จึงยังไม่ถือว่าเป็นโครงการที่ดำเนินการเสร็จสมบูรณ์</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">ศูนย์ข้อมูลกลางวัฒนธรรม</a> · <a href="https://siamrath.co.th/n/609307" target="_blank" rel="noopener">สยามรัฐ</a> · <a href="https://www.thaipr.net/travel/3321904" target="_blank" rel="noopener">ThaiPR.NET</a> · <a href="https://www.naewna.com/lady/892595" target="_blank" rel="noopener">แนวหน้า</a></div></article></div></section><section class="research-section" id="timeline"><h2>เส้นเวลาแบบจุด</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status unverified">ยังไม่ยืนยัน</span><p class="era-years">27 มีนาคม·5 เมษายน 2566</p><h3>งานบวงสรวงพระนารายณ์</h3><p>จัดงานประจำปี ณ สวนสาธารณะพระนารายณ์ พร้อมกิจกรรมวัฒนธรรมและสินค้าในชุมชน</p><a href="https://www.thaipr.net/travel/3321904" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2568</p><h3>งานของดีเมืองตะกั่วป่า</h3><p>เวทีกลางของโครงการส่งเสริมเศรษฐกิจชุมชนจัดขึ้นในสวน</p><a href="https://siamrath.co.th/n/609307" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2569</p><h3>สถานะปัจจุบัน</h3><p>ยังเป็นสวนสาธารณะภายใต้การดูแลเทศบาล มีจุดสักการะ สนามเด็กเล่น และพื้นที่จัดกิจกรรม</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status unverified">ยังไม่ยืนยัน</span><p class="era-years">ไม่ระบุปี</p><h3>ยังไม่พบปีเริ่มสร้างสวน</h3><p>เอกสารที่เปิดเผยไม่ระบุปี ผู้สร้าง หรือโครงการจัดตั้งสวน</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">ไม่ระบุปี</p><h3>องค์พระนารายณ์เป็นสัญลักษณ์เมือง</h3><p>เอกสารเทศบาลระบุเทวรูปพระนารายณ์เป็นสิ่งศักดิ์สิทธิ์ของชาวเมืองและใช้เป็นตราเทศบาล แต่ไม่ระบุปีนำมาประดิษฐานในสวน</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li></ol></section><p class="missing-photo">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่</p><section class="research-section" id="highlights"><h2>จุดเด่นที่ควรดู</h2><div class="research-cards"><article class="research-note"><h3>เทวรูปพระนารายณ์</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ประติมากรรมรูปเคารพพระนารายณ์สำหรับให้ประชาชนสักการะบูชา</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>เทพบริวารจำลอง</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ภายในสวนมีองค์พระนารายณ์และเทพบริวารจำลองตามข้อมูลแหล่งราชการ</p><a href="https://www.phangngaedarea.go.th/site/wp-content/uploads/pdf/17225631.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>สนามเด็กเล่น</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>พื้นที่ส่วนหนึ่งของสวนจัดเป็นสนามเด็กเล่น</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ลานจัดกิจกรรม</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ใช้จัดกิจกรรมวัฒนธรรม สันทนาการ และงานประเพณีท้องถิ่นของเทศบาล</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="news"><h2>ข่าวและความเคลื่อนไหว</h2><div class="research-cards"><article class="research-note"><p class="muted">2025-03-14 · ThailandTravel</p><h3>งานบวงสรวงพระนารายณ์และของดีเมืองตะกั่วป่า ประจำปี 2568</h3><p>ประกาศกำหนดจัดงาน 14·23 มีนาคม 2568 ที่สวน</p><a href="https://thailandtravel.app/content/read/3344" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><p class="muted">2023-03-31 · ThaiPR.NET</p><h3>งานบวงสรวงพระนารายณ์ เอกลักษณ์ของชาวตะกั่วป่า</h3><p>รายงานงานประจำปี 2566 ซึ่งจัดที่สวนระหว่าง 27 มีนาคม·5 เมษายน</p><a href="https://www.thaipr.net/travel/3321904" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><p class="muted"> · สยามรัฐ</p><h3>เทศบาลเมืองตะกั่วป่าจัดกิจกรรมส่งเสริมเศรษฐกิจชุมชน ของดีเมืองตะกั่วป่า</h3><p>ใช้เวทีกลางสวนเป็นพื้นที่จัดโครงการส่งเสริมเศรษฐกิจชุมชนปี 2568</p><a href="https://siamrath.co.th/n/609307" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>รู้หรือไม่</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>พระนารายณ์ถูกใช้เป็นรูปในดวงตราสัญลักษณ์เทศบาลเมืองตะกั่วป่า</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>สวนอยู่ตรงข้ามสำนักงานเทศบาลเมืองตะกั่วป่าและมีโทรศัพท์ติดต่อ 076 421 750</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>วิธีเดินทาง</h2><div class="research-cards"><article class="research-note"><h3>ตัวเมืองตะกั่วป่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>อยู่ตรงข้ามสำนักงานเทศบาลเมืองตะกั่วป่าและที่ว่าการเทศบาลเมืองตะกั่วป่า บนถนนเพชรเกษม</p><a href="https://www.phangngaedarea.go.th/site/wp-content/uploads/pdf/17225631.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ภูเก็ต</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span></article><article class="research-note"><h3>เขาหลัก</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span></article><article class="research-note"><h3>สนามบิน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span></article></div></section><section class="research-section" id="nearby"><h2>ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</h2><ul class="nearby-links"><li><a href="/places/thung-phra/">สวนสาธารณะทุ่งพระโพธิ์</a></li></ul></section><section class="research-section" id="faq"><h2>คำถามที่พบบ่อย</h2><details><summary>เดินทางจากตัวเมืองตะกั่วป่าอย่างไร</summary><p>อยู่ตรงข้ามสำนักงานเทศบาลเมืองตะกั่วป่าและที่ว่าการเทศบาลเมืองตะกั่วป่า บนถนนเพชรเกษม</p></details><details><summary>สถานที่นี้มีประวัติความเป็นมาอย่างไร</summary><p>สวนอยู่ภายใต้การดูแลบริหารจัดการของเทศบาลเมืองตะกั่วป่า สวนเป็นสถานที่พักผ่อนหย่อนใจและเป็นที่ประดิษฐานองค์เทวรูปพระนารายณ์กับเทพบริวารจำลอง</p></details><details><summary>มีจุดเด่นอะไรให้ชม</summary><p>ประติมากรรมรูปเคารพพระนารายณ์สำหรับให้ประชาชนสักการะบูชา ภายในสวนมีองค์พระนารายณ์และเทพบริวารจำลองตามข้อมูลแหล่งราชการ พื้นที่ส่วนหนึ่งของสวนจัดเป็นสนามเด็กเล่น</p></details></section><section class="research-section" id="sources"><h2>ที่มาของข้อมูล</h2><div class="source-table"><table><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>วันที่เข้าถึง</th><th>ลิงก์</th></tr></thead><tbody><tr><th scope="row">ศูนย์ข้อมูลกลางวัฒนธรรม (m-culture)</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AAาธารณะอุทยานพระนารายณ์" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สำนักงานเขตพื้นที่การศึกษาพังงา</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.phangngaedarea.go.th/site/wp-content/uploads/pdf/17225631.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ThaiPR.NET</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.thaipr.net/travel/3321904" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">MGR Online</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://mgronline.com/south/detail/9550000099132" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ศูนย์ข้อมูลกลางวัฒนธรรม</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า แผนการดำเนินงานด้านสิ่งแวดล้อม</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สยามรัฐ</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://siamrath.co.th/n/609307" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">แนวหน้า</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.naewna.com/lady/892595" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ไม่พบเวลาเปิด-ปิดที่เผยแพร่และยืนยันได้</li><li>ไม่พบข้อมูลค่าเข้าชม</li><li>ไม่พบเพจเฟซบุ๊กหรือเว็บไซต์เฉพาะของสวนที่ยืนยันได้</li><li>ไม่พบข้อมูลที่จอดรถ ห้องน้ำ หรือทางเข้าถึงสำหรับรถเข็น/ผู้สูงอายุ</li><li>ไม่พบระยะทางที่ยืนยันได้จากภูเก็ต เขาหลัก หรือสนามบิน</li><li>ไม่พบข้อมูลปีสร้างและผู้สร้าง</li><li>ไม่พบหลักฐานยืนยันบทบาทของสวนในยุคเหมืองแร่ดีบุก</li><li>ไม่พบหลักฐานยืนยันสถาปัตยกรรมชิโน-โปรตุกีส/จีนของสวน</li><li>ไม่พบหลักฐานการขึ้นทะเบียนสวนเป็นโบราณสถาน</li><li>ไม่พบสถานที่ใกล้เคียงที่มีระยะเดินถึงยืนยันได้</li><li>ไม่พบเดือนจัดงานหรือข้อมูลปฏิทินจันทรคติที่ยืนยันได้</li><li>ปีจัดสร้างสวนและผู้สร้าง</li><li>เหตุผล/โครงการตั้งต้นของสวน</li><li>ประวัติการเปลี่ยนมือ การร้าง หรือการบูรณะ</li><li>หลักฐานผลกระทบจากสึนามิ พ.ศ. 2547</li><li>ปีขึ้นทะเบียนโบราณสถานของสวนโดยตรง</li><li>เวลาเปิด·ปิด ค่าเข้า สภาพอาคาร/สิ่งปลูกสร้างล่าสุด</li><li>โครงการ Narai Hub อยู่ระหว่างดำเนินการจริงหรือไม่</li><li>ยังไม่พบภาพเก่าที่ระบุว่าเป็นสวนโดยตรง</li><li>ยังไม่พบ URL ไฟล์ภาพปัจจุบันแบบตรงที่ยืนยันสิทธิ์ได้</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
