.\data\i18n\en\missing.json:128: "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"ศูนย์อาหารลานโล่งตะกั่วป่า\", \"item\": \"https://takuapa101.pages.dev/places/food-center/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"ศูนย์อาหารลานโล่งตะกั่วป่า\", \"url\": \"https://takuapa101.pages.dev/places/food-center/\", \"image\": \"https://takuapa101.pages.dev/assets/food-center.webp\", \"description\": \"เอกสารแนะนำศูนย์อาหารที่รวมอาหารหลายประเภท\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8675924, \"longitude\": 98.3420033}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"มีค่าเข้าชมหรือไม่\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · วงในระบุว่าไม่มีค่าเข้าชมสำหรับผู้ใหญ่และเด็ก ยังไม่มีหลักฐานยืนยันจากผู้ดูแลตลาด\"}}, {\"@type\": \"Question\", \"name\": \"เดินทางจากตัวเมืองตะกั่วป่าอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ใช้ลานพระรูปพระนารายณ์เป็นจุดสังเกต: รีวิวร้านขนมจีนป้าม่อมระบุว่าร้านอยู่บริเวณลานโล่งฝั่งตรงข้าม ข้อมูลนี้เป็นจุดสังเกตจากรีวิว ไม่ใช่เส้นทางนำทางที่ตรวจสอบแล้ว\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"วิดีโอประชาสัมพันธ์ของเทศบาลเมืองตะกั่วป่าที่เผยแพร่วันที่ 1 กันยายน 2567 แนะนำตลาดลานโล่งเป็นแหล่งรวมอาหารหลายประเภท หลักฐานนี้ยืนยันการประชาสัมพันธ์ในปีดังกล่าว ไม่ใช่ปีสร้างตลาด ข่าววันที่ 19 มิถุนายน 2568 กล่าวถึงแนวทางพัฒนาตลาดลานโล่งเป็นศูนย์อาหารสมัยใหม่และเพิ่มทางเลือกอาหารริมทาง เป็นการรายงานแผนพัฒนา ไม่ใช่หลักฐานว่าโครงการแล้วเสร็จ\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เทศบาลแนะนำว่ามีข้าวราดแกงและอาหารตามสั่งให้เลือกซื้อ อาหารเส้นสองประเภทนี้ปรากฏในรายการอาหารที่เทศบาลประชาสัมพันธ์ เทศบาลระบุว่ามีตัวเลือกขนม ของหวาน และเครื่องดื่มภายในตลาด\"}}]}]": 1,
