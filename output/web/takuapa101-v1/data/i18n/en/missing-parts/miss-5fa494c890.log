data\i18n\en\missing-parts\miss-e3e856dd04.json:46:  "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"ตลาดริมน้ำตะกั่วป่า\", \"item\": \"https://takuapa101.pages.dev/places/riverwalk/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"ตลาดริมน้ำตะกั่วป่า\", \"url\": \"https://takuapa101.pages.dev/places/riverwalk/\", \"image\": \"https://takuapa101.pages.dev/assets/riverwalk.webp\", \"description\": \"พื้นที่ตลาดริมแม่น้ำที่มีสินค้าและอาหารท้องถิ่น\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"ถนนศรีตะกั่วป่า/ถนนริมคลอง ข้างวัดย่านยาว\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.87157, \"longitude\": 98.35091}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"เปิดให้เข้าชมเวลาใด\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · วันเสาร์ 15:00·20:00 น.\"}}, {\"@type\": \"Question\", \"name\": \"มีค่าเข้าชมหรือไม่\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · ไม่มีค่าธรรมเนียมการเข้าชม\"}}, {\"@type\": \"Question\", \"name\": \"เดินทางจากตัวเมืองตะกั่วป่าอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เดินทางไปย่านริมน้ำ/ถนนศรีตะกั่วป่า บริเวณข้างวัดย่านยาว; แหล่งข้อมูลระบุว่าสามารถใช้รถรับจ้างท้องถิ่นหรือมอเตอร์ไซค์รับจ้างจากสถานีขนส่งตะกั่วป่าได้\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ตลาดมีชื่อในโครงการตลาดประชารัฐต้องชมว่า ‘ตลาดริมน้ำตะกั่วป่า ร่วมใจประชารัฐ’ และตั้งอยู่ถนนริมคลองข้างวัดย่านยาว\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"มีแผงจำหน่ายขนมพื้นบ้าน อาหารพื้นเมือง สินค้าโอทอป และของดีเมืองตะกั่วป่า ตลาดตั้งอยู่ติดแนวคลอง/แม่น้ำตะกั่วป่า เหมาะกับการชมวิวริมน้ำและถ่ายภาพ รีวิวผู้ใช้ระบุว่ามีดนตรีสดโดยนักเรียนในบางช่วง\"}}]}]": "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Takua Pa Riverside Market\", \"item\": \"https://takuapa101.pages.dev/places/riverwalk/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"Takua Pa Riverside Market\", \"url\": \"https://takuapa101.pages.dev/places/riverwalk/\", \"image\": \"https://takuapa101.pages.dev/assets/riverwalk.webp\", \"description\": \"A riverside market area with local goods and food\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Si Takua Pa Road or canal-side road, beside Wat Yan Yao\", \"addressLocality\": \"Takua Pa\", \"addressRegion\": \"Phang Nga\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.87157, \"longitude\": 98.35091}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"When is it open to visitors?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Information not verified · Saturdays 15:00·20:00\"}}, {\"@type\": \"Question\", \"name\": \"Is there an admission fee?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Information not verified · No admission fee\"}}, {\"@type\": \"Question\", \"name\": \"How do I get there from Takua Pa town?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Go to the riverside or Si Takua Pa Road beside Wat Yan Yao; sources say local taxis or motorcycle taxis can be taken from Takua Pa Bus Station\"}}, {\"@type\": \"Question\", \"name\": \"What is this place's history?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The market is named in the Pracharัฐ market programme as ‘Takua Pa Riverside Market, Ruamjai Pracharัฐ’ and is located on the canal-side road beside Wat Yan Yao\"}}, {\"@type\": \"Question\", \"name\": \"What is there to see?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"There are stalls selling local sweets, local food, OTOP products, and Takua Pa specialties. The market is beside the canal or Takua Pa River, suitable for riverside views and photos. User reviews mention live music by students at some times\"}}]}]"
