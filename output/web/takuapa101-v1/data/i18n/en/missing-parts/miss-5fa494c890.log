data\i18n\en\missing-parts\miss-2ab25b5716.log:516:+  "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"สะพานเหล็กบุญสูง\", \"item\": \"https://takuapa101.pages.dev/places/iron-bridge/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"สะพานเหล็กบุญสูง\", \"url\": \"https://takuapa101.pages.dev/places/iron-bridge/\", \"image\": \"https://takuapa101.pages.dev/assets/iron-bridge.webp\", \"description\": \"สะพานมีความเกี่ยวข้องกับการเดินทางและการขนส่งในยุคเหมืองแร่\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"ถนนราษฎร์บำรุง บ้านโคกขนุน\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8531719567, \"longitude\": 98.3540239936}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"เปิดให้เข้าชมเวลาใด\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · เข้าชมได้ตลอดทั้งวัน (ข้อมูลจากแหล่งท่องเที่ยวรอง)\"}}, {\"@type\": \"Question\", \"name\": \"มีที่จอดรถไหม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"มีข้อมูลจากรีวิวว่าจอดริมถนนได้และมีพื้นที่จำกัด แต่ไม่มีข้อมูลทางการยืนยัน\"}}, {\"@type\": \"Question\", \"name\": \"เดินทางจากตัวเมืองตะกั่วป่าอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เดินทางตามถนนราษฎร์บำรุงไปทางเมืองเก่าตะกั่วป่า สะพานอยู่ด้านซ้ายมือ ห่างจากตัวเมืองประมาณ 2 กิโลเมตร\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"พ.ศ. 2511 มีการนำเหล็กจากเรือขุดแร่มาสร้างสะพานเหล็กโคกขนุน ความยาวกว่า 200 เมตร ข้ามแม่น้ำตะกั่วป่า ผู้ริเริ่มคือ นายจุติ บุญสูง เจ้าของกิจการบริษัทเรือขุดแร่จุติบุญสูง จำกัด ซึ่งก่อตั้งบริษัทใน พ.ศ. 2503\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"สะพานทอดข้ามแม่น้ำตะกั่วป่าและเชื่อมพื้นที่ถนนหลักกับบริเวณโรงขุดแร่เก่า ใช้เหล็กจากเรือขุดแร่ที่ไม่ใช้งานแล้ว และปลายทางยังมองเห็นโรงขุดแร่เก่า จากสะพานเห็นทุ่งสีเขียว ต้นไม้ และทิวเขา เหมาะกับการชมวิวและถ่ายภาพ\"}}]}]": "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Boonsung Iron Bridge\", \"item\": \"https://takuapa101.pages.dev/places/iron-bridge/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"Boonsung Iron Bridge\", \"url\": \"https://takuapa101.pages.dev/places/iron-bridge/\", \"image\": \"https://takuapa101.pages.dev/assets/iron-bridge.webp\", \"description\": \"A bridge associated with travel and transport during the mining era\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Thanon Rat Bamrung, Ban Khok Khanoon\", \"addressLocality\": \"Takua Pa\", \"addressRegion\": \"Phang Nga\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8531719567, \"longitude\": 98.3540239936}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What are the opening hours?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Information not verified · Open to visitors all day (information from a secondary tourism source)\"}}, {\"@type\": \"Question\", \"name\": \"Is parking available?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Reviews say roadside parking is possible and space is limited, but there is no official confirmation\"}}, {\"@type\": \"Question\", \"name\": \"How do I get there from Takua Pa town?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Follow Thanon Rat Bamrung towards Takua Pa old town. The bridge is on the left, about 2 kilometres from town\"}}, {\"@type\": \"Question\", \"name\": \"What is the history of this place?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"In 1968 CE (2511 BE), steel from a dredger was used to build Khok Khanoon Iron Bridge, more than 200 metres long, across the Takua Pa River. The initiator was Juti Boonsung, owner of Juti Boonsung Dredging Company Limited, which was founded in 1960 CE (2503 BE)\"}}, {\"@type\": \"Question\", \"name\": \"What is there to see?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The bridge crosses the Takua Pa River and connects the main road with the old dredging-plant area. It uses steel from a disused dredger, and the old dredging plant is still visible at the far end. From the bridge, you can see green fields, trees, and mountain ranges, making it suitable for views and photography\"}}]}]",
data\i18n\en\missing-parts\miss-2ab25b5716.log:529:+  "ข้อมูลยังไม่ยืนยัน · เข้าชมได้ตลอดทั้งวัน (ข้อมูลจากแหล่งท่องเที่ยวรอง)": "Information not verified · Open to visitors all day (information from a secondary tourism source)",
data\i18n\en\missing-parts\miss-e108f1d3a4.log:34:- อาคารตั้งอยู่บนถนนศรีตะกั่วป่าในย่านเมืองเก่า และยังถูกใช้เป็นจุดหมายในสื่อท่องเที่ยวของเทศบาล การท่องเที่ยวแห่งประเทศไทย และกิจกรรมเมืองเก่า เช่น ถนนสายวัฒนธรรมที่จัดในย่านถนนศรีตะกั่วป่า ข้อมูลที่พบยืนยันบริบทกิจกรรมของย่าน แต่ยังไม่ยืนยันว่ามีกิจกรรมจัดภายในอาคารเป็นประจำ
data\i18n\en\missing-parts\miss-e108f1d3a4.log:52:- เอกสารโครงการเมืองเก่าระบุการจัดลอยกระทงที่นี่ในวันเพ็ญเดือน 12 พร้อมการประกวดกระทง การแสดง และการละเล่นพื้นบ้าน ส่วนหลักฐานที่พบยังไม่ยืนยันผลกระทบจากสึนามิ 2547 การถูกทิ้งร้าง การเปลี่ยนมือ หรือการขึ้นทะเบียนโบราณสถานเฉพาะสวน
