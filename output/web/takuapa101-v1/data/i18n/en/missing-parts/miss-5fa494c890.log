data\i18n\en\missing-parts\miss-6e81276424.json:45:  "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า\", \"item\": \"https://takuapa101.pages.dev/places/culture-street/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า\", \"url\": \"https://takuapa101.pages.dev/places/culture-street/\", \"image\": \"https://takuapa101.pages.dev/assets/culture-street.webp\", \"description\": \"ย่านถนนคนเดินที่เชื่อมอาคารเก่า อาหาร และวิถีท้องถิ่น\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"ถนนศรีตะกั่วป่า และถนนอุดมธารา\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.829848, \"longitude\": 98.364073}, \"telephone\": \"076424279\", \"openingHoursSpecification\": [{\"@type\": \"OpeningHoursSpecification\", \"dayOfWeek\": \"https://schema.org/Sunday\", \"opens\": \"14:00\", \"closes\": \"20:00\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"เปิดให้เข้าชมเวลาใด\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"วันอาทิตย์ 14.00·20.00 น.\"}}, {\"@type\": \"Question\", \"name\": \"มีค่าเข้าชมหรือไม่\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · เข้าชมฟรี\"}}, {\"@type\": \"Question\", \"name\": \"เดินทางจากตัวเมืองตะกั่วป่าอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ใช้ถนนราษฎร์บำรุงเข้าสู่ย่านเมืองเก่า แล้วต่อถนนศรีตะกั่วป่า; ช่วงถนนคนเดินอยู่บริเวณถนนศรีตะกั่วป่าและอุดมธารา\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"อาคารในย่านเมืองเก่ารักษาร่องรอยสถาปัตยกรรมชิโน-โปรตุกีส/ชิโน-ตะกั่วป่าที่สัมพันธ์กับยุคเหมืองแร่ดีบุก\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"อาคารบ้านเรือนและตึกแถวชิโน-โปรตุกีสในย่านเมืองเก่า อาหารพื้นเมือง ขนมพื้นบ้าน และของกินท้องถิ่น การแสดงศิลปวัฒนธรรม การละเล่นพื้นเมือง และการแต่งกายแบบบาบ๋า\"}}]}]": "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Takua Pa Old Town Cultural Street\", \"item\": \"https://takuapa101.pages.dev/places/culture-street/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"Takua Pa Old Town Cultural Street\", \"url\": \"https://takuapa101.pages.dev/places/culture-street/\", \"image\": \"https://takuapa101.pages.dev/assets/culture-street.webp\", \"description\": \"A walking-street district linking old buildings, food, and local life\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Thanon Si Takua Pa and Thanon Udom Thara\", \"addressLocality\": \"Takua Pa\", \"addressRegion\": \"Phang Nga\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.829848, \"longitude\": 98.364073}, \"telephone\": \"076424279\", \"openingHoursSpecification\": [{\"@type\": \"OpeningHoursSpecification\", \"dayOfWeek\": \"https://schema.org/Sunday\", \"opens\": \"14:00\", \"closes\": \"20:00\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What time is it open?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sunday 14:00·20:00\"}}, {\"@type\": \"Question\", \"name\": \"Is there an admission fee?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Not verified · Free admission\"}}, {\"@type\": \"Question\", \"name\": \"How do I get there from Takua Pa town?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Take Thanon Rat Bamrung into the old town, then continue along Thanon Si Takua Pa; the walking street is around Thanon Si Takua Pa and Thanon Udom Thara\"}}, {\"@type\": \"Question\", \"name\": \"What is the history of this place?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Buildings in the old town preserve traces of Sino-Portuguese and Sino-Takua Pa architecture associated with the tin-mining era\"}}, {\"@type\": \"Question\", \"name\": \"What is there to see?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sino-Portuguese houses and shophouses in the old town, local dishes, traditional snacks and local food, cultural performances, local games, and Baba-style clothing\"}}]}]"
data\i18n\en\missing-parts\miss-2ab25b5716.json:5:  "มีรีวิวกล่าวถึงห้องน้ำสาธารณะใกล้ศาลเจ้า แต่ยังไม่ยืนยันการเปิดใช้ปัจจุบันและสิ่งอำนวยความสะดวกภายใน": "Reviews mention a public toilet near the shrine, but its current availability and facilities inside have not been verified",
