ressed="false">สวนสาธารณะพระนารายณ์</button><button type="button" data-news-filter="สะพานเหล็กบุญสูง" aria-pressed="false">สะพานเหล็กบุญสูง</button><button type="button" data-news-filter="โรงเรียนเต้าหมิง" aria-pressed="false">โรงเรียนเต้าหมิง</button><button type="button" data-news-filter="2026" aria-pressed="false">ปี 2569</button><button type="button" data-news-filter="2025" aria-pressed="false">ปี 2568</button><button type="button" data-news-filter="2024" aria-pressed="false">ปี 2567</button><button type="button" data-news-filter="2023" aria-pressed="false">ปี 2566</button><button type="button" data-news-filter="2022" aria-pressed="false">ปี 2565</button><button type="button" data-news-filter="2021" aria-pressed="false">ปี 2564</button></div><div class="news-list-full"><article class="news-item" data-place="ศาลเจ้ากู่ใช่ตึ๋ง" data-year="2026"><time datetime="2026-05-04">4 พ.ค. 2569</time><div class="news-content"><h2>ไหว้พระขอพร ศาลเจ้ากู่ใช่ตึ๋ง จ.พังงา</h2><p>ข่าว NBT แนะนำศาลเจ้าและบทบาทศูนย์รวมศรัทธาของชาวตะกั่วป่า</p><div class="news-meta"><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a> · NBT2HD</div><a class="news-out" href="https://www.youtube.com/watch?v=q6K2Zl6700I" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ตักบาตรยามรุ่ง รับอรุณปีใหม่" data-year="2026"><time datetime="2026-04-13">13 เม.ย. 2569</time><div class="news-content"><h2>พังงาจัดใหญ่ สืบสานสงกรานต์ ตักบาตรเมืองเก่าตะกั่วป่า เสริมสิริมงคลปีใหม่ไทย</h2><p>ข่าวรายงานพิธีตักบาตรข้าวสารอาหารแห้งในถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า และกิจกรรมวัฒนธรรมต่อเนื่อง</p><div class="news-meta"><a href="/traditions/">ตักบาตรยามรุ่ง รับอรุณปีใหม่</a> · TOPNEWS</div><a class="news-out" href="https://www.topnews.co.th/news/1546452" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ตักบาตรยามรุ่ง รับอรุณปีใหม่" data-year="2026"><time datetime="2026-04-13">13 เม.ย. 2569</time><div class="news-content"><h2>ตะกั่วป่าสะพรั่ง! ย้อนรอยเสน่ห์เมืองเก่าในงาน Takuapa Oldtown Songkran Festival 2026</h2><p>ข่าวบรรยายงานสงกรานต์เมืองเก่าครั้งที่ 4 และกิจกรรมทำบุญตักบาตรในช่วงเช้า</p><div class="news-meta"><a href="/traditions/">ตักบาตรยามรุ่ง รับอรุณปีใหม่</a> · MGR Online</div><a class="news-out" href="https://mgronline.com/onlinesection/detail/9690000036775" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="สวนสาธารณะทุ่งพระโพธิ์" data-year="2026"><time datetime="2026-03-08">8 มี.ค. 2569</time><div class="news-content"><h2>โรงเรียนตะกั่วป่าคีรีเขตร่วมกิจกรรม Takuapa Walk Rally 2026</h2><p>ใช้สวนสาธารณะทุ่งพระโพธิ์และย่านเมืองเก่าเป็นพื้นที่เดิน-วิ่ง เรียนรู้ประวัติศาสตร์และวัฒนธรรมท้องถิ่น</p><div class="news-meta"><a href="/places/thung-phra/">สวนสาธารณะทุ่งพระโพธิ์</a> · โรงเรียนตะกั่วป่าคีรีเขต</div><a class="news-out" href="https://www.keereekatschool.ac.th/gallery-detail_1497" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า" data-year="2026"><time datetime="2026-03-01">1 มี.ค. 2569</time><div class="news-content"><h2>จังหวัดพังงาจัดงาน จากตะโกลา สู่ตะกั่วป่า ครั้งที่ 12</h2><p>งานส่งเสริมการท่องเที่ยวเมืองเก่าตะกั่วป่าเชื่อมโยงการเรียนรู้วิถีคนตะกั่วป่าและเศรษฐกิจชุมชน แต่ข่าวไม่ได้ยืนยันกิจกรรมภายในพิพิธภัณฑ์โดยตรง</p><div class="news-meta"><a href="/places/museum/">พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า</a> · สถานีวิทยุกระจายเสียงแห่งประเทศไทย</div><a class="news-out" href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="โรงเรียนเต้าหมิง" data-year="2026"><time datetime="2026-02-21">21 ก.พ. 2569</time><div class="news-content"><h2>งานเมืองเก่าเล่าเรื่อง ณ โรงเรียนเต้าหมิง ตะกั่วป่า</h2><p>หน้าข่าวประชาสัมพันธ์ระบุว่ามีกิจกรรมอัดแน่นตลอดวันและใช้โรงเรียนเต้าหมิงเป็นสถานที่จัดงาน</p><div class="news-meta"><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a> · YOUPHUKET</div><a class="news-out" href="https://youphuket.club/author/admin/page/58/" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="สะพานเหล็กบุญสูง" data-year="2026"><time datetime="2026-01-30">30 ม.ค. 2569</time><div class="news-content"><h2>ชวนเช็กอิน สะพานเหล็กบุญสูง มรดกเหมืองแร่ เมืองตะกั่วป่า</h2><p>NBT นำเสนอสะพานในฐานะแหล่งมรดกเหมืองแร่และแลนด์มาร์กประวัติศาสตร์ พร้อมระบุการปิดชั่วคราวเพื่อถ่ายทำภาพยนตร์ต่างชาติ</p><div class="news-meta"><a href="/places/iron-bridge/">สะพานเหล็กบุญสูง</a> · NBT2HD</div><a class="news-out" href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ลอยกระทง" data-year="2025"><time datetime="2025-11-05">5 พ.ย. 2568</time><div class="news-content"><h2>กิจกรรมลอยกระทงที่คลองตะกั่วป่าและคลองบางม่วง</h2><p>กรมทรัพยากรทางทะเลและชายฝั่งรายงานการจัดกิจกรรมปี 2568 และการมีส่วนร่วมของประชาชนจำนวนมาก</p><div class="news-meta"><a href="/traditions/">ลอยกระทง</a> · กรมทรัพยากรทางทะเลและชายฝั่ง</div><a class="news-out" href="https://newweb.dmcr.go.th/detailAll/81026/nws/258" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ศูนย์อาหารลานโล่งตะกั่วป่า" data-year="2025"><time datetime="2025-06-19">19 มิ.ย. 2568</time><div class="news-content"><h2>แนวทางพัฒนาตลาดลานโล่งเป็นศูนย์อาหารสมัยใหม่</h2><p>ข่าวรายงานแผนพัฒนาตลาดและเพิ่มทางเลือกอาหารริมทาง โดยยังไม่ยืนยันการก่อสร้างแล้วเสร็จ</p><div class="news-meta"><a href="/places/food-center/">ศูนย์อาหารลานโล่งตะกั่วป่า</a> · สยามรัฐ</div><a class="news-out" href="https://siamrath.co.th/n/630235" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="วัดนิกรวราราม (วัดย่านยาว)" data-year="2025"><time datetime="2025-04-13">13 เม.ย. 2568</time><div class="news-content"><h2>พังงาสืบสานสงกรานต์ ตักบาตรเมืองเก่าตะกั่วป่า</h2><p>พระครูนิกรธรรมโสภิตและพระสงฆ์วัดนิกรวรารามร่วมกิจกรรมจังหวัด</p><div class="news-meta"><a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a> · TOPNEWS</div><a class="news-out" href="https://www.topnews.co.th/news/1546452" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="สวนสาธารณะพระนารายณ์" data-year="2025"><time datetime="2025-03-14">14 มี.ค. 2568</time><div class="news-content"><h2>งานบวงสรวงพระนารายณ์และของดีเมืองตะกั่วป่า ประจำปี 2568</h2><p>ประกาศกำหนดจัดงาน 14–23 มีนาคม 2568 ที่สวน</p><div class="news-meta"><a href="/places/phra-narai/">สวนสาธารณะพระนารายณ์</a> · ThailandTravel</div><a class="news-out" href="https://thailandtravel.app/content/read/3344" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="วัดบรมธาตุคีรีเขต (วัดลุ่ม)" data-year="2025"><time datetime="2025-02-12">12 ก.พ. 2568</time><div class="news-content"><h2>พังงาอัญเชิญ &#x27;พระศรีบรมธาตุ&#x27; ขึ้นราชรถแห่รอบเมืองเก่าตะกั่วป่า</h2><p>กิจกรรมมาฆบูชา 2568 จัดที่วัดพระธาตุคีรีเขต มีขบวนแห่รอบเมืองเก่าและพิธีเวียนรอบพระวิหาร</p><div class="news-meta"><a href="/places/wat-boromthat/">วัดบรมธาตุคีรีเขต (วัดลุ่ม)</a> · ไทยโพสต์</div><a class="news-out" href="https://www.thaipost.net/district-news/738702/" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ขบวนแห่อัญเชิญพระบรมสารีริกธาตุขึ้นเขาพระบาท" data-year="2025"><time datetime="2025-02-11">11 ก.พ. 2568</time><div class="news-content"><h2>พังงาจัดใหญ่ งานมาฆบูชา น้อมใจวันทา พระศรีบรมธาตุ</h2><p>ประชาสัมพันธ์งานวันที่ 11–12 กุมภาพันธ์ 2568 ที่วัดพระธาตุคีรีเขตและกิจกรรมขบวนแห่</p><div class="news-meta"><a href="/traditions/">ขบวนแห่อัญเชิญพระบรมสารีริกธาตุขึ้นเขาพระบาท</a> · MGR Online</div><a class="news-out" href="https://mgronline.com/travel/detail/9680000012560" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ขบวนแห่อัญเชิญพระบรมสารีริกธาตุขึ้นเขาพระบาท" data-year="2025"><time datetime="2025-02-11">11 ก.พ. 2568</time><div class="news-content"><h2>วันมาฆบูชา 2568 น้อมใจวันทา พระศรีบรมธาตุ เมืองตะกั่วป่า</h2><p>รายงานกำหนดการขบวนราชรถรอบเมืองเก่าและการอัญเชิญพระบรมธาตุขึ้นเจดีย์</p><div class="news-meta"><a href="/traditions/">ขบวนแห่อัญเชิญพระบรมสารีริกธาตุขึ้นเขาพระบาท</a> · Kapook Travel</div><a class="news-out" href="https://travel.kapook.com/view288836.html" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="วัดนิกรวราราม (วัดย่านยาว)" data-year="2025"><time datetime="2025-01-01">1 ม.ค. 2568</time><div class="news-content"><h2>ตรวจเยี่ยมโครงการวัด ประชา รัฐ สร้างสุข</h2><p>วัดนิกรวรารามได้รับการกล่าวถึงในฐานะวัดที่พร้อมรับการประเมินระดับภาคใต้</p><div class="news-meta"><a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a> · Ride Explorer</div><a class="news-out" href="https://www.ride-explorer.com/?p=7378" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ศูนย์อาหารลานโล่งตะกั่วป่า" data-year="2024"><time datetime="2024-11-01">1 พ.ย. 2567</time><div class="news-content"><h2>ต้นทุนมะพร้าวกระทบราคาห่อหมกในตลาดลานโล่ง</h2><p>ข่าวยกตัวอย่างผู้ค้าห่อหมกต้นโพธิ์ในตลาดลานโล่งที่ปรับราคาจากต้นทุนมะพร้าวสูงขึ้น</p><div class="news-meta"><a href="/places/food-center/">ศูนย์อาหารลานโล่งตะกั่วป่า</a> · MGR Online</div><a class="news-out" href="https://mgronline.com/daily/detail/9670000105538" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" data-year="2024"><time datetime="2024-10-10">10 ต.ค. 2567</time><div class="news-content"><h2>งานอิ่มบุญ อิ่มเจ 9 บาท เมืองเก่าตะกั่วป่า</h2><p>กิจกรรมอาหารเจและประเพณีชุมชนจัดบนถนนสายวัฒนธรรม มีผู้เข้าร่วมจำนวนมากตามรายงานข่าว</p><div class="news-meta"><a href="/places/culture-street/">ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</a> · ผู้จัดการออนไลน์</div><a class="news-out" href="https://mgronline.com/south/detail/9670000097253" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" data-year="2024"><time datetime="2024-10-02">2 ต.ค. 2567</time><div class="news-content"><h2>ศาลเจ้าเก่าแก่ในพื้นที่ อ.ตะกั่วป่า จ.พังงา ประกอบพิธียกเสาโกเต้งแล้ว</h2><p>รายงานพิธียกเสาโกเต้งที่ศาลเจ้าพ่อกวนอู ซิ่นใช่ตึ๋ง โรงพระตลาดใต้ เพื่อเริ่มเทศกาลถือศีลกินผัก</p><div class="news-meta"><a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a> · ผู้จัดการออนไลน์</div><a class="news-out" href="https://mgronline.com/south/detail/9670000093105" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="วัดนิกรวราราม (วัดย่านยาว)" data-year="2024"><time datetime="2024-09-22">22 ก.ย. 2567</time><div class="news-content"><h2>คณะสงฆ์พังงาร่วมใจช่วยผู้ประสบภัยน้ำท่วมภาคเหนือ</h2><p>วัดตั้งศูนย์รับบริจาคสิ่งของร่วมกับคณะสงฆ์และประชาชน</p><div class="news-meta"><a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a> · สยามรัฐ</div><a class="news-out" href="https://archive.siamrath.co.th/n/568331" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ประเพณีกินผัก (เจี๊ยะกิ๊วอ๋องฉ่าย)" data-year="2024"><time datetime="2024-09-01">1 ก.ย. 2567</time><div class="news-content"><h2>พร้อมแถลงข่าวจัดกิจกรรมประเพณีกินผักเมืองเก่าตะกั่วป่า</h2><p>ประชาสัมพันธ์งานวันที่ 3–11 ตุลาคม 2567 และระบุศาลเจ้า/สำนักกินเจเข้าร่วม 29 แห่ง</p><div class="news-meta"><a href="/traditions/">ประเพณีกินผัก (เจี๊ยะกิ๊วอ๋องฉ่าย)</a> · Thailand Plus News</div><a class="news-out" href="https://www.thailandplus.tv/archives/864741" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ศูนย์อาหารลานโล่งตะกั่วป่า" data-year="2024"><time datetime="2024-09-01">1 ก.ย. 2567</time><div class="news-content"><h2>เทศบาลชวนกินที่ตลาดลานโล่ง</h2><p>เทศบาลเมืองตะกั่วป่าเผยแพร่วิดีโอแนะนำตลาดและรายการอาหารหลายประเภท</p><div class="news-meta"><a href="/places/food-center/">ศูนย์อาหารลานโล่งตะกั่วป่า</a> · เทศบาลเมืองตะกั่วป่า</div><a class="news-out" href="https://www.youtube.com/watch?v=YBj0I_sMc-I" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า" data-year="2024"><time datetime="2024-08-28">28 ส.ค. 2567</time><div class="news-content"><h2>ย้อนตำนานเมืองตะโกลา สู่เสน่ห์อารยะเมืองเก่าตะกั่วป่า</h2><p>จังหวัดพังงาและเทศบาลประชาสัมพันธ์การท่องเที่ยวเมืองเก่าและกระตุ้นเศรษฐกิจชุมชน ไม่พบข้อความเฉพาะการบูรณะพิพิธภัณฑ์</p><div class="news-meta"><a href="/places/museum/">พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า</a> · กรมประชาสัมพันธ์</div><a class="news-out" href="https://www.prd.go.th/th/content/category/detail/id/2040/iid/319567" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ประเพณีชักพระ" data-year="2023"><time datetime="2023-10-31">31 ต.ค. 2566</time><div class="news-content"><h2>งานสืบสานอนุรักษ์ประเพณีชักพระ พ.ศ. 2566</h2><p>ข่าวรายงานงานในอำเภอคุระบุรี จังหวัดพังงา มีการลากเรือพระจากชุมชนและพิธีสมโภช จัดเป็นข้อมูลเปรียบเทียบ ไม่ใช่ข่าวของตะกั่วป่า</p><div class="news-meta"><a href="/traditions/">ประเพณีชักพระ</a> · Thailand Plus Online</div><a class="news-out" href="https://www.thailandplus.tv/archives/755868" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ศาลเจ้ากู่ใช่ตึ๋ง" data-year="2023"><time datetime="2023-10-23">23 ต.ค. 2566</time><div class="news-content"><h2>ส่งท้ายดุ! กินเจพังงาแห่รอบเมืองตะกั่วป่า</h2><p>รายงานพิธีอิ้วเก้งที่ศาลเจ้ากู่ใช่ตึ๋งร่วมกับศาลเจ้าซิ่นใช่ตึ๋ง</p><div class="news-meta"><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a> · Innews</div><a class="news-out" href="https://www.innews.news/news.php?n=48726" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="วัดเสนานุชรังสรรค์ (วัดใหม่)" data-year="2023"><time datetime="2023-07-20">20 ก.ค. 2566</time><div class="news-content"><h2>เทศบาลเมืองตะกั่วป่าพาชมวัดเสนานุชรังสรรค์และเชิญร่วมพิธีขออนุญาตบูรณะอุโบสถ</h2><p>วิดีโอประชาสัมพันธ์ของเทศบาลกล่าวถึงวัดเก่าแก่คู่เมือง และระบุพิธีบวงสรวงขออนุญาตบูรณะอุโบสถในวันที่ 26 กรกฎาคม 2566 ควบคู่กิจกรรมแห่เทียน–เวียนเมือง</p><div class="news-meta"><a href="/places/wat-sena/">วัดเสนานุชรังสรรค์ (วัดใหม่)</a> · เทศบาลเมืองตะกั่วป่า</div><a class="news-out" href="https://www.youtube.com/watch?v=76z9YMImUUk" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="สวนสาธารณะพระนารายณ์" data-year="2023"><time datetime="2023-03-31">31 มี.ค. 2566</time><div class="news-content"><h2>งานบวงสรวงพระนารายณ์ เอกลักษณ์ของชาวตะกั่วป่า</h2><p>รายงานงานประจำปี 2566 ซึ่งจัดที่สวนระหว่าง 27 มีนาคม–5 เมษายน</p><div class="news-meta"><a href="/places/phra-narai/">สวนสาธารณะพระนารายณ์</a> · ThaiPR.NET</div><a class="news-out" href="https://www.thaipr.net/travel/3321904" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="วัดนิกรวราราม (วัดย่านยาว)" data-year="2022"><time datetime="2022-10-30">30 ต.ค. 2565</time><div class="news-content"><h2>พศจ.พังงาร่วมมอบเอกสารโฉนดที่ดินของวัดนิกรวราราม</h2><p>มอบเอกสารโฉนดที่ดินให้พระครูนิกรธรรมโสภิต เจ้าอาวาสวัดนิกรวราราม</p><div class="news-meta"><a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a> · สำนักงานพระพุทธศาสนาจังหวัดพังงา</div><a class="news-out" href="https://pna.onab.go.th/th/content/page/index/id/34431" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" data-year="2022"><time datetime="2022-06-26">26 มิ.ย. 2565</time><div class="news-content"><h2>พังงาเปิดถนนคนเดินตะกั่วป่าหน้าฝน พร้อมรถโพถ้องฟรี</h2><p>กิจกรรมกรีนซีซันจัดทุกวันอาทิตย์ 26 มิถุนายน–28 สิงหาคม 2565 เพื่อกระจายรายได้สู่ชุมชน</p><div class="news-meta"><a href="/places/culture-street/">ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</a> · ผู้จัดการออนไลน์</div><a class="news-out" href="https://mgronline.com/travel/detail/9650000061422" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" data-year="2022"><time datetime="2022-04-17">17 เม.ย. 2565</time><div class="news-content"><h2>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่าในกิจกรรมตลาดต้องชม</h2><p>กรมการค้าภายในรายงานการจัดกิจกรรมส่งเสริมช่องทางตลาดชุมชนที่ถนนวัฒนธรรมเมืองเก่าตะกั่วป่า</p><div class="news-meta"><a href="/places/culture-street/">ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</a> · กรมการค้าภายใน</div><a class="news-out" href="https://www.dit.go.th/FILE/CONTENT_FILE/256602221220300556074.pdf" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="ศาลเจ้าปุนเถ่ากงอ๊า" data-year="2021"><time datetime="2021-10-28">28 ต.ค. 2564</time><div class="news-content"><h2>แซยิดพระฮกเต็กเจี่ยสิน แป๊ะกง ศาลเจ้าปุนเถ้ากงอำ จับเส เมืองตะกั่วป่า</h2><p>วิดีโอข่าว/บันทึกกิจกรรมพิธีแซยิดของศาลเจ้า</p><div class="news-meta"><a href="/places/pun-thao/">ศาลเจ้าปุนเถ่ากงอ๊า</a> · PaiPaPai ปายพาไป</div><a class="news-out" href="https://www.youtube.com/watch?v=PkMXN_xPdLI" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article><article class="news-item" data-place="สวนสาธารณะพระนารายณ์" data-year=""><time datetime=""></time><div class="news-content"><h2>เทศบาลเมืองตะกั่วป่าจัดกิจกรรมส่งเสริมเศรษฐกิจชุมชน ของดีเมืองตะกั่วป่า</h2><p>ใช้เวทีกลางสวนเป็นพื้นที่จัดโครงการส่งเสริมเศรษฐกิจชุมชนปี 2568</p><div class="news-meta"><a href="/places/phra-narai/">สวนสาธารณะพระนารายณ์</a> · สยามรัฐ</div><a class="news-out" href="https://siamrath.co.th/n/609307" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></div></article></div></div><script type="application/ld+json"