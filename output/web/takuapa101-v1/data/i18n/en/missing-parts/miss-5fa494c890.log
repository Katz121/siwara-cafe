data\i18n\en\missing-parts\miss-029a8c3af0.log:383:+  "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"ศูนย์อาหารลานโล่งตะกั่วป่า\", \"item\": \"https://takuapa101.pages.dev/places/food-center/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"ศูนย์อาหารลานโล่งตะกั่วป่า\", \"url\": \"https://takuapa101.pages.dev/places/food-center/\", \"image\": \"https://takuapa101.pages.dev/assets/food-center.webp\", \"description\": \"เอกสารแนะนำศูนย์อาหารที่รวมอาหารหลายประเภท\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8675924, \"longitude\": 98.3420033}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"มีค่าเข้าชมหรือไม่\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · วงในระบุว่าไม่มีค่าเข้าชมสำหรับผู้ใหญ่และเด็ก ยังไม่มีหลักฐานยืนยันจากผู้ดูแลตลาด\"}}, {\"@type\": \"Question\", \"name\": \"เดินทางจากตัวเมืองตะกั่วป่าอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ใช้ลานพระรูปพระนารายณ์เป็นจุดสังเกต: รีวิวร้านขนมจีนป้าม่อมระบุว่าร้านอยู่บริเวณลานโล่งฝั่งตรงข้าม ข้อมูลนี้เป็นจุดสังเกตจากรีวิว ไม่ใช่เส้นทางนำทางที่ตรวจสอบแล้ว\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"วิดีโอประชาสัมพันธ์ของเทศบาลเมืองตะกั่วป่าที่เผยแพร่วันที่ 1 กันยายน 2567 แนะนำตลาดลานโล่งเป็นแหล่งรวมอาหารหลายประเภท หลักฐานนี้ยืนยันการประชาสัมพันธ์ในปีดังกล่าว ไม่ใช่ปีสร้างตลาด ข่าววันที่ 19 มิถุนายน 2568 กล่าวถึงแนวทางพัฒนาตลาดลานโล่งเป็นศูนย์อาหารสมัยใหม่และเพิ่มทางเลือกอาหารริมทาง เป็นการรายงานแผนพัฒนา ไม่ใช่หลักฐานว่าโครงการแล้วเสร็จ\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เทศบาลแนะนำว่ามีข้าวราดแกงและอาหารตามสั่งให้เลือกซื้อ อาหารเส้นสองประเภทนี้ปรากฏในรายการอาหารที่เทศบาลประชาสัมพันธ์ เทศบาลระบุว่ามีตัวเลือกขนม ของหวาน และเครื่องดื่มภายในตลาด\"}}]}]": "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Takua Pa Open-Air Food Center\", \"item\": \"https://takuapa101.pages.dev/places/food-center/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"Takua Pa Open-Air Food Center\", \"url\": \"https://takuapa101.pages.dev/places/food-center/\", \"image\": \"https://takuapa101.pages.dev/assets/food-center.webp\", \"description\": \"A guide to a food center bringing together many types of food\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Takua Pa\", \"addressRegion\": \"Phang Nga\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8675924, \"longitude\": 98.3420033}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Is there an admission fee?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Not verified · Wongnai states that there is no admission fee for adults or children. There is still no confirming evidence from the market administrator.\"}}, {\"@type\": \"Question\", \"name\": \"How do I get there from Takua Pa town?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Use the Narai statue plaza as a landmark: a review of Pa Mom Khanom Chin says the shop is around the open lot opposite. This is a landmark from a review, not a verified route.\"}}, {\"@type\": \"Question\", \"name\": \"What is the history of this place?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A promotional video from Takua Pa Town Municipality, published on 1 September 2024 (B.E. 2567), presents the open-air market as a place bringing together many types of food. This evidence confirms promotion in that year, not the year the market was built. A 19 June 2025 news report discusses plans to develop the open-air market into a modern food center and add more street-food choices. It reports a development plan, not proof that the project was completed.\"}}, {\"@type\": \"Question\", \"name\": \"What can I see there?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The municipality recommends rice with curry and made-to-order dishes. These two types of noodle dishes appear in the municipality's published food list. The municipality says the market also has snacks, desserts, and drinks.\"}}]}]",
data\i18n\en\missing-parts\miss-029a8c3af0.log:384:+  "08.00·22.00 น. ตามคำอธิบายวิดีโอเทศบาลเมืองตะกั่วป่า เผยแพร่ 1 กันยายน 2567; ยังไม่ยืนยันตารางปัจจุบันและวันหยุด และวงในระบุอีกชุดเป็นทุกวัน 03.00·21.00 น.": "08.00·22.00, according to the description of a Takua Pa Town Municipality video published on 1 September 2024 (B.E. 2567); the current schedule and closing days are not verified, and Wongnai gives another set of hours, every day 03.00·21.00.",
data\i18n\en\missing-parts\miss-f0f5cbac8e.json:2:  "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"วัดปทุมธารา (วัดหน้าเมือง)\", \"item\": \"https://takuapa101.pages.dev/places/wat-pathum/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"วัดปทุมธารา (วัดหน้าเมือง)\", \"url\": \"https://takuapa101.pages.dev/places/wat-pathum/\", \"image\": \"https://takuapa101.pages.dev/assets/wat-pathum.webp\", \"description\": \"โบสถ์เก่าและเรื่องการขนส่งทางน้ำเชื่อมสถานที่นี้กับประวัติการค้าของเมือง\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"ถนนหน้าเมือง ชุมชนตลาดใหญ่\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8282064, \"longitude\": 98.3667554}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"เปิดให้เข้าชมเวลาใด\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · เว็บเลิฟไทยแลนด์ระบุทุกวัน 08.00·17.00 น. ยังไม่มีประกาศจากวัดยืนยัน\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เอกสารเทศบาลระบุว่าอุโบสถเป็นศิลปะพื้นถิ่นภาคใต้และใช้เสาไม้เป็นแกน เทศบาลระบุว่ากรมศิลปากรขึ้นทะเบียนอุโบสถเป็นโบราณสถานใน พ.ศ. 2478; การวิจัยครั้งนี้ยังไม่ได้ตรวจประกาศขึ้นทะเบียนต้นฉบับ\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"รายละเอียดโครงสร้างที่เอกสารเทศบาลกล่าวถึง เหมาะกับการสังเกตงานช่างพื้นถิ่น; ยังไม่มีข้อมูลว่ามองเห็นได้ครบจากภายนอกหรือไม่ ชิ้นส่วนเรือที่แหล่งข้อมูลระบุว่าจัดอยู่ในบริเวณวัด เป็นหลักฐานเชื่อมกับการขนส่งสินค้าทางน้ำของเมือง ทั้งนี้ยังไม่มีข้อมูลตรวจสภาพล่าสุดในปี 2569\"}}]}]": "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Wat Pathum Thara (Wat Na Mueang)\", \"item\": \"https://takuapa101.pages.dev/places/wat-pathum/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"Wat Pathum Thara (Wat Na Mueang)\", \"url\": \"https://takuapa101.pages.dev/places/wat-pathum/\", \"image\": \"https://takuapa101.pages.dev/assets/wat-pathum.webp\", \"description\": \"An old ordination hall and the story of water transport connect this site to the town's trading history\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Thanon Na Mueang, Talat Yai Community\", \"addressLocality\": \"Takua Pa\", \"addressRegion\": \"Phang Nga\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8282064, \"longitude\": 98.3667554}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What are the opening hours?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Information not verified · Love Thailand lists daily hours of 08.00·17.00, but the temple has not issued a confirmation\"}}, {\"@type\": \"Question\", \"name\": \"What is the history of this place?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Municipal documents describe the ordination hall as southern vernacular art with wooden posts as its structural core. The municipality states that the Fine Arts Department registered it as an ancient monument in 1935 (B.E. 2478); this research has not checked the original registration notice\"}}, {\"@type\": \"Question\", \"name\": \"What is there to see?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The structural details mentioned in municipal documents suit close observation of local craftsmanship; it is not known whether all of them can be seen from outside. Boat parts identified by sources as being on the temple grounds provide a link to the town's waterborne goods transport. There is no recent condition report for 2026 (B.E. 2569)\"}}]}]",
