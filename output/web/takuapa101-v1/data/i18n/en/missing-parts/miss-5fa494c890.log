data\i18n\en\missing-parts\miss-f0f5cbac8e.log:159:+  "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"วัดปทุมธารา (วัดหน้าเมือง)\", \"item\": \"https://takuapa101.pages.dev/places/wat-pathum/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"วัดปทุมธารา (วัดหน้าเมือง)\", \"url\": \"https://takuapa101.pages.dev/places/wat-pathum/\", \"image\": \"https://takuapa101.pages.dev/assets/wat-pathum.webp\", \"description\": \"โบสถ์เก่าและเรื่องการขนส่งทางน้ำเชื่อมสถานที่นี้กับประวัติการค้าของเมือง\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"ถนนหน้าเมือง ชุมชนตลาดใหญ่\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8282064, \"longitude\": 98.3667554}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"เปิดให้เข้าชมเวลาใด\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · เว็บเลิฟไทยแลนด์ระบุทุกวัน 08.00·17.00 น. ยังไม่มีประกาศจากวัดยืนยัน\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เอกสารเทศบาลระบุว่าอุโบสถเป็นศิลปะพื้นถิ่นภาคใต้และใช้เสาไม้เป็นแกน เทศบาลระบุว่ากรมศิลปากรขึ้นทะเบียนอุโบสถเป็นโบราณสถานใน พ.ศ. 2478; การวิจัยครั้งนี้ยังไม่ได้ตรวจประกาศขึ้นทะเบียนต้นฉบับ\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"รายละเอียดโครงสร้างที่เอกสารเทศบาลกล่าวถึง เหมาะกับการสังเกตงานช่างพื้นถิ่น; ยังไม่มีข้อมูลว่ามองเห็นได้ครบจากภายนอกหรือไม่ ชิ้นส่วนเรือที่แหล่งข้อมูลระบุว่าจัดอยู่ในบริเวณวัด เป็นหลักฐานเชื่อมกับการขนส่งสินค้าทางน้ำของเมือง ทั้งนี้ยังไม่มีข้อมูลตรวจสภาพล่าสุดในปี 2569\"}}]}]": "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Wat Pathum Thara (Wat Na Mueang)\", \"item\": \"https://takuapa101.pages.dev/places/wat-pathum/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"Wat Pathum Thara (Wat Na Mueang)\", \"url\": \"https://takuapa101.pages.dev/places/wat-pathum/\", \"image\": \"https://takuapa101.pages.dev/assets/wat-pathum.webp\", \"description\": \"An old ordination hall and the story of water transport connect this site to the town's trading history\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Thanon Na Mueang, Talat Yai Community\", \"addressLocality\": \"Takua Pa\", \"addressRegion\": \"Phang Nga\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8282064, \"longitude\": 98.3667554}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What are the opening hours?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Information not verified · Love Thailand lists daily hours of 08.00·17.00, but the temple has not issued a confirmation\"}}, {\"@type\": \"Question\", \"name\": \"What is the history of this place?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Municipal documents describe the ordination hall as southern vernacular art with wooden posts as its structural core. The municipality states that the Fine Arts Department registered it as an ancient monument in 1935 (B.E. 2478); this research has not checked the original registration notice\"}}, {\"@type\": \"Question\", \"name\": \"What is there to see?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The structural details mentioned in municipal documents suit close observation of local craftsmanship; it is not known whether all of them can be seen from outside. Boat parts identified by sources as being on the temple grounds provide a link to the town's waterborne goods transport. There is no recent condition report for 2026 (B.E. 2569)\"}}]}]",
