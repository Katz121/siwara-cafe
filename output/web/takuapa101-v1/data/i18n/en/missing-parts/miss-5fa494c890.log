data\i18n\en\missing-parts\miss-e108f1d3a4.log:133:+  "อาคารตั้งอยู่บนถนนศรีตะกั่วป่าในย่านเมืองเก่า และยังถูกใช้เป็นจุดหมายในสื่อท่องเที่ยวของเทศบาล การท่องเที่ยวแห่งประเทศไทย และกิจกรรมเมืองเก่า เช่น ถนนสายวัฒนธรรมที่จัดในย่านถนนศรีตะกั่วป่า ข้อมูลที่พบยืนยันบริบทกิจกรรมของย่าน แต่ยังไม่ยืนยันว่ามีกิจกรรมจัดภายในอาคารเป็นประจำ": "The building stands on Thanon Si Takua Pa in the old town and is still used as a destination in tourism materials from the municipality, the Tourism Authority of Thailand, and old-town activities such as the cultural street event held in the Thanon Si Takua Pa area. The available information confirms the area's activity context, but not that events are regularly held inside the building.",
data\i18n\en\missing-parts\miss-e108f1d3a4.log:151:+  "เอกสารโครงการเมืองเก่าระบุการจัดลอยกระทงที่นี่ในวันเพ็ญเดือน 12 พร้อมการประกวดกระทง การแสดง และการละเล่นพื้นบ้าน ส่วนหลักฐานที่พบยังไม่ยืนยันผลกระทบจากสึนามิ 2547 การถูกทิ้งร้าง การเปลี่ยนมือ หรือการขึ้นทะเบียนโบราณสถานเฉพาะสวน": "Old-town project documents record Loy Krathong activities here on the full moon of the twelfth lunar month, including krathong contests, performances, and folk games. The evidence found does not yet verify impacts from the 2004 tsunami (B.E. 2547), abandonment, a change of ownership, or separate registration of the park as an archaeological site.",
data\i18n\en\missing-parts\miss-e108f1d3a4.log:167:+  "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"วัดบรมธาตุคีรีเขต (วัดลุ่ม)\", \"item\": \"https://takuapa101.pages.dev/places/wat-boromthat/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"วัดบรมธาตุคีรีเขต (วัดลุ่ม)\", \"url\": \"https://takuapa101.pages.dev/places/wat-boromthat/\", \"image\": \"https://takuapa101.pages.dev/assets/wat-boromthat.webp\", \"description\": \"มีพระบรมสารีริกธาตุประดิษฐานอยู่ และเป็นสถานที่สำคัญทางศรัทธา\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"ถนนกลั่นแก้ว ย่านตลาดเก่า (บริเวณซอยคีรีเขต)\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8336680169, \"longitude\": 98.3563150443}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"เปิดให้เข้าชมเวลาใด\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · ทุกวัน 08.00·17.00 น.\"}}, {\"@type\": \"Question\", \"name\": \"มีค่าเข้าชมหรือไม่\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · ไม่เสียค่าเข้าชม\"}}, {\"@type\": \"Question\", \"name\": \"ควรแต่งกายอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"แต่งกายสุภาพเมื่อเข้าสักการะศาสนสถาน\"}}, {\"@type\": \"Question\", \"name\": \"เดินทางจากตัวเมืองตะกั่วป่าอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"มุ่งสู่ย่านเมืองเก่าตะกั่วป่า แล้วเข้าถนนกลั่นแก้ว/ซอยคีรีเขต\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เดิมเป็นที่พักสงฆ์ของพระฝ่ายอรัญวาสี และมีอายุประมาณ 200 ปี ชาวบ้านเรียกวัดนี้ว่า ‘วัดลุ่ม’ เพราะตั้งอยู่ในพื้นที่ลาดลุ่ม\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ฐานเจดีย์โบราณที่มีต้นไทรใหญ่ขึ้นอยู่บนฐาน เป็นศูนย์รวมศรัทธาสำคัญของชุมชนตามข้อมูลเทศบาล ประดิษฐานอยู่ภายในวัด\"}}]}]": "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Wat Boromthat Khiri Khet (Wat Lum)\", \"item\": \"https://takuapa101.pages.dev/places/wat-boromthat/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"Wat Boromthat Khiri Khet (Wat Lum)\", \"url\": \"https://takuapa101.pages.dev/places/wat-boromthat/\", \"image\": \"https://takuapa101.pages.dev/assets/wat-boromthat.webp\", \"description\": \"The temple houses relics of the Buddha and is an important place of faith\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"Thanon Klan Kaew, Old Market area (around Soi Khiri Khet)\", \"addressLocality\": \"Takuapa\", \"addressRegion\": \"Phang Nga\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8336680169, \"longitude\": 98.3563150443}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What are the opening hours?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Not verified · Daily 08.00·17.00\"}}, {\"@type\": \"Question\", \"name\": \"Is there an admission fee?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Not verified · No admission fee\"}}, {\"@type\": \"Question\", \"name\": \"How should I dress?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Dress respectfully when visiting a religious site\"}}, {\"@type\": \"Question\", \"name\": \"How do I get there from Takuapa town centre?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Head to Takuapa Old Town, then take Thanon Klan Kaew or Soi Khiri Khet\"}}, {\"@type\": \"Question\", \"name\": \"What is the history of this place?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"It was originally a forest-dwelling monks' retreat and is around 200 years old. Locals call it Wat Lum because it stands on low-lying ground\"}}, {\"@type\": \"Question\", \"name\": \"What is there to see?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"An ancient chedi base with a large banyan tree growing on it. Municipal information identifies it as an important focus of community faith, located within the temple\"}}]}]",
data\i18n\en\missing-parts\miss-e108f1d3a4.log:187:+  "อาคารตั้งอยู่บนถนนศรีตะกั่วป่าในย่านเมืองเก่า และยังถูกใช้เป็นจุดหมายในสื่อท่องเที่ยวของเทศบาล การท่องเที่ยวแห่งประเทศไทย และกิจกรรมเมืองเก่า เช่น ถนนสายวัฒนธรรมที่จัดในย่านถนนศรีตะกั่วป่า ข้อมูลที่พบยืนยันบริบทกิจกรรมของย่าน แต่ยังไม่ยืนยันว่ามีกิจกรรมจัดภายในอาคารเป็นประจำ": "The building stands on Thanon Si Takua Pa in the old town and is still used as a destination in tourism materials from the municipality, the Tourism Authority of Thailand, and old-town activities such as the cultural street event held in the Thanon Si Takua Pa area. The available information confirms the area's activity context, but not that events are regularly held inside the building.",
data\i18n\en\missing-parts\miss-e108f1d3a4.log:205:+  "เอกสารโครงการเมืองเก่าระบุการจัดลอยกระทงที่นี่ในวันเพ็ญเดือน 12 พร้อมการประกวดกระทง การแสดง และการละเล่นพื้นบ้าน ส่วนหลักฐานที่พบยังไม่ยืนยันผลกระทบจากสึนามิ 2547 การถูกทิ้งร้าง การเปลี่ยนมือ หรือการขึ้นทะเบียนโบราณสถานเฉพาะสวน": "Old-town project documents record Loy Krathong activities here on the full moon of the twelfth lunar month, including krathong contests, performances, and folk games. The evidence found does not yet verify impacts from the 2004 tsunami (B.E. 2547), abandonment, a change of ownership, or separate registration of the park as an archaeological site.",
