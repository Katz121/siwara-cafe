data\i18n\en\missing-parts\miss-dc14f4aa94.log:461: "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"สะพานเหล็กบุญสูง\", \"item\": \"https://takuapa101.pages.dev/places/iron-bridge/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"สะพานเหล็กบุญสูง\", \"url\": \"https://takuapa101.pages.dev/places/iron-bridge/\", \"image\": \"https://takuapa101.pages.dev/assets/iron-bridge.webp\", \"description\": \"สะพานมีความเกี่ยวข้องกับการเดินทางและการขนส่งในยุคเหมืองแร่\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"ถนนราษฎร์บำรุง บ้านโคกขนุน\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8531719567, \"longitude\": 98.3540239936}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"เปิดให้เข้าชมเวลาใด\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ข้อมูลยังไม่ยืนยัน · เข้าชมได้ตลอดทั้งวัน (ข้อมูลจากแหล่งท่องเที่ยวรอง)\"}}, {\"@type\": \"Question\", \"name\": \"มีที่จอดรถไหม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"มีข้อมูลจากรีวิวว่าจอดริมถนนได้และมีพื้นที่จำกัด แต่ไม่มีข้อมูลทางการยืนยัน\"}}, {\"@type\": \"Question\", \"name\": \"เดินทางจากตัวเมืองตะกั่วป่าอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เดินทางตามถนนราษฎร์บำรุงไปทางเมืองเก่าตะกั่วป่า สะพานอยู่ด้านซ้ายมือ ห่างจากตัวเมืองประมาณ 2 กิโลเมตร\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"พ.ศ. 2511 มีการนำเหล็กจากเรือขุดแร่มาสร้างสะพานเหล็กโคกขนุน ความยาวกว่า 200 เมตร ข้ามแม่น้ำตะกั่วป่า ผู้ริเริ่มคือ นายจุติ บุญสูง เจ้าของกิจการบริษัทเรือขุดแร่จุติบุญสูง จำกัด ซึ่งก่อตั้งบริษัทใน พ.ศ. 2503\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"สะพานทอดข้ามแม่น้ำตะกั่วป่าและเชื่อมพื้นที่ถนนหลักกับบริเวณโรงขุดแร่เก่า ใช้เหล็กจากเรือขุดแร่ที่ไม่ใช้งานแล้ว และปลายทางยังมองเห็นโรงขุดแร่เก่า จากสะพานเห็นทุ่งสีเขียว ต้นไม้ และทิวเขา เหมาะกับการชมวิวและถ่ายภาพ\"}}]}]": 1,
