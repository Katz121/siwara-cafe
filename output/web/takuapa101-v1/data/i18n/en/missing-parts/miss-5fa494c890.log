pa101.pages.dev/stories/architecture/"}, {"@type": "ListItem", "position": 3, "url": "https://takuapa101.pages.dev/stories/water-trade/"}, {"@type": "ListItem", "position": 4, "url": "https://takuapa101.pages.dev/stories/food-people/"}, {"@type": "ListItem", "position": 5, "url": "https://takuapa101.pages.dev/stories/kuapapoh/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><script src="/assets/trip.js" defer></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.pages.dev/stories/"><link rel="alternate" hreflang="en" href="https://takuapa101.pages.dev/en/stories/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.pages.dev/stories/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/stories/" aria-current="page">เรื่องเล่าตะกั่วป่า</a><a href="/places/">สถานที่</a><a href="/news/">ความเคลื่อนไหว</a><a href="/map/">แผนที่</a><a href="/traditions/">ประเพณี</a><a href="/eat/">กินและของฝาก</a><a href="/rest/">กินเที่ยว</a><a href="/routes/">เส้นทางเดิน</a><a href="/trip/">ทริปของคุณ</a><a href="/about/">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/stories/" hreflang="en" lang="en">EN</a><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="stories-index-v2"><div class="intro"><a class="eyebrow" href="/">ตะกั่วป่า 101 / คู่มือเมืองเก่า</a><h1>เรื่องเล่าตะกั่วป่า</h1><p class="lead">สี่มุมมองสำหรับอ่านเมืองผ่านแหล่งข้อมูล · รู้จักเมือง บ้านเก่าและสถาปัตยกรรม สายน้ำและการค้า ผู้คนและรสชาติ</p></div><div class="story-grid-v2"><article class="story-card-v2 story-card-v2-lead"><div class="card-art-v2"><img src="/assets/riverwalk.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">รู้จักเมือง</span><h2><a href="/stories/city/">ตะกั่วป่า เมืองที่ย้ายตัวเองตามสายน้ำ</a></h2><p>จากชุมชนโบราณบนเส้นทางข้ามคาบสมุทร สู่เมืองตลาดและเมืองเหมืองแร่ · เรื่องที่ยืนยันได้และปริศนาที่ยังรอคำตอบ</p><div class="card-meta-v2"><span class="story-mins">6 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article><article class="story-card-v2"><div class="card-art-v2"><img src="/assets/culture-street.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">บ้านเก่าและสถาปัตยกรรม</span><h2><a href="/stories/architecture/">ตึกที่สร้างด้วยเงินดีบุกและเหล็กจากเรือขุดแร่ · สถาปัตยกรรมที่จำเมืองไว้</a></h2><p>อ่านเมืองตะกั่วป่าผ่านตึกแถวบนถนนสายวัฒนธรรม สะพานเหล็กบุญสูง จวนเจ้าเมือง และโรงเรียนเต้าหมิง · การเปลี่ยนผ่านที่ฝังอยู่ในอิฐ ปูน และโครงสร้างเหล็ก</p><div class="card-meta-v2"><span class="story-mins">6 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article><article class="story-card-v2"><div class="card-art-v2"><img src="/assets/iron-bridge.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">สายน้ำและการค้า</span><h2><a href="/stories/water-trade/">จากทุ่งตึกถึงแม่น้ำตะกั่วป่า: วันที่สายน้ำสร้างเมือง</a></h2><p>สายน้ำไม่ได้เป็นเพียงฉากหลัง แต่มันคือเส้นทาง ผู้เชื่อมคน และตัวกำหนดชะตาเมืองที่ต้องย้ายตามตะกอนน้ำ</p><div class="card-meta-v2"><span class="story-mins">7 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article><article class="story-card-v2"><div class="card-art-v2"><img src="/assets/food-center.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">ผู้คนและรสชาติ</span><h2><a href="/stories/food-people/">รสชาติของชุมชนบาบ๋าและตลาดเก่า</a></h2><p>อาหารเป็นทั้งความทรงจำของครัวเรือนและหลักฐานของการแลกเปลี่ยน · ลองอ่านตะกั่วป่าผ่านสำรับบาบ๋า เต้าส้อสองชั้น และถนนสายวัฒนธรรม</p><div class="card-meta-v2"><span class="story-mins">7 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article><article class="story-card-v2"><div class="card-art-v2"><img src="/assets/tao-ming.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">กระทู้เมือง</span><h2><a href="/stories/kuapapoh/">กั่วป่าโพ้: วันที่บ้านเก่าลุกขึ้นมาเล่าเรื่องตัวเอง</a></h2><p>โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา</p><div class="card-meta-v2"><span class="story-mins">6 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article></div><aside class="source"><h2>วิธีอ่านหน้านี้</h2><p>บทความเรียบเรียงจากเอกสารราชการและฐานข้อมูลสถาบันการศึกษา พร้อมแยกระดับหลักฐานในแต่ละเรื่อง · ข้อมูลร้าน เวลาเปิด และกำหนดการควรตรวจสอบกับผู้ให้บริการก่อนเดินทาง</p></aside></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
