ols"><label class="search-label">ค้นหาสถานที่<input type="search" data-place-search placeholder="ชื่อวัด ศาลเจ้า หรือจุดที่อยากไป" autocomplete="off"></label><div class="filter-tabs" role="group" aria-label="หมวดสถานที่"><button type="button" data-filter="all" aria-pressed="true">ทั้งหมด <sup>20</sup></button><button type="button" data-filter="temple" aria-pressed="false">วัดและเจดีย์ <sup>6</sup></button><button type="button" data-filter="shrine" aria-pressed="false">ศาลเจ้าและโรงเจ <sup>4</sup></button><button type="button" data-filter="heritage" aria-pressed="false">ตึกเก่าและร่องรอยเมือง <sup>4</sup></button><button type="button" data-filter="park" aria-pressed="false">สวนและพื้นที่สาธารณะ <sup>2</sup></button><button type="button" data-filter="market" aria-pressed="false">ตลาดและของกิน <sup>3</sup></button><button type="button" data-filter="museum" aria-pressed="false">พิพิธภัณฑ์ <sup>1</sup></button></div></div><div class="explorer-status"><span data-place-count role="status" aria-live="polite">20 สถานที่ให้ค่อย ๆ รู้จัก</span><span>เลือกภาพเพื่อเปิดอ่าน ↗</span></div><div class="places-grid"><article class="place-card" data-place-card data-category="temple" data-name="วัดบรมธาตุคีรีเขต (วัดลุ่ม)"><a class="place-image" href="/places/wat-boromthat/"><img src="/assets/wat-boromthat.webp" alt="วัดบรมธาตุคีรีเขต (วัดลุ่ม)" width="1000" height="1000" loading="lazy"><span class="card-index">01</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-boromthat/">วัดบรมธาตุคีรีเขต (วัดลุ่ม)</a></h3><p>เจดีย์สีขาวกับศรัทธาของเมือง</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดคุหาภิมุข (วัดควนถ้ำ)"><a class="place-image" href="/places/wat-khuha/"><img src="/assets/wat-khuha.webp" alt="วัดคุหาภิมุข (วัดควนถ้ำ)" width="1000" height="1000" loading="lazy"><span class="card-index">02</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-khuha/">วัดคุหาภิมุข (วัดควนถ้ำ)</a></h3><p>รายละเอียดเล็กที่ชวนให้หยุดมอง</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดปทุมธารา (วัดหน้าเมือง)"><a class="place-image" href="/places/wat-pathum/"><img src="/assets/wat-pathum.webp" alt="วัดปทุมธารา (วัดหน้าเมือง)" width="1000" height="1000" loading="lazy"><span class="card-index">03</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-pathum/">วัดปทุมธารา (วัดหน้าเมือง)</a></h3><p>โบสถ์เก่ากับเรื่องราวทางน้ำ</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดคงคาภิมุข (วัดคงคา)"><a class="place-image" href="/places/wat-kongkha/"><img src="/assets/wat-kongkha.webp" alt="วัดคงคาภิมุข (วัดคงคา)" width="1000" height="1000" loading="lazy"><span class="card-index">04</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-kongkha/">วัดคงคาภิมุข (วัดคงคา)</a></h3><p>เส้นสายอุโบสถแบบปักษ์ใต้</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดนิกรวราราม (วัดย่านยาว)"><a class="place-image" href="/places/wat-nikorn/"><img src="/assets/wat-nikorn.webp" alt="วัดนิกรวราราม (วัดย่านยาว)" width="1000" height="726" loading="lazy"><span class="card-index">05</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a></h3><p>วัดกับความทรงจำของชุมชน</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดเสนานุชรังสรรค์ (วัดใหม่)"><a class="place-image" href="/places/wat-sena/"><img src="/assets/wat-sena.webp" alt="