="true">เต็มภาพ</button><button type="button" data-map-zone="north" aria-pressed="false">ย่านยาว</button><button type="button" data-map-zone="old" aria-pressed="false">เมืองเก่า</button></div><div class="map-zoom"><button type="button" data-map-action="out" aria-label="ย่อแผนที่">−</button><output data-map-level aria-live="polite" aria-label="ระดับการขยาย">100%</output><button type="button" data-map-action="in" aria-label="ขยายแผนที่">+</button><button type="button" data-map-action="reset" aria-label="คืนขนาดแผนที่">↺</button></div></div><div class="map-stage" tabindex="0" role="region" aria-label="ภาพแผนที่ เลื่อนด้วยปุ่มลูกศร ขยายด้วยเครื่องหมายบวก ย่อด้วยเครื่องหมายลบ"><img class="map-image" src="/assets/municipal-map.png" width="1358" height="1938" alt="แผนที่ท่องเที่ยวตะกั่วป่าจากเทศบาล แสดงย่านยาว เมืองเก่า ถนน สถานที่ และหมายเลขร้าน" draggable="false" loading="eager"></div><div class="map-help"><span>ลากเพื่อเลื่อน · ใช้ปุ่ม + / − เพื่อขยาย</span><a href="/assets/municipal-map.png" target="_blank" rel="noopener">เปิดภาพเต็มในแท็บใหม่ ↗</a></div></section><p class="small map-source-caption">แผนที่ประชาสัมพันธ์ของเทศบาลเมืองตะกั่วป่า ระยะและสัดส่วนไม่ตรงตามพื้นที่จริง · หมายเลขและสัญลักษณ์บนภาพคงตามเอกสารต้นทาง</p><section class="section"><div class="section-heading"><div><span class="chapter">อ่านต่อ / เปิดอ่านเมือง</span><h2>พบจุดหมายแล้ว เปิดเรื่องของที่นี่</h2></div><p>รายชื่อสถานที่ในคู่มือ · เลือกชื่อเพื่ออ่านต่อ</p></div><div class="map-place-index"><section><h3>วัดและเจดีย์</h3><ul><li><a href="/places/wat-boromthat/">วัดบรมธาตุคีรีเขต (วัดลุ่ม)</a></li><li><a href="/places/wat-khuha/">วัดคุหาภิมุข (วัดควนถ้ำ)</a></li><li><a href="/places/wat-pathum/">วัดปทุมธารา (วัดหน้าเมือง)</a></li><li><a href="/places/wat-kongkha/">วัดคงคาภิมุข (วัดคงคา)</a></li><li><a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a></li><li><a href="/places/wat-sena/">วัดเสนานุชรังสรรค์ (วัดใหม่)</a></li></ul></section><section><h3>ศาลเจ้าและโรงเจ</h3><ul><li><a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a></li><li><a href="/places/pun-thao/">ศาลเจ้าปุนเถ่ากงอ๊า</a></li><li><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a></li><li><a href="/places/rong-jae/">โรงเจในสวน</a></li></ul></section><section><h3>ตึกเก่าและร่องรอยเมือง</h3><ul><li><a href="/places/iron-bridge/">สะพานเหล็กบุญสูง</a></li><li><a href="/places/governor-wall/">กำแพงจวนเจ้าเมืองตะกั่วป่า</a></li><li><a href="/places/khun-in/">บ้านขุนอินทร์</a></li><li><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a></li></ul></section><section><h3>สวนและพื้นที่สาธารณะ</h3><ul><li><a href="/places/phra-narai/">สวนสาธารณะพระนารายณ์</a></li><li><a href="/places/thung-phra/">สวนสาธารณะทุ่งพระโพธิ์</a></li></ul></section><section><h3>ตลาดและของกิน</h3><ul><li><a href="/places/riverwalk/">ตลาดริมน้ำตะกั่วป่า</a></li><li><a href="/places/culture-street/">ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</a></li><li><a href="/places/food-center/">ศูนย์อาหารลานโล่งตะกั่วป่า</a></li></ul></section><section><h3>พิพิธภัณฑ์</h3><ul><li><a href="/places/museum/">พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า</a></li></ul></section></div></section></noscript><aside class="source"><h2>ที่มาของข้อมูล</h2><p>เรียบเรียงจาก<a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับเทศบาลเมืองตะกั่วป่า</a> · สกัดข้อมูล 6 กันยายน 2569 เอกสารไม่ระบุวันที่เผยแพร่ เวลาเปิด สถานะร้าน และกำหนดงานปัจจุบันยังไม่ได้ยืนยัน ควรตรวจสอบกับสถานที่ก่อนเดินทาง</p></aside></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidd