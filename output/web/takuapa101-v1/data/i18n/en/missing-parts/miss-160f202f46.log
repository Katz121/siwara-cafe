.\site\places\khun-in\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>บ้านขุนอินทร์ · ตึกขุนอินทร์ ตะกั่วป่า · ตะกั่วป่า 101</title><meta name="description" content="หน้าต่างและระเบียงชวนมองอดีต · บ้านขุนอินทร์ ตะกั่วป่า · ตึกขุนอินทร์ พังงา · เมืองเก่าตะกั่วป่า"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="บ้านขุนอินทร์ · ตึกขุนอินทร์ ตะกั่วป่า"><meta property="og:description" content="หน้าต่างและระเบียงชวนมองอดีต · บ้านขุนอินทร์ ตะกั่วป่า · ตึกขุนอินทร์ พังงา · เมืองเก่าตะกั่วป่า"><meta property="og:url" content="https://takuapa101.com/places/khun-in/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/khun-in.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/khun-in.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/places/khun-in/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "บ้านขุนอินทร์ · ตึกขุนอินทร์ ตะกั่วป่า", "item": "https://takuapa101.com/places/khun-in/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "บ้านขุนอินทร์", "url": "https://takuapa101.com/places/khun-in/", "image": "https://takuapa101.com/as