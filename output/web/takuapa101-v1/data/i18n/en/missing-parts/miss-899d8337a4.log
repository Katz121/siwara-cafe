data\i18n\en\missing-parts\miss-2bbda3e954.log:45:- [{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "ศาลเจ้ากู่ใช่ตึ๋ง", "item": "https://takuapa101.com/places/kue-chai/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "ศาลเจ้ากู่ใช่ตึ๋ง", "url": "https://takuapa101.com/places/kue-chai/", "image": "https://takuapa101.com/assets/kue-chai.webp", "description": "เอกสารกล่าวถึงการขอพรด้านสุขภาพและโชคลาภ", "address": {"@type": "PostalAddress", "streetAddress": "บ้านเลขที่ 87 ถนนศรีตะกั่วป่า", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8265089587, "longitude": 98.3647240165}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "ควรแต่งกายอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "แต่งกายสุภาพเมื่อเข้าสักการะ"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "เป็นศาลเจ้าแรกของอำเภอตะกั่วป่า และมีการเชิญองค์เทพจากเมืองจีนมาประดิษฐาน ตามเอกสารสภาวัฒนธรรม นายหง่อจกซื้อบ้านเลขที่ 87 ถนนศรีตะกั่วป่ามาทำเป็นศาลเจ้า หลังขอพรเรื่องผลผลิตเหมืองแร่และโชคลาภ"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "มีองค์เทพนาจาและองค์เทพอื่น ๆ สำหรับสักการะ เอกสารชุมชนเล่าความเชื่อมโยงของศาลเจ้ากับการขอพรให้ทำเหมืองแร่ได้แร่ดีและมีกำไร ในเทศกาลกินเจมีพิธีโก้ยห่าน ข้ามสะพาน และผูกสายสิญจน์เพื่อความเป็นสิริมงคล"}}]}]
data\i18n\en\missing-parts\miss-2bbda3e954.log:57:- [{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "วัดคงคาภิมุข (วัดคงคา)", "item": "https://takuapa101.com/places/wat-kongkha/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "วัดคงคาภิมุข (วัดคงคา)", "url": "https://takuapa101.com/places/wat-kongkha/", "image": "https://takuapa101.com/assets/wat-kongkha.webp", "description": "มีอุโบสถแบบปักษ์ใต้ซึ่งเอกสารระบุว่าเป็นโบราณสถาน", "address": {"@type": "PostalAddress", "streetAddress": "ถนนราษฎร์บำรุง", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.840837, "longitude": 98.362899}, "telephone": "076-421-479"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "จากที่ทำการเทศบาลเมืองตะกั่วป่าไปทางตะวันตกตามถนนเพชรเกษม/ทางหลวงหมายเลข 4 ราว 5 กิโลเมตร เลี้ยวซ้ายเข้าถนนราษฎร์บำรุง ตรงต่อประมาณ 280 เมตร แล้วเลี้ยวซ้ายตามทาง จะพบวัดอยู่ด้านขวามือ"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "อุโบสถและเจดีย์เป็นโบราณสถานที่ยังใช้งานอยู่ และวัดเป็นสถานปฏิบัติธรรมประจำจังหวัดพังงาแห่งที่ 1 กรมศิลปากรประกาศขึ้นทะเบียนโบราณสถานและกำหนดเขตที่ดินในราชกิจจานุเบกษาเมื่อ 18 ธันวาคม พ.ศ. 2539"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "ชมอาคารก่ออิฐถือปูน หน้าบันและซุ้มประตูหน้าต่างประดับปูนปั้น รวมถึงภาพพระพุทธรูปและลวดลายพันธุ์พฤกษา เป็นหนึ่งในโบราณสถานสำคัญภายในวัดและยังอยู่ในวัดที่มีการใช้งาน วัดตั้งอยู่ริมฝั่งคลองตะกั่วป่าด้านตะวันตก โดยคลองอยู่ทางทิศตะวันออกของวัด"}}]}]
data\i18n\en\missing-parts\miss-2bbda3e954.log:70:- การเปลี่ยนผ่านจากการปกครองระบบเจ้าเมืองเข้าสู่ระบบอำเภอ ถูกบันทึกไว้ในสถาปัตยกรรมของ &#x27;บ้านขุนอินทร์&#x27; ตามหลักฐานท้องถิ่น บ้านหลังนี้สร้างขึ้นราว พ.ศ. 2460 โดยช่างฝีมือชาวจีน เพื่อเป็นที่พักของ ร.อ.ท. ขุนอินทรคีรี (ช้อย ณ นคร) ผู้สืบสายตระกูลเจ้าเมืองที่ต่อมาได้รับตำแหน่งเป็นนายอำเภอตะกั่วป่า
