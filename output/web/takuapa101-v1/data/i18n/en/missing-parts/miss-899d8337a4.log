data\i18n\en\missing-parts\miss-7d58d2312d.log:45:- [{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "ศาลเจ้ากู่ใช่ตึ๋ง", "item": "https://takuapa101.com/places/kue-chai/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "ศาลเจ้ากู่ใช่ตึ๋ง", "url": "https://takuapa101.com/places/kue-chai/", "image": "https://takuapa101.com/assets/kue-chai.webp", "description": "เอกสารกล่าวถึงการขอพรด้านสุขภาพและโชคลาภ", "address": {"@type": "PostalAddress", "streetAddress": "บ้านเลขที่ 87 ถนนศรีตะกั่วป่า", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8265089587, "longitude": 98.3647240165}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "ควรแต่งกายอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "แต่งกายสุภาพเมื่อเข้าสักการะ"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "เป็นศาลเจ้าแรกของอำเภอตะกั่วป่า และมีการเชิญองค์เทพจากเมืองจีนมาประดิษฐาน ตามเอกสารสภาวัฒนธรรม นายหง่อจกซื้อบ้านเลขที่ 87 ถนนศรีตะกั่วป่ามาทำเป็นศาลเจ้า หลังขอพรเรื่องผลผลิตเหมืองแร่และโชคลาภ"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "มีองค์เทพนาจาและองค์เทพอื่น ๆ สำหรับสักการะ เอกสารชุมชนเล่าความเชื่อมโยงของศาลเจ้ากับการขอพรให้ทำเหมืองแร่ได้แร่ดีและมีกำไร ในเทศกาลกินเจมีพิธีโก้ยห่าน ข้ามสะพาน และผูกสายสิญจน์เพื่อความเป็นสิริมงคล"}}]}]
data\i18n\en\missing-parts\miss-7d58d2312d.log:56:- [{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "วัดคงคาภิมุข (วัดคงคา)", "item": "https://takuapa101.com/places/wat-kongkha/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "วัดคงคาภิมุข (วัดคงคา)", "url": "https://takuapa101.com/places/wat-kongkha/", "image": "https://takuapa101.com/assets/wat-kongkha.webp", "description": "มีอุโบสถแบบปักษ์ใต้ซึ่งเอกสารระบุว่าเป็นโบราณสถาน", "address": {"@type": "PostalAddress", "streetAddress": "ถนนราษฎร์บำรุง", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.840837, "longitude": 98.362899}, "telephone": "076-421-479"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "จากที่ทำการเทศบาลเมืองตะกั่วป่าไปทางตะวันตกตามถนนเพชรเกษม/ทางหลวงหมายเลข 4 ราว 5 กิโลเมตร เลี้ยวซ้ายเข้าถนนราษฎร์บำรุง ตรงต่อประมาณ 280 เมตร แล้วเลี้ยวซ้ายตามทาง จะพบวัดอยู่ด้านขวามือ"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "อุโบสถและเจดีย์เป็นโบราณสถานที่ยังใช้งานอยู่ และวัดเป็นสถานปฏิบัติธรรมประจำจังหวัดพังงาแห่งที่ 1 กรมศิลปากรประกาศขึ้นทะเบียนโบราณสถานและกำหนดเขตที่ดินในราชกิจจานุเบกษาเมื่อ 18 ธันวาคม พ.ศ. 2539"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "ชมอาคารก่ออิฐถือปูน หน้าบันและซุ้มประตูหน้าต่างประดับปูนปั้น รวมถึงภาพพระพุทธรูปและลวดลายพันธุ์พฤกษา เป็นหนึ่งในโบราณสถานสำคัญภายในวัดและยังอยู่ในวัดที่มีการใช้งาน วัดตั้งอยู่ริมฝั่งคลองตะกั่วป่าด้านตะวันตก โดยคลองอยู่ทางทิศตะวันออกของวัด"}}]}]
data\i18n\en\missing-parts\miss-7d58d2312d.log:68:- การเปลี่ยนผ่านจากการปกครองระบบเจ้าเมืองเข้าสู่ระบบอำเภอ ถูกบันทึกไว้ในสถาปัตยกรรมของ &#x27;บ้านขุนอินทร์&#x27; ตามหลักฐานท้องถิ่น บ้านหลังนี้สร้างขึ้นราว พ.ศ. 2460 โดยช่างฝีมือชาวจีน เพื่อเป็นที่พักของ ร.อ.ท. ขุนอินทรคีรี (ช้อย ณ นคร) ผู้สืบสายตระกูลเจ้าเมืองที่ต่อมาได้รับตำแหน่งเป็นนายอำเภอตะกั่วป่า
data\i18n\en\missing-parts\miss-7d58d2312d.log:261:data\i18n\en\missing-parts\miss-5fa494c890.log:546:data\i18n\en\missing-parts\miss-dc14f4aa94.log:207:.\site\places\khun-in\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api="https://takuapa101-news.siwatid-99.workers.dev"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>บ้านขุนอินทร์ · ตะกั่วป่า 101</title><meta name="description" content="หน้าต่างและระเบียงชวนมองอดีต · บ้านสถาปัตยกรรมชิโน-ยูโรเปียนที่สะท้อนความรุ่งเรืองในอดีต ผ่านรูปทรงอาคารและรายละเอียดของบ้าน"><meta name="robots" content="noindex,follow"><meta property="og:title" content="บ้านขุนอินทร์"><meta property="og:description" content="หน้าต่างและระเบียงชวนมองอดีต · บ้านสถาปัตยกรรมชิโน-ยูโรเปียนที่สะท้อนความรุ่งเรืองในอดีต ผ่านรูปทรงอาคารและรายละเอียดของบ้าน"><meta property="og:url" content="https://takuapa101.pages.dev/places/khun-in/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.pages.dev/assets/og/khun-in.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.pages.dev/assets/og/khun-in.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.pages.dev/places/khun-in/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.pages.dev/"}, {"@type": "ListItem", "position": 2, "name": "บ้านขุนอินทร์", "item": "https://takuapa101.pages.dev/places/khun-in/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "บ้านขุนอินทร์", "url": "https://takuapa101.pages.dev/places/khun-in/", "image": "https://takuapa101.pages.dev/assets/khun-in.webp", "description": "บ้านที่เอกสารอธิบายว่ามีสถาปัตยกรรมชิโน-ยูโรเปียนและสะท้อนความรุ่งเรืองในอดีต", "address": {"@type": "PostalAddress", "streetAddress": "ใกล้สี่แยกหมอพิทักษ์", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "postalCode": "82110", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8307319975, "longitude": 98.3633399749}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "เป็นบ้านพักอาศัยของ ร.อ.ท. ขุนอินทรคีรี (ช้อย ณ นคร) แหล่งข้อมูลการท่องเที่ยวของชุมชนจัดบ้านขุนอินทร์ไว้ในกลุ่มโบราณสถาน/อาคารเก่าของเมืองตะกั่วป่า"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "รูปทรงอาคารสองชั้นเป็นองค์ประกอบที่เห็นได้จากภายนอก การผสมศิลปะตะวันตกและตะวันออกในรูปแบบชิโนโปรตุกีสประยุกต์ เป็นบ้านพักอาศัยของบุคคลสำคัญที่ฐานข้อมูล ONEP ระบุชื่อไว้"}}, {"@type": "Question", "name": "เอกสารเทศบาลกล่าวถึงที่นี่อย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "บ้านที่เอกสารอธิบายว่ามีสถาปัตยกรรมชิโน-ยูโรเปียนและสะท้อนความรุ่งเรืองในอดีต"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><script src="/assets/trip.js" defer></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.pages.dev/places/khun-in/"><link rel="alternate" hreflang="en" href="https://takuapa101.pages.dev/en/places/khun-in/"><link rel="alternat