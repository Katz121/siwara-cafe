data\i18n\en\missing-parts\miss-dc14f4aa94.log:484: "บ้านขุนอินทร์ · ตะกั่วป่า 101": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:485: "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"บ้านขุนอินทร์\", \"item\": \"https://takuapa101.pages.dev/places/khun-in/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"บ้านขุนอินทร์\", \"url\": \"https://takuapa101.pages.dev/places/khun-in/\", \"image\": \"https://takuapa101.pages.dev/assets/khun-in.webp\", \"description\": \"บ้านที่เอกสารอธิบายว่ามีสถาปัตยกรรมชิโน-ยูโรเปียนและสะท้อนความรุ่งเรืองในอดีต\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"ใกล้สี่แยกหมอพิทักษ์\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"postalCode\": \"82110\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8307319975, \"longitude\": 98.3633399749}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เป็นบ้านพักอาศัยของ ร.อ.ท. ขุนอินทรคีรี (ช้อย ณ นคร) แหล่งข้อมูลการท่องเที่ยวของชุมชนจัดบ้านขุนอินทร์ไว้ในกลุ่มโบราณสถาน/อาคารเก่าของเมืองตะกั่วป่า\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"รูปทรงอาคารสองชั้นเป็นองค์ประกอบที่เห็นได้จากภายนอก การผสมศิลปะตะวันตกและตะวันออกในรูปแบบชิโนโปรตุกีสประยุกต์ เป็นบ้านพักอาศัยของบุคคลสำคัญที่ฐานข้อมูล ONEP ระบุชื่อไว้\"}}, {\"@type\": \"Question\", \"name\": \"เอกสารเทศบาลกล่าวถึงที่นี่อย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"บ้านที่เอกสารอธิบายว่ามีสถาปัตยกรรมชิโน-ยูโรเปียนและสะท้อนความรุ่งเรืองในอดีต\"}}]}]": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:488: "หลักฐานท้องถิ่นระบุว่าบ้านขุนอินทร์สร้างขึ้นราว พ.ศ. 2460 โดยช่างฝีมือชาวจีน เพื่อเป็นบ้านพักของ ร.อ.ท. ขุนอินทรคีรี (ช้อย ณ นคร) ผู้สืบสายตระกูลเจ้าเมืองและต่อมาเป็นนายอำเภอตะกั่วป่าระหว่าง พ.ศ. 2464·2469 จึงไม่ใช่เพียงอาคารสวยงาม แต่เป็นบ้านของผู้มีบทบาทในโครงสร้างการปกครองเมืองช่วงปลายยุคเจ้าเมืองสู่ระบบอำเภอ": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:492: "หลังใช้งานมาหลายทศวรรษ อาคารชำรุดทรุดโทรมลง ก่อนที่ตระกูล ณ นครจะซ่อมแซมประมาณ พ.ศ. 2524 โดยยึดรูปแบบเดิมเป็นหลัก และเปลี่ยนวัสดุมุงหลังคาจากกระเบื้องหลังเต่าเป็นกระเบื้องลอน นี่เป็นเหตุการณ์อนุรักษ์ที่มีปีระบุชัดที่สุดของบ้านขุนอินทร์จากแหล่งข้อมูลที่เข้าถึงได้": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:493: "ระหว่างนั้น เมืองตะกั่วป่าเปลี่ยนจากศูนย์กลางเหมืองแร่และการค้าทางน้ำไปสู่เมืองที่เงียบลงเมื่อเศรษฐกิจเดิมเสื่อมถอย แม่น้ำลำคลองตื้นเขินจากกิจกรรมเหมือง และชุมชนเก่าค่อย ๆ เปลี่ยนบทบาทเป็นย่านวัฒนธรรมและท่องเที่ยว บ้านขุนอินทร์จึงถูกจดจำร่วมกับถนนสายวัฒนธรรม อาคารจีนผสมยุโรป และหลักฐานของเมืองเหมืองเก่า": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:494: "แหล่งทางการของ ONEP จัดบ้านขุนอินทร์เป็นแหล่งศิลปกรรมประเภทสถาปัตยกรรม และฐานข้อมูลชุมชน SAC ระบุไว้ในกลุ่มแหล่งประวัติศาสตร์ของเมืองตะกั่วป่า แต่จากการตรวจแหล่งเปิดอ่านได้ยังไม่พบปีขึ้นทะเบียนเป็นโบราณสถานของกรมศิลปากร การใช้เป็นกิจการอื่น หรือหลักฐานว่าบ้านได้รับความเสียหายจากสึนามิ พ.ศ. 2547": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:495: "สถานะที่ยืนยันได้ในปี 2569 คือบ้านขุนอินทร์ยังถูกกล่าวถึงในฐานะอาคารประวัติศาสตร์ของเมืองเก่าตะกั่วป่า และแหล่งข้อมูลท้องถิ่นระบุว่ายังอยู่ในความดูแลของตระกูล ณ นคร ตัวอาคารมีคุณค่าจากรูปแบบชิโนโปรตุกีสประยุกต์และประวัติความเชื่อมโยงกับขุนอินทรคีรี": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:497: "ปัจจุบันบ้านทำหน้าที่เชิงสัญลักษณ์ในภูมิทัศน์เมืองเก่า โดยอยู่ร่วมกับถนนสายวัฒนธรรมและอาคารประวัติศาสตร์อื่น ๆ ของชุมชน ตรงกันข้ามกับโครงการที่มีประกาศชัดเจน ยังไม่พบข่าวหรือประกาศปี 2565·2569 ที่ระบุการบูรณะหรือกิจกรรมเฉพาะบ้านขุนอินทร์": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:503: "เป็นบ้านพักอาศัยของ ร.อ.ท. ขุนอินทรคีรี (ช้อย ณ นคร) แหล่งข้อมูลการท่องเที่ยวของชุมชนจัดบ้านขุนอินทร์ไว้ในกลุ่มโบราณสถาน/อาคารเก่าของเมืองตะกั่วป่า": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:510: "ศาลเจ้ากู่ใช่ตึ๋ง · ตะกั่วป่า 101": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:511: "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.pages.dev/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"ศาลเจ้ากู่ใช่ตึ๋ง\", \"item\": \"https://takuapa101.pages.dev/places/kue-chai/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"TouristAttraction\", \"name\": \"ศาลเจ้ากู่ใช่ตึ๋ง\", \"url\": \"https://takuapa101.pages.dev/places/kue-chai/\", \"image\": \"https://takuapa101.pages.dev/assets/kue-chai.webp\", \"description\": \"เอกสารกล่าวถึงการขอพรด้านสุขภาพและโชคลาภ\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"บ้านเลขที่ 87 ถนนศรีตะกั่วป่า\", \"addressLocality\": \"ตะกั่วป่า\", \"addressRegion\": \"พังงา\", \"addressCountry\": \"TH\"}, \"geo\": {\"@type\": \"GeoCoordinates\", \"latitude\": 8.8265089587, \"longitude\": 98.3647240165}}, {\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"ควรแต่งกายอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"แต่งกายสุภาพเมื่อเข้าสักการะ\"}}, {\"@type\": \"Question\", \"name\": \"สถานที่นี้มีประวัติความเป็นมาอย่างไร\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"เป็นศาลเจ้าแรกของอำเภอตะกั่วป่า และมีการเชิญองค์เทพจากเมืองจีนมาประดิษฐาน ตามเอกสารสภาวัฒนธรรม นายหง่อจกซื้อบ้านเลขที่ 87 ถนนศรีตะกั่วป่ามาทำเป็นศาลเจ้า หลังขอพรเรื่องผลผลิตเหมืองแร่และโชคลาภ\"}}, {\"@type\": \"Question\", \"name\": \"มีจุดเด่นอะไรให้ชม\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"มีองค์เทพนาจาและองค์เทพอื่น ๆ สำหรับสักการะ เอกสารชุมชนเล่าความเชื่อมโยงของศาลเจ้ากับการขอพรให้ทำเหมืองแร่ได้แร่ดีและมีกำไร ในเทศกาลกินเจมีพิธีโก้ยห่าน ข้ามสะพาน และผูกสายสิญจน์เพื่อความเป็นสิริมงคล\"}}]}]": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:630: "เอกสารท้องถิ่นอีกชุดเล่าว่านายส้อเส็งเคยร่วมงานกับศาลเจ้ากู่ใช่ตึ๋งก่อนเปิดศาลเจ้าในสวน อย่างไรก็ดี ยังยืนยันไม่ได้ว่าเป็นบุคคลเดียวกับนายส้อ เทียนเส้ง จึงไม่นำมาเล่าเป็นข้อเท็จจริงเดียวกัน": 1,
data\i18n\en\missing-parts\miss-dc14f4aa94.log:735: "วัดคงคาภิมุข (วัดคงคา) · ตะกั่วป่า 101": 1,
