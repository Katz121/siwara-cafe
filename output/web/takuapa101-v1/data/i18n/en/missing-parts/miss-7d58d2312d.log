 src="/assets/trip.js" defer></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.pages.dev/places/iron-bridge/"><link rel="alternate" hreflang="en" href="https://takuapa101.pages.dev/en/places/iron-bridge/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.pages.dev/places/iron-bridge/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><a href="/places/" aria-current="page">สถานที่</a><a href="/news/">ความเคลื่อนไหว</a><a href="/map/">แผนที่</a><a href="/traditions/">ประเพณี</a><a href="/eat/">กินและของฝาก</a><a href="/rest/">กินเที่ยว</a><a href="/routes/">เส้นทางเดิน</a><a href="/trip/">ทริปของคุณ</a><a href="/about/">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/places/iron-bridge/" hreflang="en" lang="en">EN</a><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/">หน้าแรก</a> / <a href="/places/">สถานที่</a> / ตึกเก่าและร่องรอยเมือง</div><header class="place-hero full-place-hero"><div><span class="chapter">บันทึกสถานที่ · ตึกเก่าและร่องรอยเมือง</span><h1>สะพานเหล็กบุญสูง</h1><p class="english">Boon Soong Iron Bridge</p><span class="fact-status confirmed">ยืนยันแล้ว 9 ข้อ</span><p><a class="text-link" href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้ ↓</a></p></div><div class="place-hero-art"><img src="/assets/iron-bridge.webp" alt="สะพานเหล็กบุญสูง" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>ข้อมูลใช้จริง</h2><dl><div><dt>พิกัด</dt><dd>8.8531719567, 98.3540239936 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.8531719567,98.3540239936" target="_blank" rel="noopener">นำทางด้วย Google Maps ↗</a><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">แหล่งพิกัด ↗</a></div><div><dt>เวลาเปิด</dt><dd>เข้าชมได้ตลอดทั้งวัน (ข้อมูลจากแหล่งท่องเที่ยวรอง) <span class="fact-status unverified">ยังไม่ยืนยัน</span></dd></div><div><dt>ค่าเข้า</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ที่จอดรถ</dt><dd>มีข้อมูลจากรีวิวว่าจอดริมถนนได้และมีพื้นที่จำกัด แต่ไม่มีข้อมูลทางการยืนยัน <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div><dt>ห้องน้ำ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>รถเข็น</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>การแต่งกาย</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>โทรศัพท์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เพจ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เว็บไซต์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ไลน์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a><a href="https://www.wongnai.com/attractions/583288JQ-%E0%B8%9E%E0%B8%B2%E0%B8%99%E0%B9%80%E0%B8%AB%E0%B8%A5%E0%B9%87%E0%B8%81-%E0%B8%9A%E0%B8%B8%E0%B8%8D%E0%B8%AA%E0%B8%B9%E0%B8%87" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">แหล่งข้อมูลติดต่อ ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">ในบันทึกหน้านี้</span><a href="#visit">ข้อมูลใช้จริง</a><a href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้</a><a href="#timeline">เส้นเวลาแบบจุด</a><a href="#highlights">จุดเด่นที่ควรดู</a><a href="#news">ข่าวและความเคลื่อนไหว</a><a href="#did_you_know">รู้หรือไม่</a><a href="#getting_there">วิธีเดินทาง</a><a href="#nearby">ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</a><a href="#faq">คำถามที่พบบ่อย</a><a href="#sources">ที่มาของข้อมูล</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>ตอนนั้น · ก่อนหน้า · ตอนนี้</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">ตอนนั้น</span><h3>จากเรือขุดแร่สู่สะพานของคนงาน</h3><p class="era-years">พ.ศ. 2503-2511 / ค.ศ. 1960-1968</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>เรื่องของสะพานเริ่มขึ้นในเมืองตะกั่วป่ายุคเหมืองดีบุก เมื่อบริษัทเรือขุดแร่บุญสูงตั้งอยู่คนละฟากกับตลาดเก่า คลองตะกั่วป่ากว้างกว่า 40 เมตรทำให้คนงานและชาวบ้านต้องพายเรือข้ามไปมา และลำบากเป็นพิเศษเมื่อน้ำหลาก ฐานข้อมูลท้องถิ่นของมหาวิทยาลัยสงขลานครินทร์ระบุว่านายจุติ บุญสูง ผู้ประกอบการเหมือง จึงริเริ่มทำสะพานไม้ให้เดินและขี่จักรยานได้ก่อน</p><p>ต่อมาใน พ.ศ. 2511 มีการนำเหล็กจากเรือขุดแร่ที่เลิกใช้งานมาประกอบเป็นสะพานเหล็กโคกขนุน ยาวกว่า 200 เมตร ข้ามแม่น้ำตะกั่วป่า สะพานจึงไม่ใช่เพียงโครงสร้างอุตสาหกรรม แต่เป็นทางลัดของแรงงาน ทางขนสินค้า และทางเชื่อมชีวิตประจำวันระหว่างตลาดเก่ากับพื้นที่เหมืองของเมืองที่ขับเคลื่อนด้วยแร่ดีบุก หลักฐานที่ตรวจสอบได้ยืนยันบทบาทเหมืองและการสัญจร แต่ยังไม่พบเอกสารร่วมสมัยที่อธิบายรายละเอียดเรื่องการค้าทางทะเล คนจีนฮกเกี้ยน หรือระบบเจ้าเมืองให้โยงตรงกับสะพานแห่งนี้</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">ฐานข้อมูลท้องถิ่นภาคใต้ มหาวิทยาลัยสงขลานครินทร์</a> · <a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม</a></div></article><article class="era-card" data-era="before"><span class="chapter">ก่อนหน้า</span><h3>เมื่อเหมืองเงียบ สะพานกลายเป็นร่องรอยเมืองแร่</h3><p class="era-years">หลัง พ.ศ. 2511-ก่อน พ.ศ. 2569 / ค.ศ. 1968-2026</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>เมื่อกิจการเหมืองแร่ยุติลง สะพานไม่ได้หายไปพร้อมโรงขุดแร่ แต่เปลี่ยนบทบาทจากโครงสร้างเพื่อการทำงานเป็นทางสัญจรของชุมชนและหลักฐานภูมิทัศน์อุตสาหกรรม แหล่งข้อมูลของ ONEP ระบุว่ายังมองเห็นโรงขุดแร่เก่าที่คงสภาพเดิมได้จากบริเวณสะพาน ขณะที่แหล่งท่องเที่ยวร่วมสมัยเรียกสะพานนี้ว่าเป็นสัญลักษณ์ของอดีตเมืองแร่ตะกั่วป่า</p><p>ในช่วงต่อมา สะพานถูกเล่าและนำเสนอเป็นจุดท่องเที่ยวและจุดถ่ายภาพ รวมถึงปรากฏเป็นโลเคชันในภาพยนตร์ Wonderful Town (2007) ตามบทความติดตามสถานที่ถ่ายทำ อย่างไรก็ตาม การตรวจสอบครั้งนี้ยังไม่พบหลักฐานยืนยันปีที่เหมืองปิด ปีที่มีการซ่อมบูรณะครั้งใหญ่ ผลกระทบโดยตรงจากสึนามิ พ.ศ. 2547 หรือการขึ้นทะเบียนเป็นโบราณสถานของกรมศิลปากร จึงไม่ควรเติมเหตุการณ์เหล่านี้เป็นข้อเท็จจริง</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม</a> · <a href="https://th.readme.me/p/40233" target="_blank" rel="noopener">ตามรอย Location ภาพยนตร์ Wonderful Town</a> · <a href="https://www.takuapacity.go.th/travel" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า: แหล่งท่องเที่ยว</a></div></article><article class="era-card" data-era="now"><span class="chapter">ตอนนี้</span><h3>มรดกเหมืองที่ยังเป็นทางผ่านและจุดหมาย</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ปัจจุบันสะพานเหล็กบุญสูงยังทำหน้าที่เป็นทางสัญจรของชุมชน โดยมีข้อมูลภาคสนามและรีวิวระบุว่าชาวบ้านใช้เดินทางและรถจักรยานยนต์ผ่าน ขณะเดียวกันเทศบาลเมืองตะกั่วป่าจัดไว้ในหมวดแหล่งท่องเที่ยว และแหล่งท่องเที่ยวของ ททท. มีภาพปัจจุบันของสถานที่นี้ สะพานจึงอยู่กึ่งกลางระหว่างโครงสร้างใช้งานจริงกับแลนด์มาร์กที่คนมาเดินชมวิวและถ่ายภาพ</p><p>หลักฐานล่าสุดที่พบคือข่าว NBT วันที่ 30 มกราคม 2569 ซึ่งพาไปรู้จักสะพานในฐานะมรดกเหมืองแร่คู่เมืองตะกั่วป่า และระบุว่าช่วงนั้นมีการปิดชั่วคราวเพื่อรองรับการถ่ายทำภาพยนตร์ต่างชาติ นอกจากนี้เอกสารงบประมาณเทศบาลที่ค้นพบมีรายการเกี่ยวกับการบำรุงรักษาและปรับปรุงบริเวณทางเข้าสะพาน แต่ยังไม่พบเอกสารยืนยันโครงการบูรณะตัวโครงสร้างโดยตรง ตารางเวลาเปิด-ปิด ค่าเข้าชม ผู้ดูแลเฉพาะกิจกรรม และสภาพความปลอดภัยล่าสุดจึงยังต้องตรวจสอบหน้างาน</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://www.takuapacity.go.th/travel" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า: แหล่งท่องเที่ยว</a> · <a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">NBT2HD, ข่าวเช้า 30 มกราคม 2569</a> · <a href="https://www.takuapacity.go.th/files/com_news_form/2020-07_bc4d766e789d542.pdf" target="_blank" rel="noopener">เทศบัญญัติงบประมาณเทศบาลเมืองตะกั่วป่า</a></div></article></div></section><section class="research-section" id="timeline"><h2>เส้นเวลาแบบจุด</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2503</p><h3>จุติ บุญสูงเข้ามารับช่วงกิจการเหมือง</h3><p>ฐานข้อมูลท้องถิ่นระบุว่านายจุติ บุญสูงซื้อกิจการบริษัทเรือขุดแร่ตะกั่วป่าวาเลย์ และพบปัญหาการเดินทางของคนงานกับชาวบ้านระหว่างตลาดเก่ากับพื้นที่บริษัท</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2511</p><h3>สร้างสะพานเหล็กโคกขนุน</h3><p>นำเหล็กจากเรือขุดแร่ที่เลิกใช้งานมาสร้างสะพานยาวกว่า 200 เมตรข้ามแม่น้ำตะกั่วป่า เพื่อเชื่อมเมืองกับพื้นที่เหมืองและโรงงาน</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status unverified">ยังไม่ยืนยัน</span><p class="era-years">พ.ศ. 2550</p><h3>ปรากฏเป็นโลเคชันภาพยนตร์ Wonderful Town</h3><p>บทความติดตามสถานที่ถ่ายทำระบุว่าสะพานเป็นหนึ่งในฉากของภาพยนตร์ไทยเรื่อง Wonderful Town แต่หลักฐานนี้เป็นบทความผู้ชม ไม่ใช่เอกสารการผลิตภาพยนตร์</p><a href="https://th.readme.me/p/40233" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2563</p><h3>เทศบาลบรรจุพื้นที่ทางเข้าสะพานในเอกสารงบประมาณ</h3><p>เอกสารงบประมาณเทศบาลที่ค้นพบมีรายการบำรุงรักษาและปรับปรุงที่ดินและสิ่งก่อสร้างบริเวณทางเข้าสะพานเหล็กบุญสูง ยังไม่ใช่หลักฐานว่ามีการบูรณะตัวสะพาน</p><a href="https://www.takuapacity.go.th/files/com_news_form/2020-07_bc4d766e789d542.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">30 มกราคม 2569</p><h3>NBT รายงานสะพานในฐานะมรดกเหมืองแร่</h3><p>NBT รายงานว่าสะพานเป็นแลนด์มาร์กประวัติศาสตร์ และมีการปิดชั่วคราวในสัปดาห์นั้นเพื่อรองรับการถ่ายทำภาพยนตร์ต่างชาติ</p><a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">ไม่ระบุปี</p><h3>สะพานไม้เกิดขึ้นก่อน</h3><p>มีการทำสะพานไม้เพื่อให้คนงานเดินและขี่จักรยานข้ามคลอง รวมทั้งให้ชาวบ้านใช้ขนสินค้า แต่แหล่งที่ตรวจสอบไม่ระบุปีแน่ชัด</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li></ol></section><p class="missing-photo">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่</p><section class="research-section" id="highlights"><h2>จุดเด่นที่ควรดู</h2><div class="research-cards"><article class="research-note"><h3>โครงสร้างเหล็กยาวประมาณ 200 เมตร</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>สะพานทอดข้ามแม่น้ำตะกั่วป่าและเชื่อมพื้นที่ถนนหลักกับบริเวณโรงขุดแร่เก่า</p><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ร่องรอยอุตสาหกรรมเหมืองแร่</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ใช้เหล็กจากเรือขุดแร่ที่ไม่ใช้งานแล้ว และปลายทางยังมองเห็นโรงขุดแร่เก่า</p><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>วิวทุ่งและแนวเขา</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>จากสะพานเห็นทุ่งสีเขียว ต้นไม้ และทิวเขา เหมาะกับการชมวิวและถ่ายภาพ</p><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ทางสัญจรของชุมชน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>สะพานยังเป็นเส้นทางที่ชาวบ้านใช้สัญจร จึงควรระวังยานพาหนะขณะเดินชม</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="news"><h2>ข่าวและความเคลื่อนไหว</h2><div class="research-cards"><article class="research-note"><p class="muted">2026-01-30 · NBT2HD</p><h3>ชวนเช็กอิน สะพานเหล็กบุญสูง มรดกเหมืองแร่ เมืองตะกั่วป่า</h3><p>NBT นำเสนอสะพานในฐานะแหล่งมรดกเหมืองแร่และแลนด์มาร์กประวัติศาสตร์ พร้อมระบุการปิดชั่วคราวเพื่อถ่ายทำภาพยนตร์ต่างชาติ</p><a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>รู้หรือไม่</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>โครงสะพานเหล็กสร้างจากเหล็กของเรือขุดแร่ที่เลิกใช้งานแล้ว ไม่ใช่เหล็กใหม่ที่ผลิตเพื่อสะพานโดยเฉพาะ</p><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ก่อนมีสะพานเหล็ก คนงานและชาวบ้านต้องใช้เรือแจวข้ามคลอง และเคยมีสะพานไม้สำหรับเดินกับขี่จักรยาน</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status unverified">ยังไม่ยืนยัน</span><p>สะพานปรากฏในบทความตามรอยโลเคชันภาพยนตร์ Wonderful Town (2007)</p><a href="https://th.readme.me/p/40233" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>วิธีเดินทาง</h2><div class="research-cards"><article class="research-note"><h3>ตัวเมืองตะกั่วป่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>เดินทางตามถนนราษฎร์บำรุงไปทางเมืองเก่าตะกั่วป่า สะพานอยู่ด้านซ้ายมือ ห่างจากตัวเมืองประมาณ 2 กิโลเมตร</p><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="nearby"><h2>ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</h2><ul class="nearby-links"><li><a href="/places/governor-wall/">กำแพงจวนเจ้าเมืองตะกั่วป่า</a></li><li><a href="/places/khun-in/">บ้านขุนอินทร์</a></li><li><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a></li></ul></section><section class="research-section" id="faq"><h2>คำถามที่พบบ่อย</h2><details><summary>เปิดให้เข้าชมเวลาใด</summary><p>ข้อมูลยังไม่ยืนยัน · เข้าชมได้ตลอดทั้งวัน (ข้อมูลจากแหล่งท่องเที่ยวรอง)</p></details><details><summary>มีที่จอดรถไหม</summary><p>มีข้อมูลจากรีวิวว่าจอดริมถนนได้และมีพื้นที่จำกัด แต่ไม่มีข้อมูลทางการยืนยัน</p></details><details><summary>เดินทางจากตัวเมืองตะกั่วป่าอย่างไร</summary><p>เดินทางตามถนนราษฎร์บำรุงไปทางเมืองเก่าตะกั่วป่า สะพานอยู่ด้านซ้ายมือ ห่างจากตัวเมืองประมาณ 2 กิโลเมตร</p></details><details><summary>สถานที่นี้มีประวัติความเป็นมาอย่างไร</summary><p>พ.ศ. 2511 มีการนำเหล็กจากเรือขุดแร่มาสร้างสะพานเหล็กโคกขนุน ความยาวกว่า 200 เมตร ข้ามแม่น้ำตะกั่วป่า ผู้ริเริ่มคือ นายจุติ บุญสูง เจ้าของกิจการบริษัทเรือขุดแร่จุติบุญสูง จำกัด ซึ่งก่อตั้งบริษัทใน พ.ศ. 2503</p></details><details><summary>มีจุดเด่นอะไรให้ชม</summary><p>สะพานทอดข้ามแม่น้ำตะกั่วป่าและเชื่อมพื้นที่ถนนหลักกับบริเวณโรงขุดแร่เก่า ใช้เหล็กจากเรือขุดแร่ที่ไม่ใช้งานแล้ว และปลายทางยังมองเห็นโรงขุดแร่เก่า จากสะพานเห็นทุ่งสีเขียว ต้นไม้ และทิวเขา เหมาะกับการชมวิวและถ่ายภาพ</p></details></section><section class="research-section" id="sources"><h2>ที่มาของข้อมูล</h2><div class="source-table"><table><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>วันที่เข้าถึง</th><th>ลิงก์</th></tr></thead><tbody><tr><th scope="row">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม: สะพานเหล็ก (โคกขนุน)</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ฐานข้อมูลท้องถิ่นภาคใต้ มหาวิทยาลัยสงขลานครินทร์</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">TrueID Travel: สะพานเหล็กบุญสูง</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">TAT Media Assets: Boon Soong Iron Bridge</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://tatmediaassets.com/file/1098453" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า: แหล่งท่องเที่ยว</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/travel" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">Wongnai: พานเหล็กบุญสูง</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://www.wongnai.com/attractions/583288JQ-%E0%B8%9E%E0%B8%B2%E0%B8%99%E0%B9%80%E0%B8%AB%E0%B8%A5%E0%B9%87%E0%B8%81-%E0%B8%9A%E0%B8%B8%E0%B8%8D%E0%B8%AA%E0%B8%B9%E0%B8%87" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">เทศบัญญัติงบประมาณเทศบาลเมืองตะกั่วป่า</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_form/2020-07_bc4d766e789d542.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">NBT2HD ข่าวเช้า</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">TAT Media Assets: ภาพไฟล์ 1594919</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://tatmediaassets.com/file/1594919" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">TAT Media Assets: ภาพไฟล์ 1098453</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://tatmediaassets.com/file/1098453" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ตามรอย Location ภาพยนตร์ Wonderful Town</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://th.readme.me/p/40233" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ไม่พบเบอร์โทรศัพท์ เพจเฟซบุ๊ก เว็บไซต์ หรือ LINE ทางการของสถานที่</li><li>ไม่พบค่าเข้าชมจากแหล่งที่ตรวจสอบ</li><li>ไม่พบข้อมูลทางการเรื่องห้องน้ำ ที่จอดรถ และการรองรับรถเข็น</li><li>ไม่พบข้อมูลระยะทางหรือเส้นทางที่ตรวจสอบได้จากภูเก็ต เขาหลัก หรือสนามบิน</li><li>ไม่พบข้อมูลเทศกาลที่จัดขึ้นเฉพาะที่สะพาน</li><li>ไม่พบหลักฐานยืนยันปีและผู้ออกแบบสะพานไม้/สะพานเหล็กนอกเหนือจากข้อมูล พ.ศ. 2511 และนายจุติ บุญสูง</li><li>ยังไม่พบหลักฐานการขึ้นทะเบียนโบราณสถานโดยกรมศิลปากร</li><li>ไม่พบหลักฐานว่าสะพานมีสถาปัตยกรรมชิโน-โปรตุกีสหรือจีน จึงไม่สรุปว่าเป็นเช่นนั้น</li><li>ไม่มีสถานที่ใกล้เคียงที่ยืนยันระยะเดินได้จากแหล่งที่เปิดอ่าน</li><li>ไม่พบหลักฐานที่ยืนยันปีเหมืองปิดหรือการเปลี่ยนมือหลังยุคบริษัทเรือขุดแร่</li><li>ไม่พบหลักฐานยืนยันปีและรายละเอียดการบูรณะตัวสะพาน</li><li>ไม่พบหลักฐานยืนยันผลกระทบโดยตรงจากสึนามิ พ.ศ. 2547</li><li>ไม่พบหลักฐานการขึ้นทะเบียนเป็นโบราณสถานโดยกรมศิลปากร</li><li>ไม่พบชื่อหน่วยงานหรือบุคคลที่รับผิดชอบดูแลตัวสะพานโดยตรงในปี 2569</li><li>ไม่พบประกาศเวลาเปิด-ปิด ค่าเข้าชม ห้องน้ำ ที่จอดรถ หรือมาตรฐานความปลอดภัยล่าสุด</li><li>ไม่พบภาพถ่ายประวัติศาสตร์ที่มี URL สาธารณะและระบุแหล่งที่มาได้ชัดเจน</li><li>ภาพจาก ททท. มีหน้ารายการไฟล์ แต่ไม่ทราบสิทธิ์การใช้งาน ต้องขออนุญาตก่อนใช้</li><li>ไม่พบข่าวย้อนหลัง 5 ปีเพิ่มเติมที่ยืนยันโครงการบูรณะ งานประเพณี หรือรางวัลเฉพาะสะพาน</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
data\i18n\en\missing-parts\miss-dc14f4aa94.log:214:.\site\places\governor-wall\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api="https://takuapa101-news.siwatid-99.workers.dev"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>กำแพงจวนเจ้าเมืองตะกั่วป่า · ตะกั่วป่า 101</title><meta name="description" content="ร่องรอยบนกำแพงที่เล่าเรื่องเมือง · กำแพงจวนเก่าเชื่อมกับประวัติการปกครองและความขัดแย้งในอดีตของตะกั่วป่า"><meta name="robots" content="noindex,follow"><meta property="og:title" content="กำแพงจวนเจ้าเมืองตะกั่วป่า"><meta property="og:description" content="ร่องรอยบนกำแพงที่เล่าเรื่องเมือง · กำแพงจวนเก่าเชื่อมกับประวัติการปกครองและความขัดแย้งในอดีตของตะกั่วป่า"><meta property="og:url" content="https://takuapa101.pages.dev/places/governor-wall/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.pages.dev/assets/og/governor-wall.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.pages.dev/assets/og/governor-wall.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.pages.dev/places/governor-wall/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.pages.dev/"}, {"@type": "ListItem", "position": 2, "name": "กำแพงจวนเจ้าเมืองตะกั่วป่า", "item": "https://takuapa101.pages.dev/places/governor-wall/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "กำแพงจวนเจ้าเมืองตะกั่วป่า", "url": "https://takuapa101.pages.dev/places/governor-wall/", "image": "https://takuapa101.pages.dev/assets/governor-wall.webp", "description": "กำแพงเก่าเชื่อมกับประวัติการปกครองและความขัดแย้งในอดีต", "address": {"@type": "PostalAddress", "streetAddress": "ถนนอุดมธารา", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.830904, "longitude": 98.366634}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "มีค่าเข้าชมหรือไม่", "acceptedAnswer": {"@type": "Answer", "text": "ไม่เสียค่าเข้าชม"}}, {"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "จากที่ทำการเทศบาลเมืองตะกั่วป่า ใช้ถนนราษฎร์บำรุง เลี้ยวขวาเข้าถนนมนตรี 2 แล้วเลี้ยวซ้ายเข้าถนนศรีตะกั่วป่า ตรงประมาณ 260 เมตร พบโบราณสถานอยู่ทางซ้ายมือ"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "แหล่งนี้มีอายุทางโบราณคดีอยู่ในช่วง พ.ศ. 2383·2424 (ค.ศ. 1840·1881) สันนิษฐานว่าสร้างในสมัยพระยาเสนานุชิต (นุช ณ นคร) เจ้าเมืองตะกั่วป่า เพื่อเป็นกำแพงล้อมรอบจวนและป้องกันศัตรู"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "ชมกำแพงส่วนที่ยังสมบูรณ์ สูงประมาณ 5 เมตร และส่วนที่ชำรุดตามกาลเวลา สังเกตการแบ่งพื้นที่เป็นวังหน้า ห้องโถง และวังหลัง พร้อมช่องประตูเชื่อม เห็นชั้นวัสดุปูนผสมกรวดทรายและฐานกำแพงที่กว้างกว่าตัวกำแพง"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><script src="/assets/trip.js" defer></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.pages.dev/places/governor-wall/"><link rel="alternate" hreflang="en" href="https://takuapa101.pages.dev/en/places/governor-wall/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.pages.dev/places/governor-wall/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><a href="/places/" aria-current="page">สถานที่</a><a href="/news/">ความเคลื่อนไหว</a><a href="/map/">แผนที่</a><a href="/traditions/">ประเพณี</a><a href="/eat/">กินและของฝาก</a><a href="/rest/">กินเที่ยว</a><a href="/routes/">เส้นทางเดิน</a><a href="/trip/">ทริปของคุณ</a><a href="/about/">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/places/governor-wall/" hreflang="en" lang="en">EN</a><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/">หน้าแรก</a> / <a href="/places/">สถานที่</a> / ตึกเก่าและร่องรอยเมือง</div><header class="place-hero full-place-hero"><div><span class="chapter">บันทึกสถานที่ · ตึกเก่าและร่องรอยเมือง</span><h1>กำแพงจวนเจ้าเมืองตะกั่วป่า</h1><p class="english">Governor’s Residence Wall</p><span class="fact-status confirmed">ยืนยันแล้ว 15 ข้อ</span><p><a class="text-link" href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้ ↓</a></p></div><div class="place-hero-art"><img src="/assets/governor-wall.webp" alt="กำแพงจวนเจ้าเมืองตะกั่วป่า" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>ข้อมูลใช้จริง</h2><dl><div><dt>พิกัด</dt><dd>8.830904, 98.366634 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.830904,98.366634" target="_blank" rel="noopener">นำทางด้วย Google Maps ↗</a><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">แหล่งพิกัด ↗</a></div><div><dt>เวลาเปิด</dt><dd>เข้าชมได้ทุกวัน (ไม่ระบุเวลา) <span class="fact-status confirmed">ยืนยันแล้ว</span></dd></div><div><dt>ค่าเข้า</dt><dd>ไม่เสียค่าเข้าชม <span class="fact-status confirmed">ยืนยันแล้ว</span></dd></div><div><dt>ที่จอดรถ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ห้องน้ำ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>รถเข็น</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>การแต่งกาย</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>โทรศัพท์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เพจ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เว็บไซต์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ไลน์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">ในบันทึกหน้านี้</span><a href="#visit">ข้อมูลใช้จริง</a><a href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้</a><a href="#timeline">เส้นเวลาแบบจุด</a><a href="#highlights">จุดเด่นที่ควรดู</a><a href="#news">ข่าวและความเคลื่อนไหว</a><a href="#did_you_know">รู้หรือไม่</a><a href="#getting_there">วิธีเดินทาง</a><a href="#nearby">ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</a><a href="#faq">คำถามที่พบบ่อย</a><a href="#sources">ที่มาของข้อมูล</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>ตอนนั้น · ก่อนหน้า · ตอนนี้</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">ตอนนั้น</span><h3>กำแพงค่ายของจวนเจ้าเมือง ในเมืองเหมืองดีบุกริมเส้นทางทะเล</h3><p class="era-years">พ.ศ. 2383·2424 (ค.ศ. 1840·1881)</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>กำแพงจวนเจ้าเมืองตะกั่วป่าน่าจะสร้างขึ้นในสมัยพระยาเสนานุชิต (นุช ณ นคร) เจ้าเมืองตะกั่วป่า ช่วง พ.ศ. 2383·2424 แต่แหล่งวิชาการยังไม่ระบุปีเริ่มก่อสร้างที่แน่นอน ตัวกำแพงล้อมจวนที่พักและพื้นที่ราชการ ทำหน้าที่คล้ายกำแพงค่ายสำหรับป้องกันอันตรายและเป็นที่หลบภัยของชาวเมือง</p><p>นี่คือช่วงที่ตะกั่วป่าเติบโตจากเศรษฐกิจเหมืองแร่ดีบุกและการค้าชายฝั่ง เมืองเก่าตั้งอยู่ริมแม่น้ำตะกั่วป่า ซึ่งเชื่อมกับทะเลอันดามันและเครือข่ายการค้าหลายชาติ ชุมชนจีนที่เข้ามาทำเหมืองและค้าขายมีบทบาทสำคัญ แต่ความขัดแย้งเรื่องผลประโยชน์เหมืองแร่ทำให้ต้องมีพื้นที่คุ้มกันที่มั่นคง กำแพงจึงเป็นทั้งบ้านของผู้ปกครองและเครื่องมือรักษาความสงบของเมือง</p><p>ผังภายในแบ่งเป็นวังหน้า ห้องโถง และวังหลัง มีประตูเชื่อมกัน ก่อด้วยปูนผสมกรวดทรายวางซ้อนเป็นชั้นและทำฐานกว้างกว่าตัวกำแพง ส่วนที่ยังสมบูรณ์สูงราว 5 เมตร หลักฐานจากการขุดค้นภายหลังพบเครื่องถ้วยจีนสมัยราชวงศ์ชิง เครื่องถ้วยยุโรป และวัสดุร่วมสมัย สะท้อนการติดต่อค้าขายของเมืองในยุคนั้น</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">ฐานข้อมูลแหล่งโบราณคดีที่สำคัญในประเทศไทย (ศมส.)</a> · <a href="https://culturalenvi.onep.go.th/site/detail/4428" target="_blank" rel="noopener">สำนักงานสิ่งแวดล้อมศิลปกรรม ONEP: แหล่งศิลปกรรมเมืองตะกั่วป่า</a></div></article><article class="era-card" data-era="before"><span class="chapter">ก่อนหน้า</span><h3>จากจวนที่เคยมีคนอยู่ สู่โบราณสถานที่เมืองเก่าช่วยกันรักษา</h3><p class="era-years">พ.ศ. 2424·2568 (ค.ศ. 1881·2025)</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>หลังพระยาเสนานุชิต (นุช) พ้นตำแหน่ง กำแพงและจวนยังใช้งานต่อในสมัยพระยาเสนานุชิต (เอี่ยม ณ นคร) ระหว่าง พ.ศ. 2424·2435 พระบาทสมเด็จพระจุลจอมเกล้าเจ้าอยู่หัวเสด็จตะกั่วป่าและทอดพระเนตรจวนแห่งนี้เมื่อ 28 พฤษภาคม ร.ศ. 109 หรือ พ.ศ. 2433</p><p>ต่อมาเมื่อมีการย้ายที่ตั้งเมืองไปเกาะคอเขาและบ้านย่านยาวในสมัยพระนราเทพภักดี (สิทธิ์ ณ นคร) จวนเดิมจึงหมดบทบาทราชการและน่าจะถูกทิ้งร้างตั้งแต่ช่วงนั้น แหล่งข้อมูลที่ตรวจสอบได้ไม่พบหลักฐานยืนยันว่ากำแพงถูกใช้เป็นกิจการอื่น หรือได้รับความเสียหายโดยตรงจากสึนามิ พ.ศ. 2547</p><p>กรมศิลปากรขึ้นทะเบียนเป็นโบราณสถานและกำหนดเขตที่ดินในราชกิจจานุเบกษา เล่ม 113 ตอนพิเศษ 50 ง วันที่ 18 ธันวาคม พ.ศ. 2539 ต่อมาขุดแต่งและขุดค้นใน พ.ศ. 2542 ก่อนมีการบูรณปฏิสังขรณ์และปรับภูมิทัศน์ในระยะหลัง แหล่งปัจจุบันระบุว่ากำแพงมั่นคงขึ้น แต่ยังมีวัชพืชและรากไม้บางจุดที่ต้องดูแล</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">ฐานข้อมูลแหล่งโบราณคดีที่สำคัญในประเทศไทย (ศมส.)</a></div></article><article class="era-card" data-era="now"><span class="chapter">ตอนนี้</span><h3>โบราณสถานมีชีวิต: กำแพงเก่ากลายเป็นเวทีของเมืองตะกั่วป่า</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ปัจจุบันกำแพงจวนเจ้าเมืองตะกั่วป่าเป็นโบราณสถานที่ยังเปิดให้เข้าชมทุกวันโดยไม่เสียค่าเข้าชม ฐานข้อมูลแหล่งโบราณคดีระบุหน่วยงานดูแลร่วม ได้แก่ กรมศิลปากร เทศบาลเมืองตะกั่วป่า และตระกูล ณ นคร ภายในมีสนามหญ้าและทางเดินบางส่วน พร้อมป้ายข้อมูลของกรมศิลปากรและการท่องเที่ยวแห่งประเทศไทย</p><p>พื้นที่ไม่ได้ทำหน้าที่เป็นที่พักของเจ้าเมืองแล้ว แต่ยังทำหน้าที่เป็นหมุดหมายของย่านเมืองเก่าและพื้นที่ประกอบพิธี/กิจกรรมชุมชน ในช่วง พ.ศ. 2569 จังหวัดพังงาและเทศบาลเมืองตะกั่วป่าจัดงาน “จากตะโกลา สู่ตะกั่วป่า ครั้งที่ 12” ที่จวนฯ ระหว่าง 28 กุมภาพันธ์·3 มีนาคม มีการแสดง โขน โนรา หนังตะลุง พิธีบวงสรวงและเจริญพระพุทธมนต์ รวมถึงจำหน่ายอาหารพื้นบ้านและสินค้า OTOP</p><p>การใช้พื้นที่ร่วมสมัยจึงเป็นการท่องเที่ยวเชิงมรดกและการเรียนรู้วิถีคนตะกั่วป่า ขณะเดียวกันสภาพกำแพงบางช่วงยังชำรุดและมีพืชยึดเกาะ แหล่งทางการที่ตรวจสอบได้ยังไม่ประกาศโครงการบูรณะระยะใหม่หรือรายละเอียดงบประมาณเฉพาะสำหรับ พ.ศ. 2569</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">ฐานข้อมูลแหล่งโบราณคดีที่สำคัญในประเทศไทย (ศมส.)</a> · <a href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">สถานีวิทยุกระจายเสียงแห่งประเทศไทย: งานจากตะโกลา สู่ตะกั่วป่า ครั้งที่ 12</a></div></article></div></section><section class="research-section" id="timeline"><h2>เส้นเวลาแบบจุด</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2383</p><h3>เริ่มช่วงสมัยพระยาเสนานุชิต (นุช)</h3><p>สันนิษฐานว่าเริ่มสร้างกำแพงล้อมจวนที่พักและพื้นที่ราชการ เพื่อป้องกันศัตรูและความวุ่นวายจากความขัดแย้งเรื่องเหมืองดีบุก</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2424</p><h3>จวนยังใช้งานต่อในสมัยเจ้าเมืองคนถัดมา</h3><p>พระยาเสนานุชิต (เอี่ยม ณ นคร) เป็นเจ้าเมือง และการใช้พื้นที่จวนดำเนินต่อถึง พ.ศ. 2435 ตามหลักฐานเอกสารที่ฐานข้อมูลโบราณคดีสรุปไว้</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">28 พฤษภาคม ร.ศ. 109</p><h3>รัชกาลที่ 5 ทอดพระเนตรจวนเจ้าเมือง</h3><p>พระบาทสมเด็จพระจุลจอมเกล้าเจ้าอยู่หัวเสด็จตะกั่วป่าและทอดพระเนตรจวนเจ้าเมืองแห่งนี้</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2435</p><h3>หมดบทบาทเมื่อย้ายศูนย์กลางเมือง</h3><p>เมื่อย้ายที่ตั้งเมืองไปเกาะคอเขาและบ้านย่านยาว จวนเดิมไม่มีการใช้งานและคงถูกทิ้งร้างตั้งแต่ช่วงนี้</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">18 ธันวาคม 2539</p><h3>ขึ้นทะเบียนโบราณสถาน</h3><p>กรมศิลปากรประกาศขึ้นทะเบียนและกำหนดเขตที่ดินโบราณสถานในราชกิจจานุเบกษา</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2542</p><h3>ขุดแต่งและขุดค้นทางโบราณคดี</h3><p>พบเครื่องถ้วยจีนสมัยราชวงศ์ชิง เครื่องถ้วยยุโรป เศษภาชนะ เครื่องแก้ว และชิ้นส่วนประดับสถาปัตยกรรม</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">28 กุมภาพันธ์·3 มีนาคม 2569</p><h3>จวนฯ เป็นพื้นที่จัดงานเมืองเก่า</h3><p>จัดงานจากตะโกลา สู่ตะกั่วป่า ครั้งที่ 12 มีการแสดง พิธีกรรม และตลาดอาหารพื้นบ้าน/สินค้า OTOP</p><a href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li></ol></section><p class="missing-photo">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่</p><section class="research-section" id="highlights"><h2>จุดเด่นที่ควรดู</h2><div class="research-cards"><article class="research-note"><h3>แนวกำแพงโบราณ</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ชมกำแพงส่วนที่ยังสมบูรณ์ สูงประมาณ 5 เมตร และส่วนที่ชำรุดตามกาลเวลา</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ผัง 3 ส่วน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>สังเกตการแบ่งพื้นที่เป็นวังหน้า ห้องโถง และวังหลัง พร้อมช่องประตูเชื่อม</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>เทคนิคก่อสร้าง</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>เห็นชั้นวัสดุปูนผสมกรวดทรายและฐานกำแพงที่กว้างกว่าตัวกำแพง</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ป้ายข้อมูล</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ด้านหน้ามีป้ายข้อมูลประวัติจากกรมศิลปากรและการท่องเที่ยวแห่งประเทศไทย</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>บริบทเมืองเก่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>อยู่ริมถนนอุดมธารา ฝั่งตะวันตกของแม่น้ำตะกั่วป่า และใกล้วัดหน้าเมือง</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="news"><h2>ข่าวและความเคลื่อนไหว</h2><div class="research-cards"><article class="research-note"><p class="muted">2026-02-28 · สถานีวิทยุกระจายเสียงแห่งประเทศไทย</p><h3>จังหวัดพังงาจัดงาน จากตะโกลา สู่ตะกั่วป่า ครั้งที่ 12</h3><p>เทศบาลเมืองตะกั่วป่าจัดกิจกรรมส่งเสริมการท่องเที่ยวเมืองเก่าที่จวนเจ้าเมืองตะกั่วป่า ระหว่าง 28 กุมภาพันธ์·3 มีนาคม 2569</p><a href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>รู้หรือไม่</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>กำแพงมีผังสี่เหลี่ยมผืนผ้าและแบ่งพื้นที่ภายในเป็นวังหน้า ห้องโถง และวังหลัง</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>การขุดค้นพบทั้งเครื่องถ้วยจีนสมัยราชวงศ์ชิงและเครื่องถ้วยยุโรปในแหล่งเดียวกัน</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>วิธีเดินทาง</h2><div class="research-cards"><article class="research-note"><h3>ตัวเมืองตะกั่วป่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>จากที่ทำการเทศบาลเมืองตะกั่วป่า ใช้ถนนราษฎร์บำรุง เลี้ยวขวาเข้าถนนมนตรี 2 แล้วเลี้ยวซ้ายเข้าถนนศรีตะกั่วป่า ตรงประมาณ 260 เมตร พบโบราณสถานอยู่ทางซ้ายมือ</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ภูเก็ต</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ไม่พบเส้นทางและระยะทางเฉพาะจากภูเก็ตในแหล่งที่อ่านแล้ว</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>เขาหลัก</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ไม่พบเส้นทางและระยะทางเฉพาะจากเขาหลักในแหล่งที่อ่านแล้ว</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>สนามบิน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ไม่พบสนามบินต้นทางที่ระบุและระยะทางในแหล่งที่อ่านแล้ว</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="nearby"><h2>ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</h2><ul class="nearby-links"><li>วัดหน้าเมือง <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li>ตลาดเก่าตะกั่วป่า <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li>ตึกขุนอินทร์ <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><a href="/places/iron-bridge/">สะพานเหล็กบุญสูง</a></li><li><a href="/places/khun-in/">บ้านขุนอินทร์</a></li><li><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a></li></ul></section><section class="research-section" id="faq"><h2>คำถามที่พบบ่อย</h2><details><summary>มีค่าเข้าชมหรือไม่</summary><p>ไม่เสียค่าเข้าชม</p></details><details><summary>เดินทางจากตัวเมืองตะกั่วป่าอย่างไร</summary><p>จากที่ทำการเทศบาลเมืองตะกั่วป่า ใช้ถนนราษฎร์บำรุง เลี้ยวขวาเข้าถนนมนตรี 2 แล้วเลี้ยวซ้ายเข้าถนนศรีตะกั่วป่า ตรงประมาณ 260 เมตร พบโบราณสถานอยู่ทางซ้ายมือ</p></details><details><summary>สถานที่นี้มีประวัติความเป็นมาอย่างไร</summary><p>แหล่งนี้มีอายุทางโบราณคดีอยู่ในช่วง พ.ศ. 2383·2424 (ค.ศ. 1840·1881) สันนิษฐานว่าสร้างในสมัยพระยาเสนานุชิต (นุช ณ นคร) เจ้าเมืองตะกั่วป่า เพื่อเป็นกำแพงล้อมรอบจวนและป้องกันศัตรู</p></details><details><summary>มีจุดเด่นอะไรให้ชม</summary><p>ชมกำแพงส่วนที่ยังสมบูรณ์ สูงประมาณ 5 เมตร และส่วนที่ชำรุดตามกาลเวลา สังเกตการแบ่งพื้นที่เป็นวังหน้า ห้องโถง และวังหลัง พร้อมช่องประตูเชื่อม เห็นชั้นวัสดุปูนผสมกรวดทรายและฐานกำแพงที่กว้างกว่าตัวกำแพง</p></details></section><section class="research-section" id="sources"><h2>ที่มาของข้อมูล</h2><div class="source-table"><table><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>วันที่เข้าถึง</th><th>ลิงก์</th></tr></thead><tbody><tr><th scope="row">ฐานข้อมูลแหล่งโบราณคดีที่สำคัญในประเทศไทย: กำแพงจวนเจ้าเมืองตะกั่วป่า</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">เมืองตะกั่วป่า · ศูนย์ข้อมูลชุมชน ศมส.</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://wikicommunity.sac.or.th/community/1549" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">แหล่งศิลปกรรมอันควรอนุรักษ์: ตะกั่วป่า</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4428" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ฐานข้อมูลแหล่งโบราณคดีที่สำคัญในประเทศไทย (ศูนย์มานุษยวิทยาสิรินธร)</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สำนักงานสิ่งแวดล้อมศิลปกรรม ONEP: แหล่งศิลปกรรมเมืองตะกั่วป่า</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4428" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สถานีวิทยุกระจายเสียงแห่งประเทศไทย</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">Wongnai: รูปกำแพงเมืองเก่าตะกั่วป่า</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://www.wongnai.com/attractions/403843FU-%E0%B8%81%E0%B8%B3%E0%B9%81%E0%B8%9E%E0%B8%87%E0%B9%80%E0%B8%A1%E0%B8%B7%E0%B8%AD%E0%B8%87%E0%B9%80%E0%B8%81%E0%B9%88%E0%B8%B2%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2/photos/b51c676106884f98a0c8334b8584b456" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ไม่พบรหัสไปรษณีย์ที่ระบุเฉพาะสถานที่จากแหล่งที่อ่านแล้ว</li><li>ไม่พบเวลาเปิด·ปิดที่แน่นอน แหล่งทางการระบุเพียงเข้าชมได้ทุกวัน</li><li>ไม่พบเบอร์โทรศัพท์ เพจเฟซบุ๊ก เว็บไซต์ หรือ LINE ของสถานที่โดยตรง</li><li>ไม่พบค่าใช้จ่ายด้านที่จอดรถ ห้องน้ำ และข้อมูลการเข้าถึงสำหรับผู้สูงอายุ/รถเข็น</li><li>ไม่พบข้อมูลยืนยันว่าเป็นสถาปัตยกรรมชิโน-โปรตุกีสโดยตรงของกำแพง</li><li>ไม่พบระยะทาง/เวลาเดินทางจากภูเก็ต เขาหลัก หรือสนามบิน</li><li>ไม่พบภาพที่สามารถยืนยันสิทธิ์การใช้งานได้ จึงไม่ใส่ลิงก์รูปภาพ</li><li>ไม่พบหลักฐานที่ยืนยันปีเริ่มก่อสร้างแบบปีเดียว นอกจากกรอบ พ.ศ. 2383·2424</li><li>ไม่พบหลักฐานยืนยันว่ากำแพงได้รับผลกระทบโดยตรงจากสึนามิ พ.ศ. 2547</li><li>ไม่พบรายละเอียดโครงการบูรณะหรืองบประมาณเฉพาะสำหรับ พ.ศ. 2569</li><li>ไม่พบภาพเก่าที่ตรวจสอบแหล่งที่มาและสิทธิ์การใช้งานได้ จึงเว้น photos_archive ว่าง</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
