s/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/rest/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/rest/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/rest/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/" aria-current="page">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/rest/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="intro"><a class="eyebrow" href="/">ตะกั่วป่า 101 / คู่มือเมืองเก่า</a><h1>พักเบรกและกินเที่ยวตะกั่วป่า</h1><p class="lead">ร้านและจุดแวะที่คนทำคู่มือเล่มนี้ไปมาเองแล้ว พร้อมเวลาเปิดและพิกัดนำทาง</p></div><p>เมืองเก่าเดินได้ทั้งย่านแต่ร่มน้อย ช่วงบ่ายแดดแรง การมีจุดแวะช่วยให้เดินได้ครบ</p><p class="small">รายการข้างล่างคัดมาจาก<a href="https://siwaracafe.com/guide" target="_blank" rel="noopener">คู่มือกินเที่ยวตะกั่วป่าของศิวรา คาเฟ่</a> ซึ่งเป็นคนจัดทำเว็บนี้ · ต่างจากรายชื่อร้านใน<a href="/eat/">หน้ากินและของฝาก</a> ตรงที่ทุกร้านตรงนี้มีคนไปมาเองแล้ว จึงมีเวลาเปิดและพิกัดที่ใช้ได้จริง · ถึงอย่างนั้นร้านเล็กเปลี่ยนเวลาได้เสมอ ควรโทรถามก่อนเดินทางไกล</p><h2>ร้านอาหารและของกิน</h2><div class="rest-stops"><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=Baan%20Lapp%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener"><img src="/assets/guide/guide-baan-lapp.jpg" alt="BAAN LAPP บ้านลัพพ์ (โฮมมี่ &amp; สเต๊ก ตะกั่วป่า)" loading="lazy"></a><div class="pick-body"><h3>BAAN LAPP บ้านลัพพ์ (โฮมมี่ &amp; สเต๊ก ตะกั่วป่า)</h3><p>ร้านอาหาร &amp; คาเฟ่บรรยากาศโฮมมี่สุดอบอุ่นสไตล์ Hidden Gem เสิร์ฟเมนูสเต๊ก พาสต้า และอาหารฟิวชั่นรสมือประณีต</p><p class="pick-meta">เวลาเปิด 11:00 ถึง 21:00 น. (หยุดวันพุธ) · ~2.2 กม. จากศิวรา</p><p class="pick-tip">ช่วงเย็น 17:30 เป็นต้นไปเปิดไฟบรรยากาศดีมาก เหมาะกับการมาทานมื้อค่ำกับครอบครัว</p><a class="shop-nav" href="https://maps.google.com/?q=Baan%20Lapp%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B8%AB%E0%B8%A1%E0%B8%B9%E0%B8%AA%E0%B8%B0%E0%B9%80%E0%B8%95%E0%B9%8A%E0%B8%B0%E0%B8%84%E0%B8%A3%E0%B8%B9%E0%B9%81%E0%B8%AD%E0%B9%8B%E0%B8%A7" target="_blank" rel="noopener"><img src="/assets/guide/guide-moo-satay-kruaew.jpg" alt="ขนมจีนหมูสะเต๊ะครูแอ๋ว (ทุ่งพระโพธิ์)" loading="lazy"></a><div class="pick-body"><h3>ขนมจีนหมูสะเต๊ะครูแอ๋ว (ทุ่งพระโพธิ์)</h3><p>ร้านลับย่านทุ่งพระโพธิ์ หมูสะเต๊ะเตาถ่านเนื้อนุ่มชุ่มฉ่ำหมักเครื่องเทศเข้าเนื้อ ย่างร้อนๆ ทานคู่กับขนมจีนน้ำยาปักษ์ใต้รสจัดจ้าน</p><p class="pick-meta">เวลาเปิด 12:00 ถึง 18:00 น. (หยุดวันพฤหัสบดี) · ~2.4 กม. จากศิวรา</p><p class="pick-tip">หมูสะเต๊ะย่างสดใหม่ไม้ต่อไม้ แนะนำสั่งชุดใหญ่ 20-30 ไม้ ทานคู่กับขนมจีนเข้ากันสุดๆ</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B8%AB%E0%B8%A1%E0%B8%B9%E0%B8%AA%E0%B8%B0%E0%B9%80%E0%B8%95%E0%B9%8A%E0%B8%B0%E0%B8%84%E0%B8%A3%E0%B8%B9%E0%B9%81%E0%B8%AD%E0%B9%8B%E0%B8%A7" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B8%9A%E0%B8%B0%E0%B8%AB%E0%B8%A1%E0%B8%B5%E0%B9%88%E0%B8%95%E0%B8%A5%E0%B8%B2%E0%B8%94%E0%B8%82%E0%B8%A7%E0%B8%B2%E0%B8%87" target="_blank" rel="noopener"><img src="/assets/guide/guide-mee-talad-khwang.jpg" alt="บะหมี่พังงา ตลาดขวาง" loading="lazy"></a><div class="pick-body"><h3>บะหมี่พังงา ตลาดขวาง</h3><p>บะหมี่ไข่เส้นทำเองเหนียวนุ่มสูตรฮกเกี้ยนโบราณ คลุกเคล้าน้ำมันหอมเจียวและกากหมูกรอบชิ้นโต รสชาติกลมกล่อมนุ่มนวล</p><p class="pick-meta">เวลาเปิด 09:00 ถึง 15:30 น. (หยุดวันอังคาร) · ~0.6 กม. จากศิวรา</p><p class="pick-tip">แนะนำสั่ง &quot;บะหมี่แห้งต้มยำพิเศษกากหมู&quot; คลุกเคล้าให้เข้ากัน อร่อยฟินไม่ต้องปรุงเพิ่ม</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B8%9A%E0%B8%B0%E0%B8%AB%E0%B8%A1%E0%B8%B5%E0%B9%88%E0%B8%95%E0%B8%A5%E0%B8%B2%E0%B8%94%E0%B8%82%E0%B8%A7%E0%B8%B2%E0%B8%87" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B8%9B%E0%B9%89%E0%B8%B2%E0%B8%94%E0%B8%B2%E0%B8%AB%E0%B8%A1%E0%B8%B5%E0%B9%88%E0%B8%AE%E0%B8%81%E0%B9%80%E0%B8%81%E0%B8%B5%E0%B9%89%E0%B8%A2%E0%B8%99" target="_blank" rel="noopener"><img src="/assets/guide/guide-pa-da-hokkien.jpg" alt="ป้าดา หมี่ฮกเกี้ยน (ถนนศรีตะกั่วป่า)" loading="lazy"></a><div class="pick-body"><h3>ป้าดา หมี่ฮกเกี้ยน (ถนนศรีตะกั่วป่า)</h3><p>ร้านหมี่ฮกเกี้ยนเจ้าเก่าแก่คู่ถนนศรีตะกั่วป่า เส้นบะหมี่เหนียวนุ่มผัดหอมกลิ่นกระทะไหม้ ใส่ซีฟู้ดแน่นๆ และไข่เยิ้มคลุกเคล้า</p><p class="pick-meta">เวลาเปิด 07:00 ถึง 17:00 น. (ทุกวัน) · ~0.7 กม. จากศิวรา</p><p class="pick-tip">แนะนำสั่ง &quot;หมี่ฮกเกี้ยนผัดไข่เยิ้ม&quot; เจาะไข่แดงแล้วคลุกกับเส้นร้อนๆ นัวเข้มข้นมาก</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B8%9B%E0%B9%89%E0%B8%B2%E0%B8%94%E0%B8%B2%E0%B8%AB%E0%B8%A1%E0%B8%B5%E0%B9%88%E0%B8%AE%E0%B8%81%E0%B9%80%E0%B8%81%E0%B8%B5%E0%B9%89%E0%B8%A2%E0%B8%99" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B8%A3%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%9A%E0%B8%B1%E0%B8%87%E0%B8%94%E0%B8%B5%E0%B8%99%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener"><img src="/assets/guide/guide-bang-deen.jpg" alt="ร้านบังดีน ข้าวหมกไก่ &amp; โรตีแกง (Michelin Guide)" loading="lazy"></a><div class="pick-body"><h3>ร้านบังดีน ข้าวหมกไก่ &amp; โรตีแกง (Michelin Guide)</h3><p>ร้านอาหารเช้ามุสลิมชื่อดังการันตีมิชลินไกด์ ข้าวหมกหอมนุ่มกลิ่นเครื่องเทศ เสิร์ฟคู่น้ำจิ้มรสจัดจ้าน และโรตีแป้งนุ่มแกงมัสมั่นไก่</p><p class="pick-meta">เวลาเปิด 06:00 ถึง 13:30 น. (ทุกวัน) · ~2.8 กม. จากศิวรา</p><p class="pick-tip">แป้งโรตีนวดสดทอดกรอบนุ่ม แนะนำสั่งโรตีแกงมัสมั่นคู่กับชาชักร้อน อร่อยเข้ากันมาก</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B8%A3%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%9A%E0%B8%B1%E0%B8%87%E0%B8%94%E0%B8%B5%E0%B8%99%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B8%A3%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%9B%E0%B8%B9%E0%B8%94%E0%B8%B3%20%E0%B8%9A%E0%B8%B2%E0%B8%87%E0%B8%99%E0%B8%B2%E0%B8%A2%E0%B8%AA%E0%B8%B5" target="_blank" rel="noopener"><img src="/assets/guide/guide-pu-dam.jpg" alt="ร้านปูดำ (บางนายสี)" loading="lazy"></a><div class="pick-body"><h3>ร้านปูดำ (บางนายสี)</h3><p>ร้านลับริมคลองป่าชายเลนย่านบางนายสี การันตีปูดำสดๆ จากธรรมชาติเนื้อแน่นหวานเจี๊ยบ ปรุงรสมือพื้นบ้านรสจัดจ้านถึงเครื่อง</p><p class="pick-meta">เวลาเปิด 10:00 ถึง 21:00 น. (ทุกวัน) · ~3.2 กม. จากศิวรา</p><p class="pick-tip">ปูดำนึ่งและข้าวผัดปูคือเมนูที่คนสั่งกันมากที่สุด แนะนำโทรเช็กของสดหรือไปก่อนช่วงค่ำ</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B8%A3%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%9B%E0%B8%B9%E0%B8%94%E0%B8%B3%20%E0%B8%9A%E0%B8%B2%E0%B8%87%E0%B8%99%E0%B8%B2%E0%B8%A2%E0%B8%AA%E0%B8%B5" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B9%80%E0%B8%81%E0%B9%8B%E0%B8%9C%E0%B8%B1%E0%B8%94%E0%B9%84%E0%B8%97%E0%B8%A2%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener"><img src="/assets/guide/guide-kae-padthai.jpg" alt="เก๋ ผัดไทย (ตลาดเก่าตะกั่วป่า)" loading="lazy"></a><div class="pick-body"><h3>เก๋ ผัดไทย (ตลาดเก่าตะกั่วป่า)</h3><p>ร้านผัดไทยยอดนิยมประจำย่านเมืองเก่า เส้นเหนียวนุ่มผัดซอสมะขามเปียกสูตรโบราณเข้มข้นฉ่ำเข้าเนื้อ กุ้งสดตัวโตเนื้อเด้ง</p><p class="pick-meta">เวลาเปิด 16:30 ถึง 21:30 น. (ทุกวัน) · ~0.6 กม. จากศิวรา</p><p class="pick-tip">ผัดไทยกุ้งสดห่อไข่คือจานเด็ด บีบมะนาวสดแนบหัวปลีและใบบัวบก ครบรสไม่ต้องปรุง</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B9%80%E0%B8%81%E0%B9%8B%E0%B8%9C%E0%B8%B1%E0%B8%94%E0%B9%84%E0%B8%97%E0%B8%A2%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B9%80%E0%B8%88%E0%B9%8A%E0%B8%AD%E0%B9%89%E0%B8%A7%E0%B8%99%20%E0%B8%9A%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B9%80%E0%B8%84%E0%B9%87%E0%B8%A1" target="_blank" rel="noopener"><img src="/assets/guide/guide-jae-ouan.jpg" alt="เจ๊อ้วน ทะเลสด (บ้านน้ำเค็ม)" loading="lazy"></a><div class="pick-body"><h3>เจ๊อ้วน ทะเลสด (บ้านน้ำเค็ม)</h3><p>ร้านอาหารทะเลสดขึ้นชื่อย่านบ้านน้ำเค็ม วัตถุดิบสดใหม่ส่งตรงจากเรือประมงทุกวัน น้ำจิ้มซีฟู้ดมะนาวแท้รสจัดจ้าน บรรยากาศมื้อเย็นริมทะเล</p><p class="pick-meta">เวลาเปิด 10:30 ถึง 21:30 น. (ทุกวัน) · ~11.5 กม. จากศิวรา</p><p class="pick-tip">เหมาะมากสำหรับมื้อเย็น กุ้งลายเสือตัวโตเนื้อเด้งหวานเจี๊ยบทานคู่น้ำจิ้มซีฟู้ดรสแซ่บ</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B9%80%E0%B8%88%E0%B9%8A%E0%B8%AD%E0%B9%89%E0%B8%A7%E0%B8%99%20%E0%B8%9A%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B9%80%E0%B8%84%E0%B9%87%E0%B8%A1" target="_blank" rel="noopener">นำทาง ↗</a></div></article></div><h2>จุดแวะและที่เที่ยว</h2><div class="rest-stops"><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B8%96%E0%B8%99%E0%B8%99%E0%B8%A8%E0%B8%A3%E0%B8%B5%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener"><img src="/assets/guide/guide-old-town-street.jpg" alt="ถนนวัฒนธรรมศรีตะกั่วป่า &amp; สตรีทอาร์ตตึกโบราณ" loading="lazy"></a><div class="pick-body"><h3>ถนนวัฒนธรรมศรีตะกั่วป่า &amp; สตรีทอาร์ตตึกโบราณ</h3><p>ย่านตึกแถวโบราณที่มีทางเดินโค้งใต้ตึก (Five-Foot Way) พร้อมภาพวาดสตรีทอาร์ตบอกเล่าเรื่องราวชาวบาบ๋าและประวัติศาสตร์เหมืองแร่</p><p class="pick-meta">เวลาเปิด เดินชมได้ตลอดวัน (แนะนำ 09:00 ถึง 17:00 น.) · ~0.7 กม. จากศิวรา</p><p class="pick-tip">สามารถเดินทะลุซอยต่างๆ เชื่อมต่อไปยังร้านขนมเต้าส้อและร้านของกินเมืองเก่าได้สะดวก</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B8%96%E0%B8%99%E0%B8%99%E0%B8%A8%E0%B8%A3%E0%B8%B5%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%95%E0%B8%81%E0%B8%95%E0%B8%B3%E0%B8%AB%E0%B8%99%E0%B8%B1%E0%B8%87" target="_blank" rel="noopener"><img src="/assets/guide/guide-tam-nang.jpg" alt="น้ำตกตำหนัง (อุทยานแห่งชาติศรีพังงา)" loading="lazy"></a><div class="pick-body"><h3>น้ำตกตำหนัง (อุทยานแห่งชาติศรีพังงา)</h3><p>น้ำตกขนาดใหญ่กลางผืนป่าดงดิบอันสมบูรณ์ของอุทยานแห่งชาติศรีพังงา สายน้ำไหลทิ้งตัวลงมาจากหน้าผาสูง 63 เมตร น้ำใสเห็นฝูงปลาพลวงแหวกว่าย</p><p class="pick-meta">เวลาเปิด 08:30 ถึง 16:30 น. (ทุกวัน) · ~21.8 กม. จากศิวรา</p><p class="pick-tip">ช่วง 10:00 - 14:00 น. แสงแดดส่องลงผิวน้ำสวยมาก มีจุดพักผ่อนร่มรื่นใต้ต้นไม้ใหญ่</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%95%E0%B8%81%E0%B8%95%E0%B8%B3%E0%B8%AB%E0%B8%99%E0%B8%B1%E0%B8%87" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B8%AA%E0%B8%B0%E0%B8%9E%E0%B8%B2%E0%B8%99%E0%B9%80%E0%B8%AB%E0%B8%A5%E0%B9%87%E0%B8%81%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener"><img src="/assets/guide/guide-iron-bridge.jpg" alt="สะพานเหล็กบุญสูง (สะพานโคกขนุน)" loading="lazy"></a><div class="pick-body"><h3>สะพานเหล็กบุญสูง (สะพานโคกขนุน)</h3><p>แลนด์มาร์กประวัติศาสตร์ยุคเหมืองแร่รุ่งเรือง สร้างขึ้นจากชิ้นส่วนเหล็กของเรือขุดแร่โบราณ ทอดข้ามแม่น้ำตะกั่วป่าอย่างงดงาม</p><p class="pick-meta">เวลาเปิด เปิดตลอด 24 ชั่วโมง (แนะนำ 16:30 ถึง 18:30 น.) · ~2.3 กม. จากศิวรา</p><p class="pick-tip">ช่วง 17:00 - 18:30 น. แสงพระอาทิตย์ตกจะสาดเข้าโครงสะพานเหล็กสีส้มสวยมาก ถ่ายรูปสวยสุดๆ</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B8%AA%E0%B8%B0%E0%B8%9E%E0%B8%B2%E0%B8%99%E0%B9%80%E0%B8%AB%E0%B8%A5%E0%B9%87%E0%B8%81%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener">นำทาง ↗</a></div></article><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B8%AB%E0%B8%A5%E0%B8%B2%E0%B8%94%E0%B9%83%E0%B8%AB%E0%B8%8D%E0%B9%88%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener"><img src="/assets/guide/guide-lad-yai.jpg" alt="หลาดใหญ่ ถนนคนเดินสายวัฒนธรรมเมืองเก่า" loading="lazy"></a><div class="pick-body"><h3>หลาดใหญ่ ถนนคนเดินสายวัฒนธรรมเมืองเก่า</h3><p>ถนนคนเดินสายประวัติศาสตร์สุดคลาสสิก ปิดถนนศรีตะกั่วป่าให้คนท้องถิ่นนำอาหารโบราณ ขนมพื้นบ้าน และงานคราฟต์มาเปิดแผงขายใต้แสงไฟชิโนโปรตุกีส</p><p class="pick-meta">เวลาเปิด เฉพาะวันอาทิตย์ 15:30 ถึง 20:30 น. · ~0.7 กม. จากศิวรา</p><p class="pick-tip">เปิดเฉพาะวันอาทิตย์! แนะนำมาช่วง 17:00 น. แสงแดดส้มกำลังสวย ถ่ายรูปตึกเก่าคลาสสิกมาก</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B8%AB%E0%B8%A5%E0%B8%B2%E0%B8%94%E0%B9%83%E0%B8%AB%E0%B8%8D%E0%B9%88%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2" target="_blank" rel="noopener">นำทาง ↗</a></div></article></div><h2>ของฝาก</h2><div class="rest-stops"><article class="rest-stop pick"><a class="pick-art" href="https://maps.google.com/?q=%E0%B9%80%E0%B8%95%E0%B9%89%E0%B8%B2%E0%B8%AA%E0%B9%89%E0%B8%AD%E0%B8%95%E0%B8%A7%E0%B8%87%E0%B8%A3%E0%B8%B1%E0%B8%95%E0%B8%99%E0%B9%8C" target="_blank" rel="noopener"><img src="/assets/guide/guide-tuangrat-taosor.jpg" alt="เต้าส้อตวงรัตน์ (ต้นตำรับ 100 ปี)" loading="lazy"></a><div class="pick-body"><h3>เต้าส้อตวงรัตน์ (ต้นตำรับ 100 ปี)</h3><p>ของฝากอันดับ 1 ของตะกั่วป่า แป้งบางกรอบ ไส้ถั่วเนียนแน่น กลิ่นหอมอบควันเทียนสูตรโบราณดั้งเดิมสืบทอดมารุ่นสู่รุ่น</p><p class="pick-meta">เวลาเปิด 08:00 ถึง 17:00 น. (ทุกวัน) · ~0.6 กม. จากศิวรา</p><p class="pick-tip">ไส้เค็มไข่เค็มคือ Signature ซื้อแบบเพิ่งอบเตาร้อนๆ หอมอร่อยมาก เก็บได้ 7-10 วัน</p><a class="shop-nav" href="https://maps.google.com/?q=%E0%B9%80%E0%B8%95%E0%B9%89%E0%B8%B2%E0%B8%AA%E0%B9%89%E0%B8%AD%E0%B8%95%E0%B8%A7%E0%B8%87%E0%B8%A3%E0%B8%B1%E0%B8%95%E0%B8%99%E0%B9%8C" target="_blank" rel="noopener">นำทาง ↗</a></div></article></div><h2>แผ่นพับพกไปเดิน</h2><div class="leaflet-block"><a class="leaflet-art" href="/assets/leaflet/takuapa-walk-leaflet.pdf" target="_blank" rel="noopener"><img src="/assets/leaflet/leaflet-page-1.webp" alt="แผ่นพับเดินเมืองเก่าตะกั่วป่า หน้าแรก" loading="lazy"></a><div class="leaflet-copy"><p>แผ่นพับสองหน้า เล่าเรื่องบ้านไม้และสี่จุดในเส้นทางข้างบน พิมพ์ใส่กระดาษ A4 แล้วพับครึ่งพกไปเดินได้เลย ไม่ต้องเปิดมือถือกลางแดด</p><div class="leaflet-actions"><a class="button" href="/assets/leaflet/takuapa-walk-leaflet.pdf" target="_blank" rel="noopener">โหลดแผ่นพับ PDF</a><a class="text-link" href="/leaflet/">อ่านบนเว็บแทน ↗</a></div><p class="small">จัดทำโดย<a href="https://siwaracafe.com/" target="_blank" rel="noopener">ศิวรา คาเฟ่</a> ผู้จัดทำคู่มือเล่มนี้ · แจกฟรี นำไปพิมพ์ต่อได้</p></div></div>
site\rest\index.html:7:    <h2>เส้นทางเดินสั้นจากบ้านไม้</h2><div class="short-walk"><article class="walk-point"><a href="/places/khun-in/"><img src="/assets/khun-in.webp" alt="บ้านขุนอินทร์" width="1000" height="1000" loading="lazy"></a><div><h3><a href="/places/khun-in/">บ้านขุนอินทร์</a></h3><p>ชวนมอง: หลังคาระเบียงและช่องเปิด</p><button data-trip-add="khun-in">เพิ่มลงทริป</button></div></article><article class="walk-point"><a href="/places/tao-ming/"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" width="1000" height="667" loading="lazy"></a><div><h3><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a></h3><p>ชวนมอง: หน้าจั่วและระเบียงสีเหลือง</p><button data-trip-add="tao-ming">เพิ่มลงทริป</button></div></article><article class="walk-point"><a href="/places/guan-yu/"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="lazy"></a><div><h3><a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a></h3><p>ชวนมอง: ประตูและรายละเอียดสีแดง</p><button data-trip-add="guan-yu">เพิ่มลงทริป</button></div></article><article class="walk-point"><a href="/places/iron-bridge/"><img src="/assets/iron-bridge.webp" alt="สะพานเหล็กบุญสูง" width="1000" height="1000" loading="lazy"></a><div><h3><a href="/places/iron-bridge/">สะพานเหล็กบุญสูง</a></h3><p>ชวนมอง: โครงเหล็กและภูมิทัศน์ริมน้ำ</p><button data-trip-add="iron-bridge">เพิ่มลงทริป</button></div></article></div><p>วางแผนต่อ: <a href="/trip/">จัดทริปของคุณ ↗</a> · <a href="/map/">ดูแผนที่เมือง ↗</a></p><aside class="source"><h2>ที่มาของข้อมูล</h2><p>เรียบเรียงจาก<a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับเทศบาลเมืองตะกั่วป่า</a> · สกัดข้อมูล 6 กันยายน 2569 เอกสารไม่ระบุวันที่เผยแพร่ เวลาเปิด สถานะร้าน และกำหนดงานปัจจุบันยังไม่ได้ยืนยัน ควรตรวจสอบกับสถานที่ก่อนเดินทาง</p></aside><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", 