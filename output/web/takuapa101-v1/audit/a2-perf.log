"url": "https://takuapa101.com/stories/water-trade/"}, {"@type": "ListItem", "position": 4, "url": "https://takuapa101.com/stories/food-people/"}, {"@type": "ListItem", "position": 5, "url": "https://takuapa101.com/stories/kuapapoh/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/stories/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/stories/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/stories/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/" aria-current="page">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/stories/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="stories-index-v2"><div class="intro"><a class="eyebrow" href="/">ตะกั่วป่า 101 / คู่มือเมืองเก่า</a><h1>เรื่องเล่าตะกั่วป่า</h1><p class="lead">สี่มุมมองสำหรับอ่านเมืองผ่านแหล่งข้อมูล · รู้จักเมือง บ้านเก่าและสถาปัตยกรรม สายน้ำและการค้า ผู้คนและรสชาติ</p></div><div class="story-grid-v2"><article class="story-card-v2 story-card-v2-lead"><div class="card-art-v2"><img src="/assets/riverwalk.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">รู้จักเมือง</span><h2><a href="/stories/city/">ตะกั่วป่า เมืองที่ย้ายตัวเองตามสายน้ำ</a></h2><p>จากชุมชนโบราณบนเส้นทางข้ามคาบสมุทร สู่เมืองตลาดและเมืองเหมืองแร่ · เรื่องที่ยืนยันได้และปริศนาที่ยังรอคำตอบ</p><div class="card-meta-v2"><span class="story-mins">6 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article><article class="story-card-v2"><div class="card-art-v2"><img src="/assets/culture-street.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">บ้านเก่าและสถาปัตยกรรม</span><h2><a href="/stories/architecture/">ตึกที่สร้างด้วยเงินดีบุกและเหล็กจากเรือขุดแร่ · สถาปัตยกรรมที่จำเมืองไว้</a></h2><p>อ่านเมืองตะกั่วป่าผ่านตึกแถวบนถนนสายวัฒนธรรม สะพานเหล็กบุญสูง จวนเจ้าเมือง และโรงเรียนเต้าหมิง · การเปลี่ยนผ่านที่ฝังอยู่ในอิฐ ปูน และโครงสร้างเหล็ก</p><div class="card-meta-v2"><span class="story-mins">6 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article><article class="story-card-v2"><div class="card-art-v2"><img src="/assets/iron-bridge.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">สายน้ำและการค้า</span><h2><a href="/stories/water-trade/">จากทุ่งตึกถึงแม่น้ำตะกั่วป่า: วันที่สายน้ำสร้างเมือง</a></h2><p>สายน้ำไม่ได้เป็นเพียงฉากหลัง แต่มันคือเส้นทาง ผู้เชื่อมคน และตัวกำหนดชะตาเมืองที่ต้องย้ายตามตะกอนน้ำ</p><div class="card-meta-v2"><span class="story-mins">7 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article><article class="story-card-v2"><div class="card-art-v2"><img src="/assets/food-center.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">ผู้คนและรสชาติ</span><h2><a href="/stories/food-people/">รสชาติของชุมชนบาบ๋าและตลาดเก่า</a></h2><p>อาหารเป็นทั้งความทรงจำของครัวเรือนและหลักฐานของการแลกเปลี่ยน · ลองอ่านตะกั่วป่าผ่านสำรับบาบ๋า เต้าส้อสองชั้น และถนนสายวัฒนธรรม</p><div class="card-meta-v2"><span class="story-mins">7 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article><article class="story-card-v2"><div class="card-art-v2"><img src="/assets/tao-ming.webp" alt="" loading="lazy"></div><div class="card-content-v2"><span class="chapter">กระทู้เมือง</span><h2><a href="/stories/kuapapoh/">กั่วป่าโพ้: วันที่บ้านเก่าลุกขึ้นมาเล่าเรื่องตัวเอง</a></h2><p>โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา</p><div class="card-meta-v2"><span class="story-mins">6 นาที</span><span class="card-go" aria-hidden="true">เปิดเรื่องนี้ ↗</span></div></div></article></div><aside class="source"><h2>วิธีอ่านหน้านี้</h2><p>บทความเรียบเรียงจากเอกสารราชการและฐานข้อมูลสถาบันการศึกษา พร้อมแยกระดับหลักฐานในแต่ละเรื่อง · ข้อมูลร้าน เวลาเปิด และกำหนดการควรตรวจสอบกับผู้ให้บริการก่อนเดินทาง</p></aside></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="foot
... 3944958 bytes omitted ...
ะกรรมการดูแล</p><p>ยังไม่พบข่าวย้อนหลัง 5 ปีที่ยืนยันโครงการบูรณะ รางวัล หรือโครงการพัฒนาเฉพาะศาลเจ้าแห่งนี้ และยังไม่มีภาพปัจจุบันจากหน่วยงานทางการที่ตรวจสอบสิทธิ์การใช้งานได้</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">ศูนย์มานุษยวิทยาสิรินธร ฐานข้อมูลชุมชนตลาดใหญ่</a> · <a href="https://www.youtube.com/watch?v=PkMXN_xPdLI" target="_blank" rel="noopener">PaiPaPai ปายพาไป (วิดีโอกิจกรรมปี 2564)</a></div></article></div></section><section class="research-section" id="timeline"><h2>เส้นเวลาแบบจุด</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status unverified">ยังไม่ยืนยัน</span><p class="era-years">21 กันยายน 2564</p><h3>พิธีแซยิดและกิจกรรมศรัทธาที่ศาลเจ้า</h3><p>มีวิดีโอบันทึกพิธีแซยิดพระฮกเต็กเจี่ยสิน/แป๊ะกงที่ศาลเจ้าปุนเถ้ากงอำ จับเส</p><a href="https://www.youtube.com/watch?v=PkMXN_xPdLI" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status unverified">ยังไม่ยืนยัน</span><p class="era-years">พ.ศ. 2564</p><h3>พิธีอาบน้ำมัน พระลา และอัญเชิญไฟศักดิ์สิทธิ์</h3><p>วิดีโออีกชุดกล่าวถึงกิจกรรมพิธีกรรมของศาลเจ้าและการกลับมาร่วมงานของลูกหลานชาวตะกั่วป่า</p><a href="https://www.youtube.com/watch?v=n8El59smf1s" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">ไม่ระบุปี</p><h3>เริ่มก่อสร้างศาลเจ้า</h3><p>ยังไม่พบปีสร้างหรือชื่อผู้ก่อตั้ง; แหล่งทางการระบุว่าเป็นศาลเจ้าแห่งแรกของเมืองตะกั่วป่า</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">ไม่ระบุปี</p><h3>กระถางธูปพระราชทานรัชกาลที่ 6</h3><p>เทศบาลระบุว่ามีกระถางธูปที่รัชกาลที่ 6 ทรงประธาน แต่ไม่ระบุปีหรือวาระ</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li></ol></section><p class="missing-photo">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่</p><section class="research-section" id="highlights"><h2>จุดเด่นที่ควรดู</h2><div class="research-cards"><article class="research-note"><h3>กระถางธูปที่เกี่ยวข้องกับรัชกาลที่ 6</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>เอกสารเทศบาลระบุว่ามีกระถางธูปพระราชทานอยู่ภายในศาลเจ้า ยังไม่พบข้อมูลยืนยันตำแหน่งจัดแสดงหรือการเปิดให้ชมในปัจจุบัน</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>องค์เทพประธานปุนเถ้าก๋ง</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>บทความท่องเที่ยวระบุว่าภายในมีเทพเจ้าปุนเถ้าก๋งเป็นองค์ประธาน ข้อมูลนี้ยังไม่ได้ยืนยันจากศาลเจ้าหรือหน่วยงานทางการ</p><a href="https://dashmv.com/blog-posts/cultural-tourism" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ตึกแถวย่านจับเสบนถนนอุดมธารา</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>จุดชมในย่านรอบศาลเจ้า ไม่ใช่ภายในศาล: ฐานข้อมูลชุมชนกล่าวถึงตึกเก่าสองชั้นบนถนนอุดมธาราในย่านจับเส</p><a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="news"><h2>ข่าวและความเคลื่อนไหว</h2><div class="research-cards"><article class="research-note"><p class="muted">2021-10-28 · PaiPaPai ปายพาไป</p><h3>แซยิดพระฮกเต็กเจี่ยสิน แป๊ะกง ศาลเจ้าปุนเถ้ากงอำ จับเส เมืองตะกั่วป่า</h3><p>วิดีโอข่าว/บันทึกกิจกรรมพิธีแซยิดของศาลเจ้า</p><a href="https://www.youtube.com/watch?v=PkMXN_xPdLI" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>รู้หรือไม่</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>เทศบาลเมืองตะกั่วป่าระบุว่าศาลเจ้าแห่งนี้เป็นศาลเจ้าแห่งแรกของเมืองตะกั่วป่า</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ภายในศาลเจ้ามีกระถางธูปที่เอกสารเทศบาลระบุว่าได้รับพระราชทานจากรัชกาลที่ 6</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="nearby"><h2>ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</h2><ul class="nearby-links"><li>ตึกแถวย่านจับเส ถนนอุดมธารา <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li>ค่ายกำแพงเมืองเก่า ถนนอุดมธารา <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a></li><li><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a></li><li><a href="/places/rong-jae/">โรงเจในสวน</a></li></ul></section><section class="research-section" id="faq"><h2>คำถามที่พบบ่อย</h2><details><summary>สถานที่นี้มีประวัติความเป็นมาอย่างไร</summary><p>เอกสารเทศบาลระบุว่าศาลเจ้าบุ่นเท่าก๋งอ้ามเป็นศาลเจ้าแห่งแรกของเมืองตะกั่วป่า และตั้งอยู่ในย่านท่าเรือเก่าที่เรียกว่าจับเสหรือจับเซ้ เทศบาลบันทึกว่าภายในศาลเจ้ามีกระถางธูปที่ได้รับพระราชทานจากรัชกาลที่ 6 แต่ไม่ได้ระบุปีหรือวาระการพระราชทาน</p></details><details><summary>มีจุดเด่นอะไรให้ชม</summary><p>บทความท่องเที่ยวระบุว่าภายในมีเทพเจ้าปุนเถ้าก๋งเป็นองค์ประธาน ข้อมูลนี้ยังไม่ได้ยืนยันจากศาลเจ้าหรือหน่วยงานทางการ จุดชมในย่านรอบศาลเจ้า ไม่ใช่ภายในศาล: ฐานข้อมูลชุมชนกล่าวถึงตึกเก่าสองชั้นบนถนนอุดมธาราในย่านจับเส</p></details><details><summary>เอกสารเทศบาลกล่าวถึงที่นี่อย่างไร</summary><p>เอกสารกล่าวถึงศาลเจ้าในย่านท่าเรือเก่าของตะกั่วป่า</p></details></section><section class="research-section" id="sources"><h2>ที่มาของข้อมูล</h2><div class="source-table"><table><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>วันที่เข้าถึง</th><th>ลิงก์</th></tr></thead><tbody><tr><th scope="row">เทศบาลเมืองตะกั่วป่า แผนการดำเนินงานด้านสิ่งแวดล้อม ประจำปีงบประมาณ 2563 หน้าเอกสาร 11 และ 13</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ศูนย์มานุษยวิทยาสิรินธร ฐานข้อมูลชุมชน ตลาดใหญ่</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">แดช เอ็มวี ที่เที่ยวพังงา ตะกั่วป่า สถานที่ท่องเที่ยวเชิงวัฒนธรรม</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://dashmv.com/blog-posts/cultural-tourism" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">กูเกิลแมปส์ หมุดศาลเจ้าที่เชื่อมจากบทความแดช เอ็มวี</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://goo.gl/maps/JREsvAnLQ2vycGG78" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า แผนการดำเนินงานด้านสิ่งแวดล้อม ปีงบประมาณ 2563</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ศูนย์มานุษยวิทยาสิรินธร ฐานข้อมูลชุมชนตลาดใหญ่</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">แดช เอ็มวี บทความท่องเที่ยวเชิงวัฒนธรรม</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://dashmv.com/blog-posts/cultural-tourism" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">PaiPaPai ปายพาไป: แซยิดพระฮกเต็กเจี่ยสิน แป๊ะกง</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.youtube.com/watch?v=PkMXN_xPdLI" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">PaiPaPai ปายพาไป: พิธีอาบน้ำมันและพระลา</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.youtube.com/watch?v=n8El59smf1s" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ชื่อไทยและชื่ออังกฤษหลักคงตามโจทย์ ไม่พบแหล่งที่เปิดอ่านได้ใช้ชื่ออังกฤษตรงตามโจทย์; ชื่ออื่นใน aka อ้างจากเอกสารเทศบาลและบทความแดช เอ็มวี ส่วนคำค้น SEO เป็นข้อเสนอสำหรับค้นหา ไม่ใช่หลักฐานชื่อทางการ</li><li>พิกัดอ่านจากค่าตำแหน่งสถานที่ !3d และ !4d ในปลายทางการเปลี่ยนเส้นทางของลิงก์กูเกิลแมปส์ที่บทความแนบไว้ ปลายทางใช้ชื่อ Bun Tao Kong Shrine; เปิดปลายทางผ่านคำขอเว็บได้ แต่ยังไม่มีแผนที่อิสระชุดที่สองหรือภาพป้ายยืนยัน จึงให้ความมั่นใจปานกลาง</li><li>ถนนและชุมชนอ้างจากรายการศาสนสถานในเอกสารเทศบาล ส่วนตำบลอ้างจากหน้า ตลาดใหญ่ ของศูนย์มานุษยวิทยาสิรินธร; ไม่พบเลขที่อาคารและรหัสไปรษณีย์เฉพาะสถานที่ จึงไม่เติมรหัสจากที่อยู่หน่วยงานอื่น</li><li>ไม่พบเวลาเปิดปิดและค่าเข้าชมเฉพาะศาลเจ้านี้ จึงไม่สรุปว่าเปิดทุกวันหรือเข้าฟรี</li><li>ไม่พบเบอร์โทร เพจเฟซบุ๊ก เว็บไซต์ หรือไลน์ที่ยืนยันว่าเป็นช่องทางของศาลเจ้านี้โดยตรง</li><li>ไม่พบคำอธิบายเส้นทางถึงศาลเจ้าจากตัวเมืองตะกั่วป่า ภูเก็ต เขาหลัก หรือสนามบิน พร้อมระยะทางที่ตรวจสอบได้ จึงเว้น getting_there</li><li>ไม่พบปีสร้าง ชื่อผู้ก่อตั้งรายบุคคล ปีบูรณะ หรือหลักฐานบทบาทเฉพาะในอุตสาหกรรมดีบุกนอกเหนือจากการก่อตั้งโดยชาวจีนที่ทำเหมือง</li><li>ไม่พบหลักฐานจำแนกรูปแบบสถาปัตยกรรมของอาคารศาลเจ้าโดยตรง จึงไม่ใช้คำบรรยายชิโนโปรตุกีสของอาคารในชุมชนแทนศาลเจ้า</li><li>ไม่พบประกาศขึ้นทะเบียนโบราณสถานที่ระบุศาลเจ้านี้โดยตรง การไม่พบข้อมูลไม่เท่ากับยืนยันว่าไม่ได้ขึ้นทะเบียน</li><li>ไม่พบช่วงเวลาที่เหมาะสม ระยะเวลาเข้าชม ข้อกำหนดการแต่งกาย ที่จอดรถ ห้องน้ำ ทางลาด หรือข้อมูลรองรับผู้สูงอายุและรถเข็น</li><li>ยังไม่มีข้อมูลสิ่งที่ชมภายในศาลได้ครบ 3 ถึง 6 รายการที่ตรวจยืนยันสภาพปัจจุบันได้ จึงให้สองรายการตามคำบรรยายแหล่งข้อมูลและอีกหนึ่งรายการในย่านรอบศาล</li><li>พบผลค้นหาวิดีโอแซยิดพระฮกเต็กเจี่ยสินที่ศาลเจ้าปุนเถ้ากงอำ จับเส ลงวันที่ 21 กันยายน 2564 แต่เปิดอ่านหน้าไม่ได้ จึงไม่ใช้ยืนยันเทศกาล เดือน หรือปฏิทินจันทรคติ</li><li>ผลค้นหาประเพณีถือศีลกินผักจำนวนมากเกี่ยวกับศาลเจ้าบุนเท่าก๋งตำบลคึกคัก หรือศาลเจ้าพ่อกวนอู ไม่สามารถนำมาใช้เป็นกำหนดการของศาลเจ้าย่านจับเสได้</li><li>สถานที่ nearby มีหลักฐานว่าอยู่บนถนนอุดมธาราในย่านเดียวกัน แต่ยังไม่ได้ตรวจเส้นทางเดินจริงและระยะเวลา จึงใส่ walk_minutes เป็น null</li><li>ไม่พบลิงก์รูปภาพทางการที่ระบุว่าเป็นศาลเจ้านี้อย่างชัดเจนพร้อมสิทธิ์การใช้งาน จึงเว้น photos</li><li>แผนเทศบาลที่อ้างเป็นเอกสารแผนการดำเนินงานด้านสิ่งแวดล้อมที่เปิดอ่านใหม่ ไม่ใช่แผ่นพับตั้งต้น; ข้อความประวัติในฐานข้อมูลชุมชนใกล้เคียงกับเอกสารเทศบาล จึงไม่ถือเป็นหลักฐานอิสระสองชุด</li><li>ปีสร้าง ชื่อผู้ก่อตั้งรายบุคคล และเหตุผลการสร้างแบบเฉพาะเจาะจงยังไม่พบหลักฐาน</li><li>ยังไม่พบปีบูรณะ การเปลี่ยนมือ การถูกทิ้งร้าง หรือการขึ้นทะเบียนโบราณสถาน</li><li>ยังไม่พบหลักฐานว่าศาลเจ้าได้รับผลกระทบจากสึนามิ พ.ศ. 2547 หรือการปิดเหมืองดีบุกอย่างไร</li><li>ยังไม่ยืนยันผู้ดูแล เวลาเปิด-ปิด ค่าเข้าชม สภาพอาคาร และกิจกรรมประจำปี ณ พ.ศ. 2569</li><li>ไม่มีภาพเก่าที่ตรวจสอบได้จากหอจดหมายเหตุหรือแหล่งประวัติศาสตร์ท้องถิ่นที่เปิดเผยออนไลน์</li><li>ภาพปัจจุบันที่พบเป็นภาพตัวอย่างจากภาพปกวิดีโอ ไม่ใช่ไฟล์ภาพจากหน่วยงานทางการ และต้องขออนุญาตก่อนใช้</li><li>ไม่พบข่าวย้อนหลัง 5 ปีเกี่ยวกับโครงการบูรณะ รางวัล หรือโครงการพัฒนาเฉพาะศาลเจ้าเพิ่มเติมจากวิดีโอกิจกรรมปี 2564</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
site\places\museum\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า · ตะกั่วป่า 101</title><meta name="description" content="เก็บเรื่องเล่าของเมืองไว้ด้วยกัน · พิพิธภัณฑ์ชุมชนตะกั่วป่า · พิพิธภัณฑ์บ้านตะกั่วป่า · วัดเสนานุชรังสรรค์"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า"><meta property="og:description" content="เก็บเรื่องเล่าของเมืองไว้ด้วยกัน · พิพิธภัณฑ์ชุมชนตะกั่วป่า · พิพิธภัณฑ์บ้านตะกั่วป่า · วัดเสนานุชรังสรรค์"><meta property="og:url" content="https://takuapa101.com/places/museum/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/museum.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/museum.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/places/museum/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า", "item": "https://takuapa101.com/places/museum/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า", "url": "https://takuapa101.com/places/museum/", "image": "https://takuapa101.com/assets/museum.webp", "description": "รวบรวมเรื่องศาสนา ศิลปะ และการค้าของท้องถิ่น", "address": {"@type": "PostalAddress", "streetAddress": "ภายในวัดเสนานุชรังสรรค์ ย่านตลาดเก่า", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "postalCode": "82110", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8302299579, "longitude": 98.3624509671}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "ควรแต่งกายอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "ควรแต่งกายสุภาพเมื่อเข้าพื้นที่วัด"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "พิพิธภัณฑ์ชุมชนตะกั่วป่าเป็นอาคารสองชั้นภายในวัดเสนานุชรังสรรค์ และรวบรวมเครื่องใช้กับอุปกรณ์ที่สะท้อนวิถีชีวิตคนตะกั่วป่า รวมถึงของจากยุคเหมืองแร่ วัดเสนานุชรังสรรค์สร้างโดยพระยาเสนานุชิต (นุช) และอุโบสถมีอิทธิพลทางสถาปัตยกรรมจากจีน"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "ตัวพิพิธภัณฑ์ชุมชนตั้งอยู่ภายในวัดเสนานุชรังสรรค์ จัดเก็บสิ่งของจากยุคทำเหมืองและของหายากที่สะท้อนวิถีชีวิตท้องถิ่น อุโบสถขนาดใหญ่มีรูปแบบได้รับอิทธิพลจากสถาปัตยกรรมจีน"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/places/museum/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/places/museum/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/places/museum/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/" aria-current="page">สถานที่</a><a href="/stories/">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/places/museum/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/">หน้าแรก</a> / <a href="/places/">สถานที่</a> / พิพิธภัณฑ์</div><header class="place-hero full-place-hero"><div><span class="chapter">บันทึกสถานที่ · พิพิธภัณฑ์</span><h1>พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า</h1><p class="english">Takua Pa Community Museum</p><span class="fact-status confirmed">ยืนยันแล้ว 8 ข้อ</span><p><a class="text-link" href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้ ↓</a></p><p class="place-hero-actions"><button class="button" type="button" data-trip-add="museum">เพิ่มลงทริป</button><a class="text-link" href="/trip/">ดูทริปของคุณ</a></p></div><div class="place-hero-art"><img src="/assets/museum.webp" alt="พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>ข้อมูลใช้จริง</h2><dl><div><dt>พิกัด</dt><dd>8.8302299579, 98.3624509671 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.8302299579,98.3624509671" target="_blank" rel="noopener">นำทางด้วย Google Maps ↗</a><a href="https://culturalenvi.onep.go.th/site/detail/4412" target="_blank" rel="noopener">แหล่งพิกัด ↗</a></div><div><dt>เวลาเปิด</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ค่าเข้า</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ที่จอดรถ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ห้องน้ำ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>รถเข็น</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>การแต่งกาย</dt><dd>ควรแต่งกายสุภาพเมื่อเข้าพื้นที่วัด <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div><dt>โทรศัพท์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เพจ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เว็บไซต์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ไลน์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><a href="https://mgronline.com/south/detail/9610000016873" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a><a href="https://www.gplace.com/960255" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">ในบันทึกหน้านี้</span><a href="#visit">ข้อมูลใช้จริง</a><a href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้</a><a href="#timeline">เส้นเวลาแบบจุด</a><a href="#highlights">จุดเด่นที่ควรดู</a><a href="#news">ข่าวและความเคลื่อนไหว</a><a href="#did_you_know">รู้หรือไม่</a><a href="#nearby">ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</a><a href="#faq">คำถามที่พบบ่อย</a><a href="#sources">ที่มาของข้อมูล</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>ตอนนั้น · ก่อนหน้า · ตอนนี้</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">ตอนนั้น</span><h3>วัดใหม่กำแพงในเมืองเหมืองและเมืองท่า</h3><p class="era-years">พ.ศ. 2390 / ค.ศ. 1847 เป็นต้นมา</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>จุดตั้งต้นของสถานที่นี้อยู่ที่วัดเสนานุชรังสรรค์ หรือชื่อเดิมที่ชาวบ้านเรียกว่า “วัดใหม่กำแพง” วัดมีทะเบียนระบุวันตั้งวัด พ.ศ. 2390 และแหล่งข้อมูลท้องถิ่นระบุว่าสร้างในสมัยรัชกาลที่ 3 โดยพระยาเสนานุชิต (นุช) ผู้สำเร็จราชการเมืองตะกั่วป่า</p><p>ในเวลานั้นตะกั่วป่าเป็นเมืองท่าชายฝั่งอันดามันที่เชื่อมการค้าและทรัพยากรดีบุก ผู้คนหลายกลุ่ม โดยเฉพาะแรงงานและพ่อค้าจีน ได้เข้ามาตั้งถิ่นฐานจนเกิดย่านตลาดและวัฒนธรรมจีน อาคารอุโบสถของวัดที่รับอิทธิพลสถาปัตยกรรมจีนจึงเป็นหลักฐานของเมืองพหุวัฒนธรรม ส่วนพิพิธภัณฑ์ที่เห็นในปัจจุบันยังไม่มีหลักฐานเปิดเผยว่าเริ่มจัดตั้งในปีใดหรือใครเป็นผู้ก่อตั้งโดยตรง</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://www.50amfh.org/userfiles/file/News/Thai%20temple%20name%20list/south/Phangnga.pdf" target="_blank" rel="noopener">รายงานทะเบียนวัดจังหวัดพังงา</a> · <a href="https://culturalenvi.onep.go.th/site/detail/4412" target="_blank" rel="noopener">สิ่งแวดล้อมศิลปกรรมอันควรอนุรักษ์ (ONEP)</a> · <a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">ศูนย์มานุษยวิทยาสิรินธร: เมืองตะกั่วป่า</a></div></article><article class="era-card" data-era="before"><span class="chapter">ก่อนหน้า</span><h3>จากวัดและชุมชน สู่พิพิธภัณฑ์ความทรงจำ</h3><p class="era-years">ไม่พบปีเริ่มจัดตั้งพิพิธภัณฑ์; ก่อน พ.ศ. 2561 มีหลักฐานการใช้งานในบริบทเมืองเก่า</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ระหว่างทาง วัดเสนานุชรังสรรค์ยังทำหน้าที่เป็นศาสนสถานและพื้นที่ของชุมชน ขณะเดียวกันเมืองตะกั่วป่าเปลี่ยนจากศูนย์กลางเหมืองดีบุกและการค้าไปสู่เมืองประวัติศาสตร์ที่ต้องอนุรักษ์มรดกเดิม แหล่งวิชาการอธิบายว่าพิพิธภัณฑ์ชุมชนตะกั่วป่าเป็นอาคารสองชั้น จัดแสดงเครื่องใช้ อุปกรณ์ และสิ่งของหายากที่สะท้อนวิถีชีวิต รวมถึงร่องรอยยุคเหมืองแร่</p><p>อุโบสถวัดได้รับการขึ้นทะเบียนเป็นโบราณสถานโดยกรมศิลปากร แต่แหล่งที่ตรวจสอบได้ในครั้งนี้ไม่แสดงปีขึ้นทะเบียนอย่างชัดเจน และยังไม่พบหลักฐานว่าตัวอาคารพิพิธภัณฑ์เคยถูกทิ้งร้าง บูรณะครั้งใหญ่ หรือได้รับผลกระทบจากสึนามิ พ.ศ. 2547 โดยตรง จึงไม่สรุปเกินหลักฐาน</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://so05.tci-thaijo.org/index.php/parichartjournal/article/download/219292/168797/871014" target="_blank" rel="noopener">วารสารปาริชาต มหาวิทยาลัยทักษิณ</a> · <a href="https://culturalenvi.onep.go.th/site/detail/4412" target="_blank" rel="noopener">สิ่งแวดล้อมศิลปกรรมอันควรอนุรักษ์ (ONEP)</a> · <a href="https://www.andamannlttrang.com/%E0%B8%82%E0%B9%89%E0%B8%AD%E0%B8%A1%E0%B8%B9%E0%B8%A5/%E0%B8%AD%E0%B8%B8%E0%B9%82%E0%B8%9A%E0%B8%AA%E0%B8%96%E0%B8%A7%E0%B8%B1%E0%B8%94%E0%B9%80%E0%B8%AA%E0%B8%99%E0%B8%B2%E0%B8%99%E0%B8%B8%E0%B8%8A%E0%B8%A3%E0%B8%B1%E0%B8%87%E0%B8%AA%E0%B8%A3%E0%B8%A3/" target="_blank" rel="noopener">สารสนเทศท้องถิ่นภาคใต้ฝั่งอันดามัน</a></div></article><article class="era-card" data-era="now"><span class="chapter">ตอนนี้</span><h3>พิพิธภัณฑ์เล็กในเส้นทางเมืองเก่า</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>หลักฐานร่วมสมัยเรียกพื้นที่นี้ทั้ง “พิพิธภัณฑ์ชุมชนตะกั่วป่า” และ “พิพิธภัณฑ์บ้านตะกั่วป่า” โดยวางไว้ในบริบทถนนวัฒนธรรมเมืองเก่า จัดแสดงภาพ โบราณวัตถุ และเรื่องราวของชุมชนควบคู่กับอาคารชิโน-โปรตุกีสและวัดเก่า จึงมีบทบาทเป็นแหล่งเรียนรู้ความทรงจำของเมือง มากกว่าจะเป็นพิพิธภัณฑ์ขนาดใหญ่ที่มีระบบบริการนักท่องเที่ยวครบถ้วน</p><p>อย่างไรก็ดี ยังไม่พบประกาศทางการที่ยืนยันเวลาเปิด-ปิด ค่าเข้าชม ผู้ดูแลโดยตรง สภาพอาคารล่าสุด หรือโครงการบูรณะเฉพาะพิพิธภัณฑ์ในปี 2569 กิจกรรมเมืองเก่าและถนนวัฒนธรรมยังดำเนินต่อในระดับเทศบาล/ชุมชน แต่ไม่ควรตีความว่าเป็นหลักฐานว่าพิพิธภัณฑ์เปิดทุกวัน</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://www.dit.go.th/th/market/2383/%E0%B8%A0%E0%B8%B2%E0%B8%84%E0%B9%83%E0%B8%95/%E0%B8%9E-%E0%B8%87%E0%B8%87%E0%B8%B2/%E0%B8%96%E0%B8%99%E0%B8%99%E0%B8%A7-%E0%B8%92%E0%B8%99%E0%B8%98%E0%B8%A3%E0%B8%A3%E0%B8%A1%E0%B9%80%E0%B8%A1-%E0%B8%AD%E0%B8%87%E0%B9%80%E0%B8%81-%E0%B8%B2%E0%B8%95%E0%B8%B0%E0%B8%81-%E0%B8%A7%E0%B8%9B-%E0%B8%B2/" target="_blank" rel="noopener">กรมการค้าภายใน กระทรวงพาณิชย์</a> · <a href="https://www.phangngapao.go.th/travel/detail/89" target="_blank" rel="noopener">จังหวัดพังงา: เมืองเก่าตะกั่วป่า</a> · <a href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">สถานีวิทยุกระจายเสียงแห่งประเทศไทย</a></div></article></div></section><section class="research-section" id="timeline"><h2>เส้นเวลาแบบจุด</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2390</p><h3>ตั้งวัดเสนานุชรังสรรค์</h3><p>ทะเบียนวัดระบุวันตั้งวัด พ.ศ. 2390; แหล่งท้องถิ่นระบุผู้สร้างคือพระยาเสนานุชิต (นุช)</p><a href="https://www.50amfh.org/userfiles/file/News/Thai%20temple%20name%20list/south/Phangnga.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2569</p><h3>อยู่ในบริบทการท่องเที่ยวเมืองเก่า</h3><p>พิพิธภัณฑ์บ้านตะกั่วป่าถูกกล่าวถึงเป็นส่วนหนึ่งของถนนวัฒนธรรมเมืองเก่า แต่ไม่พบประกาศเวลาเปิดเฉพาะสถานที่</p><a href="https://www.dit.go.th/th/market/2383/%E0%B8%A0%E0%B8%B2%E0%B8%84%E0%B9%83%E0%B8%95/%E0%B8%9E-%E0%B8%87%E0%B8%87%E0%B8%B2/%E0%B8%96%E0%B8%99%E0%B8%99%E0%B8%A7-%E0%B8%92%E0%B8%99%E0%B8%98%E0%B8%A3%E0%B8%A3%E0%B8%A1%E0%B9%80%E0%B8%A1%E0%B8%AD%E0%B8%87%E0%B9%80%E0%B8%81-%E0%B8%B2%E0%B8%95%E0%B8%B0%E0%B8%81-%E0%B8%A7%E0%B8%9B-%E0%B8%B2/" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">ไม่ระบุปี</p><h3>อุโบสถได้รับการขึ้นทะเบียนโบราณสถาน</h3><p>กรมศิลปากรขึ้นทะเบียนอุโบสถ แต่แหล่งที่ตรวจสอบได้ไม่ระบุปีในข้อความที่อ่านได้</p><a href="https://culturalenvi.onep.go.th/site/detail/4412" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">ไม่ระบุปี</p><h3>จัดตั้งพิพิธภัณฑ์ชุมชนในอาคารสองชั้น</h3><p>มีหลักฐานวิชาการบรรยายอาคารและสิ่งจัดแสดง แต่ไม่พบปีเริ่มจัดตั้งหรือชื่อผู้ก่อตั้ง</p><a href="https://so05.tci-thaijo.org/index.php/parichartjournal/article/download/219292/168797/871014" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li></ol></section><p class="missing-photo">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่</p><section class="research-section" id="highlights"><h2>จุดเด่นที่ควรดู</h2><div class="research-cards"><article class="research-note"><h3>อาคารพิพิธภัณฑ์สองชั้น</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ตัวพิพิธภัณฑ์ชุมชนตั้งอยู่ภายในวัดเสนานุชรังสรรค์</p><a href="https://so05.tci-thaijo.org/index.php/parichartjournal/article/download/219292/168797/871014" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ของใช้และอุปกรณ์ยุคเหมืองแร่</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>จัดเก็บสิ่งของจากยุคทำเหมืองและของหายากที่สะท้อนวิถีชีวิตท้องถิ่น</p><a href="https://so05.tci-thaijo.org/index.php/parichartjournal/article/download/219292/168797/871014" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>อุโบสถอิทธิพลจีน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>อุโบสถขนาดใหญ่มีรูปแบบได้รับอิทธิพลจากสถาปัตยกรรมจีน</p><a href="https://culturalenvi.onep.go.th/site/detail/4412" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>บริบทเมืองเก่าตะกั่วป่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>อยู่ในชุมชนเมืองเก่าที่มีอาคารชิโน-โปรตุกีสและมรดกจากยุคเหมืองแร่</p><a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="news"><h2>ข่าวและความเคลื่อนไหว</h2><div class="research-cards"><article class="research-note"><p class="muted">2026-03-01 · สถานีวิทยุกระจายเสียงแห่งประเทศไทย</p><h3>จังหวัดพังงาจัดงาน จากตะโกลา สู่ตะกั่วป่า ครั้งที่ 12</h3><p>งานส่งเสริมการท่องเที่ยวเมืองเก่าตะกั่วป่าเชื่อมโยงการเรียนรู้วิถีคนตะกั่วป่าและเศรษฐกิจชุมชน แต่ข่าวไม่ได้ยืนยันกิจกรรมภายในพิพิธภัณฑ์โดยตรง</p><a href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><p class="muted">2024-08-28 · กรมประชาสัมพันธ์</p><h3>ย้อนตำนานเมืองตะโกลา สู่เสน่ห์อารยะเมืองเก่าตะกั่วป่า</h3><p>จังหวัดพังงาและเทศบาลประชาสัมพันธ์การท่องเที่ยวเมืองเก่าและกระตุ้นเศรษฐกิจชุมชน ไม่พบข้อความเฉพาะการบูรณะพิพิธภัณฑ์</p><a href="https://www.prd.go.th/th/content/category/detail/id/2040/iid/319567" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>รู้หรือไม่</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>วัดเสนานุชรังสรรค์มีชื่อเดิมว่า “วัดใหม่กำแพง” และอุโบสถได้รับอิทธิพลจากสถาปัตยกรรมจีน</p><a href="https://culturalenvi.onep.go.th/site/detail/4412" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>พิพิธภัณฑ์ชุมชนตะกั่วป่าเป็นอาคารสองชั้นและเก็บของใช้จากยุคเหมืองแร่</p><a href="https://so05.tci-thaijo.org/index.php/parichartjournal/article/download/219292/168797/871014" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="nearby"><h2>ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</h2><ul class="nearby-links"><li>ศาลเจ้าซิ่นใช่ตึ๋ง <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://mapcarta.com/N7619565714" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a> <span class="fact-status unknown">ยังไม่ยืนยัน</span></li><li><a href="/places/khun-in/">บ้านขุนอินทร์</a> <span class="fact-status unknown">ยังไม่ยืนยัน</span></li><li><a href="/places/governor-wall/">กำแพงจวนเจ้าเมืองตะกั่วป่า</a> <span class="fact-status unknown">ยังไม่ยืนยัน</span></li></ul></section><section class="research-section" id="faq"><h2>คำถามที่พบบ่อย</h2><details><summary>ควรแต่งกายอย่างไร</summary><p>ควรแต่งกายสุภาพเมื่อเข้าพื้นที่วัด</p></details><details><summary>สถานที่นี้มีประวัติความเป็นมาอย่างไร</summary><p>พิพิธภัณฑ์ชุมชนตะกั่วป่าเป็นอาคารสองชั้นภายในวัดเสนานุชรังสรรค์ และรวบรวมเครื่องใช้กับอุปกรณ์ที่สะท้อนวิถีชีวิตคนตะกั่วป่า รวมถึงของจากยุคเหมืองแร่ วัดเสนานุชรังสรรค์สร้างโดยพระยาเสนานุชิต (นุช) และอุโบสถมีอิทธิพลทางสถาปัตยกรรมจากจีน</p></details><details><summary>มีจุดเด่นอะไรให้ชม</summary><p>ตัวพิพิธภัณฑ์ชุมชนตั้งอยู่ภายในวัดเสนานุชรังสรรค์ จัดเก็บสิ่งของจากยุคทำเหมืองและของหายากที่สะท้อนวิถีชีวิตท้องถิ่น อุโบสถขนาดใหญ่มีรูปแบบได้รับอิทธิพลจากสถาปัตยกรรมจีน</p></details></section><section class="research-section" id="sources"><h2>ที่มาของข้อมูล</h2><div class="source-table"><table><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>วันที่เข้าถึง</th><th>ลิงก์</th></tr></thead><tbody><tr><th scope="row">สิ่งแวดล้อมศิลปกรรมอันควรอนุรักษ์ (ONEP)</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4412" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">วารสารปาริชาต มหาวิทยาลัยทักษิณ</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://so05.tci-thaijo.org/index.php/parichartjournal/article/download/219292/168797/871014" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ฐานข้อมูลชุมชน ศูนย์มานุษยวิทยาสิรินธร</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">Mapcarta / OpenStreetMap</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://mapcarta.com/N7619565714" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">รายงานทะเบียนวัดจังหวัดพังงา</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.50amfh.org/userfiles/file/News/Thai%20temple%20name%20list/south/Phangnga.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">กรมโบราณคดี ศูนย์มานุษยวิทยาสิรินธร</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">MGR Online</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://mgronline.com/south/detail/9610000016873" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ศูนย์มานุษยวิทยาสิรินธร: เมืองตะกั่วป่า</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สารสนเทศท้องถิ่นภาคใต้ฝั่งอันดามัน</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://www.andamannlttrang.com/%E0%B8%82%E0%B9%89%E0%B8%AD%E0%B8%A1%E0%B8%B9%E0%B8%A5/%E0%B8%AD%E0%B8%B8%E0%B9%82%E0%B8%9A%E0%B8%AA%E0%B8%96%E0%B8%A7%E0%B8%B1%E0%B8%94%E0%B9%80%E0%B8%AA%E0%B8%99%E0%B8%B2%E0%B8%99%E0%B8%B8%E0%B8%8A%E0%B8%A3%E0%B8%B1%E0%B8%87%E0%B8%AA%E0%B8%A3%E0%B8%A3/" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">กรมการค้าภายใน กระทรวงพาณิชย์</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.dit.go.th/th/market/2383/%E0%B8%A0%E0%B8%B2%E0%B8%84%E0%B9%83%E0%B8%95/%E0%B8%9E-%E0%B8%87%E0%B8%87%E0%B8%B2/%E0%B8%96%E0%B8%99%E0%B8%99%E0%B8%A7-%E0%B8%92%E0%B8%99%E0%B8%98%E0%B8%A3%E0%B8%A3%E0%B8%A1%E0%B9%80%E0%B8%A1%E0%B8%AD%E0%B8%87%E0%B9%80%E0%B8%81%E0%B9%88%E0%B8%B2%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2/" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สถานีวิทยุกระจายเสียงแห่งประเทศไทย</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ไม่พบเวลาเปิด-ปิดของพิพิธภัณฑ์โดยตรง</li><li>ไม่พบค่าเข้าชมที่ยืนยันได้สำหรับพิพิธภัณฑ์</li><li>ไม่พบเบอร์โทร เพจเฟซบุ๊ก เว็บไซต์ หรือ LINE ของพิพิธภัณฑ์โดยตรง</li><li>ไม่พบระยะทางและเส้นทางจากตัวเมืองตะกั่วป่า ภูเก็ต เขาหลัก หรือสนามบิน</li><li>ไม่พบข้อมูลยืนยันปีสร้าง ผู้ก่อตั้ง และรายละเอียดการขึ้นทะเบียนของตัวพิพิธภัณฑ์เอง</li><li>ไม่พบข้อมูลยืนยันที่จอดรถ ห้องน้ำ หรือการรองรับรถเข็น</li><li>ไม่พบภาพถ่ายทางการที่ยืนยันสิทธิ์การใช้งาน</li><li>ไม่พบปีเริ่มจัดตั้งพิพิธภัณฑ์และชื่อผู้ก่อตั้ง</li><li>ไม่พบปีขึ้นทะเบียนโบราณสถานของอุโบสถจากข้อความแหล่งที่ตรวจสอบได้</li><li>ไม่พบหลักฐานยืนยันการบูรณะ การถูกทิ้งร้าง หรือความเสียหายจากสึนามิ พ.ศ. 2547 ของตัวพิพิธภัณฑ์</li><li>ไม่พบผู้ดูแลโดยตรง เวลาเปิด-ปิด ค่าเข้าชม และประกาศว่ายังเปิดให้เข้าชมในปี 2569</li><li>ไม่พบข่าวย้อนหลัง 5 ปีที่กล่าวถึงการบูรณะหรือโครงการเฉพาะพิพิธภัณฑ์</li><li>ไม่พบ URL รูปภาพจริงที่ตรวจสอบสิทธิ์และระบุได้แน่ชัดว่าเป็นตัวพิพิธภัณฑ์ จึงเว้น photos_archive และ photos_current เป็นอาร์เรย์ว่าง</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
