site\en\places\pun-thao\index.html:1:<!doctype html><html lang="en" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Pun Thao Kong A Shrine, Takua Pa · Takua Pa 101</title><meta name="description" content="Connecting faith with the old port district · Bun Tao Kong Shrine Takua Pa · Pun Thao Kong Takua Pa · Takua Pa old town shrine"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="Pun Thao Kong A Shrine, Takua Pa"><meta property="og:description" content="Connecting faith with the old port district · Bun Tao Kong Shrine Takua Pa · Pun Thao Kong Takua Pa · Takua Pa old town shrine"><meta property="og:url" content="https://takuapa101.com/places/pun-thao/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/pun-thao.png"><meta property="og:locale" content="en_US"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/pun-thao.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/en/places/pun-thao/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "inLanguage": "en", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "ศาลเจ้าปุนเถ่ากงอ๊า ตะกั่วป่า", "item": "https://takuapa101.com/places/pun-thao/"}]}, {"@context": "https://schema.org", "inLanguage": "en", "@type": "TouristAttraction", "name": "ศาลเจ้าปุนเถ