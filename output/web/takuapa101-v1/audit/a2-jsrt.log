flang="x-default" href="https://takuapa101.com/routes/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" aria-current="page" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/routes/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="intro"><a class="eyebrow" href="/">ตะกั่วป่า 101 / คู่มือเมืองเก่า</a><h1>เลือกจังหวะเดินของคุณ</h1><p class="lead">สามชุดจุดหมาย ที่ชวนมองตะกั่วป่าผ่านคนละเรื่อง</p></div><p class="route-notice">จัดกลุ่มตามความสนใจ ไม่กำหนดระยะทางหรือเวลาเดิน ตรวจสอบการเข้าชมและใช้แผนที่ประกอบก่อนเดินทาง</p><div class="route-jumps"><a href="#route-1">01 / เส้นวัดและเจดีย์</a><a href="#route-2">02 / เส้นศาลเจ้าและโรงเจ</a><a href="#route-3">03 / เส้นตึกเก่าและตลาดริมน้ำ</a><a href="#route-4">04 / เดินสั้นจากบ้านไม้</a></div><section class="route-chapter" id="route-1"><div class="route-chapter-visual"><span class="giant-number">01</span><img src="/assets/wat-boromthat.webp" alt="วัดบรมธาตุคีรีเขต (วัดลุ่ม)" width="1000" height="1000" loading="lazy"><span class="chapter">TAKUA PA / WALK & READ</span></div><div class="route-chapter-copy"><h2>เส้นวัดและเจดีย์</h2><ol class="stops"><li><span>01</span><div><h3><a href="/places/wat-boromthat/">วัดบรมธาตุคีรีเขต (วัดลุ่ม)</a></h3><p>เจดีย์สีขาวกับศรัทธาของเมือง</p></div></li><li><span>02</span><div><h3><a href="/places/wat-khuha/">วัดคุหาภิมุข (วัดควนถ้ำ)</a></h3><p>รายละเอียดเล็กที่ชวนให้หยุดมอง</p></div></li><li><span>03</span><div><h3><a href="/places/wat-pathum/">วัดปทุมธารา (วัดหน้าเมือง)</a></h3><p>โบสถ์เก่ากับเรื่องราวทางน้ำ</p></div></li><li><span>04</span><div><h3><a href="/places/wat-kongkha/">วัดคงคาภิมุข (วัดคงคา)</a></h3><p>เส้นสายอุโบสถแบบปักษ์ใต้</p></div></li><li><span>05</span><div><h3><a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a></h3><p>วัดกับความทรงจำของชุมชน</p></div></li><li><span>06</span><div><h3><a href="/places/wat-sena/">วัดเสนานุชรังสรรค์ (วัดใหม่)</a></h3><p>ร่องรอยไทยและจีนในอาคารเดียวกัน</p></div></li></ol><a class="text-link" href="/map/">เปิดแผนที่ประกอบ ↗</a></div></section><section class="route-chapter" id="route-2"><div class="route-chapter-visual"><span class="giant-number">02</span><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="lazy"><span class="chapter">TAKUA PA / WALK & READ</span></div><div class="route-chapter-copy"><h2>เส้นศาลเจ้าและโรงเจ</h2><ol class="stops"><li><span>01</span><div><h3><a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a></h3><p>ประตูสีแดงกับศรัทธาของชุมชน</p></div></li><li><span>02</span><div><h3><a href="/places/pun-thao/">ศาลเจ้าปุนเถ่ากงอ๊า</a></h3><p>ศรัทธาในย่านท่าเรือเก่า</p></div></li><li><span>03</span><div><h3><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a></h3><p>พื้นที่ฝากความหวังของผู้คน</p></div></li><li><span>04</span><div><h3><a href="/places/rong-jae/">โรงเจในสวน</a></h3><p>ประเพณีที่ส่งต่อผ่านสถานที่</p></div></li></ol><a class="text-link" href="/map/">เปิดแผนที่ประกอบ ↗</a></div></section><section class="route-chapter" id="route-3"><div class="route-chapter-visual"><span class="giant-number">03</span><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" width="1000" height="667" loading="lazy"><span class="chapter">TAKUA PA / WALK & READ</span></div><div class="route-chapter-copy"><h2>เส้นตึกเก่าและตลาดริมน้ำ</h2><ol class="stops"><li><span>01</span><div><h3><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a></h3><p>อาคารที่ส่งต่อภาษาและวัฒนธรรม</p></div></li><li><span>02</span><div><h3><a href="/places/khun-in/">บ้านขุนอินทร์</a></h3><p>หน้าต่างและระเบียงชวนมองอดีต</p></div></li><li><span>03</span><div><h3><a href="/places/governor-wall/">กำแพงจวนเจ้าเมืองตะกั่วป่า</a></h3><p>ร่องรอยบนกำแพงที่เล่าเรื่องเมือง</p></div></li><li><span>04</span><div><h3><a href="/places/culture-street/">ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</a></h3><p>เดินอ่านเมืองผ่านอาคารและผู้คน</p></div></li><li><span>05</span><div><h3><a href="/places/riverwalk/">ตลาดริมน้ำตะกั่วป่า</a></h3><p>อาหารและชีวิตริมแม่น้ำ</p></div></li><li><span>06</span><div><h3><a href="/places/food-center/">ศูนย์อาหารลานโล่งตะกั่วป่า</a></h3><p>หลายรสชาติในจุดหมายเดียว</p></div></li></ol><a class="text-link" href="/map/">เปิดแผนที่ประกอบ ↗</a></div></section><section class="route-chapter" id="route-4"><div class="route-chapter-visual"><span class="giant-number">04</span><img src="/assets/khun-in.webp" alt="บ้านขุนอินทร์" width="1000" height="1000" loading="lazy"><span class="chapter">TAKUA PA / WALK & READ</span></div><div class="route-chapter-copy"><h2>เดินสั้นจากบ้านไม้</h2><ol class="stops"><li><span>01</span><div><h3><a href="/places/khun-in/">บ้านขุนอินทร์</a></h3><p>หน้าต่างและระเบียงชวนมองอดีต</p></div></li><li><span>02</span><div><h3><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a></h3><p>อาคารที่ส่งต่อภาษาและวัฒนธรรม</p></div></li><li><span>03</span><div><h3><a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a></h3><p>ประตูสีแดงกับศรัทธาของชุมชน</p></div></li><li><span>04</span><div><h3><a href="/places/iron-bridge/">สะพานเหล็กบุญสูง</a></h3><p>โครงเหล็กที่เชื่อมเรื่องเหมืองแร่</p></div></li></ol><a class="text-link" href="/map/">เปิดแผนที่ประกอบ ↗</a></div></section><aside class="source"><h2>ที่มาของข้อมูล</h2><p>เรียบเรียงจาก<a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับเทศบาลเมืองตะกั่วป่า</a> · สกัดข้อมูล 6 กันยายน 2569 เอกสารไม่ระบุวันที่เผยแพร่ เวลาเปิด สถานะร้าน และกำหนดงานปัจจุบันยังไม่ได้ยืนยัน ควรตรวจสอบกับสถานที่ก่อนเดินทาง</p></aside></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
