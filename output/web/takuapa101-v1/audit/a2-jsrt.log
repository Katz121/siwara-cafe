site\about\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ข้อมูลนี้มาจากไหน · ตะกั่วป่า 101</title><meta name="description" content="ที่มาของคู่มือเมืองเก่าตะกั่วป่า ความสัมพันธ์กับบ้านศิวรา และขอบเขตข้อมูลจากแผ่นพับเทศบาล"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="ข้อมูลนี้มาจากไหน"><meta property="og:description" content="ที่มาของคู่มือเมืองเก่าตะกั่วป่า ความสัมพันธ์กับบ้านศิวรา และขอบเขตข้อมูลจากแผ่นพับเทศบาล"><meta property="og:url" content="https://takuapa101.com/about/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/default.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/default.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/about/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "ข้อมูลนี้มาจากไหน", "item": "https://takuapa101.com/about/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/about/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/about/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/about/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" aria-current="page" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/about/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="intro"><a class="eyebrow" href="/">ตะกั่วป่า 101 / คู่มือเมืองเก่า</a><h1>เมืองหนึ่งเมือง<br>เล่าได้อีกหลายหน้า</h1><p class="lead">ที่มาของตะกั่วป่า 101 และเรื่องที่เราเลือกนำมาเล่า</p></div><div class="about-layout"><div class="about-illustration"><img src="/assets/culture-street.webp" alt="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" width="1000" height="1000" loading="eager"><span class="chapter">TAKUA PA / PEOPLE & PLACES</span></div><article class="prose"><h2>คู่มือจากบ้านศิวรา</h2><p>ตะกั่วป่า 101 จัดทำโดย <a href="https://siwaracafe.com/">บ้านศิวรา</a> ในตะกั่วป่า เพื่อรวบรวมเรื่องสถานที่ ประเพณี และร้านค้าในเมืองให้อ่านต่อกันได้</p><p>ศิวรา คาเฟ่ เป็นบ้านไม้สักหลังหนึ่งในย่านตลาดเก่า สังเกตได้จากจั่วไม้ กระจกสี และบานประตูไม้เก่าแบบดั้งเดิม ตั้งอยู่ที่ 53 ถนนราษฎร์บำรุง โดยเราตั้งใจให้บ้านไม้หลังนี้พาผู้คนไปรู้จักเมืองให้ลึกซึ้งขึ้น</p><h2>ข้อมูลที่นำมาใช้</h2><p>แผ่นพับเทศบาลเมืองตะกั่วป่าเป็นต้นทางของข้อมูลสถานที่ 20 แห่ง ประเพณี 7 รายการ และรายชื่อร้าน 59 แห่ง รวม 86 รายการ สกัดเมื่อ 6 กันยายน 2569</p><h2>ก่อนออกเดินทาง</h2><p>เอกสารต้นทางไม่ระบุวันที่เผยแพร่ เว็บไซต์จึงยังไม่ยืนยันเวลาเปิด ค่าเข้า สถานะร้าน หรือกำหนดการจัดงานปัจจุบัน ควรติดต่อสถานที่หรือเทศบาลเพื่อยืนยันรายละเอียดก่อนเดินทาง</p><h2>แผนที่ที่คุณเห็น</h2><p>แผนที่ประชาสัมพันธ์ของเทศบาลเมืองตะกั่วป่า ระยะและสัดส่วนไม่ตรงตามพื้นที่จริง เว็บไซต์ใช้ภาพแผนที่ต้นทางโดยตรง และให้ขยายหรือเลื่อนอ่านได้</p></article></div><aside class="source"><h2>ที่มาของข้อมูล</h2><p>เรียบเรียงจาก<a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับเทศบาลเมืองตะกั่วป่า</a> · สกัดข้อมูล 6 กันยายน 2569 เอกสารไม่ระบุวันที่เผยแพร่ เวลาเปิด สถานะร้าน และกำหนดงานปัจจุบันยังไม่ได้ยืนยัน ควรตรวจสอบกับสถานที่ก่อนเดินทาง</p></aside></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
