es/wat-boromthat/", "image": "https://takuapa101.com/assets/wat-boromthat.webp", "description": "มีพระบรมสารีริกธาตุประดิษฐานอยู่ และเป็นสถานที่สำคัญทางศรัทธา", "address": {"@type": "PostalAddress", "streetAddress": "ถนนกลั่นแก้ว ย่านตลาดเก่า (บริเวณซอยคีรีเขต)", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "postalCode": "82110", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8336680169, "longitude": 98.3563150443}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "เปิดให้เข้าชมเวลาใด", "acceptedAnswer": {"@type": "Answer", "text": "ข้อมูลยังไม่ยืนยัน · ทุกวัน 08.00 ถึง 17.00 น."}}, {"@type": "Question", "name": "มีค่าเข้าชมหรือไม่", "acceptedAnswer": {"@type": "Answer", "text": "ข้อมูลยังไม่ยืนยัน · ไม่เสียค่าเข้าชม"}}, {"@type": "Question", "name": "ควรแต่งกายอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "แต่งกายสุภาพเมื่อเข้าสักการะศาสนสถาน"}}, {"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "มุ่งสู่ย่านเมืองเก่าตะกั่วป่า แล้วเข้าถนนกลั่นแก้ว/ซอยคีรีเขต"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "เดิมเป็นที่พักสงฆ์ของพระฝ่ายอรัญวาสี และมีอายุประมาณ 200 ปี ชาวบ้านเรียกวัดนี้ว่า ‘วัดลุ่ม’ เพราะตั้งอยู่ในพื้นที่ลาดลุ่ม"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "ฐานเจดีย์โบราณที่มีต้นไทรใหญ่ขึ้นอยู่บนฐาน เป็นศูนย์รวมศรัทธาสำคัญของชุมชนตามข้อมูลเทศบาล ประดิษฐานอยู่ภายในวัด"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/