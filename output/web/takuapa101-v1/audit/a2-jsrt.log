import os,json
from playwright.sync_api import sync_playwright
pages=[]
for root,ds,fs in os.walk('site'):
    if os.sep+'en'+os.sep in root or root.endswith(os.sep+'en'): continue
    if 'index.html' in fs: pages.append('/'+os.path.relpath(os.path.join(root,'index.html'),'site').replace('\\\\','/').replace('index.html',''))
pages.sort(); out=[]
with sync_playwright() as pw:
    b=pw.chromium.launch(headless=True)
    for u in pages:
        p=b.new_page(); cons=[]; bad=[]
        p.on('console',lambda m: cons.append(m.type+': '+m.text) if m.type in ('error','warning') else None)
        p.on('response',lambda r: bad.append(f'{r.status} {r.url}') if r.status==404 or r.status>=500 else None)
        try: p.goto('http://127.0.0.1:8799'+u,wait_until='networkidle',timeout=15000)
        except Exception as e: cons.append('navigation: '+str(e))
        out.append({'u':u,'console':cons,'requests':bad,'scripts':p.locator('script[src]').evaluate_all('(es)=>es.map(e=>e.getAttribute(\"src\"))')})
        p.close()
    b.close()
print(json.dumps({'count':len(pages),'all':out},ensure_ascii=False))
