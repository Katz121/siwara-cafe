assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/stories/water-trade/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/stories/water-trade/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/stories/water-trade/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/" aria-current="page">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/stories/water-trade/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="story-article-v2"><header class="story-hero-v2"><div class="breadcrumbs"><a href="/">หน้าแรก</a><span>/</span><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><span>/</span><span>สายน้ำและการค้า</span></div><span class="eyebrow">เรื่องเล่าตะกั่วป่า · สายน้ำและการค้า</span><h1>จากทุ่งตึกถึงแม่น้ำตะกั่วป่า: วันที่สายน้ำสร้างเมือง</h1><p class="lead">สายน้ำไม่ได้เป็นเพียงฉากหลัง แต่มันคือเส้นทาง ผู้เชื่อมคน และตัวกำหนดชะตาเมืองที่ต้องย้ายตามตะกอนน้ำ</p><p class="story-meta">ปรับปรุงเมื่อ 2026-09-07 · เวลาอ่าน 7 นาที</p></header><figure class="hero-photo-v2"><img src="/assets/photos/kuapapoh-port.webp" alt="ภาพเก่า เรือจอดที่ท่าน้ำตะกั่วป่า" loading="eager"><figcaption><span>ภาพเก่า เรือจอดที่ท่าน้ำตะกั่วป่า</span><span class="credit">คลังภาพโครงการกั่วป่าโพ้</span></figcaption></figure><div class="story-layout-v2"><div class="story-main-v2"><div class="story-lede-v2"><p>ถ้าคุณยืนอยู่ริมแม่น้ำตะกั่วป่าในวันนี้ สายน้ำที่ไหลเอื่อยและเงียบสงบอาจดูเหมือนเป็นเพียงฉากหลังของภูมิทัศน์เมืองเก่า แต่หากเรามองย้อนกลับไปในหน้าประวัติศาสตร์ แม่น้ำสายนี้ไม่เคยหลับใหล มันคือเส้นเลือดใหญ่ที่สูบฉีดความเจริญ ผู้คน และทรัพยากรเข้าสู่พื้นที่มาหลายศตวรรษ</p><p>เมืองตะกั่วป่าไม่ได้ตั้งอยู่ตรงพิกัดเดิมมาตั้งแต่ต้น แต่มันขยับและเติบโตตามเส้นทางน้ำ จากบริเวณพื้นที่ราบใกล้ปากน้ำสู่ย่านตลาดใหญ่ จนถึงวันที่ตะกอนแม่น้ำบีบให้ศูนย์กลางเมืองต้องย้ายอีกครั้ง</p><p>สายน้ำตะกั่วป่าจึงไม่ใช่แค่ภูมิประเทศทางธรรมชาติ แต่เป็นผู้เขียนประวัติศาสตร์ตัวจริงที่พัดพาพาณิชย์นาวีจากทั่วโลกมาเยือน และเป็นผู้กำหนดชะตากรรมของเมืองในวันที่สายน้ำตื้นเขินลง</p></div><section class="story-section-v2"><h2 id="section-0">ทุ่งตึก ท่าเรือก่อนมีเมือง</h2><figure class="section-photo-v2"><img src="/assets/riverwalk.webp" alt="ตลาดริมน้ำตะกั่วป่า" loading="lazy"><figcaption><span>ตลาดริมน้ำตะกั่วป่า</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>ก่อนที่ภาพจำของเมืองตะกั่วป่าจะเป็นอาคารก่ออิฐถือปูนหรือย่านการค้าชิโน-โปรตุกีสอย่างที่เราเห็นในปัจจุบัน ศูนย์กลางการค้าดั้งเดิมของพื้นที่นี้ตั้งอยู่ที่ทุ่งตึก บริเวณที่ราบใกล้ปากแม่น้ำ ทุ่งตึกทำหน้าที่เป็นเมืองท่าการค้าโบราณที่คึกคักบนเส้นทางข้ามคาบสมุทร</p><p>พื้นที่บริเวณปากแม่น้ำแห่งนี้ไม่ได้เติบโตอย่างโดดเดี่ยว แต่เป็นจิ๊กซอว์ชิ้นสำคัญที่เชื่อมโยงกับเครือข่ายการค้าทางทะเลที่กว้างขวาง มันคือจุดแวะพักและสถานที่แลกเปลี่ยนสินค้าของนักเดินทางจากหลากหลายเชื้อชาติ ที่อาศัยกระแสน้ำและลมมรสุมตามฤดูกาลในการสัญจร</p><p>ลำน้ำตะกั่วป่าในยุคนั้นไม่ได้มีไว้เพื่อการสัญจรของคนในท้องถิ่นเพียงอย่างเดียว แต่ถูกใช้เป็นเส้นทางหลักในการเดินทางข้ามคาบสมุทรระหว่างฝั่งทะเลอันดามันและอ่าวไทย ด้วยระยะระหว่างต้นน้ำสองฝั่งที่เอื้ออำนวย เส้นทางนี้ช่วยลดเวลาเดินทางลงได้อย่างมหาศาล</p><p>ที่สำคัญ การใช้เส้นทางแม่น้ำยังช่วยให้นักเดินเรือหลีกเลี่ยงอันตรายและความเสี่ยงจากการต้องเดินเรืออ้อมช่องแคบมะละกาที่ยาวไกล สายน้ำจึงทำหน้าที่เสมือนสะพานเชื่อมสองฝั่งมหาสมุทร พาผู้คน สินค้า และวัฒนธรรมไหลเวียนเข้าสู่พื้นที่อย่างต่อเนื่อง นี่คือปฐมบทของเมืองท่า ก่อนที่ศูนย์กลางความเจริญจะขยับขยายลึกเข้ามาในแผ่นดินตามสายน้ำ</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">ข้อสันนิษฐานสถานะท่าเรือโบราณ</span></div></section><blockquote class="pull-quote-v2"><p>เมืองตะกั่วป่าไม่ได้ตั้งอยู่ตรงพิกัดเดิมมาตั้งแต่ต้น แต่มันขยับและเติบโตตามเส้นทางน้ำ</p></blockquote><section class="story-section-v2"><h2 id="section-1">หม้อไอน้ำกับความรุ่งเรืองของตลาดใหญ่</h2><figure class="section-photo-v2"><img src="/assets/iron-bridge.webp" alt="สะพานเหล็กบุญสูง" loading="lazy"><figcaption><span>สะพานเหล็กบุญสูง</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>เมื่อยุคสมัยเปลี่ยนผ่านและการค้าทางทะเลขยับเข้ามาสู่พื้นที่ด้านใน ศูนย์กลางของเมืองได้ย้ายมาที่ชุมชนตลาดใหญ่ในยุคฟื้นฟูเมืองสมัยรัชกาลที่สาม พื้นที่บริเวณนี้มีแม่น้ำล้อมรอบถึงสามด้าน ซึ่งเหมาะอย่างยิ่งทั้งสำหรับการป้องกันเมืองและการสัญจรทางน้ำ</p><p>การค้าทางน้ำของตะกั่วป่ายังคงเฟื่องฟูและทิ้งร่องรอยทางวัตถุเอาไว้ให้เราเห็นจนถึงปัจจุบัน หากคุณเดินทางไปยังวัดปทุมธาราหรือวัดหน้าเมืองในย่านตลาดใหญ่ คุณจะพบกับหม้อไอน้ำขนาดใหญ่ตั้งอยู่ ชิ้นส่วนโลหะนี้ไม่ใช่เครื่องจักรทำเหมือง แต่เป็นชิ้นส่วนสำคัญของเรือกลไฟในอดีต</p><p>พระยาเสนานุชิต (นุช ณ นคร) ได้ร่วมทุนกับพระยาวิชิตสงครามซื้อเรือกลไฟลำนี้มาใน พ.ศ. 2410 เพื่อใช้ขนส่งสินค้าและปราบปรามโจรสลัดในน่านน้ำ มันเป็นเครื่องยืนยันถึงความมั่งคั่งและปริมาณการสัญจรที่หนาแน่นในยุคนั้น</p><p>แม้ในเวลาต่อมาเรือกลไฟจะเสื่อมสภาพและจมลงในลำน้ำตะกั่วป่า แต่หม้อไอน้ำที่กู้ขึ้นมาได้ก็ยังคงตั้งตระหง่านเป็นประจักษ์พยาน ความคึกคักของชุมชนตลาดใหญ่ในเวลานั้นผูกพันอยู่กับแม่น้ำอย่างแยกไม่ออก วิถีชีวิตของผู้คนต่างพึ่งพาสายน้ำที่ทำหน้าที่เสมือนถนนสายหลักของเมือง</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">บทบาทวัดกับการค้า</span></div></section><section class="story-section-v2"><h2 id="section-2">วันที่ตะกอนทับถมและเมืองต้องขยับ</h2><figure class="section-photo-v2"><img src="/assets/wat-pathum.webp" alt="วัดปทุมธารา (วัดหน้าเมือง)" loading="lazy"><figcaption><span>วัดปทุมธารา (วัดหน้าเมือง)</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>แต่สายน้ำเป็นสิ่งที่ไม่เคยหยุดนิ่ง และธรรมชาติก็มีบทบาทในการกำหนดชะตาเมืองเสมอ เมื่อเวลาผ่านไป ตะกอนดินจากการทำเหมืองแร่ที่เติบโตขึ้นอย่างรวดเร็วและปรากฏการณ์ทางธรรมชาติ ได้ทับถมจนลำน้ำตะกั่วป่าเริ่มตื้นเขินขึ้นเรื่อย·</p><p>การเปลี่ยนแปลงทางภูมิศาสตร์นี้ส่งผลกระทบโดยตรงต่อโครงสร้างเศรษฐกิจของเมือง การเดินเรือที่เคยสะดวกสบายกลับลดลงและยากลำบากขึ้น เรือสินค้าขนาดใหญ่ที่เคยนำความมั่งคั่งมาให้ ไม่สามารถเทียบท่าได้สะดวกเหมือนในอดีต ทำให้ความคึกคักของชุมชนตลาดใหญ่เริ่มถดถอย</p><p>ในที่สุด ศูนย์กลางของเมืองก็จำต้องย้ายออกจากพื้นที่เดิมบริเวณบ้านตลาดใหญ่ ไปยังย่านใหม่ที่เรียกว่าย่านย่านยาว ใน พ.ศ. 2456 การย้ายเมืองครั้งนี้ไม่ได้เกิดจากภัยสงครามหรือโรคระบาด แต่เกิดจากขีดจำกัดของสายน้ำที่เปลี่ยนแปลงไปจนไม่เอื้อต่อการค้าอีกต่อไป</p><p>เหตุการณ์ประวัติศาสตร์นี้พิสูจน์ให้เห็นว่าสายน้ำมีอิทธิพลเหนือการตั้งถิ่นฐานของผู้คนอย่างสมบูรณ์ วันที่น้ำตื้นเขิน คือวันที่เมืองต้องเก็บข้าวของและเดินทางไปสร้างลมหายใจใหม่ในพื้นที่ที่สามารถรองรับความเปลี่ยนแปลงได้ดีกว่า</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">วันที่และสาเหตุการย้ายเมือง</span></div></section><section class="story-section-v2"><h2 id="section-3">สะพานเหล็กบุญสูง ทางเชื่อมของคนเหมือง</h2><figure class="section-photo-v2"><img src="/assets/thung-phra.webp" alt="สวนสาธารณะทุ่งพระโพธิ์" loading="lazy"><figcaption><span>สวนสาธารณะทุ่งพระโพธิ์</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>เมื่อศูนย์กลางเมืองเปลี่ยนผ่านจากยุคท่าเรือพาณิชย์มาสู่ยุคทองของการทำเหมืองดีบุก ภูมิทัศน์และโครงสร้างพื้นฐานริมแม่น้ำก็ถูกปรับเปลี่ยนตามไปด้วย ในอดีต คลองตะกั่วป่ามีความกว้างกว่าสี่สิบเมตร เป็นอุปสรรคทางธรรมชาติที่ขวางกั้นพื้นที่</p><p>ความกว้างของลำน้ำทำให้คนงานเหมืองและชาวบ้านต้องพายเรือแจวข้ามไปมาระหว่างฝั่งตลาดเก่ากับพื้นที่ของบริษัทเหมืองแร่ เพื่อแก้ปัญหาการสัญจรที่ยากลำบาก โดยเฉพาะในฤดูน้ำหลากที่กระแสน้ำเชี่ยวกราก นายจุติ บุญสูง ผู้ก่อตั้งบริษัทเรือขุดแร่ จึงได้ริเริ่มสร้างสะพานไม้ขึ้นก่อน เพื่อให้คนสามารถเดินและขี่จักรยานข้ามได้</p><p>จนกระทั่งใน พ.ศ. 2511 ได้มีการปรับปรุงสะพานครั้งใหญ่ โดยนำเอาเหล็กจากเรือขุดแร่ที่เลิกใช้งานแล้ว มาประกอบสร้างขึ้นใหม่เป็นสะพานเหล็กโคกขนุน หรือที่เราคุ้นเคยกันในชื่อสะพานเหล็กบุญสูง ด้วยความยาวที่ทอดข้ามแม่น้ำกว่าสองร้อยเมตร</p><p>สะพานเหล็กแห่งนี้จึงไม่ได้เป็นแค่วัตถุก่อสร้างหรือโครงสร้างทางวิศวกรรม แต่มันคือทางลัดที่ย่นระยะเวลาของแรงงาน เป็นเส้นทางขนส่งสินค้า และเป็นทางเชื่อมชีวิตประจำวัน สัญลักษณ์ชิ้นนี้บอกเล่าการเปลี่ยนผ่านจากยุคเรือแจวมาสู่ยุคอุตสาหกรรมเหมืองแร่ที่หล่อเลี้ยงเศรษฐกิจของเมืองอย่างทรงพลัง</p></section><section class="story-section-v2"><h2 id="section-4">พื้นที่รับน้ำและงานบุญที่ทุ่งพระโพธิ์</h2><p>สายน้ำตะกั่วป่าไม่เพียงแต่หล่อเลี้ยงเศรษฐกิจ แต่ยังผูกพันกับชีวิตประจำวันและการรับมือกับธรรมชาติของชาวเมือง พื้นที่ริมน้ำอย่างสวนสาธารณะทุ่งพระโพธิ์ เป็นตัวอย่างที่ชัดเจนของการปรับตัวให้อยู่ร่วมกับระบบน้ำของเมืองเก่า</p><p>เอกสารแผนงานของเทศบาลระบุว่าพื้นที่ทุ่งพระโพธิ์มีความสำคัญในฐานะโครงสร้างพื้นฐานในการจัดการน้ำ โดยมีโครงการขุดลอกคลองส่งน้ำและก่อสร้างท่าน้ำ ในช่วงเวลาที่เมืองเผชิญปัญหาน้ำท่วม พื้นที่นี้ยังถูกใช้เป็นจุดติดตั้งเครื่องสูบน้ำเพื่อบรรเทาอุทกภัยให้แก่ชุมชน</p><p>แต่นอกจากมิติของการรับมือภัยธรรมชาติแล้ว ทุ่งพระโพธิ์ยังเป็นพื้นที่เปิดโล่งสำหรับกิจกรรมทางวัฒนธรรม ในวันเพ็ญเดือนสิบสองของทุกปี ลานกว้างริมน้ำแห่งนี้จะถูกใช้เป็นสถานที่จัดงานประเพณีลอยกระทงประจำปีของเทศบาล</p><p>การใช้งานที่หลากหลายนี้สะท้อนให้เห็นว่า พื้นที่ริมสายน้ำไม่ได้ถูกทิ้งร้างหลังยุคเหมืองแร่ แต่ถูกปรับเปลี่ยนหน้าที่ให้กลายเป็นทั้งกลไกป้องกันเมืองและลานกิจกรรมที่รวมผู้คนเข้าไว้ด้วยกันในวันงานบุญ</p></section><section class="story-section-v2"><h2 id="section-5">ร่องรอยที่ยังไหลเวียนในภูมิทัศน์ปัจจุบัน</h2><p>วันนี้ แม้เหมืองแร่จะปิดตัวลงและการค้าทางเรือขนาดใหญ่จะกลายเป็นเพียงอดีตที่ถูกบันทึกไว้ในหน้ากระดาษ แต่สถานที่ริมน้ำหลายแห่งยังคงมีชีวิตและอยู่ร่วมกับลมหายใจของคนเมืองเก่าตะกั่วป่าอย่างกลมกลืน</p><p>สะพานเหล็กบุญสูงยังคงทำหน้าที่เป็นทางสัญจรของชุมชน ที่ชาวบ้านยังคงใช้เดินเท้าและขี่รถจักรยานยนต์ผ่านไปมา ในขณะเดียวกัน มันก็ได้กลายเป็นแลนด์มาร์กที่ผู้คนมาชมวิวและถ่ายภาพร่องรอยของโรงขุดแร่เก่าที่ยังมองเห็นได้จากบนสะพาน หรือแม้แต่ถูกใช้เป็นสถานที่ถ่ายทำภาพยนตร์ต่างประเทศ</p><p>บริเวณริมคลองใกล้กับวัดย่านยาว ก็ได้มีการริเริ่มพื้นที่ตลาดชุมชนในชื่อตลาดริมน้ำตะกั่วป่า เพื่อช่วยปลุกบรรยากาศเก่า· ให้ผู้คนได้กลับมาสัมผัสวิถีชีวิตริมน้ำอีกครั้ง และมีการจัดเทศกาลอาหารทะเลตามปฏิทินวัฒนธรรม</p><p>สายน้ำตะกั่วป่ายังคงไหลเอื่อย เป็นผู้พิทักษ์ความทรงจำตั้งแต่วันที่เป็นเมืองท่าระดับโลกที่คลาคล่ำไปด้วยเรือสินค้า จนถึงวันที่เป็นจุดชมวิวที่สงบงามของเมืองเก่าที่เราเห็นในปัจจุบัน</p></section><section class="story-places-v2"><h2>ไปดูของจริงได้ที่ไหน</h2><div class="mini-cards-v2"><div class="place-card-mini"><div><h3>ตลาดริมน้ำตะกั่วป่า</h3><button class="button button-outline" data-trip-add="riverwalk">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>สะพานเหล็กบุญสูง</h3><button class="button button-outline" data-trip-add="iron-bridge">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>วัดปทุมธารา (วัดหน้าเมือง)</h3><button class="button button-outline" data-trip-add="wat-pathum">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>สวนสาธารณะทุ่งพระโพธิ์</h3><button class="button button-outline" data-trip-add="thung-phra">เพิ่มลงทริป</button></div></div></div></section><details class="unknowns-box-v2"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ลักษณะสถาปัตยกรรมและรายละเอียดผังเมืองของท่าเรือทุ่งตึกในยุคก่อนการค้าเหมืองแร่ดีบุก</li><li>ภาพถ่ายร่วมสมัยที่สามารถระบุสิทธิ์การใช้งานได้ชัดเจน ซึ่งแสดงความคับคั่งของการจราจรทางน้ำในยุคที่เรือกลไฟยังแล่นได้</li><li>เอกสารบันทึกเหตุการณ์วันที่ย้ายเมืองไปย่านยาวอย่างเป็นทางการ และเสียงสะท้อนของชาวบ้านในชุมชนตลาดใหญ่ในขณะนั้น</li></ul></details><section class="story-sources-v2"><h2>แหล่งข้อมูล</h2><ol><li><cite>ทุ่งตึกเมืองท่าการค้าโบราณ</cite> · กรมศิลปากร · บทความแหล่งโบราณคดีทุ่งตึก · <a href="https://www.finearts.go.th/architecture/view/35708-ทุ่งตึกเมืองท่าการค้าโบราณ" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>เอกสารเมืองเก่าตะกั่วป่า</cite> · สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (สผ.) · PDF หน้า 11 ถึง 13, 55 ถึง 56, 58 · <a href="https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ฐานข้อมูลแหล่งโบราณคดี: ชุมชนตลาดใหญ่</cite> · ศูนย์มานุษยวิทยาสิรินธร · ข้อมูลประวัติศาสตร์ชุมชน · <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>สะพานเหล็กบุญสูง (โคกขนุน)</cite> · ฐานข้อมูลท้องถิ่นภาคใต้ มหาวิทยาลัยสงขลานครินทร์ · หน้าประวัติและภาพรวม · <a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>เอกสารแผนการดำเนินงานด้านสิ่งแวดล้อม พ.ศ.2565</cite> · เทศบาลเมืองตะกั่วป่า · ระเบียนโครงการและการจัดการน้ำ · <a href="https://www.takuapacity.go.th/files/com_strategy/2022-12_231dcd9d5169573.pdf" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ข่าวน้ำท่วมตะกั่วป่าและการติดตั้งเครื่องสูบน้ำ</cite> · MGR Online · ข่าวภูมิภาค · <a href="https://mgronline.com/south/detail/9560000096203" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ตลาดริมน้ำตะกั่วป่า ร่วมใจประชารัฐ</cite> · กรมการค้าภายใน กระทรวงพาณิชย์ · ข้อมูลตลาดต้องชม · <a href="https://www.dit.go.th/FILE/CONTENT_FILE/256202181736250948974.pdf" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ข่าวเช้า: สะพานเหล็กบุญสูง</cite> · NBT2HD · รายการข่าว 30 มกราคม 2569 · <a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ปฏิทินเทศกาลอาหารทะเล ตลาดริมน้ำตะกั่วป่า</cite> · กระทรวงวัฒนธรรม · ปฏิทินกิจกรรมวัฒนธรรม · <a href="https://calendar.m-culture.go.th/events/103651" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li></ol></section></div><div class="story-sidebar-v2"><aside class="evidence-box-v2"><h3>หลักฐานอยู่ตรงไหน</h3><ul class="ev-items-v2"><li><div class="ev-claim">ระยะทางข้ามคาบสมุทรและจุดเริ่มต้นของทุ่งตึก</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">ตัวเลขระยะทางเป็นข้อมูลจากรายงาน สผ. และการจัดตั้งทุ่งตึกอ้างอิงจากคำอธิบายของกรมศิลปากร ซึ่งเว็บไซต์คงระดับข้อความไว้ตามเอกสารต้นฉบับ ไม่ได้ยืนยันข้อสรุปใหม่ <a href="https://www.finearts.go.th/architecture/view/35708-ทุ่งตึกเมืองท่าการค้าโบราณ" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">การย้ายเมืองเพราะแม่น้ำตื้นเขิน</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">วันที่และเหตุผลการย้ายเมืองใน พ.ศ. 2456 เป็นการรวบรวมข้อมูลตามรายงาน สผ. ซึ่งควรอ้างอิงตามรายงานฉบับต้นทางเมื่อใช้ในงานวิชาการ <a href="https://culturalenvi.onep.go.th/site/detail/4428" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">ที่มาของหม้อไอน้ำวัดหน้าเมือง</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">ข้อมูลจากฐานข้อมูลศูนย์มานุษยวิทยาสิรินธรระบุถึงการซื้อเรือกลไฟใน พ.ศ. 2410 แต่หลักฐานชิ้นนี้ไม่ได้ยืนยันว่าวัดเป็นผู้ดำเนินกิจการเหมืองแร่โดยตรง <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li></ul></aside><nav class="story-toc-v2 scrollspy" id="story-toc"><h2>เนื้อหาในบทความ</h2><ul class="scrollspy-nav"><li><a href="#section-0">ทุ่งตึก ท่าเรือก่อนมีเมือง</a></li><li><a href="#section-1">หม้อไอน้ำกับความรุ่งเรืองของตลาดใหญ่</a></li><li><a href="#section-2">วันที่ตะกอนทับถมและเมืองต้องขยับ</a></li><li><a href="#section-3">สะพานเหล็กบุญสูง ทางเชื่อมของคนเหมือง</a></li><li><a href="#section-4">พื้นที่รับน้ำและงานบุญที่ทุ่งพระโพธิ์</a></li><li><a href="#section-5">ร่องรอยที่ยังไหลเวียนในภูมิทัศน์ปัจจุบัน</a></li></ul></nav></div></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
site\assets\site.js:2:if(search){const category=document.querySelector('#shop-category');const groups=[...document.querySelectorAll('.shop-group')];const filter=()=>{let total=0;const query=search.value.trim().normalize('NFC').toLocaleLowerCase('th');for(const group of groups){let count=0;for(const row of group.querySelectorAll('[data-shop]')){const visible=(category.value==='all'||category.value===group.dataset.category)&&row.dataset.shop.normalize('NFC').toLocaleLowerCase('th').includes(query);row.hidden=!visible;if(visible)count++;}group.hidden=count===0;total+=count;}document.querySelector('#results').textContent=`แสดง ${total} ร้าน`;document.querySelector('#empty').hidden=total!==0;};search.addEventListener('input',filter);category.addEventListener('change',filter);}
site\stories\food-people\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>อาหารบาบ๋าตะกั่วป่า รสชาติของชุมชนตลาดเก่า · ตะกั่วป่า 101</title><meta name="description" content="อาหารเป็นทั้งความทรงจำของครัวเรือนและหลักฐานของการแลกเปลี่ยน · ลองอ่านตะกั่วป่าผ่านสำรับบาบ๋า เต้าส้อสองชั้น และถนนสายวัฒนธรรม"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="อาหารบาบ๋าตะกั่วป่า รสชาติของชุมชนตลาดเก่า"><meta property="og:description" content="อาหารเป็นทั้งความทรงจำของครัวเรือนและหลักฐานของการแลกเปลี่ยน · ลองอ่านตะกั่วป่าผ่านสำรับบาบ๋า เต้าส้อสองชั้น และถนนสายวัฒนธรรม"><meta property="og:url" content="https://takuapa101.com/stories/food-people/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/default.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/default.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/stories/food-people/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "อาหารบาบ๋าตะกั่วป่า รสชาติของชุมชนตลาดเก่า", "item": "https://takuapa101.com/stories/food-people/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/stories/food-people/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/stories/food-people/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/stories/food-people/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/" aria-current="page">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/stories/food-people/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="story-article-v2"><header class="story-hero-v2"><div class="breadcrumbs"><a href="/">หน้าแรก</a><span>/</span><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><span>/</span><span>ผู้คนและรสชาติ</span></div><span class="eyebrow">เรื่องเล่าตะกั่วป่า · ผู้คนและรสชาติ</span><h1>รสชาติของชุมชนบาบ๋าและตลาดเก่า</h1><p class="lead">อาหารเป็นทั้งความทรงจำของครัวเรือนและหลักฐานของการแลกเปลี่ยน · ลองอ่านตะกั่วป่าผ่านสำรับบาบ๋า เต้าส้อสองชั้น และถนนสายวัฒนธรรม</p><p class="story-meta">ปรับปรุงเมื่อ 2026-09-07 · เวลาอ่าน 7 นาที</p></header><figure class="hero-photo-v2 is-illustration"><img src="/assets/food-center.webp" alt="ศูนย์อาหารลานโล่งตะกั่วป่า" loading="eager"><figcaption><span>ศูนย์อาหารลานโล่งตะกั่วป่า</span><span class="credit">ภาพวาดประกอบ · ยังไม่มีภาพถ่ายที่ได้รับอนุญาตของเรื่องนี้</span></figcaption></figure><div class="story-layout-v2"><div class="story-main-v2"><div class="story-lede-v2"><p>เมืองที่เคยเป็นศูนย์กลางเหมืองแร่ดีบุกและท่าเรือบนเส้นทางข้ามคาบสมุทรอย่างตะกั่วป่า ไม่ได้ทิ้งไว้เพียงร่องรอยของตึกเก่าชิโน-โปรตุกีส หรือตารางเวลาเปิดปิดตลาดในย่านชุมชนเท่านั้น แต่ยังซ่อนเรื่องราวของตัวเองไว้ในรสชาติและการกินอยู่ของผู้คน</p><p>ตะกั่วป่าในเอกสารราชการปรากฏภาพของชุมชนที่เติบโตขึ้นจากการรับวัฒนธรรมภายนอกเข้ามาผสมผสาน อาหารแต่ละจานจึงเป็นเหมือนเครื่องสะท้อนถึงการอพยพตั้งถิ่นฐาน การแต่งงานข้ามวัฒนธรรม และความเปลี่ยนแปลงของย่านการค้าในแต่ละยุคสมัย รสชาติในทุกวันนี้คือการบอกเล่าความทรงจำที่กินได้</p></div><section class="story-section-v2"><h2 id="section-0">ตะกั่วป่าในแผนที่อาหารบาบ๋า</h2><figure class="section-photo-v2"><img src="/assets/culture-street.webp" alt="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>เมื่อพูดถึงวัฒนธรรมอาหารในฝั่งอันดามัน กรมส่งเสริมวัฒนธรรมได้ระบุชื่อตะกั่วป่าไว้ในกลุ่มชุมชนอาหารบาบ๋า-เปอรานากันอย่างเป็นทางการ ตั้งแต่การขึ้นทะเบียนมรดกภูมิปัญญาทางวัฒนธรรมของชาติใน พ.ศ. 2556 การระบุเช่นนี้เป็นการวางตะกั่วป่าให้เป็นส่วนหนึ่งของเครือข่ายลูกหลานชาวจีนโพ้นทะเล ที่เดินทางเข้ามาทำเหมืองดีบุกและได้ตั้งรกรากร่วมกับคนท้องถิ่น</p><p>ความรู้เรื่องรสชาติและการปรุงอาหารเหล่านี้ไม่ได้เกิดขึ้นจากคนกลุ่มใดกลุ่มหนึ่งแบบตัดขาดจากโลกภายนอก แต่เกิดจากการส่งต่อความทรงจำและวิธีการทำอาหารภายในครอบครัว เป็นเรื่องของการรักษาเอกลักษณ์และรสสัมผัสจากรุ่นสู่รุ่น ไม่ว่าจะเป็นเมนูอาหารคาวในมื้อปกติ หรือขนมในงานพิธีกรรมสำคัญของครอบครัว</p><p>อย่างไรก็ตาม การที่เมืองตะกั่วป่าถูกจัดให้อยู่ในแผนที่วัฒนธรรมอาหารนี้ เป็นการอธิบายบริบททางวัฒนธรรมในภาพรวม ไม่ได้หมายความว่าทุกบ้านหรือทุกร้านค้าในตะกั่วป่าจะมีสูตรหมูฮ้อง โอต้าว หรือขนมเต่าแดงที่เหมือนกันทุกกระเบียดนิ้ว ความหลากหลายในแต่ละครัวเรือนยังคงเป็นหัวใจสำคัญของการมีชีวิตของอาหารท้องถิ่น</p></section><blockquote class="pull-quote-v2"><p>การอ่านเมนูอาหาร หรือการสังเกตวัตถุดิบท้องถิ่นที่นำมาใช้ปรุงในตลาด คือการทำความรู้จักกับวิถีชีวิตและรสชาติของตะกั่วป่าอย่างเป็นธรรมชาติและค่อยเป็นค่อยไป</p></blockquote><section class="story-section-v2"><h2 id="section-1">เต้าส้อสองชั้นกับความเปลี่ยนแปลงของเมือง</h2><p>ในบรรดาของกินท้องถิ่นที่ถูกพูดถึงบ่อยครั้ง เต้าส้อเป็นชื่อที่ปรากฏชัดเจนในบันทึกของหน่วยงานรัฐ สำนักงานการท่องเที่ยวและกีฬาจังหวัดพังงาระบุว่าเต้าส้อเป็นทั้งของฝากขึ้นชื่อและสินค้าโอทอปของเมืองตะกั่วป่า โดยอธิบายลักษณะว่ามีความคล้ายคลึงกับขนมเปี๊ยะแต่มีขนาดเล็กกว่าและนิยมโรยงาไว้ด้านบน</p><p>การคงอยู่ของเต้าส้อในตะกั่วป่ายังได้รับการบันทึกจากสำนักงานคณะกรรมการอาหารและยา ในการลงพื้นที่ตรวจสอบเมื่อเดือนสิงหาคม 2568 โดยบันทึกว่าร้านตวงรัตน์ยังคงสืบทอดการทำเต้าส้อด้วยการใช้แป้งสองชั้นแบบดั้งเดิม และความพยายามนี้ทำให้ได้รับรางวัล อย. ควอลิตี้ อวอร์ด สาขาผลิตภัณฑ์สุขภาพดีเด่น ประเภทส่งเสริมเศรษฐกิจฐานรากอีกด้วย</p><p>เรื่องราวของขนมเต้าส้อช่วยให้เรามองเห็นว่าขนมท้องถิ่นสามารถพัฒนาและเติบโตไปพร้อมกับเศรษฐกิจของเมืองได้ แต่ในขณะเดียวกัน เราก็ไม่อาจสรุปด่วนได้ว่าเต้าส้อถือกำเนิดที่ตะกั่วป่าเป็นที่แรกของโลก หรือมีสูตรต้นตำรับเพียงหนึ่งเดียวผูกขาดอยู่ที่นี่ เนื่องจากยังไม่มีหลักฐานทางประวัติศาสตร์ชิ้นใดที่ยืนยันถึงจุดกำเนิดแรกสุดได้อย่างชัดเจน</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">แหล่งกำเนิดและสูตรต้นตำรับยังไม่มีข้อยุติ</span></div></section><section class="story-section-v2"><h2 id="section-2">ถนนวัฒนธรรมกับย่านการค้าเดิม</h2><p>เมื่อเดินเข้าสู่ถนนศรีตะกั่วป่าและถนนอุดมธารา เรากำลังก้าวเข้าไปในอดีตศูนย์กลางการค้าแห่งยุคเหมืองแร่ดีบุก ร่องรอยของยุคทองยังคงปรากฏผ่านรูปทรงตึกแถวแบบอิทธิพลอาณานิคมช่องแคบที่มีทางเดินมีหลังคาด้านหน้า ปัจจุบันถนนเหล่านี้ถูกปรับบริบทให้กลายเป็นพื้นที่สำหรับถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า เพื่อดึงผู้คนให้กลับมาใช้ชีวิตในย่านเก่าอีกครั้ง</p><p>ทะเบียนของกรมการค้าภายในบันทึกว่าตลาดแห่งนี้เป็นแหล่งรวมขนมพื้นบ้าน อาหารพื้นเมือง งานหัตถกรรม งานจักสาน และกิจกรรมศิลปวัฒนธรรม ถนนเก่าที่เคยหลับใหลจึงถูกปลุกให้ตื่นขึ้นมามีชีวิตอีกครั้งในทุกบ่ายวันอาทิตย์ สร้างพื้นที่ที่คนรุ่นใหม่และคนดั้งเดิมได้พบปะพูดคุยกันผ่านร้านค้าและอาหาร</p><p>อย่างไรก็ตาม จุดเริ่มต้นของการจัดกิจกรรมยังมีข้อมูลที่ไม่ได้สรุปตรงกันทั้งหมด ข่าวท้องถิ่นบางแห่งระบุว่าเริ่มจัดงานเล่าความหลังมาตั้งแต่ พ.ศ. 2550 ขณะที่ทะเบียนตลาดของราชการระบุวันก่อตั้งและส่งเสริมตลาดใน พ.ศ. 2560 ความแตกต่างของข้อมูลเหล่านี้อาจตีความได้ว่าเป็นคนละหมุดหมาย ระหว่างจุดเริ่มกิจกรรมโดยชุมชนกับการขึ้นทะเบียนส่งเสริมให้เป็นตลาดอย่างเป็นทางการของรัฐ</p><div class="story-flags-v2"><span class="story-flag-v2 flag-disputed">ปีเริ่มจัดงานมีแหล่งข้อมูลไม่ตรงกัน</span></div></section><section class="story-section-v2"><h2 id="section-3">ตลาดลานโล่ง จุดนัดพบของความหลากหลาย</h2><p>นอกจากถนนคนเดินที่เปิดสัปดาห์ละครั้งแล้ว ตะกั่วป่ายังมีพื้นที่ศูนย์รวมอาหารที่พร้อมรองรับผู้คนในแต่ละวัน เช่น ศูนย์อาหารลานโล่งตะกั่วป่า ที่นี่รวบรวมอาหารจานหลักหลากชนิด ตั้งแต่ข้าวราดแกง อาหารตามสั่ง ขนมจีน ก๋วยเตี๋ยว ไปจนถึงของหวานและเครื่องดื่มแบบครบครัน</p><p>สถานที่เหล่านี้ไม่ได้เป็นเพียงแหล่งซื้อขายแลกเปลี่ยนสินค้า แต่ยังทำหน้าที่เป็นพื้นที่แลกเปลี่ยนบทสนทนาของคนในเมือง การอ่านเมนูอาหารที่เขียนด้วยลายมือ หรือการสังเกตวัตถุดิบท้องถิ่นที่นำมาใช้ปรุงในตลาด คือการทำความรู้จักกับวิถีชีวิตและรสชาติของตะกั่วป่าอย่างเป็นธรรมชาติและค่อยเป็นค่อยไป</p><p>สำหรับข้อมูลเรื่องเวลาเปิดปิดของศูนย์อาหาร หรือสถานะของร้านค้าเฉพาะเจาะจง ข้อมูลบนอินเทอร์เน็ตอาจมีความคลาดเคลื่อนและไม่ได้อัปเดตแบบเรียลไทม์เสมอไป การเดินสอบถามจากผู้คนในพื้นที่ หรือตรวจเช็กข้อมูลกับผู้ค้าโดยตรงก่อนการเดินทาง จึงเป็นวิธีที่ทำให้คุณไม่พลาดโอกาสลิ้มรสอาหารจานโปรด</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">เวลาเปิดปิดและราคาอาจเปลี่ยนแปลงตามฤดูกาล</span></div></section><section class="story-section-v2"><h2 id="section-4">ศิวรา คาเฟ่ ในระบบเรื่องเล่าของเมือง</h2><p>หากคุณมาเยือนเมืองตะกั่วป่าในวันนี้ คุณอาจพบเห็นร้านกาแฟและคาเฟ่หลายแห่งที่พยายามนำเสนอเรื่องราวของเมืองผ่านเครื่องดื่มและการตกแต่ง ศิวรา คาเฟ่ ก็เป็นหนึ่งในนั้น และยังเป็นผู้จัดทำข้อมูลตะกั่วป่า 101 นี้ขึ้นมาด้วย โดยเว็บไซต์ได้จัดคาเฟ่ไว้ในหมวดหมู่ร้านเครื่องดื่มโดยเฉพาะ</p><p>การจัดหมวดหมู่และอธิบายเช่นนี้ ทำไปเพื่อให้ผู้อ่านสามารถแยกแยะบทบาทของผู้จัดทำข้อมูลออกจากข้อเท็จจริงทางประวัติศาสตร์ได้อย่างชัดเจน โปร่งใส และไม่สับสน ส่วนข้อมูลเวลาทำการ เมนูใหม่ๆ หรือราคาสินค้านั้น ผู้อ่านสามารถตรวจสอบรายละเอียดล่าสุดได้จากช่องทางการสื่อสารของทางร้านโดยตรง</p><p>การเติบโตของร้านกาแฟและพื้นที่นั่งเล่นในปัจจุบัน ถือเป็นภาพสะท้อนของการต่อยอดวัฒนธรรมการดื่มกินจากอดีต ที่ผสมผสานเข้ากับไลฟ์สไตล์ของคนรุ่นใหม่และคนท้องถิ่นที่เข้ามามีส่วนร่วมในการฟื้นฟูย่านเก่าให้กลับมามีชีวิตชีวาอีกครั้ง</p></section><section class="story-places-v2"><h2>ไปดูของจริงได้ที่ไหน</h2><div class="mini-cards-v2"><div class="place-card-mini"><div><h3>ศูนย์อาหารลานโล่งตะกั่วป่า</h3><button class="button button-outline" data-trip-add="food-center">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</h3><button class="button button-outline" data-trip-add="culture-street">เพิ่มลงทริป</button></div></div></div></section><aside class="story-outro"><p>บทความนี้เล่าที่มาของรสชาติ ส่วนรายชื่อร้านที่ยังเปิดอยู่จริงพร้อมเวลาเปิดและพิกัด อยู่ในคู่มือกินเที่ยวที่คนทำเว็บนี้เดินไปชิมมาเอง</p><a class="text-link" href="https://siwaracafe.com/guide" target="_blank" rel="noopener">เปิดคู่มือกินเที่ยวตะกั่วป่า ↗</a></aside><details class="unknowns-box-v2"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>บุคคลผู้คิดค้นสูตรเต้าส้อคนแรกในตะกั่วป่ายังไม่สามารถยืนยันได้จากเอกสารสิ่งพิมพ์</li><li>ตารางเวลาเปิดปิดที่แน่นอนและอัปเดตที่สุดของตลาดและร้านค้าในปัจจุบัน</li></ul></details><section class="story-sources-v2"><h2>แหล่งข้อมูล</h2><ol><li><cite>มรดกภูมิปัญญาทางวัฒนธรรมของชาติ: อาหารบาบ๋า</cite> · กรมส่งเสริมวัฒนธรรม · หน้า 124 (ฉบับพิมพ์) / PDF หน้า 133 · <a href="https://book.culture.go.th/newbook/ich/ich2013.pdf" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ข่าวลงพื้นที่ผลิตภัณฑ์เต้าส้อจังหวัดพังงา</cite> · สำนักงานคณะกรรมการอาหารและยา · ข่าวภาคสนามปี 2568 · <a href="https://dis.fda.moph.go.th/detail-newsUpdate?id=3271" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ของดีจังหวัดพังงา</cite> · สำนักงานการท่องเที่ยวและกีฬาจังหวัดพังงา · ขนมเต้าส้อตะกั่วป่า · <a href="https://phangnga.mots.go.th/news/369" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ถนนวัฒนธรรมเมืองเก่าตะกั่วป่า</cite> · กรมการค้าภายใน · ประวัติความเป็นมา · <a href="https://www.dit.go.th/th/market/2383/ภาคใต/พ-งงา/ถนนว-ฒนธรรมเม-องเก-าตะก-วป-า/" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>สัมผัสกลิ่นอายถนนสายวัฒนธรรม</cite> · ผู้จัดการออนไลน์ · เนื้อหาข่าวอ้างอิงถึงปี 2550 · <a href="https://mgronline.com/south/detail/9650000044214" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ตลาดลานโล่ง</cite> · Wongnai · ข้อมูลทั่วไป · <a href="https://www.wongnai.com/attractions/399190Vq-ตลาดลานโล่ง" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ศูนย์อาหารลานโล่ง</cite> · เทศบาลเมืองตะกั่วป่า · คำอธิบายวิดีโอ 1 ก.ย. 2567 · <a href="https://www.youtube.com/watch?v=YBj0I_sMc-I" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li></ol></section></div><div class="story-sidebar-v2"><aside class="evidence-box-v2"><h3>หลักฐานอยู่ตรงไหน</h3><ul class="ev-items-v2"><li><div class="ev-claim">ขนมเต้าส้อถือกำเนิดในตะกั่วป่าและมีสูตรเดียว</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">ไม่มีหลักฐานทางประวัติศาสตร์ชิ้นใดที่ระบุชัดเจนถึงจุดเริ่มต้นแรกสุด หรือการผูกขาดว่ามีสูตรเพียงหนึ่งเดียวในตะกั่วป่า <a href="https://dis.fda.moph.go.th/detail-newsUpdate?id=3271" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">ถนนสายวัฒนธรรมเริ่มจัดเมื่อปี 2550 หรือ 2560</div><div class="ev-status disputed">DISPUTED</div><div class="ev-explain">ข่าวบางแห่งอ้างอิงปี 2550 สำหรับจุดเริ่มต้นงานเล่าความหลังของชุมชน แต่เอกสารของกรมการค้าภายในระบุปี 2560 ในฐานะตลาดส่งเสริม <a href="https://www.dit.go.th/th/market/2383/ภาคใต/พ-งงา/ถนนว-ฒนธรรมเม-องเก-าตะก-วป-า/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li></ul></aside><nav class="story-toc-v2 scrollspy" id="story-toc"><h2>เนื้อหาในบทความ</h2><ul class="scrollspy-nav"><li><a href="#section-0">ตะกั่วป่าในแผนที่อาหารบาบ๋า</a></li><li><a href="#section-1">เต้าส้อสองชั้นกับความเปลี่ยนแปลงของเมือง</a></li><li><a href="#section-2">ถนนวัฒนธรรมกับย่านการค้าเดิม</a></li><li><a href="#section-3">ตลาดลานโล่ง จุดนัดพบของความหลากหลาย</a></li><li><a href="#section-4">ศิวรา คาเฟ่ ในระบบเรื่องเล่าของเมือง</a></li></ul></nav></div></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
site\stories\kuapapoh\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>กั่วป่าโพ้ บ้านเก่าตะกั่วป่าที่กลับมามีชีวิต · ตะกั่วป่า 101</title><meta name="description" content="โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="กั่วป่าโพ้ บ้านเก่าตะกั่วป่าที่กลับมามีชีวิต"><meta property="og:description" content="โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา"><meta property="og:url" content="https://takuapa101.com/stories/kuapapoh/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/default.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/default.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/stories/kuapapoh/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "กั่วป่าโพ้ บ้านเก่าตะกั่วป่าที่กลับมามีชีวิต", "item": "https://takuapa101.com/stories/kuapapoh/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/stories/kuapapoh/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/stories/kuapapoh/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/stories/kuapapoh/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/" aria-current="page">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/stories/kuapapoh/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="story-article-v2"><header class="story-hero-v2"><div class="breadcrumbs"><a href="/">หน้าแรก</a><span>/</span><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><span>/</span><span>กระทู้เมือง</span></div><span class="eyebrow">เรื่องเล่าตะกั่วป่า · กระทู้เมือง</span><h1>กั่วป่าโพ้: วันที่บ้านเก่าลุกขึ้นมาเล่าเรื่องตัวเอง</h1><p class="lead">โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา</p><p class="story-meta">ปรับปรุงเมื่อ 2026-09-07 · เวลาอ่าน 6 นาที</p></header><figure class="hero-photo-v2"><img src="/assets/photos/kuapapoh-brand.jpg" alt="กั่วป่าโพ้ · แบรนด์ของโครงการเมืองเก่าตะกั่วป่า" loading="eager"><figcaption><span>กั่วป่าโพ้ · แบรนด์ของโครงการเมืองเก่าตะกั่วป่า</span><span class="credit">โครงการกั่วป่าโพ้</span></figcaption></figure><div class="story-layout-v2"><div class="story-main-v2"><div class="story-lede-v2"><p>คุณลองจินตนาการถึงการเดินทอดน่องไปตามถนนศรีตะกั่วป่า ถนนที่สองข้างทางเต็มไปด้วยอาคารเรือนแถวเก่าแก่ที่ยืนหยัดข้ามกาลเวลา อาคารหลายหลังถูกปิดประตูไม้เงียบเชียบ หลับใหลไปพร้อมกับยุคทองของการทำเหมืองแร่ที่ผ่านพ้นไปนานแล้ว แต่ภายใต้ความเงียบสงบนั้น มีความทรงจำของเมือง ผู้คน และการค้าขายซุกซ่อนอยู่มากมายรอวันถูกเล่าขาน</p><p>ในช่วงไม่กี่ปีที่ผ่านมา โครงการพื้นที่สร้างสรรค์ที่ชื่อว่า “กั่วป่าโพ้ จีโชว์เมือง” ได้พยายามก้าวเข้ามาเปิดประตูบ้านเก่าที่เคยถูกทิ้งร้าง ให้กลับมามีลมหายใจอีกครั้ง พวกเขาไม่ได้แค่ทาสีใหม่หรือซ่อมแซมหลังคา แต่กำลังนำเรื่องราวของตะกั่วป่ากลับมาจัดแสดงให้คนรุ่นหลังได้เห็น</p><p>การเคลื่อนไหวนี้สะท้อนภาพเมืองที่พยายามลุกขึ้นมาเล่าเรื่องตัวเอง ผ่านมุมมองของคนท้องถิ่น ศิลปิน และการทำงานร่วมกับชุมชน อย่างไรก็ตาม ในการอ่านความเปลี่ยนแปลงนี้ เรายังคงต้องแยกแยะระหว่างเรื่องเล่าที่สร้างสรรค์ขึ้นใหม่เพื่อการท่องเที่ยว กับข้อเท็จจริงทางประวัติศาสตร์ที่ยังต้องตรวจสอบด้วยความระมัดระวัง</p></div><section class="story-section-v2"><h2 id="section-0">พื้นที่ที่เคยหลับใหล กลับมาเป็นของเมือง</h2><figure class="section-photo-v2"><img src="/assets/photos/shophouse-109.webp" alt="ตึกแถวเลขที่ 109 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>ตึกแถวเลขที่ 109 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</span><span class="credit">คลังภาพโครงการกั่วป่าโพ้</span></figcaption></figure><p>เรามักจดจำภาพของตะกั่วป่าผ่านยุคเหมืองแร่ดีบุกอันรุ่งเรือง แต่เมื่ออุตสาหกรรมนั้นซาลง อาคารหลายแห่งก็ถูกทิ้งไว้เบื้องหลัง หนึ่งในนั้นคือบ้านเลขที่ 78 ซึ่งอดีตเคยเป็นบ้านของนายเหมืองและเป็นที่ตั้งของบริษัทเหมืองแร่ดีบุก วันนี้พื้นที่ที่เคยว่างเปล่าถูกปรับเปลี่ยนให้เป็น “กั่วป่าเหมืองมิวเซียม” ที่จัดแสดงอุปกรณ์การทำเหมือง แผนที่เก่า และเอกสารสำคัญ เพื่อให้ผู้มาเยือนได้สัมผัสร่องรอยของอดีต</p><p>ถัดไปไม่ไกลบนเส้นทางเดียวกัน คือบ้านเลขที่ 109 อาคารของศาลเจ้ากังตั้งโหยกวน หรือหวุ่ยกุ่น ซึ่งเป็นสมาคมของชาวจีนฮากก้าหรือจีนแคะ บริเวณชั้นสองของอาคารยังคงประดิษฐานองค์พระท่ามกุงหย่าให้ผู้คนได้กราบไหว้เคารพ แต่พื้นที่ชั้นล่างที่เคยว่างเปล่าไร้การใช้งาน ได้ถูกเปลี่ยนเป็น “กั่วป่าโพ้แกลอรี่” สำหรับจัดนิทรรศการและแสดงภูมิปัญญาของชาวเมืองเก่าตะกั่วป่า</p><p>อีกหนึ่งอาคารสำคัญที่โครงการนำกลับมาปัดฝุ่นคืออาคารหมายเลข 305 หรือ “โรงเรียนเต้าหมิง” โรงเรียนจีนที่เคยเป็นศูนย์กลางการศึกษาในยุคเหมืองแร่รุ่งเรือง ทีมงานมีแนวคิดฟื้นคืนพื้นที่นี้ภายใต้ชื่อ “เต้าหมิง ประกายแสงแห่งการเรียนรู้” โดยใช้เป็นสถานที่จัดแสดงองค์ความรู้ด้านสถาปัตยกรรม วัฒนธรรม และประเพณีที่เกี่ยวข้องกับตะกั่วป่า</p><p>ความพยายามในการนำพื้นที่ทั้งสามแห่งนี้กลับมาใช้งาน เป็นการริเริ่มที่เต็มไปด้วยความมุ่งมั่นของเจ้าของโครงการในการเพิ่มมูลค่าทางเศรษฐกิจและสร้างคุณค่าให้เมือง แต่เราต้องเข้าใจร่วมกันว่า นี่เป็นคำอธิบายและการดำเนินการระดับโครงการชุมชน ไม่ใช่การประกาศสถานะโบราณสถานหรือการรับรองทางประวัติศาสตร์จากหน่วยงานภาครัฐ</p></section><blockquote class="pull-quote-v2"><p>การทำงานกับเรื่องเล่าของชุมชน คือการรักษาสมดุลระหว่างความทรงจำที่งดงามกับข้อเท็จจริงที่ต้องตรวจทาน</p></blockquote><section class="story-section-v2"><h2 id="section-1">กั่วป่าโพ้ คำเรียกขานที่พัดพามาจากสายน้ำ</h2><figure class="section-photo-v2"><img src="/assets/photos/tao-ming-school.jpg" alt="อาคารโรงเรียนเต้าหมิง ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>อาคารโรงเรียนเต้าหมิง ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</span><span class="credit">คลังภาพโครงการกั่วป่าโพ้</span></figcaption></figure><p>ทันทีที่คุณได้ยินชื่อ “กั่วป่าโพ้” คำถามแรกที่มักตามมาคือคำนี้มาจากไหน ข้อมูลจดหมายเหตุของโครงการอธิบายว่า คำนี้คือคำที่ชาวจีนฮกเกี้ยนในอดีตใช้เรียกเมืองตะกั่วป่า โดยแบ่งการแปลออกเป็นสองส่วนคือ “กั่วป่า” ที่หมายถึงตะกั่วป่า และ “โพ้” ที่แปลว่าตลาดหรือท่าเรือ</p><p>เมื่อนำมารวมกัน คำนี้จึงสื่อถึง “ตลาดท่าเรือตะกั่วป่า” ซึ่งสะท้อนภาพในวันวานที่ชาวจีนโล้สำเภาข้ามน้ำข้ามทะเลเข้ามาค้าขายและทำเหมืองดีบุก โดยใช้ท่าน้ำเป็นศูนย์กลางในการแลกเปลี่ยนทั้งสินค้าและวัฒนธรรม นอกจากนี้ ในความเชื่อของชุมชน คำว่ากั่วป่าโพ้ยังแฝงอยู่ในการประกอบพิธีกรรมตามศาลเจ้าต่างๆ ในช่วงเทศกาลกินผัก จนกลายเป็นคำที่มีความหมายลึกซึ้งในใจชาวเมือง</p><p>แม้นี่จะเป็นเรื่องเล่าที่งดงามและเชื่อมโยงรากเหง้าของชุมชนได้เป็นอย่างดี แต่ในแวดวงวิชาการ เรื่องที่มาของชื่อเมืองตะกั่วป่านั้นยังคงเป็นข้อถกเถียงที่มีหลายสมมติฐาน บ้างก็อ้างถึงชื่อโบราณอย่างตะโกลา บ้างก็อิงกับคำว่าตะกั่วและป่า</p><p>ดังนั้น คำอธิบายของโครงการจึงถือเป็นบันทึกความทรงจำและการตีความผ่านบริบทของชุมชนชาวจีนฮกเกี้ยน มากกว่าที่จะเป็นข้อยุติทางวิชาการประวัติศาสตร์ที่ฟันธงได้เพียงทางเดียว นี่คือเหตุผลที่เราต้องอ่านเรื่องนี้ด้วยความเปิดกว้างและระมัดระวัง</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">ยังไม่มีข้อยุติทางวิชาการ</span></div></section><section class="story-section-v2"><h2 id="section-2">มนต์เสน่ห์เปอรานากันผ่านปลายพู่กัน</h2><figure class="section-photo-v2"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" loading="lazy"><figcaption><span>โรงเรียนเต้าหมิง</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>ความมีชีวิตชีวาของย่านเมืองเก่ากลับมาปรากฏให้เห็นอย่างเป็นรูปธรรมในเดือนกันยายน พ.ศ. 2569 เมื่อ 78 สตูดิโอ บนถนนวัฒนธรรมตะกั่วป่า ได้เปิดพื้นที่จัดแสดงนิทรรศการศิลปะเดี่ยวภายใต้ชื่อ “มนต์เสน่ห์เปอรานากัน · Still Becoming”</p><p>ศิลปินผู้อยู่เบื้องหลังผลงานเหล่านี้คือ ติณณภพ งานสถิร หรือ ช่างป๋อง เขาเป็นชาวตลาดเก่าตะกั่วป่าโดยกำเนิด เติบโตมากับภาพวาดการ์ตูน ซูเปอร์ฮีโร่ และเทพเจ้าจีนที่คุ้นเคยในวัฒนธรรมท้องถิ่น หลังจากสั่งสมประสบการณ์ทางศิลปะมาอย่างยาวนาน เขาได้เลือกใช้ปลายพู่กันมาถ่ายทอดเรื่องราวของเมืองที่เขาผูกพัน</p><p>ผลงานในนิทรรศการเน้นไปที่การดึงเอาสีสัน ลวดลาย และเครื่องแต่งกายแบบเปอรานากันมาจัดแสดง เพื่อเป็นสะพานเชื่อมโยงอดีตอันรุ่งเรืองเข้ากับผู้คนในยุคปัจจุบัน ภาพวาดแต่ละชิ้นไม่ใช่แค่ความสวยงามทางสายตา แต่เป็นบันทึกทางอารมณ์ของศิลปินที่มีต่อเมือง</p><p>แม้ว่าเอกสารโครงการจะบันทึกถึงการจัดนิทรรศการและการเปิดพื้นที่ให้ศิลปินได้แสดงออกอย่างชัดเจน แต่สิ่งที่เรายังไม่เห็นในรายงานคือตัวเลขผู้เข้าร่วมงานหรือการประเมินผลกระทบทางเศรษฐกิจที่เป็นทางการ กิจกรรมเหล่านี้จึงทำหน้าที่เป็นแรงกระเพื่อมทางวัฒนธรรมมากกว่าจะเป็นสถิติทางราชการ</p></section><section class="story-section-v2"><h2 id="section-3">มองเมืองผ่านแว่นตาแห่งมรดกทั้งหก</h2><figure class="section-photo-v2"><img src="/assets/photos/kuapapoh-pattern.jpg" alt="ลายกระเบื้องเปอรานากันที่ยังเห็นได้ในเมืองเก่า" loading="lazy"><figcaption><span>ลายกระเบื้องเปอรานากันที่ยังเห็นได้ในเมืองเก่า</span><span class="credit">โครงการกั่วป่าโพ้</span></figcaption></figure><p>เพื่อให้ผู้มาเยือนเข้าใจอัตลักษณ์ของเมืองเก่าตะกั่วป่าได้ลึกซึ้งขึ้น โครงการไม่ได้หยุดอยู่แค่การจัดนิทรรศการ แต่ได้รวบรวมและนำเสนอแนวคิด “6 อ.” เพื่อใช้เป็นกรอบในการมองมรดกของเมืองที่ซ่อนอยู่ในชีวิตประจำวัน</p><p>แนวคิดนี้เริ่มต้นที่ “อาภรณ์” หรือเครื่องแต่งกายเฉพาะถิ่น ไม่ว่าจะเป็นผ้าลูกไม้ ผ้าถุงปาเต๊ะ และเครื่องประดับต่างๆ ตามมาด้วย “อาศัย” ที่ครอบคลุมวิถีชีวิต การค้าขาย และความเป็นอยู่ที่สอดคล้องกับยุคสมัย ส่วน “อาหาร” คือสิ่งที่ขาดไม่ได้ มันคือรสชาติดั้งเดิมที่สืบทอดกันมาจากรุ่นสู่รุ่น และร้านอาหารเก่าแก่ที่ยังคงเปิดเตาไฟอยู่จนถึงทุกวันนี้</p><p>ในมิติของจิตใจ เมืองถูกขับเคลื่อนด้วย “อารมณ์” ที่แสดงออกผ่านงานศิลปะ เสียงเพลง และเสียงกลองในเทศกาลกินผัก ขณะเดียวกัน “อาราม” ก็เป็นศูนย์รวมศรัทธา ทั้งวัด ศาลเจ้า และโหย่กวนที่กระจายตัวอยู่ในย่านเมืองเก่า และสุดท้ายคือ “อาคาร” สถาปัตยกรรมที่ยืนหยัดเป็นประจักษ์พยานของการเปลี่ยนแปลง</p><p>แนวคิดทั้งหมดนี้ยังถูกนำไปต่อยอดในการออกแบบสินค้าของที่ระลึก เช่น เสื้อยืดของโครงการโพ้ช็อป ซึ่งรายได้จากการจำหน่ายจะถูกนำกลับมาสมทบทุนเพื่อใช้ฟื้นฟูและขับเคลื่อนกิจกรรมของเมืองต่อไป เป็นการหมุนเวียนคุณค่ากลับคืนสู่ชุมชนอย่างแท้จริง</p></section><section class="story-section-v2"><h2 id="section-4">สิ่งที่เมืองเล่าและสิ่งที่เราต้องตรวจสอบ</h2><figure class="section-photo-v2"><img src="/assets/culture-street.webp" alt="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>โครงการกั่วป่าโพ้ ทำให้เราได้เห็นความมุ่งมั่นของคนรุ่นใหม่และคนในพื้นที่ที่ต้องการจะรักษาและต่อยอดเรื่องราวของตะกั่วป่า พวกเขาสร้างพื้นที่สร้างสรรค์ ดึงเอาศิลปะเข้ามาเป็นสื่อกลาง และเปลี่ยนบ้านที่เคยปิดตายให้กลายเป็นจุดหมายใหม่ของการเดินทาง</p><p>สิ่งที่ถูกบันทึกไว้ในเว็บไซต์และเอกสารของโครงการ เป็นเสมือนจดหมายเหตุร่วมสมัยที่ชุมชนเลือกที่จะเล่าถึงตัวเอง มันคือความทรงจำที่เปี่ยมไปด้วยชีวิตชีวาและความภาคภูมิใจของผู้อยู่อาศัย</p><p>แต่ในขณะเดียวกัน การอ่านเรื่องราวเหล่านี้ก็เรียกร้องให้เรารักษาความสมดุลระหว่างความชื่นชมกับข้อเท็จจริงทางประวัติศาสตร์ ข้อมูลหลายส่วนเป็นคำอธิบายที่ไม่ได้ผ่านการรับรองจากหน่วยงานรัฐ และไม่สามารถใช้แทนปฏิทินหรือเอกสารทางวิชาการได้</p><p>นี่คือความท้าทายและความสนุกของการเดินชมเมืองเก่าตะกั่วป่าในวันนี้ เรามีหน้าที่รับฟังเรื่องเล่าที่งดงามเหล่านั้น พร้อมๆ ไปกับการตั้งคำถามและค้นหาคำตอบตามแหล่งข้อมูลที่เชื่อถือได้ เพื่อให้การเดินทางของเราไม่ได้จบลงแค่การดูรูปภาพ แต่เป็นการทำความเข้าใจเมืองในทุกมิติอย่างแท้จริง</p></section><section class="story-places-v2"><h2>ไปดูของจริงได้ที่ไหน</h2><div class="mini-cards-v2"><div class="place-card-mini"><div><h3>โรงเรียนเต้าหมิง</h3><button class="button button-outline" data-trip-add="tao-ming">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</h3><button class="button button-outline" data-trip-add="culture-street">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>ตลาดริมน้ำตะกั่วป่า</h3><button class="button button-outline" data-trip-add="riverwalk">เพิ่มลงทริป</button></div></div></div></section><details class="unknowns-box-v2"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>จำนวนผู้เข้าร่วมงานหรือผลกระทบทางเศรษฐกิจที่เกิดจากโครงการอย่างเป็นทางการ</li><li>สถานะทางกฎหมายหรือการรับรองจากหน่วยงานรัฐของบ้านทั้งสามหลัง</li><li>ที่มาที่ชัดเจนและยุติแล้วของชื่อเมืองตะกั่วป่าในหน้าประวัติศาสตร์</li></ul></details><section class="story-sources-v2"><h2>แหล่งข้อมูล</h2><ol><li><cite>กั่วป่าโพ้ · จดหมายเหตุโครงการ</cite> · โครงการกั่วป่าโพ้ · content.json · ส่วน origin, events, openings · <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li></ol></section></div><div class="story-sidebar-v2"><aside class="evidence-box-v2"><h3>หลักฐานอยู่ตรงไหน</h3><ul class="ev-items-v2"><li><div class="ev-claim">การนิยามพื้นที่บ้านเลขที่ 78, 109 และ 305 เป็นพื้นที่สร้างสรรค์</div><div class="ev-status qualified">QUALIFIED</div><div class="ev-explain">ข้อนี้เป็นคำอธิบายจากเจ้าของโครงการ ไม่ใช่การประกาศสถานะโบราณสถานหรือพื้นที่จากหน่วยงานรัฐ <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">ที่มาของคำว่ากั่วป่าโพ้แปลว่าตลาดท่าเรือตะกั่วป่า</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">เรื่องที่มาของชื่อเมืองตะกั่วป่าในงานประวัติศาสตร์ยังมีหลายสมมติฐาน จึงไม่ควรใช้คำอธิบายโครงการแทนข้อยุติทางวิชาการ <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">การจัดนิทรรศการมนต์เสน่ห์เปอรานากัน โดย ติณณภพ งานสถิร ในเดือนกันยายน 2569</div><div class="ev-status qualified">QUALIFIED</div><div class="ev-explain">อ้างอิงจากข้อมูลโครงการ แต่ไม่ได้เป็นปฏิทินราชการย้อนหลังที่ยืนยันจำนวนผู้เข้าร่วมหรือผลกระทบทางเศรษฐกิจ <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li></ul></aside><nav class="story-toc-v2 scrollspy" id="story-toc"><h2>เนื้อหาในบทความ</h2><ul class="scrollspy-nav"><li><a href="#section-0">พื้นที่ที่เคยหลับใหล กลับมาเป็นของเมือง</a></li><li><a href="#section-1">กั่วป่าโพ้ คำเรียกขานที่พัดพามาจากสายน้ำ</a></li><li><a href="#section-2">มนต์เสน่ห์เปอรานากันผ่านปลายพู่กัน</a></li><li><a href="#section-3">มองเมืองผ่านแว่นตาแห่งมรดกทั้งหก</a></li><li><a href="#section-4">สิ่งที่เมืองเล่าและสิ่งที่เราต้องตรวจสอบ</a></li></ul></nav></div></div></div><section class="research-section" id="project-gallery"><h2>ภาพจากคลังโครงการกั่วป่าโพ้</h2><div data-gallery><div class="gallery-tabs" hidden><button type="button" data-tab="today">ภาพวันนี้</button><button type="button" data-tab="archive">ภาพเก่า</button></div><div id="gallery-today" data-panel="today"><h3>ภาพวันนี้</h3><div class="photo-grid"><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-brand.jpg" aria-label="ขยายภาพ · กั่วป่าโพ้ แบรนด์เมืองเก่าตะกั่วป่า"><img src="/assets/photos/kuapapoh-brand.jpg" alt="กั่วป่าโพ้ แบรนด์เมืองเก่าตะกั่วป่า" loading="lazy"></a><figcaption>กั่วป่าโพ้ แบรนด์เมืองเก่าตะกั่วป่า<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-pattern.jpg" aria-label="ขยายภาพ · ลายกระเบื้องเปอรานากันเมืองเก่า"><img src="/assets/photos/kuapapoh-pattern.jpg" alt="ลายกระเบื้องเปอรานากันเมืองเก่า" loading="lazy"></a><figcaption>ลายกระเบื้องเปอรานากันเมืองเก่า<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure></div></div><div id="gallery-archive" data-panel="archive"><h3>ภาพเก่า</h3><div class="photo-grid"><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-history.jpg" aria-label="ขยายภาพ · แผ่นเล่าประวัติกั่วป่าโพ้"><img src="/assets/photos/kuapapoh-history.jpg" alt="แผ่นเล่าประวัติกั่วป่าโพ้" loading="lazy"></a><figcaption>แผ่นเล่าประวัติกั่วป่าโพ้<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-wuikun.jpg" aria-label="ขยายภาพ · หวุ่ยกุ่น"><img src="/assets/photos/kuapapoh-wuikun.jpg" alt="หวุ่ยกุ่น" loading="lazy"></a><figcaption>หวุ่ยกุ่น<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-doc-1.jpg" aria-label="ขยายภาพ · เอกสารเก่าเมืองตะกั่วป่า 1"><img src="/assets/photos/kuapapoh-doc-1.jpg" alt="เอกสารเก่าเมืองตะกั่วป่า 1" loading="lazy"></a><figcaption>เอกสารเก่าเมืองตะกั่วป่า 1<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure><figure class="research-photo"><a data-lightbox href="/assets/photos/kuapapoh-doc-2.jpg" aria-label="ขยายภาพ · เอกสารเก่าเมืองตะกั่วป่า 2"><img src="/assets/photos/kuapapoh-doc-2.jpg" alt="เอกสารเก่าเมืองตะกั่วป่า 2" loading="lazy"></a><figcaption>เอกสารเก่าเมืองตะกั่วป่า 2<small>เครดิต · กั่วป่าโพ้ / คลังภาพโครงการเมืองเก่าตะกั่วป่า</small><small>สัญญาอนุญาต · ภาพจากคลังของโครงการ ใช้ในเว็บนี้ได้</small></figcaption></figure></div></div></div></section></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>