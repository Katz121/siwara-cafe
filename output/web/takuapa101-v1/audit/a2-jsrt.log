tItem", "position": 22, "url": "https://takuapa101.com/places/phra-narai/"}, {"@type": "ListItem", "position": 23, "url": "https://takuapa101.com/places/riverwalk/"}, {"@type": "ListItem", "position": 24, "url": "https://takuapa101.com/places/culture-street/"}, {"@type": "ListItem", "position": 25, "url": "https://takuapa101.com/places/food-center/"}, {"@type": "ListItem", "position": 26, "url": "https://takuapa101.com/traditions/new-year-alms/"}, {"@type": "ListItem", "position": 27, "url": "https://takuapa101.com/traditions/ruler-ceremony/"}, {"@type": "ListItem", "position": 28, "url": "https://takuapa101.com/traditions/relic-procession/"}, {"@type": "ListItem", "position": 29, "url": "https://takuapa101.com/traditions/narai-ceremony/"}, {"@type": "ListItem", "position": 30, "url": "https://takuapa101.com/traditions/vegetarian/"}, {"@type": "ListItem", "position": 31, "url": "https://takuapa101.com/traditions/chak-phra/"}, {"@type": "ListItem", "position": 32, "url": "https://takuapa101.com/traditions/loy-krathong/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/"></head><body class="home"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><section class="hero"><div class="hero-topline"><span>PHANG NGA, THAILAND</span><span>เรื่องของเมือง / ฉบับที่ ๑</span></div><div class="hero-layout"><div class="hero-copy"><span class="hero-eyebrow"><i></i> คู่มือเมืองเก่าที่ชวนคุณค่อย ๆ เดิน</span><h1>ตะกั่วป่า<span class="hero-title-bottom">เมืองเล่าเรื่อง<em>101</em></span></h1><p>ผ่านประตูศาลเจ้า มองหน้าต่างบ้านเก่า<br>แล้วรู้จักเมืองอีกนิด ในทุกจุดที่แวะ</p><div class="hero-actions"><a class="button" href="#places">เลือกจุดหมายของคุณ<span aria-hidden="true">↗</span></a><a class="text-link" href="/map/">เปิดแผนที่ ↗</a></div><div class="hero-footnote"><span class="tiny-star" aria-hidden="true">✳</span><span>20 สถานที่ · 7 ประเพณี · 59 ร้าน<br>รวบรวมจากแผ่นพับเทศบาลเมืองตะกั่วป่า</span></div></div><div class="hero-collage"><div class="collage-ring" aria-hidden="true"></div><span class="stamp">TAKUA PA<br><strong>ตะกั่วป่า</strong><br>OLD TOWN</span><a class="postcard postcard-main" href="/places/tao-ming/"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" width="1000" height="667" loading="eager"><span><b>01 / ตึกเก่า</b> โรงเรียนเต้าหมิง ↗</span></a><a class="postcard postcard-left" href="/places/guan-yu/"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="eager"><span>ศรัทธาของชุมชน ↗</span></a><a class="postcard postcard-right" href="/places/khun-in/"><img src="/assets/khun-in.webp" alt="บ้านขุนอินทร์" width="1000" height="1000" loading="eager"><span>หน้าต่างสู่วันวาน ↗</span></a><span class="collage-note">เก็บเรื่องราวระหว่างทาง</span><span class="collage-spark" aria-hidden="true">✳</span></div></div><div class="hero-bottom"><span>วัดและเจดีย์</span><i>✳</i><span>ศาลเจ้า</span><i>✳</i><span>บ้านเก่า</span><i>✳</i><span>ตลาดริมน้ำ</span><a href="#start">เริ่มเปิดอ่าน ↓</a></div></section><nav class="quick-start" aria-label="เริ่มต้นใช้งาน"><h2 class="visually-hidden">เริ่มที่นี่</h2><a class="quick-card" href="/map/" data-qs="map"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>กางแผนที่</b><small>ดูว่าอะไรอยู่ตรงไหน</small></span></a><a class="quick-card" href="/places/" data-qs="places"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>เที่ยวไหนดี</b><small>20 สถานที่ในเมืองเก่า</small></span></a><a class="quick-card" href="/eat/" data-qs="eat"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>กินอะไรดี</b><small>60 ร้านในย่าน</small></span></a><a class="quick-card" href="/trip/" data-qs="trip"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>จัดทริปของฉัน</b><small>เลือกเก็บไว้ แล้วเดินตามลำดับ</small></span><span class="qs-badge" data-trip-count hidden>0</span></a></nav><section id="start" class="section"><div class="section-heading"><div><span class="chapter">01 / เปิดอ่านเมือง</span><h2>เริ่มจากเรื่องที่คุณสนใจ</h2></div><p>สามเส้นทางอ่านเมือง · เลือกจุดแวะในแบบของคุณ</p></div><div class="route-cards"><a class="route-card" href="/routes/#route-1"><div class="route-art"><img src="/assets/wat-boromthat.webp" alt="วัดบรมธาตุคีรีเขต (วัดลุ่ม)" width="1000" height="1000" loading="lazy"><span class="route-no">01</span></div><div class="route-copy"><span class="eyebrow">อ่านเมืองผ่านศรัทธา</span><h3>เส้นวัดและเจดีย์</h3><span class="route-footer">6 จุดหมาย <span aria-hidden="true">↗</span></span></div></a><a class="route-card" href="/routes/#route-2"><div class="route-art"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="lazy"><span class="route-no">02</span></div><div class="route-copy"><span class="eyebrow">มองเรื่องราวของชุมชนจีน</span><h3>เส้นศาลเจ้าและโรงเจ</h3><span class="route-footer">4 จุดหมาย <span aria-hidden="true">↗</span></span></div></a><a class="route-card" href="/routes/#route-3"><div class="route-art"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" width="1000" height="667" loading="lazy"><span class="route-no">03</span></div><div class="route-copy"><span class="eyebrow">ตามรอยอาคาร การค้า และผู้คน</span><h3>เส้นตึกเก่าและตลาดริมน้ำ</h3><span class="route-footer">6 จุดหมาย <span aria-hidden="true">↗</span></span></div></a><a class="route-card" href="/routes/#route-4"><div class="route-art"><img src="/assets/khun-in.webp" alt="บ้านขุนอินทร์" width="1000" height="1000" loading="lazy"><span class="route-no">04</span></div><div class="route-copy"><span class="eyebrow">เหมาะกับคนมีเวลาครึ่งวัน</span><h3>เดินสั้นจากบ้านไม้</h3><span class="route-footer">4 จุดหมาย <span aria-hidden="true">↗</span></span></div></a></div></section><section class="section city-feed" id="city-feed"><div class="section-heading"><div><span class="chapter">02 / เปิดอ่านเมือง</span><h2>กระทู้และข่าวสารของเมือง</h2></div><p>เรื่องเล่าที่เรียบเรียงไว้ และความเคลื่อนไหวล่าสุดในตะกั่วป่า</p></div><div class="city-feed-grid"><div class="cf-stories"><h3 class="cf-title">เรื่องเล่าของเมือง</h3><div class="story-tiles"><a class="story-tile story-tile-lead" href="/stories/city/"><span class="sc-img"><img src="/assets/riverwalk.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">รู้จักเมือง</span><b>ตะกั่วป่า เมืองที่ย้ายตัวเองตามสายน้ำ</b><p>จากชุมชนโบราณบนเส้นทางข้ามคาบสมุทร สู่เมืองตลาดและเมืองเหมืองแร่ · เรื่องที่ยืนยันได้และปริศนาที่ยังรอคำตอบ</p><small>6 นาที</small></span></a><a class="story-tile" href="/stories/architecture/"><span class="sc-img"><img src="/assets/culture-street.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">บ้านเก่าและสถาปัตยกรรม</span><b>ตึกที่สร้างด้วยเงินดีบุกและเหล็กจากเรือขุดแร่ · สถาปัตยกรรมที่จำเมืองไว้</b><p>อ่านเมืองตะกั่วป่าผ่านตึกแถวบนถนนสายวัฒนธรรม สะพานเหล็กบุญสูง จวนเจ้าเมือง และโรงเรียนเต้าหมิง · การเปลี่ยนผ่านที่ฝังอยู่ในอิฐ ปูน และโครงสร้างเหล็ก</p><small>6 นาที</small></span></a><a class="story-tile" href="/stories/water-trade/"><span class="sc-img"><img src="/assets/iron-bridge.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">สายน้ำและการค้า</span><b>จากทุ่งตึกถึงแม่น้ำตะกั่วป่า: วันที่สายน้ำสร้างเมือง</b><p>สายน้ำไม่ได้เป็นเพียงฉากหลัง แต่มันคือเส้นทาง ผู้เชื่อมคน และตัวกำหนดชะตาเมืองที่ต้องย้ายตามตะกอนน้ำ</p><small>7 นาที</small></span></a><a class="story-tile" href="/stories/food-people/"><span class="sc-img"><img src="/assets/food-center.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">ผู้คนและรสชาติ</span><b>รสชาติของชุมชนบาบ๋าและตลาดเก่า</b><p>อาหารเป็นทั้งความทรงจำของครัวเรือนและหลักฐานของการแลกเปลี่ยน · ลองอ่านตะกั่วป่าผ่านสำรับบาบ๋า เต้าส้อสองชั้น และถนนสายวัฒนธรรม</p><small>7 นาที</small></span></a><a class="story-tile" href="/stories/kuapapoh/"><span class="sc-img"><img src="/assets/tao-ming.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">กระทู้เมือง</span><b>กั่วป่าโพ้: วันที่บ้านเก่าลุกขึ้นมาเล่าเรื่องตัวเอง</b><p>โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา</p><small>6 นาที</small></span></a></div><a class="text-link" href="/stories/">อ่านเรื่องเล่าทั้งหมด ↗</a></div><div class="cf-news"><h3 class="cf-title">ความเคลื่อนไหวล่าสุด</h3><ol class="news-list" data-news-list data-news-max="4" data-news-keep="10"><li class="news-row"><span class="news-date">4/5/2569</span><span class="news-main"><b>ไหว้พระขอพร ศาลเจ้ากู่ใช่ตึ๋ง จ.พังงา</b><span class="news-meta"><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a> · NBT2HD</span><a class="news-out" href="https://www.youtube.com/watch?v=q6K2Zl6700I" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">13/4/2569</span><span class="news-main"><b>พังงาจัดใหญ่ สืบสานสงกรานต์ ตักบาตรเมืองเก่าตะกั่วป่า เสริมสิริมงคลปีใหม่ไทย</b><span class="news-meta"><a href="/traditions/">ตักบาตรยามรุ่ง รับอรุณปีใหม่</a> · TOPNEWS</span><a class="news-out" href="https://www.topnews.co.th/news/1546452" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">13/4/2569</span><span class="news-main"><b>ตะกั่วป่าสะพรั่ง! ย้อนรอยเสน่ห์เมืองเก่าในงาน Takuapa Oldtown Songkran Festival 2026</b><span class="news-meta"><a href="/traditions/">ตักบาตรยามรุ่ง รับอรุณปีใหม่</a> · MGR Online</span><a class="news-out" href="https://mgronline.com/onlinesection/detail/9690000036775" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">8/3/2569</span><span class="news-main"><b>โรงเรียนตะกั่วป่าคีรีเขตร่วมกิจกรรม Takuapa Walk Rally 2026</b><span class="news-meta"><a href="/places/thung-phra/">สวนสาธารณะทุ่งพระโพธิ์</a> · โรงเรียนตะกั่วป่าคีรีเขต</span><a class="news-out" href="https://www.keereekatschool.ac.th/gallery-detail_1497" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">1/3/2569</span><span class="news-main"><b>จังหวัดพังงาจัดงาน จากตะโกลา สู่ตะกั่วป่า ครั้งที่ 12</b><span class="news-meta"><a href="/places/museum/">พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า</a> · สถานีวิทยุกระจายเสียงแห่งประเทศไทย</span><a class="news-out" href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">21/2/2569</span><span class="news-main"><b>งานเมืองเก่าเล่าเรื่อง ณ โรงเรียนเต้าหมิง ตะกั่วป่า</b><span class="news-meta"><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a> · YOUPHUKET</span><a class="news-out" href="https://youphuket.club/author/admin/page/58/" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">30/1/2569</span><span class="news-main"><b>ชวนเช็กอิน สะพานเหล็กบุญสูง มรดกเหมืองแร่ เมืองตะกั่วป่า</b><span class="news-meta"><a href="/places/iron-bridge/">สะพานเหล็กบุญสูง</a> · NBT2HD</span><a class="news-out" href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">5/11/2568</span><span class="news-main"><b>กิจกรรมลอยกระทงที่คลองตะกั่วป่าและคลองบางม่วง</b><span class="news-meta"><a href="/traditions/">ลอยกระทง</a> · กรมทรัพยากรทางทะเลและชายฝั่ง</span><a class="news-out" href="https://newweb.dmcr.go.th/detailAll/81026/nws/258" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li></ol><p class="small" data-news-updated hidden></p><a class="text-link" href="/news/">ดูความเคลื่อนไหวทั้งหมด ↗</a><p class="small">รวบรวมจากข่าวสาธารณะ · ตรวจกำหนดการกับผู้จัดก่อนเดินทาง</p></div></div></section><section class="map-teaser"><div class="map-teaser-copy"><span class="chapter">กางแผนที่ / แล้วออกไปรู้จักเมือง</span><h2>ตรอกไหน ถนนไหน<br><em>มีเรื่องรออยู่</em></h2><p>จากย่านยาวถึงเมืองเก่า เปิดแผนที่เทศบาลแล้วค่อย ๆ มองหาจุดหมายถัดไป</p><a class="button" href="/map/">กางแผนที่เมือง<span aria-hidden="true">↗</span></a><span class="map-caption">ใช้ภาพแผนที่เทศบาลฉบับต้นทาง</span></div><a class="map-paper" href="/map/" aria-label="เปิดแผนที่เทศบาล"><img src="/assets/municipal-map.png" width="1358" height="1938" alt="แผนที่ท่องเที่ยวเมืองตะกั่วป่าจากเทศบาล" loading="lazy"><span class="paper-tag">TAKUA PA · TOWN MAP ↗</span></a><span class="map-compass" aria-hidden="true">✳</span></section><section id="places" class="section"><div class="section-heading"><div><span class="chapter">03 / เปิดอ่านเมือง</span><h2>เมืองเดียว หลายมุมให้รู้จัก</h2></div><p>สถานที่ทั้ง 20 แห่ง จากหน้ากระดาษสู่เรื่องเล่าของเมือง</p></div><div class="explorer" data-explorer><div class="explorer-tools"><div class="filter-tabs" role="group" aria-label="หมวดสถานที่"><button type="button" data-filter="all" aria-pressed="true">ทั้งหมด <sup>20</sup></button><button type="button" data-filter="temple" aria-pressed="false">วัดและเจดีย์ <sup>6</sup></button><button type="button" data-filter="shrine" aria-pressed="false">ศาลเจ้าและโรงเจ <sup>4</sup></button><button type="button" data-filter="heritage" aria-pressed="false">ตึกเก่าและร่องรอยเมือง <sup>4</sup></button><button type="button" data-filter="park" aria-pressed="false">สวนและพื้นที่สาธารณะ <sup>2</sup></button><button type="button" data-filter="market" aria-pressed="false">ตลาดและของกิน <sup>3</sup></button><button type="button" data-filter="museum" aria-pressed="false">พิพิธภัณฑ์ <sup>1</sup></button></div></div><div class="explorer-status"><span data-place-count role="status" aria-live="polite">20 สถานที่ให้ค่อย ๆ รู้จัก</span><span>เลือกภาพเพื่อเปิดอ่าน ↗</span></div><h2 class="visually-hidden">รายชื่อสถานที่ทั้งหมด</h2><div class="places-grid"><article class="place-card" da