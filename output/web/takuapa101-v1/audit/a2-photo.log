        src=sm.group(1) if sm else ''
        cap=am.group(1) if am else ''
        # nearby figcaption or data-caption
        tail=s[m.end():m.end()+800]; fm=re.search(r'<figcaption["'^>]*>(.*?)</figcaption>'"',tail,re.I|re.S)
        if fm: cap=re.sub('<["'^>]+>'"','',fm.group(1)).strip()
        p=by.get(src)
        rows.append((rel,slug,src,html.unescape(cap),p['allowed_on'] if p else None,p['caption_th'] if p else None))
