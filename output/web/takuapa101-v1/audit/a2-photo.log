    if rel.startswith('en/') : continue
    slug='home' if rel=='index.html' else rel.rsplit('/',2)[-2] if rel.endswith('/index.html') else rel
    s=f.read_text(encoding='utf-8',errors='replace')
    for m in re.finditer(r'<img\\b["'^>]*>'"',s,re.I):
