with sync_playwright() as p:
 b=p.chromium.launch()
 for w in [390,1440]:
  pg=b.new_page(viewport={'width':w,'height':844})
  for path in paths:
   pg.goto(base+path,wait_until='networkidle')
   btn=pg.locator('button').filter(has_text='☰').first
   if w==390 and btn.count():
    btn.click(); opened=pg.locator('body').evaluate(\"b=>({cls:b.className,dialogs:[...document.querySelectorAll('[aria-modal=true],dialog')].map(x=>getComputedStyle(x).display)})\")
    pg.keyboard.press('Escape'); closed=pg.locator('body').evaluate(\"b=>({cls:b.className,dialogs:[...document.querySelectorAll('[aria-modal=true],dialog')].map(x=>getComputedStyle(x).display)})\")
   else: opened=closed='not-tested'
   pg.keyboard.press('Tab'); f=pg.locator(':focus'); focus=f.evaluate(\"e=>{let s=getComputedStyle(e);return {tag:e.tagName,txt:(e.innerText||e.getAttribute('aria-label')||'').trim().slice(0,30),outline:s.outline,outlineWidth:s.outlineWidth,boxShadow:s.boxShadow}}\") if f.count() else None
   print(w,path,'ESC',opened,closed,'FOCUS',focus)
 b.close()
