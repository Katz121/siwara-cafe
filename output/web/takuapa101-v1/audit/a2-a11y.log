from playwright.sync_api import sync_playwright
import json, re
base='http://127.0.0.1:8799'
paths=['/','/places/','/places/tao-ming/','/stories/city/','/map/','/trip/']
def lum(c):
    m=re.search(r'rgba?\\\\((["'^)]+)'"',c)
    if not m:return None
    a=[float(x.strip()) for x in m.group(1).split(',')[:3]]
    a=[x/255 for x in a]
    a=[x/12.92 if x<=.04045 else ((x+.055)/1.055)**2.4 for x in a]
    return .2126*a[0]+.7152*a[1]+.0722*a[2]
def ratio(f,b):
    x,y=lum(f),lum(b)
    return None if x is None or y is None else (max(x,y)+.05)/(min(x,y)+.05)
with sync_playwright() as p:
  browser=p.chromium.launch(headless=True)
  for vp in [(390,844),(1440,900)]:
    print('VIEWPORT',vp)
    page=browser.new_page(viewport={'width':vp[0],'height':vp[1]})
    for path in paths:
      page.goto(base+path,wait_until='networkidle')
      imgs=page.locator('img').evaluate_all(\"els=>els.map((e,i)=>({i,src:e.currentSrc||e.src,alt:e.getAttribute('alt'),box:(()=>{let r=e.getBoundingClientRect();return [r.x,r.y,r.width,r.height]})()}))\")
      icons=page.locator('a,button').evaluate_all(\"els=>els.map((e,i)=>({i,tag:e.tagName,text:(e.innerText||'').trim(),aria:e.getAttribute('aria-label'),title:e.getAttribute('title'),html:e.outerHTML.slice(0,180)})).filter(x=>"'!x.text && !x.aria && !x.title)")
      small=page.locator('"'a,button,[role=button],input,select,textarea').evaluate_all(\"els=>els.map((e,i)=>{let r=e.getBoundingClientRect();return {i,tag:e.tagName,text:(e.innerText||'').trim().slice(0,30),w:r.width,h:r.height,x:r.x,y:r.y}}).filter(x=>x.w<44||x.h<44)\")
      # text contrast candidates by visible leaf-ish elements
      cont=page.locator('body *').evaluate_all(\"els=>els.map((e,i)=>{let s=getComputedStyle(e),r=e.getBoundingClientRect(),t=(e.childElementCount===0?(e.textContent||'').trim():'');return {i,t:t.slice(0,60),fg:s.color,bg:s.backgroundColor,vis:"'!!t&&r.width>0&&r.height>0&&s.visibility!='"'hidden'&&s.display"'!='"'none',font:s.fontSize}}).filter(x=>x.vis)\")
      bad=[]
      for x in cont:
        rr=ratio(x['fg'],x['bg'])
        if rr and rr<4.5: bad.append({**x,'ratio':round(rr,2)})
      print(path,'imgs',json.dumps(imgs,ensure_ascii=False),'iconNoName',json.dumps(icons,ensure_ascii=False),'smallN',len(small),'small',json.dumps(small[:20],ensure_ascii=False),'contrastBad',json.dumps(bad[:20],ensure_ascii=False))
      # theme toggle
