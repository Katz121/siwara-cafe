        seq.append(f.evaluate(\"e=>({tag:e.tagName,txt:(e.innerText||e.getAttribute('aria-label')||'').trim().slice(0,40),id:e.id,cls:e.className})\"))
      print(' tabs',json.dumps(seq[:30],ensure_ascii=False))
    page.close()
  browser.close()
