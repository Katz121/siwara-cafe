 for m in re.finditer(r'url\\([\"\\']?(["'^"'"\\')]+)',txt):
  if 'woff' in m.group(1) or 'ttf' in m.group(1): print('FONT_REF',css.relative_to(root),m.group(1))
# image sizes and total
