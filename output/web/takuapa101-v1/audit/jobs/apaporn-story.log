    for s in STORIES+[KUAPAPOH]:
        for n, (heading, text) in enumerate(s['sections'], 1):
            claims.append({"id": f"{s['id']}-{n}", "article_id": s['id'], "text_th": text, "status": "qualified", "source_ids": s['sources'], "notes": "à¸–à¹‰à¸­à¸¢à¸„à¸³à¸„à¸‡à¸£à¸°à¸”à¸±à¸šà¸«à¸¥à¸±à¸à¸à¸²à¸™à¸•à¸²à¸¡à¹à¸«à¸¥à¹ˆà¸‡à¸•à¹‰à¸™à¸—à¸²à¸‡"})
    audit = {"audit_date": "2026-09-07", "method": "à¸•à¸£à¸§à¸ˆà¹à¸«à¸¥à¹ˆà¸‡à¸£à¸²à¸Šà¸à¸²à¸£/à¸ªà¸–à¸²à¸šà¸±à¸™à¸à¹ˆà¸­à¸™à¹€à¸£à¸µà¸¢à¸šà¹€à¸£à¸µà¸¢à¸‡; à¹„à¸¡à¹ˆà¹ƒà¸Šà¹‰à¹‚à¸žà¸ªà¸•à¹Œà¸ªà¸£à¸¸à¸›à¹€à¸›à¹‡à¸™à¹à¸«à¸¥à¹ˆà¸‡à¸¢à¸·à¸™à¸¢à¸±à¸™; à¹à¸¢à¸ supported, qualified à¹à¸¥à¸° unverified", "sources": [{"id": k, **v, "accessed": "2026-09-07"} for k, v in SOURCES.items()], "claims": claims, "excluded_claims": ["à¹€à¸§à¸¥à¸²à¹€à¸›à¸´à¸”à¸£à¹‰à¸²à¸™ à¸£à¸²à¸„à¸² à¸£à¸µà¸§à¸´à¸§ à¸„à¸°à¹à¸™à¸™ à¹à¸¥à¸°à¸ªà¸–à¸²à¸™à¸°à¸›à¸±à¸ˆà¸ˆà¸¸à¸šà¸±à¸™à¸—à¸µà¹ˆà¹„à¸¡à¹ˆà¸¡à¸µà¹à¸«à¸¥à¹ˆà¸‡à¸¢à¸·à¸™à¸¢à¸±à¸™", "à¸„à¸³à¸à¸¥à¹ˆà¸²à¸§à¹€à¸Šà¸´à¸‡ superlative à¹€à¸Šà¹ˆà¸™ à¹€à¸¥à¹‡à¸à¸—à¸µà¹ˆà¸ªà¸¸à¸”à¸«à¸£à¸·à¸­à¹€à¸à¹ˆà¸²à¹à¸à¹ˆà¸—à¸µà¹ˆà¸ªà¸¸à¸”", "à¸à¸²à¸£à¸£à¸°à¸šà¸¸à¸—à¸µà¹ˆà¸•à¸±à¹‰à¸‡à¸•à¸°à¹‚à¸à¸¥à¸²à¹€à¸›à¹‡à¸™à¸‚à¹‰à¸­à¸¢à¸¸à¸•à¸´à¹€à¸”à¸µà¸¢à¸§"]}
    (AUDIT_DIR/'audit.json').write_text(json.dumps(audit, ensure_ascii=False, indent=2), encoding='utf-8')


