ylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/stories/apaporn/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/stories/apaporn/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/stories/apaporn/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/" aria-current="page">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/stories/apaporn/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="story-article-v2"><header class="story-hero-v2"><div class="breadcrumbs"><a href="/">หน้าแรก</a><span>/</span><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><span>/</span><span>กระทู้เมือง</span></div><span class="eyebrow">เรื่องเล่าตะกั่วป่า · กระทู้เมือง</span><h1>อาภรณ์ · เมืองเก่าที่เปิดผนึกผ่านเครื่องแต่งกาย</h1><p class="lead">อ. แรกใน 6 อ. ของย่านเมืองเก่าตะกั่วป่า · เสื้อเคบายา ลวดลาย และความงามของคนเปอรานากัน ผ่านปลายพู่กันของช่างป๋อง</p><p class="story-meta">ปรับปรุงเมื่อ 2026-09-09 · เวลาอ่าน 5 นาที</p></header><figure class="hero-photo-v2"><img src="/assets/photos/kuapapoh-charm-09.webp" width="900" height="1092" alt="ภาพเขียน Peranakan Charm No.9 · หญิงสาวสวมเสื้อครุยสีฟ้าปักดิ้นทอง ติดเข็มกลัดโกสัง สวมกำไลทอง ท่ามกลางดอกโบตั๋นและผีเสื้อ" loading="eager"><figcaption><span>ภาพเขียน Peranakan Charm No.9 · หญิงสาวสวมเสื้อครุยสีฟ้าปักดิ้นทอง ติดเข็มกลัดโกสัง สวมกำไลทอง ท่ามกลางดอกโบตั๋นและผีเสื้อ</span><span class="credit">ช่างป๋อง · ติณณภพ งานสถิร</span></figcaption></figure><div class="story-layout-v2"><div class="story-main-v2"><div class="story-lede-v2"><p>อ. แรกใน 6 อ. ของย่านเมืองเก่าตะกั่วป่าเปิดผนึกแล้ว · อาภรณ์ชวนเราอ่านเมืองผ่านเครื่องแต่งกาย ลวดลาย และเครื่องประดับที่ปรากฏในภาพเขียนของช่างป๋อง</p><p>นิทรรศการ มนต์เสน่ห์เปอรานากัน จัดแสดงในเดือนกันยายน 2569 ที่ 78 สตูดิโอ ถนนวัฒนธรรมตะกั่วป่า เรื่องราวในหน้านี้ยึดข้อมูลโครงการและสิ่งที่เห็นในภาพเป็นหลัก ส่วนประวัติศาสตร์ของเครื่องแต่งกายที่ยังไม่มีข้อมูลยืนยันจะระบุไว้ชัดเจน</p></div><section class="story-section-v2"><h2 id="section-0">6 อ. คือกรอบมองเมืองผ่านมรดก</h2><figure class="section-photo-v2"><img src="/assets/culture-street.webp" width="1000" height="1000" alt="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption><span>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>กั่วป่าโพ้ใช้แนวคิด 6 อ. เป็นกรอบเล่าเมืองเก่าตะกั่วป่า ได้แก่ อาภรณ์ อาศัย อาหาร อารมณ์ อาราม และอาคาร แต่ละคำพาไปดูมรดกคนละด้าน ตั้งแต่เครื่องแต่งกายเฉพาะถิ่น วิถีชีวิตและร้านค้า อาหารท้องถิ่น งานศิลปะและเสียงเพลง วัดศาลเจ้าและโหย่กวน ไปจนถึงบ้านเรือนและสถาปัตยกรรมที่แฝงทัศนคติและความเชื่อ</p><p>อาภรณ์เปิดก่อน เพราะนิทรรศการที่ 78 สตูดิโอทำให้กรอบนี้มีงานให้ดูได้ทันทีในเดือนกันยายน 2569 · เครื่องแต่งกายจึงเป็นประตูบานแรกที่พาเราเข้าไปอ่านความงามและตัวตนของเมืองผ่านสายตาศิลปิน</p></section><blockquote class="pull-quote-v2"><p>ผลงานจิตรกรรม มนต์เสน่ห์เปอรานากัน คือหลักฐานที่แสดงตัวตนทุกช่วงเวลาตลอดเส้นทางการดำเนินชีวิต หล่อหลอมให้เติบโตในฐานะมนุษย์ผู้หลงใหลในศิลปะ ท่ามกลางวัฒนธรรมเปอรานากัน</p></blockquote><section class="story-section-v2"><h2 id="section-1">อาภรณ์เปอรานากันในภาพเขียน</h2><figure class="section-photo-v2"><img src="/assets/photos/kuapapoh-charm-kebaya-pink.webp" width="900" height="1142" alt="ภาพเขียนหญิงสาวสวมเสื้อเคบายาสีชมพูปักลายดอก ติดเข็มกลัดโกสังทองสามชิ้นเรียงกลางอก พื้นหลังสีน้ำเงินและดอกกุหลาบ" loading="lazy"><figcaption><span>ภาพเขียนหญิงสาวสวมเสื้อเคบายาสีชมพูปักลายดอก ติดเข็มกลัดโกสังทองสามชิ้นเรียงกลางอก พื้นหลังสีน้ำเงินและดอกกุหลาบ</span><span class="credit">ช่างป๋อง · ติณณภพ งานสถิร</span></figcaption></figure><p>ในภาพเขียนที่ใช้กับนิทรรศการ เราเห็นเสื้อเคบายา เสื้อครุยสีฟ้าปักดิ้นทอง ผ้าลูกไม้ฉลุสีขาว ผ้าปาเต๊ะลายดอก เข็มกลัดโกสัง กำไลทอง และปิ่นโตลงรัก รายละเอียดเหล่านี้ไม่ได้ถูกนำเสนอเป็นรายการเสื้อผ้าแยกส่วน แต่ปรากฏพร้อมสี พื้นหลัง ดอกไม้ และท่าทางของผู้หญิงในภาพ</p><p>ข้อมูลโครงการบอกว่า อาภรณ์หมายถึงเครื่องแต่งกายเฉพาะถิ่น ผ้าลูกไม้ ผ้าถุงปาเต๊ะ ลวดลายผ้า และเครื่องประดับ ภาพของช่างป๋องจึงช่วยให้เราเห็นคำอธิบายนี้เป็นรูปธรรมมากขึ้น</p><p>เหตุผลเชิงประวัติศาสตร์ว่าทำไมเมืองที่เติบโตมากับเหมืองแร่จึงมีเครื่องแต่งกายแบบนี้ ยังไม่ยืนยันจากข้อมูลที่ใช้ในบทความนี้ · สิ่งที่ยืนยันได้คือโครงการเชื่อมเรื่องเครื่องแต่งกายเข้ากับเรื่องเล่าของเมือง และศิลปินเลือกถ่ายทอดผ่านสี ลวดลาย และการแต่งกายของผู้คน</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">ที่มาทางประวัติศาสตร์ของเครื่องแต่งกายยังไม่ยืนยัน</span></div></section><section class="story-section-v2"><h2 id="section-2">มนต์เสน่ห์เปอรานากันที่ 78 สตูดิโอ</h2><figure class="section-photo-v2"><img src="/assets/photos/kuapapoh-expo-corner.webp" width="1400" height="1050" alt="มุมแรกของนิทรรศการที่ 78 สตูดิโอ · ป้ายประวัติศิลปินบนขาตั้ง กับผลงานที่แขวนบนชั้นไม้เก่า" loading="lazy"><figcaption><span>มุมแรกของนิทรรศการที่ 78 สตูดิโอ · ป้ายประวัติศิลปินบนขาตั้ง กับผลงานที่แขวนบนชั้นไม้เก่า</span><span class="credit">โครงการกั่วป่าโพ้ จีโชว์เมือง</span></figcaption></figure><p>นิทรรศการเดี่ยว มนต์เสน่ห์เปอรานากัน โดย ช่างป๋อง · ติณณภพ งานสถิร จัดขึ้นในเดือนกันยายน 2569 ที่ 78 สตูดิโอ ถนนวัฒนธรรมตะกั่วป่า งานเลือกใช้ปลายพู่กันถ่ายทอดเรื่องราวของเมืองผ่านลวดลาย สีสัน และการแต่งกายของผู้คน เพื่อเชื่อมอดีตกับปัจจุบัน</p><p>โครงการกั่วป่าโพ้ฟื้นพื้นที่ว่างในอาคารเก่าให้เป็นพื้นที่สร้างสรรค์ บ้านเลขที่ 78 เดิมเป็นบ้านนายเหมืองและบริษัทเหมืองแร่ดีบุก ปัจจุบันเป็นกั่วป่าเหมืองมิวเซียมที่มีกิจกรรมหมุนเวียน · อ่านรายละเอียดของพื้นที่และโครงการได้ที่ <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">เว็บไซต์กั่วป่าโพ้</a></p><p>ช่างป๋องเป็นชาวตลาดเก่าตะกั่วป่าโดยกำเนิด เรียนที่โรงเรียนสุทธิธรรมอนุสรณ์และโรงเรียนตะกั่วป่า เสนานุกูล ต่อระดับ ปวช. ที่วิทยาลัยช่างศิลป และปริญญาสาขาจิตรกรรม คณะจิตรกรรม ประติมากรรมและภาพพิมพ์ มหาวิทยาลัยศิลปากร เขาเคยร่วมแสดงนิทรรศการ เขียนภาพประกอบอาคารและสถานที่ในพังงาและจังหวัดใกล้เคียง เขียนภาพประกอบฉากภาพยนตร์ RAMBO 6 และทำภาพปกหนังสือ ปัจจุบันเป็นผู้ช่วยนายช่างศิลป์ เทศบาลเมืองตะกั่วป่า และเป็นศิลปินอิสระ</p></section><section class="story-section-v2"><h2 id="section-3">ไปดูของจริงได้ที่ไหน</h2><figure class="section-photo-v2"><img src="/assets/tao-ming.webp" width="1000" height="667" alt="โรงเรียนเต้าหมิง" loading="lazy"><figcaption><span>โรงเรียนเต้าหมิง</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>นิทรรศการ มนต์เสน่ห์เปอรานากัน เปิดทุกวันที่ 78 สตูดิโอ ถนนวัฒนธรรมตะกั่วป่า ในเดือนกันยายน 2569 · ข้อมูล openings ของโครงการยังระบุว่าเลขที่ 109 เปิดเฉพาะวันอาทิตย์ และเลขที่ 305 เปิดทุกวันอาทิตย์</p><p>ก่อนออกเดินทาง คุณตรวจสอบข่าวการจัดแสดงและรายละเอียดล่าสุดได้ที่ <a href="https://www.facebook.com/profile.php?id=61590430773715" target="_blank" rel="noopener">เพจกั่วป่าโพ้</a> และติดตามภาพรวมโครงการได้ที่ <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">กั่วป่าโพ้ · จีโชว์เมือง</a></p></section><section class="story-places-v2"><h2>ไปดูของจริงได้ที่ไหน</h2><div class="mini-cards-v2"><div class="place-card-mini"><div><h3>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</h3><button class="button button-outline" data-trip-add="culture-street">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>โรงเรียนเต้าหมิง</h3><button class="button button-outline" data-trip-add="tao-ming">เพิ่มลงทริป</button></div></div></div></section><details class="unknowns-box-v2"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ที่มาทางประวัติศาสตร์ของเครื่องแต่งกายเปอรานากันในบริบทเมืองตะกั่วป่า</li><li>จำนวนผู้เข้าชมนิทรรศการและผลกระทบทางเศรษฐกิจอย่างเป็นทางการ</li><li>กำหนดการหลังเดือนกันยายน 2569</li></ul></details><section class="story-sources-v2"><h2>แหล่งข้อมูล</h2><ol><li><cite>กั่วป่าโพ้ · ข้อมูลโครงการ</cite> · โครงการกั่วป่าโพ้ · content.json · hero, six, events, houses · <a href="https://kuapoh.pages.dev/" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-09)</li><li><cite>เพจกั่วป่าโพ้</cite> · กั่วป่าโพ้ · หน้าสาธารณะของโครงการ · <a href="https://www.facebook.com/profile.php?id=61590430773715" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-09)</li></ol></section></div><div class="story-sidebar-v2"><aside class="evidence-box-v2"><h3>หลักฐานอยู่ตรงไหน</h3><ul class="ev-items-v2"><li><div class="ev-claim">แนวคิด 6 อ. และนิทรรศการอาภรณ์</div><div class="ev-status qualified">QUALIFIED</div><div class="ev-explain">อ้างอิงจากคำอธิบายและกำหนดการที่เผยแพร่โดยโครงการกั่วป่าโพ้ <a href="https://kuapapoh.pages.dev/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">รายละเอียดเสื้อผ้าและเครื่องประดับในภาพเขียน</div><div class="ev-status qualified">QUALIFIED</div><div class="ev-explain">อธิบายจากภาพที่ระบุใน photo registry และข้อมูลโครงการเท่านั้น <a href="https://kuapoh.pages.dev/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">เหตุผลทางประวัติศาสตร์ของเครื่องแต่งกายเปอรานากันในเมืองเหมืองแร่</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">ยังไม่มีข้อมูลยืนยันในแหล่งข้อมูลที่ใช้กับบทความนี้ <a href="https://kuapoh.pages.dev/" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li></ul></aside><nav class="story-toc-v2 scrollspy" id="story-toc"><h2>เนื้อหาในบทความ</h2><ul class="scrollspy-nav"><li><a href="#section-0">6 อ. คือกรอบมองเมืองผ่านมรดก</a></li><li><a href="#section-1">อาภรณ์เปอรานากันในภาพเขียน</a></li><li><a href="#section-2">มนต์เสน่ห์เปอรานากันที่ 78 สตูดิโอ</a></li><li><a href="#section-3">ไปดูของจริงได้ที่ไหน</a></li></ul></nav></div></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>

diff --git a/output/web/takuapa101-v1/data/i18n/en/stories/apaporn.json b/output/web/takuapa101-v1/data/i18n/en/stories/apaporn.json
