-    return (photo or {}).get(key, '')
+    return (photo or {}).get(key, '')
+
+def story_paragraph(text):
+    """Escape story copy while allowing the audited inline links we author."""
+    import re
+    out = escape(text)
+    return re.sub(r'\[([^\]]+)\]\((https://[^)]+)\)', r'<a href="\2" target="_blank" rel="noopener">\1</a>', out)
 
 
