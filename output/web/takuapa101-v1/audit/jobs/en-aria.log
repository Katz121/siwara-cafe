tton" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="intro"><a class="eyebrow" href="/">ตะกั่วป่า 101 / คู่มือเมืองเก่า</a><h1>ประเพณีกินผัก (เจี๊ยะกิ๊วอ๋องฉ่าย)</h1><p class="lead">วันที่ 1 ถึง 9 เดือน 9 ตามปฏิทินจีน · โดยมากกันยายนถึงตุลาคม</p></div><div class="event-note"><span class="calendar-symbol" aria-hidden="true">✳</span><article><span class="chapter">ช่วงเวลาจากเอกสาร</span><h2>วันที่ 1 ถึง 9 เดือน 9 ตามปฏิทินจีน · โดยมากกันยายนถึงตุลาคม</h2><p>รายการนี้ปรากฏในหมวดกิจกรรมและประเพณีของแผ่นพับเทศบาลเมืองตะกั่วป่า ช่วงเวลาข้างต้นยังไม่ใช่กำหนดการยืนยันของปีปัจจุบัน</p><a class="text-link" href="/traditions/">ดูประเพณีตลอดปี ↗</a></article></div><section class="section"><div class="section-heading"><div><span class="chapter">อ่านต่อ / เปิดอ่านเมือง</span><h2>สถานที่ที่เกี่ยวข้อง</h2></div><p></p></div><div class="related-grid"><article class="place-card" data-place-card data-category="shrine" data-name="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง"><a class="place-image" href="/places/guan-yu/"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="lazy"><span class="card-index">08</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ศาลเจ้าและโรงเจ</span><h3><a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a></h3><p>ประตูสีแดงกับศรัทธาของชุมชน</p></div></article><article class="place-card" data-place-card data-category="shrine" data-name="ศาลเจ้าปุนเถ่ากงอ๊า"><a class="place-image" href="/places/pun-thao/"><img src="/assets/pun-thao.webp" alt="ศาลเจ้าปุนเถ่ากงอ๊า" width="1000" height="1000" loading="lazy"><span class="card-index">09</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ศาลเจ้าและโรงเจ</span><h3><a href="/places/pun-thao/">ศาลเจ้าปุนเถ่ากงอ๊า</a></h3><p>ศรัทธาในย่านท่าเรือเก่า</p></div></article><article class="place-card" data-place-card data-category="shrine" data-name="ศาลเจ้ากู่ใช่ตึ๋ง"><a class="place-image" href="/places/kue-chai/"><img src="/assets/kue-chai.webp" alt="ศาลเจ้ากู่ใช่ตึ๋ง" width="1000" height="1000" loading="lazy"><span class="card-index">10</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ศาลเจ้าและโรงเจ</span><h3><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a></h3><p>พื้นที่ฝากความหวังของผู้คน</p></div></article><article class="place-card" data-place-card data-category="shrine" data-name="โรงเจในสวน"><a class="place-image" href="/places/rong-jae/"><img src="/assets/rong-jae.webp" alt="โรงเจในสวน" width="1000" height="1000" loading="lazy"><span class="card-index">11</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ศาลเจ้าและโรงเจ</span><h3><a href="/places/rong-jae/">โรงเจในสวน</a></h3><p>ประเพณีที่ส่งต่อผ่านสถานที่</p></div></article></div></section><aside class="source"><h2>ที่มาของข้อมูล</h2><p>เรียบเรียงจาก<a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf" target="_blank" rel="noopener">แผ่นพับเทศบาลเมืองตะกั่วป่า</a> · สกัดข้อมูล 6 กันยายน 2569 เอกสารไม่ระบุวันที่เผยแพร่ เวลาเปิด สถานะร้าน และกำหนดงานปัจจุบันยังไม่ได้ยืนยัน ควรตรวจสอบกับสถานที่ก่อนเดินทาง</p></aside></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
.\data\places-enriched.json:169:        "body_th": "หลักฐานของสำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อมระบุว่า จุดเริ่มต้นของวัดคีรีเขตเป็นที่พักสงฆ์ของพระฝ่ายอรัญวาสี ใช้บำเพ็ญสมณธรรม และมีอายุราว 200 ปีเมื่อฐานข้อมูลจัดทำขึ้น จึงยังไม่ควรฟันธงปีสร้างที่แน่นอนกว่านี้ ชื่อที่ชาวบ้านใช้ว่า “วัดลุ่ม” สะท้อนภูมิประเทศที่ลาดลุ่มของวัดในย่านตลาดเก่า\n\nแหล่งข้อมูลท้องถิ่นอีกชุดระบุว่าวัดสร้างหรือจดทะเบียนเมื่อวันที่ 15 พฤษภาคม พ.ศ. 2436 และต่อมาใช้ชื่อวัดพระธาตุคีรีเขต สังกัดมหานิกาย ภายในมีฐานเจดีย์โบราณซึ่งมีต้นไทรใหญ่ขึ้นบนฐาน และมีพระบรมสารีริกธาตุเป็นศูนย์รวมศรัทธา\n\nในภาพเมืองตะกั่วป่ายุคเหมืองแร่และการค้าทางทะเล วัดตั้งอยู่ใกล้ตลาดเก่าและชุมชนที่มีชาวจีนฮกเกี้ยนกับกลุ่มคนเหมืองแร่เข้ามาตั้งถิ่นฐาน แต่แหล่งที่ตรวจสอบได้ไม่ได้ระบุว่าวัดนี้สร้างโดยเจ้าเมืองหรือบุคคลใด และไม่พบหลักฐานตรงที่เชื่อมผู้สร้างกับชาวจีนกลุ่มใด จึงเล่าได้อย่างระมัดระวังว่าวัดทำหน้าที่เป็นศาสนสถานและหลักยึดทางจิตใจของชุมชนเมืองเก่า มากกว่าจะระบุผู้ก่อตั้งโดยเดา",
.\data\places-enriched.json:233:        "detail_th": "แหล่งข้อมูลท้องถิ่นระบุวันที่ 15 พฤษภาคม พ.ศ. 2436 และการใช้ชื่อวัดพระธาตุคีรีเขต",
.\data\places-enriched.json:1226:        "claim_th": "แหล่งข้อมูล ONEP ระบุว่าวัดสร้างเมื่อ พ.ศ. 2305 และเดิมชื่อวัดคงคา",
.\data\places-enriched.json:1228:        "quote": "สร้างเมื่อปี พ.ศ. 2305 เดิมชื่อวัดคงคา",
.\data\places-enriched.json:1235:        "claim_th": "ประวัติวัดที่บันทึกในฐานข้อมูลโบราณคดีระบุว่าอุโบสถสร้าง พ.ศ. 2479 เดิมชื่อวัดคงคา และเปลี่ยนชื่อเป็นวัดคงคาพิมุขใน พ.ศ. 2483",
.\data\places-enriched.json:1275:        "body_th": "หลักฐานของหน่วยงานด้านสิ่งแวดล้อมศิลปกรรมระบุว่าวัดสร้างขึ้นใน พ.ศ. 2305 และเดิมชื่อวัด “คงคา” ขณะที่ฐานข้อมูลโบราณคดีของศูนย์มานุษยวิทยาสิรินธรระบุอายุโบราณสถานสำคัญจากอุโบสถที่สร้างใน พ.ศ. 2479 จึงควรอ่านเรื่องกำเนิดเป็นประวัติ 2 ชั้น: อายุวัดตามทะเบียน/คำบอกเล่า กับอายุอาคารที่ยังเห็นอยู่ ซึ่งไม่ใช่เรื่องเดียวกัน\n\nวัดตั้งอยู่บนที่ราบตะกอนริมคลองตะกั่วป่า ด้านตะวันตกของลำน้ำ ในเมืองที่มีประวัติเป็นหัวเมืองชายฝั่งและศูนย์กลางแร่ดีบุกกับการค้าทางทะเล บริบทเมืองเช่นนี้ทำให้วัดน่าจะทำหน้าที่เป็นศาสนสถานประจำชุมชนริมน้ำ แต่ยังไม่พบหลักฐานเฉพาะวัดที่ระบุผู้สร้าง เหตุผลการสร้าง หรือบทบาทของชาวจีนฮกเกี้ยน/เจ้าเมืองโดยตรง จึงไม่ควรเติมรายละเอียดเกินหลักฐาน\n\nอุโบสถที่สร้างใน พ.ศ. 2479 เป็นอาคารก่ออิฐถือปูนแบบปักษ์ใต้ หันหน้าไปทางตะวันออก และประดับปูนปั้นเรื่องเจดีย์ พระพุทธรูป ธรรมจักร และพรรณพฤกษา สะท้อนการเป็นทั้งพื้นที่ประกอบศาสนกิจและงานช่างของชุมชนในยุครัตนโกสินทร์ตอนปลายถึงรัชกาลที่ 8",
.\data\places-enriched.json:1331:        "detail_th": "ONEP ระบุว่าวัดสร้างใน พ.ศ. 2305 และเดิมชื่อวัดคงคา แต่ฐานข้อมูลโบราณคดีใช้ พ.ศ. 2479 เป็นอายุอุโบสถ จึงยังสรุปไม่ได้ว่าพื้นที่หรืออาคารเริ่มต้นในปีเดียวกัน",
.\data\places-enriched.json:1349:        "detail_th": "ประวัติวัดในฐานข้อมูลโบราณคดีระบุว่าเดิมชื่อวัดคงคา แล้วเปลี่ยนชื่อเป็นวัดคงคาพิมุข",
