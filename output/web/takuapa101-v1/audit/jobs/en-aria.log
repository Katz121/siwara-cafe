 m=re.search(r'(?:alt|title|aria-label|placeholder)=\"(["'^"]*[ก-๙][''^"]*)"'"',line)
 if m: vals.add(m.group(1))
for v in sorted(vals): text += f'| {v} | {d.get(v,\"(see existing translation)\")} |\\n'
p.write_text(text,encoding='utf-8')
print('report',len(vals))
