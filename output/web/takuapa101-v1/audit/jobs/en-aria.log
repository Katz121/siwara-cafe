 data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="intro"><a class="eyebrow" href="/">ตะกั่วป่า 101 / คู่มือเมืองเก่า</a><h1>ประเพณีชักพระ</h1><p class="lead">วันถัดจากวันออกพรรษา</p></div><div class="event-note"><span class="calendar-symbol" aria-hidden="true">✳</span><article><span class="chapter">ช่วงเวลาจากเอกสาร</span><h2>วันถัดจากวันออกพรรษา</h2><p>รายการนี้ปรากฏในหมวดกิจกรรมและประเพณีของแผ่นพับเทศบาลเมืองตะกั่วป่า ช่วงเวลาข้างต้นยังไม่ใช่กำหนดการยืนยันของปีปัจจุบัน</p><a class="text-link" href="/traditions/">ดูประเพณีตลอดปี ↗</a></article></div><section class="section"><div class="section-heading"><div><span class="chapter">อ่านต่อ / เปิดอ่านเมือง</span><h2>สถานที่ที่เกี่ยวข้อง</h2></div><p></p></div><div class="related-grid"><article class="place-card" data-place-card data-category="temple" data-name="วัดบรมธาตุคีรีเขต (วัดลุ่ม)"><a class="place-image" href="/places/wat-boromthat/"><img src="/assets/wat-boromthat.webp" alt="วัดบรมธาตุคีรีเขต (วัดลุ่ม)" width="1000" height="1000" loading="lazy"><span class="card-index">01</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-boromthat/">วัดบรมธาตุคีรีเขต (วัดลุ่ม)</a></h3><p>เจดีย์สีขาวกับศรัทธาของเมือง</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดคุหาภิมุข (วัดควนถ้ำ)"><a class="place-image" href="/places/wat-khuha/"><img src="/assets/wat-khuha.webp" alt="วัดคุหาภิมุข (วัดควนถ้ำ)" width="1000" height="1000" loading="lazy"><span class="card-index">02</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-khuha/">วัดคุหาภิมุข (วัดควนถ้ำ)</a></h3><p>รายละเอียดเล็กที่ชวนให้หยุดมอง</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดปทุมธารา (วัดหน้าเมือง)"><a class="place-image" href="/places/wat-pathum/"><img src="/assets/wat-pathum.webp" alt="วัดปทุมธารา (วัดหน้าเมือง)" width="1000" height="1000" loading="lazy"><span class="card-index">03</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-pathum/">วัดปทุมธารา (วัดหน้าเมือง)</a></h3><p>โบสถ์เก่ากับเรื่องราวทางน้ำ</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดคงคาภิมุข (วัดคงคา)"><a class="place-image" href="/places/wat-kongkha/"><img src="/assets/wat-kongkha.webp" alt="วัดคงคาภิมุข (วัดคงคา)" width="1000" height="1000" loading="lazy"><span class="card-index">04</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-kongkha/">วัดคงคาภิมุข (วัดคงคา)</a></h3><p>เส้นสายอุโบสถแบบปักษ์ใต้</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดนิกรวราราม (วัดย่านยาว)"><a class="place-image" href="/places/wat-nikorn/"><img src="/assets/wat-nikorn.webp" alt="วัดนิกรวราราม (วัดย่านยาว)" width="1000" height="726" loading="lazy"><span class="card-index">05</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a></h3><p>วัดกับความทรงจำของชุมชน</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดเสนานุชรังสรรค์ (วัดใหม่)"><a class="place-image" href="/places/wat-sena/"><img src="/assets/wat-sena.webp" alt="วัดเสนานุชรังสรรค์ (วัดใหม่)" width="1000" height="1000" loading="lazy"><span class="card-index">06</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-sena/">วัดเสนานุชรังสรรค์ (วัดใหม่)</a></h3><p>ร่องรอยไทยและจีนในอาคารเดียวกัน</p></div></article></div></section><aside class="source"><h2>ที่มาของข้อมูล</h2><p>เรียบเรียงจาก<a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf" target="_blank" rel="noopener">แผ่นพับเทศบาลเมืองตะกั่วป่า</a> · สกัดข้อมูล 6 กันยายน 2569 เอกสารไม่ระบุวันที่เผยแพร่ เวลาเปิด สถานะร้าน และกำหนดงานปัจจุบันยังไม่ได้ยืนยัน ควรตรวจสอบกับสถานที่ก่อนเดินทาง</p></aside></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
.\scratch_gen.py:44:    "แหล่งข้อมูลท้องถิ่นอีกชุดระบุว่าวัดสร้างหรือจดทะเบียนเมื่อวันที่ 15 พฤษภาคม พ.ศ. 2436 และต่อมาใช้ชื่อวัดพระธาตุคีรีเขต สังกัดมหานิกาย ภายในมีฐานเจดีย์โบราณซึ่งมีต้นไทรใหญ่ขึ้นบนฐาน และมีพระบรมสารีริกธาตุเป็นศูนย์รวมศรัทธา": "Another set of local information sources states that the temple was built or registered on 15 May 1893 (2436 BE) and later used the name Wat Phra That Khiri Khet under the Maha Nikaya sect. Inside, there is an ancient pagoda base with a large banyan tree growing on the base, and there are Buddha relics serving as a center of faith.",
