# derive from current dictionary and pre-recorded values from source audit
import json
d=json.loads(Path('data/i18n/en/ui.json').read_text(encoding='utf-8'))
vals=set()
for f in Path('site/en').rglob('*.html'):
 s=f.read_text(encoding='utf-8')
 for m in re.finditer(r'(?:alt|title|aria-label|placeholder)\\s*=\\s*[\"\\'](["'^"'"\\']*)',s):
  if re.search(r'[\\u0e00-\\u0e7f]',m.group(1)): vals.add(m.group(1))
# use known pre-build values from audit log
