from pathlib import Path
import re,json
files=list(Path('site/en').rglob('*.html'))
vals=set(); hits=[]
for f in files:
 s=f.read_text(encoding='utf-8')
 for m in re.finditer(r'(?:alt|title|aria-label|placeholder)\\s*=\\s*[\"\\'](["'^"'"\\']*)',s):
  if re.search(r'[\\u0e00-\\u0e7f]',m.group(1)): vals.add(m.group(1)); hits.append((f,m.group(1)))
print('pages',len(files),'hits',len(hits),'unique',len(vals))
for v in sorted(vals): print(json.dumps(v,ensure_ascii=True))
