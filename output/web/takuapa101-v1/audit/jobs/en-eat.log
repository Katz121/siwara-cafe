image": "https://takuapa101.com/assets/culture-street.webp", "description": "ย่านถนนคนเดินที่เชื่อมอาคารเก่า อาหาร และวิถีท้องถิ่น", "address": {"@type": "PostalAddress", "streetAddress": "ถนนศรีตะกั่วป่า และถนนอุดมธารา", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.829848, "longitude": 98.364073}, "telephone": "076424279"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "เปิดให้เข้าชมเวลาใด", "acceptedAnswer": {"@type": "Answer", "text": "วันอาทิตย์ 14.00 ถึง 20.00 น."}}, {"@type": "Question", "name": "มีค่าเข้าชมหรือไม่", "acceptedAnswer": {"@type": "Answer", "text": "ข้อมูลยังไม่ยืนยัน · เข้าชมฟรี"}}, {"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "ใช้ถนนราษฎร์บำรุงเข้าสู่ย่านเมืองเก่า แล้วต่อถนนศรีตะกั่วป่า; ช่วงถนนคนเดินอยู่บริเวณถนนศรีตะกั่วป่าและอุดมธารา"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "อาคารในย่านเมืองเก่ารักษาร่องรอยสถาปัตยกรรมชิโน-โปรตุกีส/ชิโน-ตะกั่วป่าที่สัมพันธ์กับยุคเหมืองแร่ดีบุก"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "อาคารบ้านเรือนและตึกแถวชิโน-โปรตุกีสในย่านเมืองเก่า อาหารพื้นเมือง ขนมพื้นบ้าน และของกินท้องถิ่น การแสดงศิลปวัฒนธรรม การละเล่นพื้นเมือง และการแต่งกายแบบบาบ๋า"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/places/culture-street/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/places/culture-street/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/places/culture-street/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/" aria-current="page">สถานที่</a><a href="/stories/">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/places/culture-street/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/">หน้าแรก</a> / <a href="/places/">สถานที่</a> / ตลาดและของกิน</div><header class="place-hero full-place-hero"><div><span class="chapter">บันทึกสถานที่ · ตลาดและของกิน</span><h1>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</h1><p class="english">Takua Pa Culture Street</p><span class="fact-status confirmed">ยืนยันแล้ว 6 ข้อ</span><p><a class="text-link" href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้ ↓</a></p><p class="place-hero-actions"><button class="button" type="button" data-trip-add="culture-street">เพิ่มลงทริป</button><a class="text-link" href="/trip/">ดูทริปของคุณ</a></p></div><div class="place-hero-art"><figure class="research-photo"><img src="/assets/photos/shophouse-305.webp" width="400" height="300" alt="ตึกแถวเลขที่ 305 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="eager"><figcaption>ตึกแถวเลขที่ 305 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า<small>เครดิต · คลังภาพโครงการกั่วป่าโพ้</small><small>สัญญาอนุญาต · ใช้ในเว็บนี้ได้</small></figcaption></figure></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>ข้อมูลใช้จริง</h2><dl><div><dt>พิกัด</dt><dd>8.829848, 98.364073 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.829848,98.364073" target="_blank" rel="noopener">นำทางด้วย Google Maps ↗</a><span class="source-offline">แหล่งพิกัด ↗ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span></div><div><dt>เวลาเปิด</dt><dd>วันอาทิตย์ 14.00 ถึง 20.00 น. <span class="fact-status confirmed">ยืนยันแล้ว</span></dd></div><div><dt>ค่าเข้า</dt><dd>เข้าชมฟรี <span class="fact-status unverified">ยังไม่ยืนยัน</span></dd></div><div><dt>ที่จอดรถ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ห้องน้ำ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>รถเข็น</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>การแต่งกาย</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>โทรศัพท์</dt><dd>076424279 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div><dt>เพจ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เว็บไซต์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ไลน์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><span class="source-offline">แหล่งข้อมูลการเข้าชม ↗ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a><span class="source-offline">แหล่งข้อมูลติดต่อ ↗ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">ในบันทึกหน้านี้</span><a href="#visit">ข้อมูลใช้จริง</a><a href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้</a><a href="#timeline">เส้นเวลาแบบจุด</a><a href="#gallery">แกลเลอรี</a><a href="#highlights">จุดเด่นที่ควรดู</a><a href="#news">ข่าวและความเคลื่อนไหว</a><a href="#did_you_know">รู้หรือไม่</a><a href="#getting_there">วิธีเดินทาง</a><a href="#nearby">ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</a><a href="#nearby-note"></a><a href="#faq">คำถามที่พบบ่อย</a><a href="#sources">ที่มาของข้อมูล</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>ตอนนั้น · ก่อนหน้า · ตอนนี้</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">ตอนนั้น</span><h3>จากถนนการค้าเมืองเหมือง สู่เวทีเล่าความหลัง</h3><p class="era-years">พ.ศ. 2370 ถึง 2550</p><span class="fact-status disputed">ข้อมูลขัดแย้ง</span><p>ถนนสายนี้ไม่ได้ถูกสร้างขึ้นเป็นแหล่งท่องเที่ยวตั้งแต่แรก แต่เติบโตอยู่ในย่านเมืองเก่าตะกั่วป่า ซึ่งเป็นเมืองท่าและศูนย์กลางการค้าทางน้ำ ก่อนจะรุ่งเรืองมากในยุคเหมืองแร่ดีบุก ผู้คนจีนจากแผ่นดินใหญ่ ปีนัง และสิงคโปร์เข้ามาค้าขายและทำเหมือง จนเกิดตึกแถว ร้านค้า โรงแรม ร้านกาแฟ และกิจการบริการเรียงรายตามถนนอุดมธาราและศรีตะกั่วป่า</p><p>อาคารสองฝั่งถนนจึงเป็นหลักฐานของเมืองพหุวัฒนธรรม ทั้งตึกแถวแบบจีนและแบบอิทธิพลอาณานิคมที่เชื่อมโยงกับชุมชนบาบ๋า ถนนทำหน้าที่เป็นแกนการค้าและการอยู่อาศัยของเมือง ไม่ใช่ถนนคนเดินแบบปัจจุบัน</p><p>เมื่อโครงการถนนคนเดินเริ่มขึ้นใน พ.ศ. 2550 โดยความร่วมมือของ ททท. สำนักงานพังงา เทศบาลเมืองตะกั่วป่า ชุมชนตลาดใหญ่ และชุมชนเสนานุชรังสรรค์ ถนนเดิมจึงถูกนำมาใช้เป็นพื้นที่สาธารณะเพื่อเล่าอดีตและฟื้นชีวิตเศรษฐกิจชุมชน ภายใต้ชื่อ “ตะกั่วป่า เมืองเก่า เล่าความหลัง”</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://anyflip.com/yxwin/sydm/basic/" target="_blank" rel="noopener">ร้อยเรื่องเมืองเก่าอันดามัน / เอกสารวิชาการเมืองเก่าตะกั่วป่า</a> · <a href="https://mgronline.com/south/detail/9650000044214" target="_blank" rel="noopener">ผู้จัดการออนไลน์: สัมผัสกลิ่นอายถนนสายวัฒนธรรม</a> · <a href="https://so04.tci-thaijo.org/index.php/yru_human/article/download/128497/96582/" target="_blank" rel="noopener">วารสารมหาวิทยาลัยราชภัฏยะลา</a></div></article><article class="era-card" data-era="before"><span class="chapter">ก่อนหน้า</span><h3>เมืองเหมืองซบเซา แต่ถนนเก่ายังไม่หายไป</h3><p class="era-years">พ.ศ. 2500 ถึง 2565</p><span class="fact-status disputed">ข้อมูลขัดแย้ง</span><p>หลังบริษัทเหมืองแร่ปิดตัวและแร่ดีบุกลดลง เศรษฐกิจย่านการค้าเก่าตะกั่วป่าซบเซา อาคารบางหลังยังอยู่ในสภาพดี ขณะที่บางหลังทรุดโทรมตามเวลา งานศึกษาพื้นที่ชี้ว่าการจัดถนนสายวัฒนธรรมใช้เรื่องเล่า อาหาร ภูมิปัญญา และสถาปัตยกรรมเดิมเป็นทุน เพื่อทำให้ย่านกลับมามีผู้คนและรายได้อีกครั้ง</p><p>ชื่อโครงการเปลี่ยนจาก “ตะกั่วป่า เมืองเก่า เล่าความหลัง” มาเป็น “ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า” ในเวลาต่อมา ทะเบียนตลาดของกรมการค้าภายในระบุวันก่อตั้ง/ได้รับการส่งเสริม 17 ธันวาคม 2560 แต่แหล่งข่าวระบุการเริ่มกิจกรรมตั้งแต่ 2550 จึงควรเข้าใจว่าเป็นคนละหมุดหมาย: จุดเริ่มกิจกรรมกับจุดขึ้นทะเบียน/ส่งเสริมตลาด</p><p>ใน พ.ศ. 2565 จังหวัดและท้องถิ่นยังจัดกิจกรรมช่วงกรีนซีซันและมีรถโพถ้องพาเที่ยวฟรี แสดงว่าถนนถูกใช้เป็นเครื่องมือกระจายรายได้และดึงคนกลับเข้าสู่ย่านเก่า ไม่พบหลักฐานเฉพาะเจาะจงว่าถนนทั้งเส้นได้รับความเสียหายจากสึนามิ 2547 หรือได้รับการขึ้นทะเบียนเป็นโบราณสถานทั้งเส้น</p><div class="era-sources">แหล่งอ้างอิง · <span class="source-offline">กรมการค้าภายใน กระทรวงพาณิชย์ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span> · <a href="https://mgronline.com/travel/detail/9650000061422" target="_blank" rel="noopener">ผู้จัดการออนไลน์: เปิดถนนช่วงหน้าฝน พ.ศ. 2565</a> · <a href="https://so04.tci-thaijo.org/index.php/JSTD/article/view/254126" target="_blank" rel="noopener">งานวิจัยการท่องเที่ยวเชิงวัฒนธรรมตะกั่วป่า</a></div></article><article class="era-card" data-era="now"><span class="chapter">ตอนนี้</span><h3>ตลาดวันอาทิตย์ที่ยังทำให้เมืองเก่ามีชีวิต</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ข้อมูลทะเบียนตลาดของกรมการค้าภายในระบุว่าถนนวัฒนธรรมเมืองเก่าตะกั่วป่าอยู่บนถนนศรีตะกั่วป่าและอุดมธารา เปิดวันอาทิตย์ เวลา 14.00 ถึง 20.00 น. และเข้าชมกิจกรรมได้โดยไม่เสียค่าเข้า ข้อมูลดังกล่าวระบุผู้ดูแลในระดับระบบตลาด แต่ไม่ได้ระบุหน่วยงานผู้รับผิดชอบถนนเป็นนิติบุคคลแยกต่างหาก</p><p>ปัจจุบันถนนยังทำหน้าที่เป็นตลาดและพื้นที่เรียนรู้ของชุมชน มีอาหารและขนมพื้นบ้าน งานจักสาน งานฝีมือ การแสดง การแต่งกายบาบ๋า นิทรรศการภาพถ่าย และภาพสตรีตอาร์ต อาคารเก่าชิโน-โปรตุกีสยังเป็นฉากหลักของกิจกรรม โดยสภาพอาคารมีทั้งส่วนที่อนุรักษ์ได้ดีและส่วนที่มีร่องรอยเสื่อมตามกาลเวลา แต่ไม่พบประกาศโครงการบูรณะใหญ่เฉพาะถนนนี้ในแหล่งที่ตรวจสอบ</p><p>ข่าวย้อนหลังยืนยันการจัดงานต่อเนื่องอย่างน้อยใน พ.ศ. 2565 และกิจกรรมชุมชนบนถนนใน พ.ศ. 2567 จึงสรุปได้ว่าถนนยังใช้งานอยู่ในฐานะตลาดวัฒนธรรมและพื้นที่กิจกรรมของคนท้องถิ่น โดยเวลาเปิดจริงอาจเปลี่ยนตามฤดูกาลหรือประกาศของผู้จัด</p><figure class="research-photo"><img src="/assets/photos/shophouse-305.webp" width="400" height="300" alt="ตึกแถวเลขที่ 305 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"><figcaption>ตึกแถวเลขที่ 305 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า<small>เครดิต · คลังภาพโครงการกั่วป่าโพ้</small><small>สัญญาอนุญาต · ใช้ในเว็บนี้ได้</small></figcaption></figure><div class="era-sources">แหล่งอ้างอิง · <span class="source-offline">กรมการค้าภายใน กระทรวงพาณิชย์ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span> · <a href="https://mgronline.com/south/detail/9670000097253" target="_blank" rel="noopener">ผู้จัดการออนไลน์: งานอิ่มบุญ อิ่มเจ 9 บาท พ.ศ. 2567</a> · <a href="https://mgronline.com/south/detail/9650000044214" target="_blank" rel="noopener">ผู้จัดการออนไลน์: ถนนสายวัฒนธรรมและสตรีตอาร์ต</a></div></article></div></section><section class="research-section" id="timeline"><h2>เส้นเวลาแบบจุด</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2370</p><h3>เริ่มพัฒนาเมืองและย่านถนนอุดมธารา</h3><p>เอกสารเมืองเก่าจัดช่วง พ.ศ. 2370 ถึง 2440 เป็นระยะตั้งเมืองและเริ่มพัฒนา ย่านถนนอุดมธาราเป็นพื้นที่ตั้งถิ่นฐานแรก ๆ ของเมือง</p><a href="https://anyflip.com/yxwin/sydm/basic/" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2430</p><h3>ตึกแถวรับอิทธิพลเมืองท่าปีนัง · สิงคโปร์</h3><p>ถนนศรีตะกั่วป่ามีตึกแถวแบบอิทธิพลอาณานิคมช่องแคบ ซึ่งสัมพันธ์กับการค้าและชุมชนจีนในเมืองท่า</p><a href="https://anyflip.com/yxwin/sydm/basic/" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2500</p><h3>เมืองตะกั่วป่ารุ่งเรืองถึงจุดสูงสุดของยุคเหมือง</h3><p>เอกสารอธิบายว่าความรุ่งเรืองของเมืองถึงขีดสุดช่วงต้น พ.ศ. 2500 ก่อนเหมืองปิดและย่านการค้าซบเซา</p><a href="https://anyflip.com/yxwin/sydm/basic/" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status disputed">ข้อมูลขัดแย้ง</span><p class="era-years">พ.ศ. 2550</p><h3>เริ่มโครงการถนนคนเดินเชิงวัฒนธรรม</h3><p>ททท. สำนักงานพังงา เทศบาลเมืองตะกั่วป่า และชุมชนเริ่มจัด “ตะกั่วป่า เมืองเก่า เล่าความหลัง”</p><a href="https://mgronline.com/south/detail/9650000044214" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status disputed">ข้อมูลขัดแย้ง</span><p class="era-years">17 ธันวาคม 2560</p><h3>ขึ้นทะเบียน/ได้รับการส่งเสริมเป็นตลาด</h3><p>ทะเบียนกรมการค้าภายในระบุวันก่อตั้งและได้รับการส่งเสริมของตลาดเป็น 17 ธันวาคม 2560</p><span class="source-offline">อ่านแหล่งอ้างอิง ↗ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">26 มิถุนายน ถึง 28 สิงหาคม 2565</p><h3>เปิดถนนช่วงกรีนซีซันและจัดรถโพถ้องฟรี</h3><p>จังหวัดและภาคีท้องถิ่นขยายกิจกรรมวันอาทิตย์เพื่อกระตุ้นการท่องเที่ยวนอกฤดูและกระจายรายได้</p><a href="https://mgronline.com/travel/detail/9650000061422" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">10 ตุลาคม 2567</p><h3>งานอิ่มบุญ อิ่มเจ 9 บาท</h3><p>ถนนเป็นพื้นที่จัดกิจกรรมอาหารเจและสืบทอดประเพณีของชุมชนเมืองเก่า มีร้านเข้าร่วมกว่า 200 ร้านตามข่าว</p><a href="https://mgronline.com/south/detail/9670000097253" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li></ol></section><section class="research-section" id="gallery"><h2>แกลเลอรี</h2><div data-gallery><div class="gallery-tabs" hidden><button type="button" data-tab="today">ภาพวันนี้</button><button type="button" data-tab="archive">ภาพเก่า</button></div><div id="gallery-today" data-panel="today"><h3>ภาพวันนี้</h3><div class="photo-grid"><figure class="research-photo"><a data-lightbox href="/assets/photos/shophouse-305.webp" aria-label="ขยายภาพ · ตึกแถวเลขที่ 305 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า"><img src="/assets/photos/shophouse-305.webp" width="400" height="300" alt="ตึกแถวเลขที่ 305 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" loading="lazy"></a><figcaption>ตึกแถวเลขที่ 305 บนถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า<small>เครดิต · คลังภาพโครงการกั่วป่าโพ้</small><small>สัญญาอนุญาต · ใช้ในเว็บนี้ได้</small></figcaption></figure></div></div><div id="gallery-archive" data-panel="archive"><h3>ภาพเก่า</h3><div class="photo-grid"><p class="muted">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่ในหมวดนี้</p></div></div></div></section><section class="research-section" id="highlights"><h2>จุดเด่นที่ควรดู</h2><div class="research-cards"><article class="research-note"><h3>อาคารเก่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>อาคารบ้านเรือนและตึกแถวชิโน-โปรตุกีสในย่านเมืองเก่า</p><a href="https://travel.kapook.com/view275997.html" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>อาหารและขนมพื้นบ้าน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>อาหารพื้นเมือง ขนมพื้นบ้าน และของกินท้องถิ่น</p><span class="source-offline">อ่านแหล่งอ้างอิง ↗ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span></article><article class="research-note"><h3>การแสดงและวิถีชุมชน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>การแสดงศิลปวัฒนธรรม การละเล่นพื้นเมือง และการแต่งกายแบบบาบ๋า</p><span class="source-offline">อ่านแหล่งอ้างอิง ↗ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span></article><article class="research-note"><h3>สตรีตอาร์ต</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ภาพศิลปะและสตรีตอาร์ตที่สื่อถึงวิถีชีวิตท้องถิ่น</p><a href="https://travel.kapook.com/view275997.html" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="news"><h2>ข่าวและความเคลื่อนไหว</h2><div class="research-cards"><article class="research-note"><p class="muted">2024-10-10 · ผู้จัดการออนไลน์</p><h3>งานอิ่มบุญ อิ่มเจ 9 บาท เมืองเก่าตะกั่วป่า</h3><p>กิจกรรมอาหารเจและประเพณีชุมชนจัดบนถนนสายวัฒนธรรม มีผู้เข้าร่วมจำนวนมากตามรายงานข่าว</p><a href="https://mgronline.com/south/detail/9670000097253" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><p class="muted">2022-06-26 · ผู้จัดการออนไลน์</p><h3>พังงาเปิดถนนคนเดินตะกั่วป่าหน้าฝน พร้อมรถโพถ้องฟรี</h3><p>กิจกรรมกรีนซีซันจัดทุกวันอาทิตย์ 26 มิถุนายน ถึง 28 สิงหาคม 2565 เพื่อกระจายรายได้สู่ชุมชน</p><a href="https://mgronline.com/travel/detail/9650000061422" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><p class="muted">2022-04-17 · กรมการค้าภายใน</p><h3>ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่าในกิจกรรมตลาดต้องชม</h3><p>กรมการค้าภายในรายงานการจัดกิจกรรมส่งเสริมช่องทางตลาดชุมชนที่ถนนวัฒนธรรมเมืองเก่าตะกั่วป่า</p><span class="source-offline">อ่านแหล่งอ้างอิง ↗ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span></article></div></section><section class="research-section" id="did_you_know"><h2>รู้หรือไม่</h2><div class="research-cards"><article class="research-note"><span class="fact-status disputed">ข้อมูลขัดแย้ง</span><p>ชื่อเดิมของกิจกรรมคือ “ตะกั่วป่า เมืองเก่า เล่าความหลัง” ก่อนเปลี่ยนเป็นชื่อถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</p><a href="https://mgronline.com/south/detail/9650000044214" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ตึกแถวด้านถนนศรีตะกั่วป่าหลายหลังมีทางเดินมีหลังคาด้านหน้าแบบหง่อคาขี่ ซึ่งช่วยกันแดดและฝน</p><a href="https://anyflip.com/yxwin/sydm/basic/" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>วิธีเดินทาง</h2><div class="research-cards"><article class="research-note"><h3>ตัวเมืองตะกั่วป่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ใช้ถนนราษฎร์บำรุงเข้าสู่ย่านเมืองเก่า แล้วต่อถนนศรีตะกั่วป่า; ช่วงถนนคนเดินอยู่บริเวณถนนศรีตะกั่วป่าและอุดมธารา</p><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ภูเก็ต</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span></article><article class="research-note"><h3>เขาหลัก</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span></article><article class="research-note"><h3>สนามบิน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span></article></div></section><section class="research-section" id="nearby"><h2>ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</h2><ul class="nearby-links"><li><a href="/places/governor-wall/">กำแพงจวนเจ้าเมืองตะกั่วป่า</a> <span class="fact-status unknown">ยังไม่ยืนยัน</span></li><li>วัดหน้าเมือง <span class="fact-status unknown">ยังไม่ยืนยัน</span> <a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><a href="/places/riverwalk/">ตลาดริมน้ำตะกั่วป่า</a></li><li><a href="/places/food-center/">ศูนย์อาหารลานโล่งตะกั่วป่า</a></li></ul></section><aside class="nearby-note"><span class="chapter">แวะพักใกล้ ๆ</span><p>ตึกแถวเลขที่ 53 ถนนราษฎร์บำรุง ย่านตลาดเก่า เป็นบ้านไม้สักที่เปิดเป็นคาเฟ่ จึงเป็นหนึ่งในไม่กี่หลังบนถนนสายนี้ที่เดินเข้าไปดูข้างในได้</p><a class="text-link" href="https://siwaracafe.com/" target="_blank" rel="noopener">ศิวรา คาเฟ่ บ้านไม้สักบนถนนสายนี้ ↗</a></aside><section class="research-section" id="faq"><h2>คำถามที่พบบ่อย</h2><details><summary>เปิดให้เข้าชมเวลาใด</summary><p>วันอาทิตย์ 14.00 ถึง 20.00 น.</p></details><details><summary>มีค่าเข้าชมหรือไม่</summary><p>ข้อมูลยังไม่ยืนยัน · เข้าชมฟรี</p></details><details><summary>เดินทางจากตัวเมืองตะกั่วป่าอย่างไร</summary><p>ใช้ถนนราษฎร์บำรุงเข้าสู่ย่านเมืองเก่า แล้วต่อถนนศรีตะกั่วป่า; ช่วงถนนคนเดินอยู่บริเวณถนนศรีตะกั่วป่าและอุดมธารา</p></details><details><summary>สถานที่นี้มีประวัติความเป็นมาอย่างไร</summary><p>อาคารในย่านเมืองเก่ารักษาร่องรอยสถาปัตยกรรมชิโน-โปรตุกีส/ชิโน-ตะกั่วป่าที่สัมพันธ์กับยุคเหมืองแร่ดีบุก</p></details><details><summary>มีจุดเด่นอะไรให้ชม</summary><p>อาคารบ้านเรือนและตึกแถวชิโน-โปรตุกีสในย่านเมืองเก่า อาหารพื้นเมือง ขนมพื้นบ้าน และของกินท้องถิ่น การแสดงศิลปวัฒนธรรม การละเล่นพื้นเมือง และการแต่งกายแบบบาบ๋า</p></details></section><section class="research-section" id="sources"><h2>ที่มาของข้อมูล</h2><div class="source-table"><table><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>วันที่เข้าถึง</th><th>ลิงก์</th></tr></thead><tbody><tr><th scope="row">กรมการค้าภายใน กระทรวงพาณิชย์</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><span class="source-offline">เปิดแหล่ง ↗ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span></td></tr><tr><th scope="row">ฐานข้อมูลแหล่งโบราณคดีที่สำคัญในประเทศไทย</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">Kapook Travel</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://travel.kapook.com/view275997.html" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">แนวหน้า</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.naewna.com/local/537042" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">กรมการค้าภายใน กระทรวงพาณิชย์</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><span class="source-offline">เปิดแหล่ง ↗ <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span></td></tr><tr><th scope="row">ร้อยเรื่องเมืองเก่าอันดามัน</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://anyflip.com/yxwin/sydm/basic/" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ผู้จัดการออนไลน์</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://mgronline.com/south/detail/9650000044214" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ผู้จัดการออนไลน์</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://mgronline.com/travel/detail/9650000061422" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">งานวิจัยการพัฒนาเส้นทางท่องเที่ยวเชิงวัฒนธรรมเปอรานากัน</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://so04.tci-thaijo.org/index.php/JSTD/article/view/254126" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">Kapook Travel</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://travel.kapook.com/view275997.html" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ไม่พบรหัสไปรษณีย์ของถนนสายนี้จากแหล่งที่อ่านได้โดยตรง</li><li>ไม่พบข้อมูลยืนยันเรื่องที่จอดรถ ห้องน้ำ การเข้าถึงสำหรับรถเข็น และระยะเวลาเที่ยว</li><li>ไม่พบเพจเฟซบุ๊ก เว็บไซต์ หรือ LINE ที่ยืนยันได้จากแหล่งที่อ่าน</li><li>ไม่พบระยะทางที่ยืนยันได้จากภูเก็ต เขาหลัก หรือสนามบิน</li><li>ไม่พบข้อมูลผู้สร้างเฉพาะของถนนสายวัฒนธรรม</li><li>ไม่พบหลักฐานว่าถนนสายวัฒนธรรมเองขึ้นทะเบียนโบราณสถาน; การขึ้นทะเบียนที่พบเป็นของกำแพงจวนเจ้าเมืองตะกั่วป่า</li><li>ไม่พบปฏิทินจันทรคติของงาน</li><li>ไม่มีลิงก์รูปภาพทางการที่ตรวจสอบสิทธิ์การใช้งานได้โดยตรง จึงเว้น photos</li><li>ยังไม่พบหลักฐานตรงว่าถนนสายนี้ได้รับความเสียหายจากสึนามิ พ.ศ. 2547</li><li>ยังไม่พบประกาศขึ้นทะเบียนโบราณสถานที่ระบุถนนทั้งเส้นนี้โดยตรง</li><li>ยังไม่พบเอกสารระบุชื่อผู้ก่อตั้งรายบุคคลหรือผู้รับผิดชอบถนนในปี 2550</li><li>ยังไม่พบโครงการบูรณะใหญ่เฉพาะถนนที่ประกาศอย่างเป็นทางการถึงปี 2569</li><li>ยังไม่พบภาพเก่าที่มีสิทธิ์ใช้งานชัดเจนของถนนสายนี้ จึงเว้น photos_archive เป็นอาร์เรย์ว่าง</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
