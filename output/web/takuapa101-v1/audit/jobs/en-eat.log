akuapa101.com/assets/phra-narai.webp", "description": "สวนในพื้นที่เทศบาลที่มีเรื่องราวเกี่ยวกับองค์พระนารายณ์", "address": {"@type": "PostalAddress", "streetAddress": "หมู่ชุมชนศรีเมือง ถนนเพชรเกษม", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "postalCode": "82110", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8696046, "longitude": 98.3445279}, "telephone": "076 421 750"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "อยู่ตรงข้ามสำนักงานเทศบาลเมืองตะกั่วป่าและที่ว่าการเทศบาลเมืองตะกั่วป่า บนถนนเพชรเกษม"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "สวนอยู่ภายใต้การดูแลบริหารจัดการของเทศบาลเมืองตะกั่วป่า สวนเป็นสถานที่พักผ่อนหย่อนใจและเป็นที่ประดิษฐานองค์เทวรูปพระนารายณ์กับเทพบริวารจำลอง"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "ประติมากรรมรูปเคารพพระนารายณ์สำหรับให้ประชาชนสักการะบูชา ภายในสวนมีองค์พระนารายณ์และเทพบริวารจำลองตามข้อมูลแหล่งราชการ พื้นที่ส่วนหนึ่งของสวนจัดเป็นสนามเด็กเล่น"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/places/phra-narai/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/places/phra-narai/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/places/phra-narai/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/" aria-current="page">สถานที่</a><a href="/stories/">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/places/phra-narai/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/">หน้าแรก</a> / <a href="/places/">สถานที่</a> / สวนและพื้นที่สาธารณะ</div><header class="place-hero full-place-hero"><div><span class="chapter">บันทึกสถานที่ · สวนและพื้นที่สาธารณะ</span><h1>สวนสาธารณะพระนารายณ์</h1><p class="english">Phra Narai Park</p><span class="fact-status confirmed">ยืนยันแล้ว 5 ข้อ</span><p><a class="text-link" href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้ ↓</a></p><p class="place-hero-actions"><button class="button" type="button" data-trip-add="phra-narai">เพิ่มลงทริป</button><a class="text-link" href="/trip/">ดูทริปของคุณ</a></p></div><div class="place-hero-art"><img src="/assets/phra-narai.webp" alt="สวนสาธารณะพระนารายณ์" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>ข้อมูลใช้จริง</h2><dl><div><dt>พิกัด</dt><dd>8.8696046, 98.3445279 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.8696046,98.3445279" target="_blank" rel="noopener">นำทางด้วย Google Maps ↗</a><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">แหล่งพิกัด ↗</a></div><div><dt>เวลาเปิด</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ค่าเข้า</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ที่จอดรถ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ห้องน้ำ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>รถเข็น</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>การแต่งกาย</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>โทรศัพท์</dt><dd>076 421 750 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div><dt>เพจ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เว็บไซต์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ไลน์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">แหล่งข้อมูลติดต่อ ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">ในบันทึกหน้านี้</span><a href="#visit">ข้อมูลใช้จริง</a><a href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้</a><a href="#timeline">เส้นเวลาแบบจุด</a><a href="#highlights">จุดเด่นที่ควรดู</a><a href="#news">ข่าวและความเคลื่อนไหว</a><a href="#did_you_know">รู้หรือไม่</a><a href="#getting_there">วิธีเดินทาง</a><a href="#nearby">ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</a><a href="#faq">คำถามที่พบบ่อย</a><a href="#sources">ที่มาของข้อมูล</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>ตอนนั้น · ก่อนหน้า · ตอนนี้</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">ตอนนั้น</span><h3>จุดเริ่มต้นของสวนยังอยู่หลังม่านหลักฐาน</h3><p class="era-years"></p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>สำหรับสวนสาธารณะพระนารายณ์โดยตรง ยังไม่พบเอกสารที่ระบุปีจัดสร้าง ผู้ริเริ่ม หรือเหตุผลในการจัดตั้งสวน จึงไม่ควรสรุปว่าสวนเกิดขึ้นในยุคเหมืองแร่ดีบุกหรือในสมัยเจ้าเมืองเพียงเพราะเมืองตะกั่วป่ารุ่งเรืองในช่วงนั้น</p><p>สิ่งที่ยืนยันได้คือ สวนตั้งอยู่หน้าสำนักงานเทศบาลเมืองตะกั่วป่า และเป็นพื้นที่ประดิษฐานเทวรูปพระนารายณ์กับเทพบริวารจำลอง องค์พระนารายณ์มีความหมายต่อเมืองจนถูกใช้เป็นตราสัญลักษณ์เทศบาล แต่หลักฐานนี้อธิบายความสำคัญขององค์เทวรูปและเมือง ไม่ใช่วันกำเนิดสวน</p><p>บริบทเมืองตะกั่วป่าในเอกสารเทศบาลสะท้อนเมืองเก่าที่มีการค้า เหมืองดีบุก อาคารชิโน · โปรตุกีส และชุมชนชาวจีนจำนวนมาก อย่างไรก็ตาม ยังไม่มีหลักฐานเชื่อมองค์ประกอบเหล่านี้เข้ากับการสร้างสวนโดยตรง</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า แผนการดำเนินงานด้านสิ่งแวดล้อม</a> · <a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">ศูนย์ข้อมูลกลางวัฒนธรรม</a></div></article><article class="era-card" data-era="before"><span class="chapter">ก่อนหน้า</span><h3>จากพื้นที่ศักดิ์สิทธิ์สู่เวทีกิจกรรมเมือง</h3><p class="era-years">ไม่พบลำดับปีที่ยืนยันได้</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>หลักฐานที่ค้นพบไม่ได้บันทึกการเปลี่ยนมือ การถูกทิ้งร้าง หรือการบูรณะสวนเป็นช่วงเวลา จึงยังตอบไม่ได้ว่าสวนผ่านเหตุการณ์เหล่านั้นหรือไม่ เช่นเดียวกับผลกระทบจากสึนามิ พ.ศ. 2547 ซึ่งไม่พบรายงานเฉพาะเจาะจงถึงสวนแห่งนี้</p><p>ในช่วงที่มีข้อมูล สวนทำหน้าที่กว้างขึ้นจากจุดสักการะเป็นพื้นที่สาธารณะของเมือง ใช้จัดกิจกรรมวัฒนธรรม สันทนาการ งานประเพณี งานวันเด็ก และเป็นสนามเด็กเล่น โดยเทศบาลเมืองตะกั่วป่าดูแลบริหารจัดการ</p><p>เอกสารเมืองเก่าระบุสถานที่และโบราณสถานหลายแห่งในเขตเทศบาล แต่ไม่พบประกาศกรมศิลปากรที่ขึ้นทะเบียน “สวนสาธารณะอุทยานพระนารายณ์” เป็นโบราณสถานโดยตรง จึงแยกสวนออกจากโบราณสถานใกล้เคียงอย่างระมัดระวัง</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">ศูนย์ข้อมูลกลางวัฒนธรรม</a> · <a href="https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf" target="_blank" rel="noopener">โครงการกำหนดขอบเขตพื้นที่เมืองเก่าตะกั่วป่า</a></div></article><article class="era-card" data-era="now"><span class="chapter">ตอนนี้</span><h3>สวนหน้าศาลากลางใจเมืองที่ยังมีชีวิต</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ข้อมูลล่าสุดที่เปิดเผยยืนยันว่า สวนยังเป็นพื้นที่สาธารณะและอยู่ภายใต้การดูแลของเทศบาลเมืองตะกั่วป่า ภายในมีเทวรูปพระนารายณ์และเทพบริวารสำหรับสักการะ รวมทั้งสนามเด็กเล่นและพื้นที่พักผ่อนของชุมชน</p><p>สวนยังทำหน้าที่เป็นเวทีกลางของเมือง งานบวงสรวงพระนารายณ์และของดีเมืองตะกั่วป่าจัดที่นี่ใน พ.ศ. 2568 และมีข่าวกิจกรรมของดีเมืองตะกั่วป่าที่เวทีกลางสวน ส่วนงานประจำปี พ.ศ. 2566 จัดระหว่าง 27 มีนาคม ถึง 5 เมษายน</p><p>ยังไม่มีข้อมูลทางการที่ยืนยันเวลาเปิด-ปิด ค่าเข้า สภาพกายภาพล่าสุด หรือโครงการก่อสร้างที่เสร็จแล้ว สำหรับแนวคิดพัฒนา “Narai Hub &amp; Commercial Center” พบเพียงข่าวนโยบาย/แนวทางของผู้บริหารเทศบาล จึงยังไม่ถือว่าเป็นโครงการที่ดำเนินการเสร็จสมบูรณ์</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">ศูนย์ข้อมูลกลางวัฒนธรรม</a> · <a href="https://siamrath.co.th/n/609307" target="_blank" rel="noopener">สยามรัฐ</a> · <a href="https://www.thaipr.net/travel/3321904" target="_blank" rel="noopener">ThaiPR.NET</a> · <a href="https://www.naewna.com/lady/892595" target="_blank" rel="noopener">แนวหน้า</a></div></article></div></section><section class="research-section" id="timeline"><h2>เส้นเวลาแบบจุด</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status unverified">ยังไม่ยืนยัน</span><p class="era-years">27 มีนาคม ถึง 5 เมษายน 2566</p><h3>งานบวงสรวงพระนารายณ์</h3><p>จัดงานประจำปี ณ สวนสาธารณะพระนารายณ์ พร้อมกิจกรรมวัฒนธรรมและสินค้าในชุมชน</p><a href="https://www.thaipr.net/travel/3321904" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2568</p><h3>งานของดีเมืองตะกั่วป่า</h3><p>เวทีกลางของโครงการส่งเสริมเศรษฐกิจชุมชนจัดขึ้นในสวน</p><a href="https://siamrath.co.th/n/609307" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">พ.ศ. 2569</p><h3>สถานะปัจจุบัน</h3><p>ยังเป็นสวนสาธารณะภายใต้การดูแลเทศบาล มีจุดสักการะ สนามเด็กเล่น และพื้นที่จัดกิจกรรม</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status unverified">ยังไม่ยืนยัน</span><p class="era-years">ไม่ระบุปี</p><h3>ยังไม่พบปีเริ่มสร้างสวน</h3><p>เอกสารที่เปิดเผยไม่ระบุปี ผู้สร้าง หรือโครงการจัดตั้งสวน</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">ไม่ระบุปี</p><h3>องค์พระนารายณ์เป็นสัญลักษณ์เมือง</h3><p>เอกสารเทศบาลระบุเทวรูปพระนารายณ์เป็นสิ่งศักดิ์สิทธิ์ของชาวเมืองและใช้เป็นตราเทศบาล แต่ไม่ระบุปีนำมาประดิษฐานในสวน</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li></ol></section><p class="missing-photo">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่</p><section class="research-section" id="highlights"><h2>จุดเด่นที่ควรดู</h2><div class="research-cards"><article class="research-note"><h3>เทวรูปพระนารายณ์</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ประติมากรรมรูปเคารพพระนารายณ์สำหรับให้ประชาชนสักการะบูชา</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>เทพบริวารจำลอง</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ภายในสวนมีองค์พระนารายณ์และเทพบริวารจำลองตามข้อมูลแหล่งราชการ</p><a href="https://www.phangngaedarea.go.th/site/wp-content/uploads/pdf/17225631.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>สนามเด็กเล่น</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>พื้นที่ส่วนหนึ่งของสวนจัดเป็นสนามเด็กเล่น</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ลานจัดกิจกรรม</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ใช้จัดกิจกรรมวัฒนธรรม สันทนาการ และงานประเพณีท้องถิ่นของเทศบาล</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93%E0%B9%8C" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="news"><h2>ข่าวและความเคลื่อนไหว</h2><div class="research-cards"><article class="research-note"><p class="muted">2025-03-14 · ThailandTravel</p><h3>งานบวงสรวงพระนารายณ์และของดีเมืองตะกั่วป่า ประจำปี 2568</h3><p>ประกาศกำหนดจัดงาน 14 ถึง 23 มีนาคม 2568 ที่สวน</p><a href="https://thailandtravel.app/content/read/3344" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><p class="muted">2023-03-31 · ThaiPR.NET</p><h3>งานบวงสรวงพระนารายณ์ เอกลักษณ์ของชาวตะกั่วป่า</h3><p>รายงานงานประจำปี 2566 ซึ่งจัดที่สวนระหว่าง 27 มีนาคม ถึง 5 เมษายน</p><a href="https://www.thaipr.net/travel/3321904" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><p class="muted"> · สยามรัฐ</p><h3>เทศบาลเมืองตะกั่วป่าจัดกิจกรรมส่งเสริมเศรษฐกิจชุมชน ของดีเมืองตะกั่วป่า</h3><p>ใช้เวทีกลางสวนเป็นพื้นที่จัดโครงการส่งเสริมเศรษฐกิจชุมชนปี 2568</p><a href="https://siamrath.co.th/n/609307" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>รู้หรือไม่</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>พระนารายณ์ถูกใช้เป็นรูปในดวงตราสัญลักษณ์เทศบาลเมืองตะกั่วป่า</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>สวนอยู่ตรงข้ามสำนักงานเทศบาลเมืองตะกั่วป่าและมีโทรศัพท์ติดต่อ 076 421 750</p><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>วิธีเดินทาง</h2><div class="research-cards"><article class="research-note"><h3>ตัวเมืองตะกั่วป่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>อยู่ตรงข้ามสำนักงานเทศบาลเมืองตะกั่วป่าและที่ว่าการเทศบาลเมืองตะกั่วป่า บนถนนเพชรเกษม</p><a href="https://www.phangngaedarea.go.th/site/wp-content/uploads/pdf/17225631.pdf" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ภูเก็ต</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span></article><article class="research-note"><h3>เขาหลัก</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span></article><article class="research-note"><h3>สนามบิน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span></article></div></section><section class="research-section" id="nearby"><h2>ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</h2><ul class="nearby-links"><li><a href="/places/thung-phra/">สวนสาธารณะทุ่งพระโพธิ์</a></li></ul></section><section class="research-section" id="faq"><h2>คำถามที่พบบ่อย</h2><details><summary>เดินทางจากตัวเมืองตะกั่วป่าอย่างไร</summary><p>อยู่ตรงข้ามสำนักงานเทศบาลเมืองตะกั่วป่าและที่ว่าการเทศบาลเมืองตะกั่วป่า บนถนนเพชรเกษม</p></details><details><summary>สถานที่นี้มีประวัติความเป็นมาอย่างไร</summary><p>สวนอยู่ภายใต้การดูแลบริหารจัดการของเทศบาลเมืองตะกั่วป่า สวนเป็นสถานที่พักผ่อนหย่อนใจและเป็นที่ประดิษฐานองค์เทวรูปพระนารายณ์กับเทพบริวารจำลอง</p></details><details><summary>มีจุดเด่นอะไรให้ชม</summary><p>ประติมากรรมรูปเคารพพระนารายณ์สำหรับให้ประชาชนสักการะบูชา ภายในสวนมีองค์พระนารายณ์และเทพบริวารจำลองตามข้อมูลแหล่งราชการ พื้นที่ส่วนหนึ่งของสวนจัดเป็นสนามเด็กเล่น</p></details></section><section class="research-section" id="sources"><h2>ที่มาของข้อมูล</h2><div class="source-table"><table><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>วันที่เข้าถึง</th><th>ลิงก์</th></tr></thead><tbody><tr><th scope="row">ศูนย์ข้อมูลกลางวัฒนธรรม (m-culture)</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AAาธารณะอุทยานพระนารายณ์" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สำนักงานเขตพื้นที่การศึกษาพังงา</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.phangngaedarea.go.th/site/wp-content/uploads/pdf/17225631.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ThaiPR.NET</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.thaipr.net/travel/3321904" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">MGR Online</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://mgronline.com/south/detail/9550000099132" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ศูนย์ข้อมูลกลางวัฒนธรรม</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า แผนการดำเนินงานด้านสิ่งแวดล้อม</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สยามรัฐ</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://siamrath.co.th/n/609307" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">แนวหน้า</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.naewna.com/lady/892595" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ไม่พบเวลาเปิด-ปิดที่เผยแพร่และยืนยันได้</li><li>ไม่พบข้อมูลค่าเข้าชม</li><li>ไม่พบเพจเฟซบุ๊กหรือเว็บไซต์เฉพาะของสวนที่ยืนยันได้</li><li>ไม่พบข้อมูลที่จอดรถ ห้องน้ำ หรือทางเข้าถึงสำหรับรถเข็น/ผู้สูงอายุ</li><li>ไม่พบระยะทางที่ยืนยันได้จากภูเก็ต เขาหลัก หรือสนามบิน</li><li>ไม่พบข้อมูลปีสร้างและผู้สร้าง</li><li>ไม่พบหลักฐานยืนยันบทบาทของสวนในยุคเหมืองแร่ดีบุก</li><li>ไม่พบหลักฐานยืนยันสถาปัตยกรรมชิโน-โปรตุกีส/จีนของสวน</li><li>ไม่พบหลักฐานการขึ้นทะเบียนสวนเป็นโบราณสถาน</li><li>ไม่พบสถานที่ใกล้เคียงที่มีระยะเดินถึงยืนยันได้</li><li>ไม่พบเดือนจัดงานหรือข้อมูลปฏิทินจันทรคติที่ยืนยันได้</li><li>ปีจัดสร้างสวนและผู้สร้าง</li><li>เหตุผล/โครงการตั้งต้นของสวน</li><li>ประวัติการเปลี่ยนมือ การร้าง หรือการบูรณะ</li><li>หลักฐานผลกระทบจากสึนามิ พ.ศ. 2547</li><li>ปีขึ้นทะเบียนโบราณสถานของสวนโดยตรง</li><li>เวลาเปิด-ปิด ค่าเข้า สภาพอาคาร/สิ่งปลูกสร้างล่าสุด</li><li>โครงการ Narai Hub อยู่ระหว่างดำเนินการจริงหรือไม่</li><li>ยังไม่พบภาพเก่าที่ระบุว่าเป็นสวนโดยตรง</li><li>ยังไม่พบ URL ไฟล์ภาพปัจจุบันแบบตรงที่ยืนยันสิทธิ์ได้</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
site\places\riverwalk\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ตลาดริมน้ำตะกั่วป่า · ตลาดท่าน้ำศรีเมือง · ตะกั่วป่า 101</title><meta name="description" content="อาหารและชีวิตริมแม่น้ำ · ตลาดวันเสาร์ตะกั่วป่า · ตลาดตะกั่วป่า · ของกินตะกั่วป่า"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="ตลาดริมน้ำตะกั่วป่า · ตลาดท่าน้ำศรีเมือง"><meta property="og:description" content="อาหารและชีวิตริมแม่น้ำ · ตลาดวันเสาร์ตะกั่วป่า · ตลาดตะกั่วป่า · ของกินตะกั่วป่า"><meta property="og:url" content="https://takuapa101.com/places/riverwalk/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/riverwalk.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/riverwalk.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/places/riverwalk/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "ตลาดริมน้ำตะกั่วป่า · ตลาดท่าน้ำศรีเมือง", "item": "https://takuapa101.com/places/riverwalk/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "ตลาดริมน้ำตะกั่วป่า", "url": "https://takuapa101.com/places/riverwalk/", "image": "https://takuapa101.com/assets/riverwalk.webp", "description": "พื้นที่ตลาดริมแม่น้ำที่มีสินค้าและอาหารท้องถิ่น", "address": {"@type": "PostalAddress", "streetAddress": "ถนนศรีตะกั่วป่า/ถนนริมคลอง ข้างวัดย่านยาว", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "postalCode": "82110", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.87157, "longitude": 98.35091}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "เปิดให้เข้าชมเวลาใด", "acceptedAnswer": {"@type": "Answer", "text": "ข้อมูลยังไม่ยืนยัน · วันเสาร์ 15:00 ถึง 20:00 น."}}, {"@type": "Question", "name": "มีค่าเข้าชมหรือไม่", "acceptedAnswer": {"@type": "Answer", "text": "ข้อมูลยังไม่ยืนยัน · ไม่มีค่าธรรมเนียมการเข้าชม"}}, {"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "เดินทางไปย่านริมน้ำ/ถนนศรีตะกั่วป่า บริเวณข้างวัดย่านยาว; แหล่งข้อมูลระบุว่าสามารถใช้รถรับจ้างท้องถิ่นหรือมอเตอร์ไซค์รับจ้างจากสถานีขนส่งตะกั่วป่าได้"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "ตลาดมีชื่อในโครงการตลาดประชารัฐต้องชมว่า ‘ตลาดริมน้ำตะกั่วป่า ร่วมใจประชารัฐ’ และตั้งอยู่ถนนริมคลองข้างวัดย่านยาว"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "มีแผงจำหน่ายขนมพื้นบ้าน อาหารพื้นเมือง สินค้าโอทอป และของดีเมืองตะกั่วป่า ตลาดตั้งอยู่ติดแนวคลอง/แม่น้ำตะกั่วป่า เหมาะกับการชมวิวริมน้ำและถ่ายภาพ รีวิวผู้ใช้ระบุว่ามีดนตรีสดโดยนักเรียนในบางช่วง"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alterna