+ ('gallery-3.webp','kuapapoh-charm-09-wall.webp','ภาพเขียน Peranakan Charm No.9 แขวนอยู่บนชั้นไม้ในนิทรรศการ พร้อมป้ายกำกับขนาดผลงาน','Peranakan Charm No. 9 hanging on a wooden shelf in the exhibition, with a label showing the work’s dimensions.'),
+ ('gallery-2.webp','kuapapoh-expo-wall.webp','ผนังผลงานชุดใหญ่ริมทางเดินในนิทรรศการ','A wall of large works along the exhibition walkway.'),
+ ('gallery-5.webp','kuapapoh-expo-shelf.webp','ผลงานในกรอบทองวางบนชั้นไม้เก่าในนิทรรศการ','Gold-framed works displayed on an old wooden shelf in the exhibition.'),
+ ('artist-card.webp','kuapapoh-artist-card.webp','การ์ดประวัติศิลปิน About the Artist ของนิทรรศการ มนต์เสน่ห์เปอรานากัน','The exhibition’s About the Artist biography card for Peranakan Charm.'),
+]
+paint_credit = 'ช่างป๋อง · ติณณภพ งานสถิร'
+project_credit = 'โครงการกั่วป่าโพ้ จีโชว์เมือง'
+license = 'ได้รับอนุญาตจากโครงการกั่วป่าโพ้'
+
+DST.mkdir(parents=True, exist_ok=True)
+for src, name, _, _ in items:
+    with Image.open(SRC / src) as im:
+        im = im.convert('RGB')
+        im.thumbnail((1400, 1400), Image.Resampling.LANCZOS)
+        im.save(DST / name, 'WEBP', quality=80, method=6)
+
+registry_path = ROOT / 'data' / 'photo-registry.json'
+data = json.loads(registry_path.read_text(encoding='utf-8'))
+existing = {r['file'] for r in data['photos']}
+for src, name, th, en in items:
+    path = '/assets/photos/' + name
+    if path in existing:
+        raise RuntimeError('already exists: ' + path)
+    credit = paint_credit if src.startswith('artwork-') else project_credit
+    allowed = ['/stories/apaporn/']
+    if name == 'kuapapoh-charm-09.webp': allowed.append('/stories/kuapapoh/')
+    data['photos'].append({'file': path, 'depicts_th': th, 'caption_th': th, 'allowed_on': allowed, 'era': 'now', 'credit': credit, 'license': license, 'caption_en': en})
+registry_path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
