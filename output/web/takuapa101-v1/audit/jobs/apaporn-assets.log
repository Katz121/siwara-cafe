+    image.paste(art, (615 + (570-art.width)//2, (530-art.height)//2))
+font_path = ROOT / 'fonts-src' / 'IBMPlexSansThaiLooped-Regular.ttf'
+draw = ImageDraw.Draw(image)
+title = 'อาภรณ์'
+subtitle = 'มนต์เสน่ห์เปอรานากัน'
+def wrap(text, font, width):
+    words = word_tokenize(text, engine='newmm', keep_whitespace=True)
+    lines = ['']
+    for word in words:
+        if lines[-1] and draw.textlength(lines[-1] + word, font=font) > width: lines.append(word.lstrip())
+        else: lines[-1] += word
+    return [line for line in lines if line.strip()] or ['']
+font = ImageFont.truetype(str(font_path), 64)
+draw.text((48, 190), title, font=font, fill='#203f39')
+font2 = ImageFont.truetype(str(font_path), 34)
+for i, line in enumerate(wrap(subtitle, font2, 500)): draw.text((48, 285+i*48), line, font=font2, fill='#203f39')
+draw.rectangle((0, 530, 1200, 630), fill='#203f39')
+draw.text((48, 550), 'ตะกั่วป่า 101', font=ImageFont.truetype(str(font_path), 40), fill='#f6f1e7')
+image.save(out / 'apaporn.png', 'PNG')

