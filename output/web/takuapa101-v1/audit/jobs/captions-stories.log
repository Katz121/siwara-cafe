            for k_th, k_en in (('best_time_th', 'best_time'), ('parking_th', 'parking'),
                               ('wheelchair_th', 'wheelchair'), ('dress_code_th', 'dress_code'),
                               ('opening_hours_th', 'opening_hours'), ('admission_fee_th', 'admission_fee')):
