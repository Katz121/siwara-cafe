def story_outro(sid):
    hit = STORY_OUTRO.get(sid)
    if not hit:
        return ''
    href, body, label = hit
    return (f'<aside class="story-outro"><p>{escape(body)}</p>'
            f'<a class="text-link" href="{escape(href)}" target="_blank" rel="noopener">{escape(label)}</a></aside>')


def article(story, ctx):
    is_new = 'lede' in story
    if not is_new:
        sections = ''.join(f'<section><span class="chapter">à¸«à¸¥à¸±à¸à¸à¸²à¸™à¸Šà¹ˆà¸§à¸‡à¸—à¸µà¹ˆ {i:02d}</span><h2>{escape(h)}</h2><p>{escape(p)}</p></section>' for i, (h, p) in enumerate(story['sections'], 1))
        return f'<div class="story-article"><div class="breadcrumbs"><a href="/">à¸«à¸™à¹‰à¸²à¹à¸£à¸</a><span>/</span><a href="/stories/">à¹€à¸£à¸·à¹ˆà¸­à¸‡à¹€à¸¥à¹ˆà¸²à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸²</a><span>/</span><span>{escape(story["group"])}</span></div><header class="story-hero"><span class="eyebrow">à¹€à¸£à¸·à¹ˆà¸­à¸‡à¹€à¸¥à¹ˆà¸²à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸² Â· {escape(story["group"])}</span><h1>{escape(story["title"])}</h1><p class="lead">{escape(story["dek"])}</p><p class="story-meta">à¸›à¸£à¸±à¸šà¸›à¸£à¸¸à¸‡ 7 à¸à¸±à¸™à¸¢à¸²à¸¢à¸™ 2569 Â· à¹€à¸£à¸µà¸¢à¸šà¹€à¸£à¸µà¸¢à¸‡à¸ˆà¸²à¸à¹€à¸­à¸à¸ªà¸²à¸£à¸—à¸²à¸‡à¸à¸²à¸£ Â· à¸£à¸°à¸”à¸±à¸šà¸«à¸¥à¸±à¸à¸à¸²à¸™: à¸¡à¸µà¸—à¸±à¹‰à¸‡à¸‚à¹‰à¸­à¹€à¸—à¹‡à¸ˆà¸ˆà¸£à¸´à¸‡à¹à¸¥à¸°à¸‚à¹‰à¸­à¸ªà¸±à¸™à¸™à¸´à¸©à¸à¸²à¸™</p></header><article class="story-prose">{sections}<aside class="evidence-note"><strong>à¸­à¹ˆà¸²à¸™à¸­à¸¢à¹ˆà¸²à¸‡à¸¡à¸µà¸«à¸¥à¸±à¸à¸à¸²à¸™</strong><p>à¸‚à¹‰à¸­à¸„à¸§à¸²à¸¡à¸™à¸µà¹‰à¸ªà¸£à¸¸à¸›à¸ˆà¸²à¸à¹à¸«à¸¥à¹ˆà¸‡à¸—à¸µà¹ˆà¸£à¸°à¸šà¸¸à¸”à¹‰à¸²à¸™à¸¥à¹ˆà¸²à¸‡ à¸«à¸²à¸à¹€à¸›à¹‡à¸™à¸„à¸³à¸§à¹ˆà¸² â€œà¹€à¸Šà¸·à¹ˆà¸­à¸¡à¹‚à¸¢à¸‡â€, â€œà¸ªà¸±à¸™à¸™à¸´à¸©à¸à¸²à¸™â€ à¸«à¸£à¸·à¸­ â€œà¸¢à¸±à¸‡à¹„à¸¡à¹ˆà¸¡à¸µà¸‚à¹‰à¸­à¸¢à¸¸à¸•à¸´â€ à¹€à¸§à¹‡à¸šà¹„à¸‹à¸•à¹Œà¸„à¸‡à¸„à¸³à¸à¸³à¸à¸±à¸šà¹„à¸§à¹‰à¹€à¸žà¸·à¹ˆà¸­à¹„à¸¡à¹ˆà¸—à¸³à¹ƒà¸«à¹‰à¸‚à¹‰à¸­à¸ªà¸±à¸™à¸™à¸´à¸©à¸à¸²à¸™à¸à¸¥à¸²à¸¢à¹€à¸›à¹‡à¸™à¸‚à¹‰à¸­à¹€à¸—à¹‡à¸ˆà¸ˆà¸£à¸´à¸‡</p></aside><h2>à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆà¸—à¸µà¹ˆà¸­à¹ˆà¸²à¸™à¸•à¹ˆà¸­à¹„à¸”à¹‰</h2>{_place_links(story["places"], ctx)}{story_outro(story.get("id"))}<h2>à¹à¸«à¸¥à¹ˆà¸‡à¸‚à¹‰à¸­à¸¡à¸¹à¸¥à¸‚à¸­à¸‡à¸šà¸—à¸„à¸§à¸²à¸¡</h2>{_source_list(story["sources"])}</article></div>'

    meta = f'<p class="story-meta">à¸›à¸£à¸±à¸šà¸›à¸£à¸¸à¸‡à¹€à¸¡à¸·à¹ˆà¸­ {escape(story.get("updated", ""))} Â· à¹€à¸§à¸¥à¸²à¸­à¹ˆà¸²à¸™ {story.get("reading_minutes", 0)} à¸™à¸²à¸—à¸µ</p>'
    header = f'<header class="story-hero-v2"><div class="breadcrumbs"><a href="/">à¸«à¸™à¹‰à¸²à¹à¸£à¸</a><span>/</span><a href="/stories/">à¹€à¸£à¸·à¹ˆà¸­à¸‡à¹€à¸¥à¹ˆà¸²à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸²</a><span>/</span><span>{escape(story.get("group", ""))}</span></div><span class="eyebrow">à¹€à¸£à¸·à¹ˆà¸­à¸‡à¹€à¸¥à¹ˆà¸²à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸² Â· {escape(story.get("group", ""))}</span><h1>{escape(story.get("title", ""))}</h1><p class="lead">{escape(story.get("dek", ""))}</p>{meta}</header>'
    
    used_images = set()
    hero_html = ''
    hp = photo_for(story.get("id"), (story.get("hero_photo") or {}).get("file"))
    if hp:
        used_images.add(hp["file"])
    if hp:
        cap = registry_caption(hp)
        hero_html = f'<figure class="hero-photo-v2"><img src="{escape(hp["file"])}" alt="{escape(cap)}" loading="eager"><figcaption><span>{escape(cap)}</span><span class="credit">{escape(hp.get("credit",""))}</span></figcaption></figure>'
    else:
        ill = illustration_for(story, ctx)
        if ill:
            used_images.add(ill["file"])
            hero_html = (f'<figure class="hero-photo-v2 is-illustration"><img src="{escape(ill["file"])}" '
                         f'alt="{escape(ill["caption_th"])}" loading="eager"><figcaption>'
                         f'<span>{escape(ill["caption_th"])}</span>'
                         f'<span class="credit">à¸ à¸²à¸žà¸§à¸²à¸”à¸›à¸£à¸°à¸à¸­à¸š Â· à¸¢à¸±à¸‡à¹„à¸¡à¹ˆà¸¡à¸µà¸ à¸²à¸žà¸–à¹ˆà¸²à¸¢à¸—à¸µà¹ˆà¹„à¸”à¹‰à¸£à¸±à¸šà¸­à¸™à¸¸à¸à¸²à¸•à¸‚à¸­à¸‡à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸™à¸µà¹‰</span></figcaption></figure>')
    
    lede_html = '<div class="story-lede-v2">' + ''.join(f'<p>{escape(p)}</p>' for p in story.get("lede", [])) + '</div>'
    
    toc_links = []
    sections_html = ''
    pull_quotes = story.get("pull_quotes", [])
    
    for i, sec in enumerate(story.get("sections", [])):
        h_id = f'section-{i}'
        h2 = sec.get("heading_th", "")
        toc_links.append(f'<li><a href="#{h_id}">{escape(h2)}</a></li>')
        
        sec_content = f'<h2 id="{h_id}">{escape(h2)}</h2>'
        
        sp = photo_for(story.get("id"), (sec.get("photo") or {}).get("file"))
        if sp and sp["file"] in used_images:
            sp = None
        if sp is None:
            _alt = illustration_for(story, ctx, skip=tuple(
                f.rsplit('/', 1)[-1].rsplit('.', 1)[0] for f in used_images))
            sp = None
            if _alt and _alt["file"] not in used_images:
                sp = {'file': _alt['file'], 'caption_th': _alt['caption_th'],
                      'credit': 'à¸ à¸²à¸žà¸§à¸²à¸”à¸›à¸£à¸°à¸à¸­à¸š'}
        if sp:
            used_images.add(sp["file"])
        if sp:
            cap = registry_caption(sp)
            sec_content += f'<figure class="section-photo-v2"><img src="{escape(sp["file"])}" alt="{escape(cap)}" loading="lazy"><figcaption><span>{escape(cap)}</span><span class="credit">{escape(sp.get("credit",""))}</span></figcaption></figure>'
        
        for p in sec.get("paragraphs", []):
            sec_content += f'<p>{story_paragraph(p)}</p>'

        # à¸¢à¹ˆà¸­à¸«à¸™à¹‰à¸²à¸–à¸¹à¸ escape à¸—à¸±à¹‰à¸‡à¸«à¸¡à¸” à¸ˆà¸¶à¸‡à¹ƒà¸ªà¹ˆà¸¥à¸´à¸‡à¸à¹Œà¹ƒà¸™à¹€à¸™à¸·à¹‰à¸­à¸„à¸§à¸²à¸¡à¹„à¸¡à¹ˆà¹„à¸”à¹‰
        # section à¸—à¸µà¹ˆà¸•à¹‰à¸­à¸‡à¸à¸²à¸£à¸¥à¸´à¸‡à¸à¹Œà¸­à¸­à¸à¹ƒà¸«à¹‰à¸›à¸£à¸°à¸à¸²à¸¨à¹„à¸§à¹‰à¹ƒà¸™ "links" à¹à¸¥à¹‰à¸§à¹€à¸£à¸™à¹€à¸”à¸­à¸£à¹Œà¹€à¸›à¹‡à¸™à¸šà¸£à¸£à¸—à¸±à¸”à¸•à¹ˆà¸­à¸—à¹‰à¸²à¸¢
        links = sec.get("links", [])
        if links:
            items = ''.join(
                f'<a href="{escape(l["url"], True)}" target="_blank" rel="noopener">{escape(l["text_th"])}</a>'
                for l in links if l.get("url") and l.get("text_th"))
            if items:
                sec_content += f'<p class="story-outlinks">{items}</p>'
            
        flags_html = ''
        for flag in sec.get("flags", []):
            kind = flag.get("kind", "")
            cls = "flag-unverified" if kind == "unverified" else ("flag-disputed" if kind == "disputed" else "")
            flags_html += f'<span class="story-flag-v2 {cls}">{escape(flag.get("text_th",""))}</span>'
        if flags_html:
            sec_content += f'<div class="story-flags-v2">{flags_html}</div>'
            
        sections_html += f'<section class="story-section-v2">{sec_content}</section>'
        
        if i < len(pull_quotes):
            sections_html += f'<blockquote class="pull-quote-v2"><p>{escape(pull_quotes[i])}</p></blockquote>'

    toc_html = f'<nav class="story-toc-v2 scrollspy" id="story-toc"><h2>à¹€à¸™à¸·à¹‰à¸­à¸«à¸²à¹ƒà¸™à¸šà¸—à¸„à¸§à¸²à¸¡</h2><ul class="scrollspy-nav">{"".join(toc_links)}</ul></nav>'
    
    ev = story.get("evidence_box")
    ev_html = ''
    if ev:
        items = ''
        for it in ev.get("items", []):
            st = it.get("status", "")
            items += f'<li><div class="ev-claim">{escape(it.get("claim_th",""))}</div><div class="ev-status {escape(st.lower())}">{escape(st)}</div><div class="ev-explain">{escape(it.get("explain_th",""))} {source_link(it.get("source_url",""), "à¸­à¹‰à¸²à¸‡à¸­à¸´à¸‡ â†—")}</div></li>'
        ev_html = f'<aside class="evidence-box-v2"><h3>{escape(ev.get("heading_th",""))}</h3><ul class="ev-items-v2">{items}</ul></aside>'

    places_html = ''
    if story.get("places"):
        cards = ''
        for pid in story["places"]:
            if pid in ctx["byid"]:
                pr = ctx["byid"][pid]
                pic_html = ctx["pic"](pid) if "pic" in ctx else ""
                cards += f'<div class="place-card-mini">{pic_html}<div><h3>{escape(pr["name_th"])}</h3><button class="button button-outline" data-trip-add="{escape(pid)}">à¹€à¸žà¸´à¹ˆà¸¡à¸¥à¸‡à¸—à¸£à¸´à¸›</button></div></div>'
        places_html = f'<section class="story-places-v2"><h2>à¹„à¸›à¸”à¸¹à¸‚à¸­à¸‡à¸ˆà¸£à¸´à¸‡à¹„à¸”à¹‰à¸—à¸µà¹ˆà¹„à¸«à¸™</h2><div class="mini-cards-v2">{cards}</div></section>'

    unknowns = story.get("unknowns", [])
    un_html = ''
    if unknowns:
        lis = ''.join(f'<li>{escape(u)}</li>' for u in unknowns)
        un_html = f'<details class="unknowns-box-v2"><summary>à¸‚à¹‰à¸­à¸¡à¸¹à¸¥à¸—à¸µà¹ˆà¸¢à¸±à¸‡à¸«à¸²à¹„à¸¡à¹ˆà¹€à¸ˆà¸­</summary><ul>{lis}</ul></details>'

    sources = story.get("sources", [])
    src_lis = ''
    for s in sources:
        if isinstance(s, dict):
            src_lis += f'<li><cite>{escape(s.get("title",""))}</cite> Â· {escape(s.get("publisher",""))} Â· {escape(s.get("locator",""))} Â· {source_link(s.get("url",""), "à¸”à¸¹à¹à¸«à¸¥à¹ˆà¸‡à¸—à¸µà¹ˆà¸¡à¸²")} (à¹€à¸‚à¹‰à¸²à¸–à¸¶à¸‡ {escape(s.get("accessed",""))})</li>'
        else:
            if s in SOURCES:
                src = SOURCES[s]
                src_lis += f'<li><cite>{escape(src["title"])}</cite> Â· {escape(src["publisher"])} Â· {escape(src["locator"])} Â· {source_link(src["url"], "à¸”à¸¹à¹à¸«à¸¥à¹ˆà¸‡à¸—à¸µà¹ˆà¸¡à¸²")}</li>'
    sources_html = f'<section class="story-sources-v2"><h2>à¹à¸«à¸¥à¹ˆà¸‡à¸‚à¹‰à¸­à¸¡à¸¹à¸¥</h2><ol>{src_lis}</ol></section>'

    return f'<div class="story-article-v2">{header}{hero_html}<div class="story-layout-v2"><div class="story-main-v2">{lede_html}{sections_html}{places_html}{story_outro(story.get("id"))}{un_html}{sources_html}</div><div class="story-sidebar-v2">{ev_html}{toc_html}</div></div></div>'

def index(ctx):
    cards = ''
    used_art = set()
    for i, s in enumerate(get_all_stories()):
        is_new = 'reading_minutes' in s
        route = s.get('route', f'/stories/{s["id"]}/')
        mins = f'<span class="story-mins">{s["reading_minutes"]} à¸™à¸²à¸—à¸µ</span>' if is_new else ''
        # The index is a gallery, so every card gets the same treatment: the
        # commissioned illustration of a place the story is about. Photographs
        # stay inside the articles where a caption gives them context.
        photo = ''
        for pid in s.get("places", []):
            if pid not in used_art and os.path.exists(f"site/assets/{pid}.webp"):
                photo = f'<img src="/assets/{pid}.webp" alt="" loading="lazy">'
                used_art.add(pid)
                break
        if not photo:
            for pid in s.get("places", []):
                if os.path.exists(f"site/assets/{pid}.webp"):
                    photo = f'<img src="/assets/{pid}.webp" alt="" loading="lazy">'
                    break
        photo_html = f'<div class="card-art-v2">{photo}</div>' if photo else ''
        cls = "story-card-v2"
        if i == 0:
            cls += " story-card-v2-lead"
            
        cards += (
            f'<article class="{cls}">'
            f'{photo_html}'
            f'<div class="card-content-v2">'
