             return m.group(0)
         hit = mem.get(val.strip())
-        if hit:
-            return f'{name}={quote}{esc(hit, quote=True)}{quote}'
+        if hit:
+            return f'{name}={quote}{esc(hit, quote=True)}{quote}'
         if missing is not None:
             missing[val.strip()] = missing.get(val.strip(), 0) + 1
         return m.group(0)
 
-    return re.sub(r'([\w:-]+)=(["\'])([^"\']*)', sub, tag)
+    return re.sub(r'([\w:-]+)=(["\'])([^"\']*)\2', sub, tag)
 
 
