D:\Siwaracafeweb\output\web\takuapa101-v1\site\en\places\rong-jae\index.html:1:<!doctype html><html lang="en" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>The Shrine in the Garden · Rong Jae Takua Pa · Takua Pa 101</title><meta name="description" content="A space of belief collectively maintained by the community · Nai Suan Shrine Takua Pa · Takua Pa Chinese shrine"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="The Shrine in the Garden · Rong Jae Takua Pa"><meta property="og:description" content="A space of belief collectively maintained by the community · Nai Suan Shrine Takua Pa · Takua Pa Chinese shrine"><meta property="og:url" content="https://takuapa101.com/places/rong-jae/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/rong-jae.png"><meta property="og:locale" content="en_US"><meta property="og:site_name" content="Takua Pa 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/rong-jae.png"><meta name="generator" content="Takua Pa 101"><link rel="canonical" href="https://takuapa101.com/en/places/rong-jae/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "inLanguage": "en", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "โรงเจในสวน · ศาลเจ้าเซ้งเหล่งเก้ง ตะกั่วป่า", "item": "https://takuapa101.com/places/rong-jae/"}]}, {"@context": "https://schema.org", "inLanguage": "en", "@type": "TouristAttraction", "name": "โรงเจในสวน", "url": "https://takuapa101.com/places/rong-jae/", "image": "https://takuapa101.com/assets/rong-jae.webp", "description": "สถานที่ที่เอกสารเชื่อมกับประเพณีจีนและการสืบทอดวัฒนธรรม", "address": {"@type": "PostalAddress", "streetAddress": "ซอยโรงพระ ถนนราษฎร์บำรุง อำเภอตะกั่วป่า จังหวัดพังงา", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "addressCountry": "TH"}}, {"@context": "https://schema.org", "inLanguage": "en", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "เอกสารแผนการดำเนินงานด้านสิ่งแวดล้อมของเทศบาลเมืองตะกั่วป่าระบุว่าโรงเจในสวนมีชื่อว่าศาลเจ้าเซ้งเหล่งเก้ง และมีอายุนับร้อยปี โดยไม่ได้ระบุปีสร้างที่แน่นอน เทศบาลระบุผู้ก่อตั้งคือนายส้อ เทียนเส้ง ซึ่งเป็นชาวจีนโพ้นทะเล"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "องค์เทพที่เทศบาลระบุว่าประดิษฐานในศาลเจ้า มีอีกชื่อว่าเจ้าพ่อหยาดน้ำค้าง และมีประวัติอัญเชิญมาจากประเทศจีน บล็อกหรอยจังรายงานว่าอาม่าตั๋นซี่หลุนขายขนมโกสุ้ยที่โรงเจในสวนช่วงเทศกาลกินเจ เป็นข้อมูลจากบล็อกที่ยังต้องตรวจสอบการจำหน่ายในปีที่จะเดินทาง"}}, {"@type": "Question", "name": "เอกสารเทศบาลกล่าวถึงที่นี่อย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "สถานที่ที่เอกสารเชื่อมกับประเพณีจีนและการสืบทอดวัฒนธรรม"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/places/rong-jae/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/places/rong-jae/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/places/rong-jae/"></head><body class="inner-page"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/en/" aria-label="Takua Pa 101 Home"><span class="brand-mark">101</span><span>Takua Pa<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/en/places/" aria-current="page">Places</a><a href="/en/stories/">Stories</a><a href="/en/map/">Map</a><a href="/en/rest/">Eat and explore</a><a href="/en/news/">Updates</a><a href="/en/trip/">Your trip</a><a href="/en/traditions/" class="nav-more">Traditions</a><a href="/en/eat/" class="nav-more">Eat & Souvenirs</a><a href="/en/routes/" class="nav-more">Walking Routes</a><a href="/en/leaflet/" class="nav-more">Leaflet</a><a href="/en/about/" class="nav-more">About</a></nav><div class="header-tools"><a class="lang-switch" href="/places/rong-jae/" hreflang="th" lang="th">ไทย</a><a class="lang-switch" href="/en/places/rong-jae/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="Open menu"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="Search website (Press Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/en/trip/" aria-label="Your trip"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/en/map/">Open map ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/en/">Home</a> / <a href="/en/places/">Places</a> / Shrines & Vegetarian Halls</div><header class="place-hero full-place-hero"><div><span class="chapter">Place record · Shrines and vegetarian halls</span><h1>The Shrine in the Garden</h1><p class="english">The Shrine in the Garden</p><span class="fact-status confirmed">6 items verified</span><p><a class="text-link" href="#eras">Then · Before · Now ↓</a></p><p class="place-hero-actions"><button class="button" type="button" data-trip-add="rong-jae">Add to trip</button><a class="text-link" href="/en/trip/">View your trip</a></p></div><div class="place-hero-art"><img src="/assets/rong-jae.webp" alt="The Shrine in the Garden" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>Practical information</h2><dl><div><dt>Location</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Opening hours</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Admission fee</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Parking</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Restrooms</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Wheelchair access</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Dress code</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Phone</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Page</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Website</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>LINE</dt><dd><span class="muted">Not verified</span></dd></div><div><a href="https://roijang.com/phangnga/โกสุ้ย-ขนมพื้นเมือ-งตะกั่วป่า-พังงา-2023-12-6/" target="_blank" rel="noopener">Visitor information sources ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">On this page</span><a href="#visit">Practical information</a><a href="#eras">Then · Before · Now</a><a href="#timeline">Dot timeline</a><a href="#highlights">Highlights to see</a><a href="#did_you_know">Did you know</a><a href="#nearby">Nearby and similar places</a><a href="#faq">FAQ</a><a href="#sources">Data Sources</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>Then · Before · Now</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">Then</span><h3>An old shrine of the Chinese community in Takua Pa</h3><p class="era-years">The exact construction year is unknown; municipal documents state that it is more than a century old</p><span class="fact-status confirmed">Verified</span><p>Rong Jae Nai Suan, or Seng Leng Keng Shrine, appears in Takua Pa Town Municipality documents as a centuries-old shrine, but the same documents do not give its construction year. It is therefore not yet possible to place its beginnings in a particular reign.</p><p>The founder identified in municipal documents is Mr So Thian Seng, an overseas Chinese settler. After the shrine was completed, Phra Cheng Chui Cho Sue, or Chao Pho Yat Nam Khang, was brought from China and enshrined there. The place therefore likely served both as a site of worship and as a centre of belief for the Chinese community in the mining and port town of Takua Pa. However, there is no site-specific evidence for its construction year, the founder's policy rationale, or its everyday role at the time.</p><p>Another local document says that Mr So Seng had worked with Ku Chai Tung Shrine before opening the shrine in the garden. However, it cannot yet be confirmed that he was the same person as Mr So Thian Seng, so these are not presented as the same fact.</p><div class="era-sources">References · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality): Environmental Operation Plan</a> · <a href="https://anyflip.com/tshcu/hnol/basic" target="_blank" rel="noopener">Takua Pa Vegetarian Festival, สภาวัฒนธรรมตำบลตะกั่วป่า (Takua Pa Sub-district Cultural Council)</a></div></article><article class="era-card" data-era="before"><span class="chapter">Before</span><h3>A transition period with blank documents</h3><p class="era-years">No confirmed year or event has been found</p><span class="fact-status unverified">Not verified</span><p>Among the verifiable sources, no evidence has been found that the shrine changed ownership, was abandoned, or was restored in any particular year. No site-specific evidence has been found showing how the 2004 tsunami (พ.ศ. 2547) affected this building.</p><p>No historic-site registration entry has been found for Rong Jae Nai Suan, and there is no information that it was converted to another business or type of public building. The verifiable information for the intervening period is therefore limited to the continuity of the place name and memories of an old shrine. The history of another shrine in the old town should not be used to fill the gaps.</p><p>Takua Pa's context changed from a mining and maritime-trading town into a historic and cultural town, but the sources found do not yet connect this city-level change with specific events at Rong Jae Nai Suan.</p><div class="era-sources">References · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality): Environmental Operation Plan</a></div></article><article class="era-card" data-era="now"><span class="chapter">Now</span><h3>Still named in the Vegetarian Festival landscape, but operational status is unclear</h3><p class="era-years">2569 / 2026</p><span class="fact-status unverified">Not verified</span><p>Currently, verifiable online sources do not confirm who manages the shrine, whether it is open to visitors every day, what condition the building is in, or whether any restoration project is under way. It should therefore not be described as an open tourist attraction or as a place that can be visited without an appointment.</p><p>The contemporary evidence found is a review article reporting the sale of ko sui sweets at Rong Jae Nai Suan during the Vegetarian Festival. This indicates that the place was still used for a community festival activity, but it is a blog report, not a shrine schedule announcement, and does not confirm that the activity is held every year.</p><p>Travellers should use the Soi Rong Phra, Thanon Rat Bamrung address as a starting point and check with local people or the municipality before travelling, because no verified coordinates, opening hours, telephone number, or official contact channel are available.</p><div class="era-sources">References · <a href="https://roijang.com/phangnga/โกสุ้ย-ขนมพื้นเมือ-งตะกั่วป่า-พังงา-2023-12-6/" target="_blank" rel="noopener">Roi Jang: Ko Sui, Takua Pa local dessert</a> · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Takua Pa Town Municipality: Place Information Document</a></div></article></div></section><section class="research-section" id="timeline"><h2>Dot timeline</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status confirmed">Verified</span><p class="era-years">Year unspecified</p><h3>Founding of the shrine</h3><p>The municipality document identified the founder as Mr. So Thian Seng, an overseas Chinese, but did not specify the founding year.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">Year unspecified</p><h3>Inviting the deity from China</h3><p>After building the shrine, Phra Cheng Chui Cho Sue, or the Dewdrop God, was invited from China to be enshrined.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status unverified">Not verified</span><p class="era-years">Year unspecified</p><h3>Kosui snack activity in the Vegetarian Festival</h3><p>A review article reported the selling of Kosui snacks at the Shrine in the Garden, but it is not an official announcement and it is not verified if it will be held every year.</p><a href="https://roijang.com/phangnga/โกสุ้ย-ขนมพื้นเมือ-งตะกั่วป่า-พังงา-2023-12-6/" target="_blank" rel="noopener">Read source ↗</a></li></ol></section><p class="missing-photo">No image authorized for publication yet</p><section class="research-section" id="highlights"><h2>Highlights to see</h2><div class="research-cards"><article class="research-note"><h3>Deity Cheng Chui Cho Sue</h3><span class="fact-status unknown">Not verified</span><p>The deity that the municipality states is enshrined in the shrine. Also known as the Dewdrop Deity, it has a history of being invited from China.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Ko Sui snacks during the Vegetarian Festival</h3><span class="fact-status unknown">Not verified</span><p>The Roi Jang blog reports that Grandma Tan Si Lun sells Ko Sui snacks at the Shrine in the Garden during the Vegetarian Festival. This is information from a blog that still needs to be verified for sales in the year of travel.</p><a href="https://roijang.com/phangnga/โกสุ้ย-ขนมพื้นเมือ-งตะกั่วป่า-พังงา-2023-12-6/" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>Did you know</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">Verified</span><p>The name "Rong Chae Nai Suan" (Shrine in the Garden) is a common name for Seng Leng Keng Shrine, according to Takua Pa Town Municipality data.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><span class="fact-status confirmed">Verified</span><p>Municipal documents mention a reputation for traditional Chinese healing. This is the history of the place's beliefs, not evidence of medical efficacy.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="nearby"><h2>Nearby and similar places</h2><ul class="nearby-links"><li><a href="/en/places/guan-yu/">Guan Yu / Sin Chai Tung Shrine</a></li><li><a href="/en/places/pun-thao/">Pun Thao Kong A Shrine</a></li><li><a href="/en/places/kue-chai/">Kue Chai Tung Shrine</a></li></ul></section><section class="research-section" id="faq"><h2>FAQ</h2><details><summary>What is the history of this place?</summary><p>Takua Pa Town Municipality's environmental action plan documents say that Rong Jae Nai Suan is called Seng Leng Keng Shrine and is more than a century old, without specifying an exact construction year. The municipality identifies its founder as Mr So Thian Seng, an overseas Chinese settler.</p></details><details><summary>What are the highlights to see?</summary><p>The deity that the municipality says is enshrined at the shrine is also known as Chao Pho Yat Nam Khang and is said to have been brought from China. The Hroi Jang blog reports that Ama Tan Si Lun sells ko sui sweets at Rong Jae Nai Suan during the Vegetarian Festival. This is blog information, and sales in the year of travel still need to be checked.</p></details><details><summary>How the municipality document mentions this place</summary><p>A place that documents connect with Chinese traditions and cultural continuity</p></details></section><section class="research-section" id="sources"><h2>Data Sources</h2><div class="source-table"><table><thead><tr><th>Name</th><th>Type</th><th>Date accessed</th><th>Link</th></tr></thead><tbody><tr><th scope="row">Takua Pa Town Municipality · Environmental Action Plan for Fiscal Year 2020 (พ.ศ. 2563)</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Takua Pa Vegetarian Festival, Takua Pa Subdistrict Cultural Council · Copy on AnyFlip</th><td>Blog</td><td>2026-09-07</td><td><a href="https://anyflip.com/tshcu/hnol/basic" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Hroi Jang Phang Nga · Ko Sui, a local sweet from Takua Pa, Phang Nga</th><td>Blog</td><td>2026-09-07</td><td><a href="https://roijang.com/phangnga/โกสุ้ย-ขนมพื้นเมือ-งตะกั่วป่า-พังงา-2023-12-6/" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality): Environmental Operation Plan</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Takua Pa Vegetarian Festival, สภาวัฒนธรรมตำบลตะกั่วป่า (Takua Pa Sub-district Cultural Council)</th><td>Blog</td><td>2026-09-07</td><td><a href="https://anyflip.com/tshcu/hnol/basic" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Roi Jang: Ko Sui, Takua Pa local dessert</th><td>Blog</td><td>2026-09-07</td><td><a href="https://roijang.com/phangnga/โกสุ้ย-ขนมพื้นเมือ-งตะกั่วป่า-พังงา-2023-12-6/" target="_blank" rel="noopener">Open source ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>Missing data</summary><ul><li>The English name is used according to the brief. No source confirming this as the official English name has been found yet; SEO keywords are suggestions for searching, not search volume data.</li><li>No coordinates that can verify its identity have been found from Google Maps, OpenStreetMap, Mapcarta, or Wikidata.</li><li>A Google Map embedded in the Roi Jang article shows the name Rong Than Shrine Hiap Thian Tai Te, Thung Yai Shrine, Phang Nga Province, which does not match the Shrine in the Garden, so the coordinates from that map are not used.</li><li>The address is only known as Soi Rong Phra, Rat Bamrung Road; no specific building number, subdistrict, and postal code confirmed for the location have been found.</li><li>No verified opening hours and admission fees have been found, so it is not assumed that it is open every day or free.</li><li>No verified phone number, Facebook page, website, or LINE account for the shrine has been found.</li><li>No direct travel information to the shrine from Takua Pa town center, Phuket, or Khao Lak, including distances and public transport, has been found.</li><li>No exact construction year or restoration year has been found. The phrase "century-old" is not enough to calculate the construction year.</li><li>No specific evidence regarding the role of the Shrine in the Garden in the tin mining business has been found.</li><li>No verifiable description of this building's architecture has been found, so it is not stated as Sino-Portuguese or detailed with Chinese decorations.</li><li>No ancient monument registration announcement specific to the Shrine in the Garden has been found.</li><li>Founder information in the book on AnyFlip uses the name So Seng, while the municipality uses So Thian Seng, and a connection between the individuals cannot yet be made.</li><li>Only two highlights with direct evidence to the location were found, and the snack item is seasonal data from a blog. Therefore, it is not filled up to 3-6 items without evidence.</li><li>No month and lunar calendar specific to this shrine have been found, nor the 2026 schedule.</li><li>No visiting duration, dress code, parking, restrooms, ramps, or accessibility information for the elderly and wheelchairs have been found.</li><li>No verified walking routes from the shrine to nearby places have been found.</li><li>No official image link verifying it is the Shrine in the Garden and whose image can be checked has been found.</li><li>The newly referenced municipal document is the Environmental Operations Plan for Fiscal Year 2020.</li><li>No verified construction year, restoration year, or founding date has been found.</li><li>No evidence of changing hands, abandonment, other uses, effects from the 2004 tsunami, or site-specific ancient monument registration has been found.</li><li>No current caretaker, opening hours, building condition, development projects, coordinates, phone number, and official contact channels have been found.</li><li>No old or current photos that verify the identity of the Shrine in the Garden from readable sources have been found.</li><li>No news from the past five years specific to the Shrine in the Garden has been found.</li><li>The context of the tin mining era, maritime trade, and the Chinese community of Takua Pa still has no evidence tying it directly to specific events at this location.</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/en/" class="footer-name">Takua Pa <em>101</em></a><p>One city<br>Stories to get to know</p><a class="round-link" href="#main" aria-label="Back to top">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">Created by Baan Siwara, Takua Pa</a><span>Old Town Guide · Phang Nga Province</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">Original Brochure ↗</a></div></footer><nav class="tabbar" aria-label="Quick menu"><a href="/en/"><span class="tb-glyph" aria-hidden="true">⌂</span>Home</a><a href="/en/map/"><span class="tb-glyph" aria-hidden="true">◈</span>Map</a><a href="/en/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>Eat</a><a href="/en/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>Trip<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
D:\Siwaracafeweb\output\web\takuapa101-v1\site\en\places\tao-ming\index.html:1:<!doctype html><html lang="en" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tao Ming School · Takuapa old town · Takua Pa 101</title><meta name="description" content="A school building that tells a story of cultural transmission · Tao Ming School Takuapa · Chinese school Takuapa · Sino-Portuguese Takuapa"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="Tao Ming School · Takuapa old town"><meta property="og:description" content="A school building that tells a story of cultural transmission · Tao Ming School Takuapa · Chinese school Takuapa · Sino-Portuguese Takuapa"><meta property="og:url" content="https://takuapa101.com/places/tao-ming/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/tao-ming.png"><meta property="og:locale" content="en_US"><meta property="og:site_name" content="Takua Pa 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/tao-ming.png"><meta name="generator" content="Takua Pa 101"><link rel="canonical" href="https://takuapa101.com/en/places/tao-ming/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "inLanguage": "en", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "โรงเรียนเต้าหมิง · อาคารเต้าหมิง ตะกั่วป่า", "item": "https://takuapa101.com/places/tao-ming/"}]}, {"@context": "https://schema.org", "inLanguage": "en", "@type": "TouristAttraction", "name": "โรงเรียนเต้าหมิง", "url": "https://takuapa101.com/places/tao-ming/", "image": "https://takuapa101.com/assets/tao-ming.webp", "description": "เกิดจากความร่วมมือของชาวจีนในตะกั่วป่าเพื่อการเรียนภาษาและวัฒนธรรมจีน", "address": {"@type": "PostalAddress", "streetAddress": "ถนนศรีตะกั่วป่า (ไม่พบเลขที่อาคารจากแหล่งที่อ่านได้)", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8338139717, "longitude": 98.3649490347}}, {"@context": "https://schema.org", "inLanguage": "en", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "อยู่ในเขตชุมชนเมืองเก่าตะกั่วป่า บริเวณถนนศรีตะกั่วป่า; ใช้แผนที่นำทางไปยังพิกัดที่ระบุ"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "อาคารสร้างขึ้นใน พ.ศ. 2465 โรงเรียนเริ่มขอตั้งเป็นโรงเรียนราษฎร์ใน พ.ศ. 2463 และเดิมใช้ชื่อโต๊ะเบ๋ง ตามสำเนียงฮกเกี้ยน"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "อาคารโรงเรียนประวัติศาสตร์ที่ยังคงเหลืออยู่ในย่านเมืองเก่า สังเกตรูปทรงอาคารและหลังคามุงสังกะสีซึ่งระบุโดยหน่วยงานอนุรักษ์ เป็นหลักฐานของการจัดการศึกษาโดยชุมชนชาวจีนในเมืองเหมืองแร่ตะกั่วป่า"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/places/tao-ming/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/places/tao-ming/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/places/tao-ming/"></head><body class="inner-page"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/en/" aria-label="Takua Pa 101 Home"><span class="brand-mark">101</span><span>Takua Pa<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/en/places/" aria-current="page">Places</a><a href="/en/stories/">Stories</a><a href="/en/map/">Map</a><a href="/en/rest/">Eat and explore</a><a href="/en/news/">Updates</a><a href="/en/trip/">Your trip</a><a href="/en/traditions/" class="nav-more">Traditions</a><a href="/en/eat/" class="nav-more">Eat & Souvenirs</a><a href="/en/routes/" class="nav-more">Walking Routes</a><a href="/en/leaflet/" class="nav-more">Leaflet</a><a href="/en/about/" class="nav-more">About</a></nav><div class="header-tools"><a class="lang-switch" href="/places/tao-ming/" hreflang="th" lang="th">ไทย</a><a class="lang-switch" href="/en/places/tao-ming/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="Open menu"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="Search website (Press Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/en/trip/" aria-label="Your trip"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/en/map/">Open map ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/en/">Home</a> / <a href="/en/places/">Places</a> / Old Buildings & City Traces</div><header class="place-hero full-place-hero"><div><span class="chapter">Place record · Old buildings and city traces</span><h1>Tao Ming School</h1><p class="english">Tao Ming School</p><span class="fact-status confirmed">10 verified points</span><p><a class="text-link" href="#eras">Then · Before · Now ↓</a></p><p class="place-hero-actions"><button class="button" type="button" data-trip-add="tao-ming">Add to trip</button><a class="text-link" href="/en/trip/">View your trip</a></p></div><div class="place-hero-art"><figure class="research-photo"><img src="/assets/photos/tao-ming-school.jpg" width="1477" height="1108" alt="Tao Ming School seen from the front, on the old town culture street" loading="eager"><figcaption>Tao Ming School seen from the front, on the old town culture street<small>Credit · Kua Pa Pho Project image archive</small><small>License · Cleared for this website</small></figcaption></figure></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>Practical information</h2><dl><div><dt>Location</dt><dd>8.8338139717, 98.3649490347 <span class="fact-status unknown">Not verified</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.8338139717,98.3649490347" target="_blank" rel="noopener">Navigate with Google Maps ↗</a><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Coordinates source ↗</a></div><div><dt>Opening hours</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Admission fee</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Parking</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Restrooms</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Wheelchair access</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Dress code</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Phone</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Page</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Website</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>LINE</dt><dd><span class="muted">Not verified</span></dd></div><div><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Visitor information sources ↗</a><a href="https://www.muangboranjournal.com/post/Takuapa_Naver_Ending_Stories" target="_blank" rel="noopener">Visitor information sources ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">On this page</span><a href="#visit">Practical information</a><a href="#eras">Then · Before · Now</a><a href="#timeline">Dot timeline</a><a href="#gallery">Gallery</a><a href="#highlights">Highlights to see</a><a href="#news">News and updates</a><a href="#did_you_know">Did you know</a><a href="#getting_there">Getting there</a><a href="#nearby">Nearby and similar places</a><a href="#faq">FAQ</a><a href="#sources">Data Sources</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>Then · Before · Now</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">Then</span><h3>From mining town donations to Takua Pa's first Chinese school</h3><p class="era-years">1920 to 1922 (B.E. 2463 to 2465)</p><span class="fact-status confirmed">Verified</span><p>Before it had a permanent building, Tao Ming School informally taught Chinese through private instruction. When the Private Schools Act of 1918 (พ.ศ. 2461) came into effect, the school formally declared its intention to be established in 1920 (พ.ศ. 2463), using the name “To Beng” in Hokkien pronunciation, before changing to “Tao Ming” in Mandarin pronunciation. The name conveys the idea of leading toward knowledge.</p><p>The surviving building was constructed in 1922 (พ.ศ. 2465) with funds collected from mining magnates and Chinese merchants in the old market at Yan Yao, as well as merchant networks from Ranong and Phuket. Another official source describes it as the work of a Chinese merchants' association that entered the tin-mining industry to provide Chinese-language education for Chinese children. The adapted Sino-Portuguese building with its corrugated-metal roof was therefore not only a school, but evidence that wealth from mining, trade, and Chinese networks was becoming a community institution.</p><p>At that time, Takua Pa was a trading and transport district connected to the river and sea. The town grew through tin, while Chinese people from Hokkien, Guangdong, and Hainan came as workers, merchants, and entrepreneurs. The school helped give the Chinese community in the flourishing mining town a linguistic and cultural foundation.</p><figure class="research-photo"><img src="/assets/photos/tao-ming-logo.jpg" width="1280" height="1280" alt="The Tao Ming School emblem" loading="lazy"><figcaption>The Tao Ming School emblem<small>Credit · Kua Pa Pho Project image archive</small><small>License · Cleared for this website</small></figcaption></figure><div class="era-sources">References · <a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Samnakngan Noyobai lae Phaen Sapphayakon Thammachat lae Singwaetlom (Office of Natural Resources and Environmental Policy and Planning): Rongrian Tao Ming (Tao Ming School) building</a> · <a href="https://www.muangboranjournal.com/post/Takuapa_Naver_Ending_Stories" target="_blank" rel="noopener">Muang Boran Journal: Takua Pa Old Town and its endless tales</a> · <a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">ศูนย์มานุษยวิทยาสิรินธร (Princess Maha Chakri Sirindhorn Anthropology Centre): Takua Pa Town</a> · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality): Environmental Operation Plan</a></div></article><article class="era-card" data-era="before"><span class="chapter">Before</span><h3>When the mining town quieted down, the school paused, but the building still speaks</h3><p class="era-years">1977 to 2025 (B.E. 2520 to 2568)</p><span class="fact-status confirmed">Verified</span><p>Local sources state that Takua Pa's mines gradually closed from the 1970s, reducing the town's activity, while Tao Ming School ceased operations later. Verifiable official sources confirm only that “the school has been discontinued” and that the building is under the care of the Tao Ming School Foundation, Takua Pa. They do not specify the year it ceased operating or details of any change in ownership.</p><p>No readable evidence has been found confirming that the building was directly affected by the 2004 tsunami (พ.ศ. 2547) or that it underwent restoration in any particular year. It should therefore not be concluded that it was damaged or repaired because of that event, even though the Takua Pa area has sites connected with tsunami survivor assistance and the old town has regained a cultural-tourism role.</p><p>The old town boundary document by ONEP indicates the boundary passing through Tao Ming School, and the community database of the Sirindhorn Anthropology Centre classifies the building among the important evidence of the old town. However, this search has not yet found a Fine Arts Department announcement directly registering the “Tao Ming School Building”. Therefore, the conservation status of the area is separated from the registration status of the building.</p><figure class="research-photo"><img src="/assets/photos/tao-ming-logo.jpg" width="1280" height="1280" alt="The Tao Ming School emblem" loading="lazy"><figcaption>The Tao Ming School emblem<small>Credit · Kua Pa Pho Project image archive</small><small>License · Cleared for this website</small></figcaption></figure><div class="era-sources">References · <a href="https://www.muangboranjournal.com/post/Takuapa_Naver_Ending_Stories" target="_blank" rel="noopener">Muang Boran Journal: Takua Pa Old Town and its endless tales</a> · <a href="https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf" target="_blank" rel="noopener">Office of Natural Resources and Environmental Policy and Planning (ONEP): Takua Pa Old Town Boundary</a> · <a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">ศูนย์มานุษยวิทยาสิรินธร (Princess Maha Chakri Sirindhorn Anthropology Centre): Takua Pa Town</a> · <a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Samnakngan Noyobai lae Phaen Sapphayakon Thammachat lae Singwaetlom (Office of Natural Resources and Environmental Policy and Planning): Rongrian Tao Ming (Tao Ming School) building</a></div></article><article class="era-card" data-era="now"><span class="chapter">Now</span><h3>The original building remains in the old town, but it is no longer an active school</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">Verified</span><p>The currently verified status is that the school has closed down, leaving a historical building under the care of the Munlanithi Rongrian Tao Ming Takua Pa (Tao Ming Takua Pa School Foundation). Therefore, it should be understood that "visiting the building" is not the same as "visiting an operating school".</p><p>The building is located on Thanon Si Takua Pa in the old town area and is still used as a destination in tourism media by the Thetsaban Mueang Takua Pa (Takua Pa Town Municipality), the Kan Thongthiao Haeng Prathet Thai (Tourism Authority of Thailand), and old town activities, such as the cultural street held in the Thanon Si Takua Pa area. The information found verifies the context of activities in the area but it is not verified that activities are regularly held inside the building.</p><p>The condition verified from official sources is that the building remains and has architectural value in applied Sino-Portuguese style. As for opening hours, admission fees, regular caretakers, interior access, wheelchair accessibility, and the 2026 (2569 BE) restoration project, there is still no verifiable public information. Therefore, one should contact the caretaker or municipality before traveling.</p><figure class="research-photo"><img src="/assets/photos/tao-ming-school.jpg" width="1477" height="1108" alt="Tao Ming School seen from the front, on the old town culture street" loading="lazy"><figcaption>Tao Ming School seen from the front, on the old town culture street<small>Credit · Kua Pa Pho Project image archive</small><small>License · Cleared for this website</small></figcaption></figure><div class="era-sources">References · <a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Samnakngan Noyobai lae Phaen Sapphayakon Thammachat lae Singwaetlom (Office of Natural Resources and Environmental Policy and Planning): Rongrian Tao Ming (Tao Ming School) building</a> · <a href="https://tatmediaassets.com/file/1099396" target="_blank" rel="noopener">Tourism Authority of Thailand: TAT Media Assets · Tao Ming School</a> · <a href="https://www.phangngapao.go.th/travel/detail/89" target="_blank" rel="noopener">องค์การบริหารส่วนจังหวัดพังงา (Phang Nga Provincial Administrative Organization): Takua Pa Old Town</a> · <a href="https://www.youtube.com/watch?v=qn0Tb1GSiZY" target="_blank" rel="noopener">Thetsaban Mueang Takua Pa (Takua Pa Town Municipality): Tao Ming School Building (location introduction video)</a></div></article></div></section><section class="research-section" id="timeline"><h2>Dot timeline</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status confirmed">Verified</span><p class="era-years">1920 (2463 BE)</p><h3>Application for Toh Beng Private School</h3><p>The Chinese school, initially operated informally by private individuals, applied for private school status following the Private Schools Act of 1918.</p><a href="https://www.muangboranjournal.com/post/Takuapa_Naver_Ending_Stories" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">1922 (2465 BE)</p><h3>Construction of Tao Ming School Building</h3><p>The applied Sino-Portuguese building was constructed with donations from tin mining tycoons and Chinese merchants to provide primary and Chinese language education for children in Takua Pa.</p><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">1977 to 1986 (2520s BE decade)</p><h3>Decline of the Mining Town</h3><p>Local sources state that tin mines began to gradually close during this decade, reducing the town's vibrancy. However, this is not a verified year for the school's closure.</p><a href="https://www.muangboranjournal.com/post/Takuapa_Naver_Ending_Stories" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">2020 (2563 BE)</p><h3>Municipality Releases Promotional Video</h3><p>Takua Pa Municipality published a video introducing the Tao Ming School building as an old town tourist attraction.</p><a href="https://www.youtube.com/watch?v=qn0Tb1GSiZY" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status unverified">Not verified</span><p class="era-years">21 February 2026 (2569 BE)</p><h3>Old Town Storytelling Event at Tao Ming School</h3><p>Press releases indicated the Old Town Storytelling event took place at Tao Ming School, Takua Pa. However, full details from primary news sources are not verified.</p><a href="https://youphuket.club/author/admin/page/58/" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">Year unspecified</p><h3>School Closes and Foundation Takes Over</h3><p>The exact year of closure is not verified. Official sources state the remaining building is under the care of the Tao Ming Takua Pa School Foundation.</p><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Read source ↗</a></li></ol></section><section class="research-section" id="gallery"><h2>Gallery</h2><div data-gallery><div class="gallery-tabs" hidden><button type="button" data-tab="today">Present photos</button><button type="button" data-tab="archive">Historical photos</button></div><div id="gallery-today" data-panel="today"><h3>Present photos</h3><div class="photo-grid"><figure class="research-photo"><a data-lightbox href="/assets/photos/tao-ming-school.jpg" aria-label="ขยายภาพ · อาคารโรงเรียนเต้าหมิง ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า"><img src="/assets/photos/tao-ming-school.jpg" width="1477" height="1108" alt="Tao Ming School seen from the front, on the old town culture street" loading="lazy"></a><figcaption>Tao Ming School seen from the front, on the old town culture street<small>Credit · Kua Pa Pho Project image archive</small><small>License · Cleared for this website</small></figcaption></figure></div></div><div id="gallery-archive" data-panel="archive"><h3>Historical photos</h3><div class="photo-grid"><figure class="research-photo"><a data-lightbox href="/assets/photos/tao-ming-logo.jpg" aria-label="ขยายภาพ · ตราโรงเรียนเต้าหมิง"><img src="/assets/photos/tao-ming-logo.jpg" width="1280" height="1280" alt="The Tao Ming School emblem" loading="lazy"></a><figcaption>The Tao Ming School emblem<small>Credit · Kua Pa Pho Project image archive</small><small>License · Cleared for this website</small></figcaption></figure></div></div></div></section><section class="research-section" id="highlights"><h2>Highlights to see</h2><div class="research-cards"><article class="research-note"><h3>Old yellow building</h3><span class="fact-status unknown">Not verified</span><p>A historic school building that still remains in the old town area.</p><a href="https://readme.me/p/51787" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Applied Sino-Portuguese style</h3><span class="fact-status unknown">Not verified</span><p>Observe the building's shape and zinc roof, as noted by conservation agencies.</p><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Traces of Chinese education</h3><span class="fact-status unknown">Not verified</span><p>It is evidence of educational management by the Chinese community in the Takua Pa mining town.</p><a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="news"><h2>News and updates</h2><div class="research-cards"><article class="research-note"><p class="muted">2026-02-21 · YOUPHUKET</p><h3>Old Town Storytelling Event at Tao Ming School, Takua Pa</h3><p>Press releases reported a full day of activities hosted at Tao Ming School.</p><a href="https://youphuket.club/author/admin/page/58/" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>Did you know</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">Verified</span><p>"Toh Beng" is the original name pronounced in the Hokkien dialect, while "Tao Ming" is the Mandarin pronunciation of the name 導明.</p><a href="https://www.muangboranjournal.com/post/Takuapa_Naver_Ending_Stories" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><span class="fact-status unverified">Not verified</span><p>Tao Ming School was the first and only Chinese language school in Takua Pa according to accessible local articles.</p><a href="https://www.muangboranjournal.com/post/Takuapa_Naver_Ending_Stories" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><span class="fact-status confirmed">Verified</span><p>The building was constructed by Chinese craftsmen and features a zinc roof in the applied Sino-Portuguese style.</p><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>Getting there</h2><div class="research-cards"><article class="research-note"><h3>Takua Pa Town</h3><span class="fact-status unknown">Not verified</span><p>Located in the Takua Pa old town community on Si Takua Pa Road; use a navigation map to the specified coordinates.</p><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Phuket</h3><span class="fact-status unknown">Not verified</span><p>No specific route or distance was found from verified sources.</p><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Khao Lak</h3><span class="fact-status unknown">Not verified</span><p>No specific route or distance was found from verified sources.</p><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Airport</h3><span class="fact-status unknown">Not verified</span><p>No specific route or distance was found from verified sources.</p><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="nearby"><h2>Nearby and similar places</h2><ul class="nearby-links"><li>Takua Pa Old Town Community / Talat Yai (Big Market) <span class="fact-status unknown">Not verified</span> <a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">Read source ↗</a></li><li><a href="/en/places/iron-bridge/">Boon Soong Iron Bridge</a></li><li><a href="/en/places/governor-wall/">Governor’s Residence Wall</a></li><li><a href="/en/places/khun-in/">Khun In House</a></li></ul></section><section class="research-section" id="faq"><h2>FAQ</h2><details><summary>Getting there from Takua Pa Town</summary><p>Located in the Takua Pa old town community on Si Takua Pa Road; use a navigation map to the specified coordinates.</p></details><details><summary>What is the history of this place?</summary><p>The building was constructed in 1922 (2465 BE). The school started requesting to be established as a private school in 1920 (2463 BE) and originally used the name To Beng according to the Hokkien accent.</p></details><details><summary>What are the highlights to see?</summary><p>A historical school building remaining in the old town area. Observe the building shape and corrugated zinc roof identified by conservation agencies. It is evidence of educational management by the Chinese community in the tin mining town of Takua Pa.</p></details></section><section class="research-section" id="sources"><h2>Data Sources</h2><div class="source-table"><table><thead><tr><th>Name</th><th>Type</th><th>Date accessed</th><th>Link</th></tr></thead><tbody><tr><th scope="row">Samnakngan Noyobai lae Phaen Sapphayakon Thammachat lae Singwaetlom (Office of Natural Resources and Environmental Policy and Planning): Rongrian Tao Ming (Tao Ming School) building</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4420" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">ศูนย์มานุษยวิทยาสิรินธร (Princess Maha Chakri Sirindhorn Anthropology Centre): Takua Pa Town</th><td>Other resources</td><td>2026-09-07</td><td><a href="https://wikicommunity.sac.or.th/community/951" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Muang Boran Journal: Takua Pa Old Town and its endless tales</th><td>Blog</td><td>2026-09-07</td><td><a href="https://www.muangboranjournal.com/post/Takuapa_Naver_Ending_Stories" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Readme.me: Hello Phang.Nga</th><td>Blog</td><td>2026-09-07</td><td><a href="https://readme.me/p/51787" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality): Environmental Operation Plan</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">องค์การบริหารส่วนจังหวัดพังงา (Phang Nga Provincial Administrative Organization): Takua Pa Old Town</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://www.phangngapao.go.th/travel/detail/89" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Tourism Authority of Thailand: TAT Media Assets · Tao Ming School</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://tatmediaassets.com/file/1099396" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Thetsaban Mueang Takua Pa (Takua Pa Town Municipality): Tao Ming School Building</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://www.youtube.com/watch?v=qn0Tb1GSiZY" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">YOUPHUKET: Press release for the Old Town Tells Stories event</th><td>News</td><td>2026-09-07</td><td><a href="https://youphuket.club/author/admin/page/58/" target="_blank" rel="noopener">Open source ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>Missing data</summary><ul><li>No building number or postal code found in accessible sources.</li><li>No official opening and closing hours found.</li><li>No admission fee found.</li><li>No official phone number, Facebook page, website, or LINE account found.</li><li>No verified information on parking, restrooms, and accessibility for wheelchairs or the elderly.</li><li>No information on registration as a historical site by the Fine Arts Department.</li><li>No information on individual builders found.</li><li>No festivals held directly at the school found.</li><li>Official image links with specified usage rights are not verified.</li><li>No year of school closure found, nor a list of administrators or teachers.</li><li>No verified evidence of ownership changes or use for other businesses after the school closed.</li><li>No verified evidence that the building was directly affected by the 2004 tsunami.</li><li>No year or documents confirming the specific restoration of the building found.</li><li>No Fine Arts Department announcement directly confirming the registration of the Tao Ming School building as a historical site.</li><li>No opening hours, admission fees, regular caretakers, interior access permissions, parking, restrooms, or wheelchair access found.</li><li>No verified restoration or development projects for the building in 2026 found.</li><li>No old photos with direct file URLs and clear usage rights found.</li><li>Activity news on February 21, 2026, was found on a PR aggregation page, but the main news or official announcement could not be fully read.</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/en/" class="footer-name">Takua Pa <em>101</em></a><p>One city<br>Stories to get to know</p><a class="round-link" href="#main" aria-label="Back to top">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">Created by Baan Siwara, Takua Pa</a><span>Old Town Guide · Phang Nga Province</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">Original Brochure ↗</a></div></footer><nav class="tabbar" aria-label="Quick menu"><a href="/en/"><span class="tb-glyph" aria-hidden="true">⌂</span>Home</a><a href="/en/map/"><span class="tb-glyph" aria-hidden="true">◈</span>Map</a><a href="/en/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>Eat</a><a href="/en/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>Trip<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
