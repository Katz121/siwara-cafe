schema.org", "inLanguage": "en", "@type": "TouristAttraction", "name": "Wat Nikornwararam (Wat Yan Yao)", "url": "https://takuapa101.com/places/wat-nikorn/", "image": "https://takuapa101.com/assets/wat-nikorn.webp", "description": "Documents link the temple with the community and the 2004 tsunami (พ.ศ. 2547).", "address": {"@type": "PostalAddress", "streetAddress": "Yan Yao village, Thanon Phet Kasem", "addressLocality": "Takua Pa", "addressRegion": "Phang Nga", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8691760396, "longitude": 98.348042969}}, {"@context": "https://schema.org", "inLanguage": "en", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How should visitors dress?", "acceptedAnswer": {"@type": "Answer", "text": "Dress respectfully when entering a religious site."}}, {"@type": "Question", "name": "What is the history of this place?", "acceptedAnswer": {"@type": "Answer", "text": "The temple was built in 1793 (พ.ศ. 2336) by Khun Ta Kaew and Khun Ta Ram. It received royal consecration of its ecclesiastical boundary in 1842 (พ.ศ. 2385)."}}, {"@type": "Question", "name": "What is there to see?", "acceptedAnswer": {"@type": "Answer", "text": "Confirmed highlights are its founding in 1793 (พ.ศ. 2336) and royal consecration of its ecclesiastical boundary in 1842 (พ.ศ. 2385). The temple was once used to gather victims’ remains while they awaited identity verification."}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/places/wat-nikorn/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/places/wat-nikorn/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/places/wat-nikorn/"></head><body class="inner-page"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/en/" aria-label="Takua Pa 101 Home"><span class="brand-mark">101</span><span>Takua Pa<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/en/places/" aria-current="page">Places</a><a href="/en/stories/">Stories</a><a href="/en/map/">Map</a><a href="/en/rest/">Eat and explore</a><a href="/en/news/">Updates</a><a href="/en/trip/">Your trip</a><a href="/en/traditions/" class="nav-more">Traditions</a><a href="/en/eat/" class="nav-more">Eat & Souvenirs</a><a href="/en/routes/" class="nav-more">Walking Routes</a><a href="/en/leaflet/" class="nav-more">Leaflet</a><a href="/en/about/" class="nav-more">About</a></nav><div class="header-tools"><a class="lang-switch" href="/places/wat-nikorn/" hreflang="th" lang="th">ไทย</a><a class="lang-switch" href="/en/places/wat-nikorn/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="Open menu"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="Search website (Press Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/en/trip/" aria-label="Your trip"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/en/map/">Open map ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/en/">Home</a> / <a href="/en/places/">Places</a> / Temples & Pagodas</div><header class="place-hero full-place-hero"><div><span class="chapter">Place record · Temples and pagodas</span><h1>Wat Nikornwararam</h1><p class="english">Wat Nikornwararam</p><span class="fact-status confirmed">9 items verified</span><p><a class="text-link" href="#eras">Then · Before · Now ↓</a></p><p class="place-hero-actions"><button class="button" type="button" data-trip-add="wat-nikorn">Add to trip</button><a class="text-link" href="/en/trip/">View your trip</a></p></div><div class="place-hero-art"><img src="/assets/wat-nikorn.webp" alt="Wat Nikornwararam" width="1000" height="726" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>Practical information</h2><dl><div><dt>Location</dt><dd>8.8691760396, 98.348042969 <span class="fact-status unknown">Not verified</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.8691760396,98.348042969" target="_blank" rel="noopener">Navigate with Google Maps ↗</a><a href="https://culturalenvi.onep.go.th/site/detail/4416" target="_blank" rel="noopener">Coordinates source ↗</a></div><div><dt>Opening hours</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Admission fee</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Parking</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Restrooms</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Wheelchair access</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Dress code</dt><dd>Polite dress is recommended when entering the religious site. <span class="fact-status unknown">Not verified</span></dd></div><div><dt>Phone</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Page</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Website</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>LINE</dt><dd><span class="muted">Not verified</span></dd></div><div></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">On this page</span><a href="#visit">Practical information</a><a href="#eras">Then · Before · Now</a><a href="#timeline">Dot timeline</a><a href="#highlights">Highlights to see</a><a href="#news">News and updates</a><a href="#did_you_know">Did you know</a><a href="#getting_there">Getting there</a><a href="#nearby">Nearby and similar places</a><a href="#faq">FAQ</a><a href="#sources">Data Sources</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>Then · Before · Now</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">Then</span><h3>A community temple in early Takua Pa</h3><p class="era-years">1793 to 1842 (พ.ศ. 2336 to 2385)</p><span class="fact-status confirmed">Verified</span><p>Wat Nikon Wararam, or Wat Yan Yao, was initially built in 1793 (2336 BE) by Khun Ta Kaew and Khun Ta Ram. The discovered evidence verifies the year and the names of the founders, but does not provide detailed reasons on what specific mission the temple was established for. Therefore, it should be viewed as a religious site of the local community forming in the Takua Pa basin, rather than tying it to stories without direct evidence.</p><p>The broader picture of Takua Pa town has a history as a port town and tin mining source, with maritime trade and various groups of people. However, no temple-specific evidence has been found to verify the role of Wat Nikon Wararam regarding tin mines, maritime trade, Hokkien Chinese people, or the governor system. Thus, no conclusions are made beyond the data sources.</p><div class="era-sources">References · <a href="https://culturalenvi.onep.go.th/site/detail/4416" target="_blank" rel="noopener">Samnakngan Noyobai lae Phaen Sapphayakon Thammachat lae Singwaetlom (Office of Natural Resources and Environmental Policy and Planning) · Conserved Cultural Environment Sites</a> · <a href="https://anyflip.com/vlkdm/ecrk/basic" target="_blank" rel="noopener">Takola in the past... Takua Pa in the present</a></div></article><article class="era-card" data-era="before"><span class="chapter">Before</span><h3>From an ancient temple to a tsunami memorial and land management</h3><p class="era-years">1842 to 2022 (พ.ศ. 2385 to 2565)</p><span class="fact-status confirmed">Verified</span><p>The temple received the royal granting of the land for a temple in 1842 (2385 BE), which is a crucial piece of evidence that the religious site was certified as an area for monastic activities according to the Sangha's tradition at the time. However, no documents have been found specifying major restorations, changes in ownership, or periods of abandonment.</p><p>After the tsunami on December 26, 2004 (2547 BE), the temple was used as a gathering place for the bodies of disaster victims awaiting forensic identification. This temporary role made Wat Yan Yao a part of Takua Pa's disaster response history. Later, on October 30, 2022 (2565 BE), the Samnakngan Phraphutthasatsana Changwat Phangnga (Phang Nga Provincial Office of Buddhism) participated in handing over the land title deed document to the abbot, serving as evidence of land ownership management in the modern era.</p><div class="era-sources">References · <a href="https://culturalenvi.onep.go.th/site/detail/4416" target="_blank" rel="noopener">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (Office of Natural Resources and Environmental Policy and Planning)</a> · <a href="https://pna.onab.go.th/th/content/page/index/id/34431" target="_blank" rel="noopener">Samnakngan Phraphutthasatsana Changwat Phangnga (Phang Nga Provincial Office of Buddhism) · Handing over land title deed document</a> · <a href="https://www.cifs.go.th/Files/news/file/ff82ea76-112f-4392-a8ff-e485e9fbc04e.pdf" target="_blank" rel="noopener">Sathaban Niti Witthayasat (Central Institute of Forensic Science) · Event record on December 28, 2004 (2547 BE)</a></div></article><article class="era-card" data-era="now"><span class="chapter">Now</span><h3>A temple still serving as a centre for faith and public works</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">Verified</span><p>The latest discovered evidence verifies that the temple is still in use, with Phra Khru Nikon Thammasophit as the abbot, and has monks in residence during the Buddhist Lent. The temple database indicates the organization of the united Kathina ceremony in 2024 (2567 BE) and 2025 (2568 BE), while government/local news verifies the temple's participation in district and provincial level activities.</p><p>In recent years, the temple has been both a space for religious activities and a public space: in 2024 (2567 BE) it was used as a donation center to help northern flood victims, and there was an inspection visit for the Temple, People, State, Creating Happiness project as a southern regional model temple. However, no data has been found verifying the opening and closing hours for tourists, detailed building conditions, or temple-specific restoration projects in 2026 (2569 BE).</p><div class="era-sources">References · <a href="https://pna.onab.go.th/th/content/page/index/id/34431" target="_blank" rel="noopener">สำนักงานพระพุทธศาสนาจังหวัดพังงา (Phang Nga Provincial Office of Buddhism)</a> · <a href="https://www.dmc.tv/wat/13166" target="_blank" rel="noopener">DMC · 10,000 Temples United Kathina Project across Thailand</a> · <a href="https://archive.siamrath.co.th/n/568331" target="_blank" rel="noopener">Siam Rath · Donation center to help flood victims</a> · <a href="https://www.ride-explorer.com/?p=7378" target="_blank" rel="noopener">Ride Explorer · Model temple inspection visit</a> · <a href="https://www.topnews.co.th/news/1546452" target="_blank" rel="noopener">TOPNEWS · Preserving Takua Pa old town Songkran festival</a></div></article></div></section><section class="research-section" id="timeline"><h2>Dot timeline</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status confirmed">Verified</span><p class="era-years">1793 (2336 BE)</p><h3>Beginning of temple construction</h3><p>Khun Ta Kaeo and Khun Ta Ram built Wat Nikornwararam.</p><a href="https://culturalenvi.onep.go.th/site/detail/4416" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">1842 (2385 BE)</p><h3>Received Wisungkhammasima</h3><p>The temple was granted Wisungkhammasima.</p><a href="https://culturalenvi.onep.go.th/site/detail/4416" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">December 26, 2004 (2547 BE)</p><h3>Post tsunami memorial area</h3><p>Used to gather bodies of victims waiting for identity verification.</p><a href="https://www.cifs.go.th/Files/news/file/ff82ea76-112f-4392-a8ff-e485e9fbc04e.pdf" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">October 30, 2022 (2565 BE)</p><h3>Received land title deed documents</h3><p>The Phang Nga Provincial Office of Buddhism and the Land Office handed over the title deed documents to the abbot.</p><a href="https://pna.onab.go.th/th/content/page/index/id/34431" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">September 22, 2024 (2567 BE)</p><h3>Donation center for northern floods</h3><p>The temple, together with the monastic community and the people of Takua Pa, collected items to help flood victims.</p><a href="https://archive.siamrath.co.th/n/568331" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">2025 (2568 BE)</p><h3>Participated in Takua Pa old town Songkran event</h3><p>The abbot and monks of Wat Nikornwararam participated in the alms offering activity organized by the province.</p><a href="https://www.topnews.co.th/news/1546452" target="_blank" rel="noopener">Read source ↗</a></li></ol></section><p class="missing-photo">No image authorized for publication yet</p><section class="research-section" id="highlights"><h2>Highlights to see</h2><div class="research-cards"><article class="research-note"><h3>An ancient temple of the Yan Yao community</h3><span class="fact-status unknown">Not verified</span><p>Confirmed highlights include its establishment in 1793 CE (2336 BE) and receiving its royal boundary in 1842 CE.</p><a href="https://culturalenvi.onep.go.th/site/detail/4416" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>A space of tsunami memory</h3><span class="fact-status unknown">Not verified</span><p>The temple was used to gather the bodies of tsunami victims awaiting identification.</p><a href="https://culturalenvi.onep.go.th/site/detail/4416" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="news"><h2>News and updates</h2><div class="research-cards"><article class="research-note"><p class="muted">2025-04-13 · TOPNEWS</p><h3>Phang Nga continues Songkran traditions with alms offering in Takua Pa old town</h3><p>Phra Khru Nikorn Thammasophit and monks from Wat Nikornwararam participated in provincial activities.</p><a href="https://www.topnews.co.th/news/1546452" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><p class="muted">2025-01-01 · Ride Explorer</p><h3>Inspection of the Temple, Public, State, Creating Happiness project</h3><p>Wat Nikornwararam was mentioned as a temple ready for southern regional assessment.</p><a href="https://www.ride-explorer.com/?p=7378" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><p class="muted">2024-09-22 · Siam Rath</p><h3>Phang Nga monks unite to help flood victims in the north</h3><p>The temple set up a donation center for items together with the monastic community and the public.</p><a href="https://archive.siamrath.co.th/n/568331" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><p class="muted">2022-10-30 · Samnakngan Phraphutthasatsana Changwat Phangnga (Phang Nga Provincial Office of Buddhism)</p><h3>Phang Nga Provincial Office of Buddhism joins in handing over the land title deed documents of Wat Nikornwararam</h3><p>Handing over the land title deed documents to Phra Khru Nikorn Thammasophit, the abbot of Wat Nikornwararam.</p><a href="https://pna.onab.go.th/th/content/page/index/id/34431" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>Did you know</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">Verified</span><p>Wat Yan Yao was used as a gathering place for the bodies of 2004 CE tsunami victims awaiting identification.</p><a href="https://culturalenvi.onep.go.th/site/detail/4416" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><span class="fact-status confirmed">Verified</span><p>In 2024 CE, the temple served as a donation centre to help flood victims in the North.</p><a href="https://archive.siamrath.co.th/n/568331" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>Getting there</h2><div class="research-cards"><article class="research-note"><h3>Takua Pa Town</h3><span class="fact-status unknown">Not verified</span><p>No verified route recommendations were found from the available sources.</p></article><article class="research-note"><h3>Phuket</h3><span class="fact-status unknown">Not verified</span><p>No verified route recommendations were found from the available sources.</p></article><article class="research-note"><h3>Khao Lak</h3><span class="fact-status unknown">Not verified</span><p>No verified route recommendations were found from the available sources.</p></article><article class="research-note"><h3>Airport</h3><span class="fact-status unknown">Not verified</span><p>No verified route recommendations were found from the available sources.</p></article></div></section><section class="research-section" id="nearby"><h2>Nearby and similar places</h2><ul class="nearby-links"><li>Takua Pa Riverside Market, Yan Yao Walking Street <span class="fact-status unknown">Not verified</span> <a href="https://www.youtube.com/watch?v=ZeycJnHU_Nw" target="_blank" rel="noopener">Read source ↗</a></li><li><a href="/en/places/wat-boromthat/">Wat Boromthat Khiri Khet (the town's relic temple)</a></li><li><a href="/en/places/wat-khuha/">Wat Khuha Phimuk (the cave hill temple)</a></li><li><a href="/en/places/wat-pathum/">Wat Pathum Thara (the front town temple)</a></li><li><a href="/en/places/wat-kongkha/">Wat Kongkha Phimuk (the riverside temple)</a></li><li><a href="/en/places/wat-sena/">Wat Sena Nuch Rangsan</a></li></ul></section><section class="research-section" id="faq"><h2>FAQ</h2><details><summary>How to dress</summary><p>Polite dress is recommended when entering the religious site.</p></details><details><summary>What is the history of this place?</summary><p>The temple was built in 1793 (2336 BE) by Khun Ta Kaew and Khun Ta Ram. The temple received the royal granting of the land for a temple in 1842 (2385 BE).</p></details><details><summary>What are the highlights to see?</summary><p>Verified highlights are its founding history in 1793 (2336 BE) and receiving the royal granting of the land for a temple in 1842 (2385 BE). The temple was used to gather bodies of disaster victims awaiting forensic identification.</p></details></section><section class="research-section" id="sources"><h2>Data Sources</h2><div class="source-table"><table><thead><tr>