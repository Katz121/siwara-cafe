e.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/places/wat-boromthat/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/places/wat-boromthat/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/places/wat-boromthat/"></head><body class="inner-page"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/en/" aria-label="Takua Pa 101 Home"><span class="brand-mark">101</span><span>Takua Pa<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/en/places/" aria-current="page">Places</a><a href="/en/stories/">Stories</a><a href="/en/map/">Map</a><a href="/en/rest/">Eat and explore</a><a href="/en/news/">Updates</a><a href="/en/trip/">Your trip</a><a href="/en/traditions/" class="nav-more">Traditions</a><a href="/en/eat/" class="nav-more">Eat & Souvenirs</a><a href="/en/routes/" class="nav-more">Walking Routes</a><a href="/en/leaflet/" class="nav-more">Leaflet</a><a href="/en/about/" class="nav-more">About</a></nav><div class="header-tools"><a class="lang-switch" href="/places/wat-boromthat/" hreflang="th" lang="th">ไทย</a><a class="lang-switch" href="/en/places/wat-boromthat/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="Open menu"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="Search website (Press Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/en/trip/" aria-label="Your trip"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/en/map/">Open map ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/en/">Home</a> / <a href="/en/places/">Places</a> / Temples & Pagodas</div><header class="place-hero full-place-hero"><div><span class="chapter">Place record · Temples and pagodas</span><h1>Wat Boromthat Khiri Khet (the town's relic temple)</h1><p class="english">Wat Boromthat Khiri Khet</p><span class="fact-status confirmed">8 items verified</span><p><a class="text-link" href="#eras">Then · Before · Now ↓</a></p><p class="place-hero-actions"><button class="button" type="button" data-trip-add="wat-boromthat">Add to trip</button><a class="text-link" href="/en/trip/">View your trip</a></p></div><div class="place-hero-art"><img src="/assets/wat-boromthat.webp" alt="Wat Boromthat Khiri Khet (the town&#x27;s relic temple)" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>Practical information</h2><dl><div><dt>Location</dt><dd>8.8336680169, 98.3563150443 <span class="fact-status unknown">Not verified</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.8336680169,98.3563150443" target="_blank" rel="noopener">Navigate with Google Maps ↗</a><a href="https://culturalenvi.onep.go.th/site/detail/4413" target="_blank" rel="noopener">Coordinates source ↗</a></div><div><dt>Opening hours</dt><dd>Every day 08:00 to 17:00 <span class="fact-status unverified">Not verified</span></dd></div><div><dt>Admission fee</dt><dd>No admission fee <span class="fact-status unverified">Not verified</span></dd></div><div><dt>Parking</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Restrooms</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Wheelchair access</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Dress code</dt><dd>Dress modestly when visiting religious sites <span class="fact-status unknown">Not verified</span></dd></div><div><dt>Phone</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Page</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Website</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>LINE</dt><dd><span class="muted">Not verified</span></dd></div><div><a href="https://www.lovethailand.org/travel/th/68-%E0%B8%9E%E0%B8%B1%E0%B8%87%E0%B8%87%E0%B8%B2/7959-%E0%B8%A7%E0%B8%B1%E0%B8%94%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%98%E0%B8%B2%E0%B8%95%E0%B8%B8%E0%B8%84%E0%B8%B5%E0%B8%A3%E0%B8%B5%E0%B9%80%E0%B8%82%E0%B8%95-%28%E0%B8%A7%E0%B8%B1%E0%B8%94%E0%B8%A5%E0%B8%B8%E0%B9%88%E0%B8%A1%29.html" target="_blank" rel="noopener">Visitor information sources ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">On this page</span><a href="#visit">Practical information</a><a href="#eras">Then · Before · Now</a><a href="#timeline">Dot timeline</a><a href="#highlights">Highlights to see</a><a href="#news">News and updates</a><a href="#did_you_know">Did you know</a><a href="#getting_there">Getting there</a><a href="#nearby">Nearby and similar places</a><a href="#faq">FAQ</a><a href="#sources">Data Sources</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>Then · Before · Now</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">Then</span><h3>From a forest monks' retreat to a town's sanctuary</h3><p class="era-years">About 200 years ago; temple registered in 1893 (2436 BE)</p><span class="fact-status confirmed">Verified</span><p>Evidence from the Samnakngan Noyobai Lae Phaen Sapphayakon Thammachat Lae Singwaetlom (Office of Natural Resources and Environmental Policy and Planning) states that the beginning of Wat Khiri Khet was a residence for forest monks used for ascetical practices, and it was about 200 years old when the database was created. Thus, a more exact year of construction should not yet be concluded. The name "Wat Lum" used by villagers reflects the low-lying terrain of the temple in the old market area.</p><p>Another set of local information sources states that the temple was built or registered on 15 May 1893 (2436 BE) and later used the name Wat Phra That Khiri Khet under the Maha Nikaya sect. Inside, there is an ancient pagoda base with a large banyan tree growing on the base, and there are Buddha relics serving as a center of faith.</p><p>In the picture of Takua Pa town during the tin mining and maritime trade era, the temple was located near the old market and the community where Hokkien Chinese and groups of miners came to settle. However, verifiable sources do not state whether this temple was built by a town ruler or any specific person, and no direct evidence connecting the builder to any Chinese group has been found. Therefore, it can be told cautiously that the temple served as a religious site and a spiritual anchor for the old town community, rather than guessing its founder.</p><div class="era-sources">References · <a href="https://culturalenvi.onep.go.th/site/detail/4413" target="_blank" rel="noopener">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (Office of Natural Resources and Environmental Policy and Planning)</a> · <a href="https://andaman365.blogspot.com/2015/09/blog-post_21.html" target="_blank" rel="noopener">Andaman365 / Phangnga Channel</a> · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality)</a></div></article><article class="era-card" data-era="before"><span class="chapter">Before</span><h3>An old temple tied to the memories of the old town</h3><p class="era-years">1919 to 2020 (B.E. 2462 to 2563); the year of some events is still unknown</p><span class="fact-status confirmed">Verified</span><p>A verifiable milestone is that the temple received the royal granting of the land for the consecration boundary on 25 August 1919 (2462 BE), showing that the temple had stepped from a former practice area to a temple with a clear ecclesiastical status. Meanwhile, the community still called the temple "Wat Lum" or "Wat Talat Tai".</p><p>Along the way, the replica of the Buddha's footprint, built by laywoman Kui Limsakun and the Takua Pa Buddhist congregation, was once enshrined on Khao Phra Bat before being moved to be kept at Wat Senanut Rangsan, and then moved to be enshrined in the ordination hall of Wat Phra That Khiri Khet according to local data. This also made the temple serve as a keeper of the town's symbols of faith.</p><p>Municipal documents during 2020 (2563 BE) recorded that the temple had an ancient ordination hall alongside the new one, housing a replica of the Buddha's footprint, Pho Than Kaen Rak, and a jade Buddha statue. Additionally, there was the construction of the royal relic pagoda on Phra Bat mountain and the holding of a royal relic procession tradition on Makha Bucha Day. However, evidence confirming the years of each restoration, abandonment, archaeological site registration, or damage from the 2004 (2547 BE) tsunami has not yet been found.</p><div class="era-sources">References · <a href="https://andaman365.blogspot.com/2015/09/blog-post_21.html" target="_blank" rel="noopener">Andaman365 / Phangnga Channel</a> · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality)</a> · <a href="https://culturalenvi.onep.go.th/site/detail/4413" target="_blank" rel="noopener">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (Office of Natural Resources and Environmental Policy and Planning)</a></div></article><article class="era-card" data-era="now"><span class="chapter">Now</span><h3>Wat Lum remains a living temple of the old town</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">Verified</span><p>The latest verifiable information shows that Wat Phrathat Khiri Khet is still a private Maha Nikaya temple and is listed among the religious sites of Thesaban Mueang Takua Pa (Takua Pa Town Municipality). Today, people still come to pay respects to the Buddha relics, the replica of the Buddha's footprint, Pho Than Kaen Rak, and the jade Buddha image, with both the old and new ordination halls coexisting in the area.</p><p>A contemporary activity with confirmed news is the 'Makha Bucha, Bowing the Heart to the Holy Relics' ceremony on 12 February 2025 (2568 BE). The holy relics were placed on a royal chariot, paraded around Takua Pa old town, and circumambulated around the vihara three times. This event reflects that the temple remains a center of faith and community activity, not just an old building.</p><p>No official announcements for 2026 have yet been found confirming opening hours, admission fees, individual caretakers, the latest structural condition, or temple-specific restoration projects. Therefore, visitors should check with the temple or municipality before traveling.</p><div class="era-sources">References · <a href="https://www.thaipost.net/district-news/738702/" target="_blank" rel="noopener">Thai Post</a> · <a href="https://www.buddhaparisa.org/temple/23006/" target="_blank" rel="noopener">พุทธบริษัท ฐานข้อมูลวัดไทย (Buddhaparisa Thai Temple Database)</a> · <a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality)</a></div></article></div></section><section class="research-section" id="timeline"><h2>Dot timeline</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status unverified">Not verified</span><p class="era-years">15 May 1893</p><h3>Temple Appears in Construction/Registration Records</h3><p>Local sources indicate 15 May 1893 (2436 BE) and the use of the name Wat Phrathat Khiri Khet.</p><a href="https://andaman365.blogspot.com/2015/09/blog-post_21.html" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status unverified">Not verified</span><p class="era-years">25 August 1919</p><h3>Granted Royal Boundary</h3><p>Local sources indicate the temple was granted a royal boundary (Wisungkhammasima) and is affiliated with the Maha Nikaya sect.</p><a href="https://andaman365.blogspot.com/2015/09/blog-post_21.html" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">2020 (2563 BE)</p><h3>Recorded in the Old Town Plan</h3><p>The municipality recorded the old ordination hall, the new one, the replica footprint, Pho Than Kaen Rak, the jade Buddha image, and the relic procession tradition.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">12 February 2025</p><h3>Makha Bucha Relic Procession Around the Old Town</h3><p>A royal chariot procession carrying the sacred relics takes place around Takua Pa old town, along with a ceremony of circling the vihara three times.</p><a href="https://www.thaipost.net/district-news/738702/" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">Year unspecified</p><h3>Started as a Monastic Residence for Forest Monks</h3><p>Originally a residence for forest-dwelling monks to practice asceticism, dating back approximately 200 years according to official databases.</p><a href="https://culturalenvi.onep.go.th/site/detail/4413" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status unverified">Not verified</span><p class="era-years">Year unspecified</p><h3>Replica Buddha Footprint Moved to the Temple</h3><p>The replica footprint was once on Khao Phra Bat (Phra Bat Hill), moved to Wat Senanuch Rangsan, and finally enshrined in the ordination hall of Wat Phrathat Khiri Khet.</p><a href="https://andaman365.blogspot.com/2015/09/blog-post_21.html" target="_blank" rel="noopener">Read source ↗</a></li></ol></section><p class="missing-photo">No image authorized for publication yet</p><section class="research-section" id="highlights"><h2>Highlights to see</h2><div class="research-cards"><article class="research-note"><h3>Ancient pagoda base and banyan tree</h3><span class="fact-status unknown">Not verified</span><p>An ancient pagoda base with a large banyan tree growing on it.</p><a href="https://culturalenvi.onep.go.th/site/detail/4413" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Buddha relics</h3><span class="fact-status unknown">Not verified</span><p>A major center of faith for the community, according to municipal data.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Replica of the Buddha's footprint</h3><span class="fact-status unknown">Not verified</span><p>Housed inside the temple.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Pho Than Kaen Rak</h3><span class="fact-status unknown">Not verified</span><p>A sacred figure noted by the municipality as a spot for worship within the temple.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Jade Buddha statue</h3><span class="fact-status unknown">Not verified</span><p>Located behind the main Buddha image, according to municipal documents.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="news"><h2>News and updates</h2><div class="research-cards"><article class="research-note"><p class="muted">2025-02-12 · Thai Post</p><h3>Phang Nga invited &#x27;Phra Si Borommathat&#x27; onto a royal chariot for a procession around Takua Pa old town</h3><p>The 2025 (2568 BE) Makha Bucha event was held at Wat Phrathat Khiri Khet, featuring a procession around the old town and circling the vihara.</p><a href="https://www.thaipost.net/district-news/738702/" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>Did you know</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">Verified</span><p>The name 'Wat Lum' comes from the temple's low-lying terrain, not from its original official name, which is consistently used across all sources.</p><a href="https://culturalenvi.onep.go.th/site/detail/4413" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><span class="fact-status confirmed">Verified</span><p>The ancient pagoda base with a large banyan tree growing on it is a prominent feature recorded by the cultural environment database.</p><a href="https://culturalenvi.onep.go.th/site/detail/4413" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>Getting there</h2><div class="research-cards"><article class="research-note"><h3>Takua Pa Town</h3><span class="fact-status unknown">Not verified</span><p>Head towards Takua Pa old town, then enter Klan Kaeo Road / Khiri Khet Alley.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Phuket</h3><span class="fact-status unknown">Not verified</span><p>Travel to Takua Pa district first, then take a local vehicle or car into the old town area.</p><a href="https://www.lovethailand.org/travel/th/68-%E0%B8%9E%E0%B8%B1%E0%B8%87%E0%B8%87%E0%B8%B2/7959-%E0%B8%A7%E0%B8%B1%E0%B8%94%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%98%E0%B8%B2%E0%B8%95%E0%B8%B8%E0%B8%84%E0%B8%B5%E0%B8%A3%E0%B8%B5%E0%B9%80%E0%B8%82%E0%B8%95-%28%E0%B8%A7%E0%B8%B1%E0%B8%94%E0%B8%A5%E0%B8%B8%E0%B9%88%E0%B8%A1%29.html" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Khao Lak</h3><span class="fact-status unknown">Not verified</span><p>Specific distances or routes are not verified from the read sources.</p><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="nearby"><h2>Nearby and similar places</h2><ul class="nearby-links"><li><a href="/en/places/wat-khuha/">Wat Khuha Phimuk (the cave hill temple)</a></li><li><a href="/en/places/wat-pathum/">Wat Pathum Thara (the front town temple)</a></li><li><a href="/en/places/wat-kongkha/">Wat Kongkha Phimuk (the riverside temple)</a></li><li><a href="/en/places/wat-nikorn/">Wat Nikornwararam</a></li><li><a href="/en/places/wat-sena/">Wat Sena Nuch Rangsan</a></li></ul></section><section class="research-section" id="faq"><h2>FAQ</h2><details><summary>Opening hours</summary><p>Not verified · Daily, 08:00 to 17:00</p></details><details><summary>Admission fee</summary><p>Not verified · Free admission</p></details><details><summary>How to dress</summary><p>Dress modestly when visiting religious sites</p></details><details><summary>Getting there from Takua Pa Town</summary><p>Head towards Takua Pa old town, then enter Klan Kaeo Road / Khiri Khet Alley.</p></details><details><summary>What is the history of this place?</summary><p>Originally a forest monastery residence, it is about 200 years old. Locals call it 'Wat Lum' because it is located in a low-lying area.</p></details><details><summary>What are the highlights to see?</summary><p>An ancient pagoda base with a large banyan tree growing on it. It is an important center of faith for the community according to municipality data. It is enshrined within the temple.</p></details></section><section class="research-section" id="sources"><h2>Data Sources</h2><div class="source-table"><table><thead><tr><th>Name</th><th>Type</th><th>Date accessed</th><th>Link</th></tr></thead><tbody><tr><th scope="row">Samnakngan Nayobai Lae Phaen Sapphayakon Thammachat Lae Singwaetlom (Office of Natural Resources and Environmental Policy and Planning): Art sites worthy of conservation</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4413" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality): Environmental Operation Plan</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Visit Andaman Local: Takuapa destinations</th><td>Blog</td><td>2026-09-07</td><td><a href="https://visitandamanlocal.com/provinces/destinations/detail.php?id=95" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Love Thailand: Wat Phrathat Khiri Khet (Wat Lum)</th><td>Blog</td><td>2026-09-07</td><td><a href="https://www.lovethailand.org/travel/th/68-%E0%B8%9E%E0%B8%B1%E0%B8%87%E0%B8%87%E0%B8%B2/7959-%E0%B8%A7%E0%B8%B1%E0%B8%94%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%98%E0%B8%B2%E0%B8%95%E0%B8%B8%E0%B8%84%E0%B8%B5%E0%B8%A3%E0%B8%B5%E0%B9%80%E0%B8%82%E0%B8%95-%28%E0%B8%A7%E0%B8%Bัด%E0%B8%A5%E0%B8%B8%E0%B9%88%E0%B8%A1%29.html" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (Office of Natural Resources and Environmental Policy and Planning)</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4413" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality) Environmental Operation Plan</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_formdoc/2021-08_35dfd0d7b952500.pdf" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Thai Post</th><td>News</td><td>2026-09-07</td><td><a href="https://www.thaipost.net/district-news/738702/" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Andaman365 / Phangnga Channel</th><td>Blog</td><td>2026-09-07</td><td><a href="https://andaman365.blogspot.com/2015/09/blog-post_21.html" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">พุทธบริษัท ฐานข้อมูลวัดไทย (Buddhaparisa Thai Temple Database)</th><td>Blog</td><td>2026-09-07</td><td><a href="https://www.buddhaparisa.org/temple/23006/" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Patrick Le Petit photo album</th><td>Blog</td><td>2026-09-07</td><td><a href="https://patricklepetit.jalbum.net/PHANG%20NGA/PHOTOS/TAKUA%20PA/Takua%20Pa%20Old%20Town/Phratat%20Khiri%20Ket%20Chedi/indexb.html" target="_blank" rel="noopener">Open source ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>Missing data</summary><ul><li>Phone numbers, Facebook pages, websites, or LINE accounts confirmed to belong to the temple are not verified.</li><li>The exact builder and founding year are not verified.</li><li>Direct evidence of the temple's role during the tin mining era is not verified.</li><li>Registration as a historical site for this specific temple is not verified; municipal documents only mention the registration of other temples.</li><li>Parking, restrooms, and wheelchair accessibility are not verified.</li><li>Reliable distances from Phuket, Khao Lak, the airport, or Takua Pa town are not verified.</li><li>Official image links with specified usage rights are not verified.</li><li>The exact year of construction and the name of the builder are not verified.</li><li>Direct evidence regarding ownership changes or periods of abandonment is not verified.</li><li>The years and details of individual renovations are not verified.</li><li>Evidence that the temple was affected by the 2004 tsunami is not verified.</li><li>A Fine Arts Department announcement confirming the temple's registration as a historical site is not verified.</li><li>Announcements or renovation projects specifically mentioning the temple in 2026 are not verified.</li><li>Old photographs with verifiable sources and rights are not verified.</li><li>Current opening hours, admission fees, and caretakers are not directly verified by the temple or municipality.</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/en/" class="footer-name">Takua Pa <em>101</em></a><p>One city<br>Stories to get to know</p><a class="round-link" href="#main" aria-label="Back to top">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">Created by Baan Siwara, Takua Pa</a><span>Old Town Guide · Phang Nga Province</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">Original Brochure ↗</a></div></footer><nav class="tabbar" aria-label="Quick menu"><a href="/en/"><span class="tb-glyph" aria-hidden="true">⌂</span>Home</a><a href="/en/map/"><span class="tb-glyph" aria-hidden="true">◈</span>Map</a><a href="/en/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>Eat</a><a href="/en/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>Trip<span clas