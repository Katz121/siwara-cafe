   "[{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"หน้าแรก\", \"item\": \"https://takuapa101.com/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"พักเบรกระหว่างเดินเมืองเก่า\", \"item\": \"https://takuapa101.com/rest/\"}]}, {\"@context\": \"https://schema.org\", \"@type\": \"ItemList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"item\": {\"@type\": \"Place\", \"name\": \"BAAN LAPP บ้านลัพพ์ (โฮมมี่ & สเต๊ก ตะกั่วป่า)\", \"url\": \"https://maps.google.com/?q=Baan%20Lapp%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2\"}}, {\"@type\": \"ListItem\", \"position\": 2, \"item\": {\"@type\": \"Place\", \"name\": \"ขนมจีนหมูสะเต๊ะครูแอ๋ว (ทุ่งพระโพธิ์)\", \"url\": \"https://maps.google.com/?q=%E0%B8%AB%E0%B8%A1%E0%B8%B9%E0%B8%AA%E0%B8%B0%E0%B9%80%E0%B8%95%E0%B9%8A%E0%B8%B0%E0%B8%84%E0%B8%A3%E0%B8%B9%E0%B9%81%E0%B8%AD%E0%B9%8B%E0%B8%A7\"}}, {\"@type\": \"ListItem\", \"position\": 3, \"item\": {\"@type\": \"Place\", \"name\": \"บะหมี่พังงา ตลาดขวาง\", \"url\": \"https://maps.google.com/?q=%E0%B8%9A%E0%B8%B0%E0%B8%AB%E0%B8%A1%E0%B8%B5%E0%B9%88%E0%B8%95%E0%B8%A5%E0%B8%B2%E0%B8%94%E0%B8%82%E0%B8%A7%E0%B8%B2%E0%B8%87\"}}, {\"@type\": \"ListItem\", \"position\": 4, \"item\": {\"@type\": \"Place\", \"name\": \"ป้าดา หมี่ฮกเกี้ยน (ถนนศรีตะกั่วป่า)\", \"url\": \"https://maps.google.com/?q=%E0%B8%9B%E0%B9%89%E0%B8%B2%E0%B8%94%E0%B8%B2%E0%B8%AB%E0%B8%A1%E0%B8%B5%E0%B9%88%E0%B8%AE%E0%B8%81%E0%B9%80%E0%B8%81%E0%B8%B5%E0%B9%89%E0%B8%A2%E0%B8%99\"}}, {\"@type\": \"ListItem\", \"position\": 5, \"item\": {\"@type\": \"Place\", \"name\": \"ร้านบังดีน ข้าวหมกไก่ & โรตีแกง (Michelin Guide)\", \"url\": \"https://maps.google.com/?q=%E0%B8%A3%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%9A%E0%B8%B1%E0%B8%87%E0%B8%94%E0%B8%B5%E0%B8%99%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2\"}}, {\"@type\": \"ListI