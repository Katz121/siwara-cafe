", "position": 20, "url": "https://takuapa101.com/places/rong-jae/"}, {"@type": "ListItem", "position": 21, "url": "https://takuapa101.com/places/governor-wall/"}, {"@type": "ListItem", "position": 22, "url": "https://takuapa101.com/places/phra-narai/"}, {"@type": "ListItem", "position": 23, "url": "https://takuapa101.com/places/riverwalk/"}, {"@type": "ListItem", "position": 24, "url": "https://takuapa101.com/places/culture-street/"}, {"@type": "ListItem", "position": 25, "url": "https://takuapa101.com/places/food-center/"}, {"@type": "ListItem", "position": 26, "url": "https://takuapa101.com/traditions/new-year-alms/"}, {"@type": "ListItem", "position": 27, "url": "https://takuapa101.com/traditions/ruler-ceremony/"}, {"@type": "ListItem", "position": 28, "url": "https://takuapa101.com/traditions/relic-procession/"}, {"@type": "ListItem", "position": 29, "url": "https://takuapa101.com/traditions/narai-ceremony/"}, {"@type": "ListItem", "position": 30, "url": "https://takuapa101.com/traditions/vegetarian/"}, {"@type": "ListItem", "position": 31, "url": "https://takuapa101.com/traditions/chak-phra/"}, {"@type": "ListItem", "position": 32, "url": "https://takuapa101.com/traditions/loy-krathong/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/"></head><body class="home"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/en/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">101</span><span>Takua Pa<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/en/places/">Places</a><a href="/en/stories/">Stories</a><a href="/en/map/">Map</a><a href="/en/rest/">Eat and explore</a><a href="/en/news/">Updates</a><a href="/en/trip/">Your trip</a><a href="/en/traditions/" class="nav-more">Traditions</a><a href="/en/eat/" class="nav-more">Eat & Souvenirs</a><a href="/en/routes/" class="nav-more">Walking Routes</a><a href="/en/leaflet/" class="nav-more">Leaflet</a><a href="/en/about/" class="nav-more">About</a></nav><div class="header-tools"><a class="lang-switch" href="/" hreflang="th" lang="th">ไทย</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/en/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/en/map/">Open map ↗</a></div></header><main id="main"><section class="hero"><div class="hero-topline"><span>PHANG NGA, THAILAND</span><span>Stories of the City / Issue 1</span></div><div class="hero-layout"><div class="hero-copy"><span class="hero-eyebrow"><i></i> An old town guide that invites you to walk slowly</span><h1>Takua Pa<span class="hero-title-bottom">A storytelling city<em>101</em></span></h1><p>Through shrine doors, looking at old house windows<br>And know the city a bit more at every stop</p><div class="hero-actions"><a class="button" href="#places">Choose your destination<span aria-hidden="true">↗</span></a><a class="text-link" href="/en/map/">Open map ↗</a></div><div class="hero-footnote"><span class="tiny-star" aria-hidden="true">✳</span><span>20 Places · 7 Traditions · 59 Shops<br>Compiled from Takua Pa municipal brochure</span></div></div><div class="hero-collage"><div class="collage-ring" aria-hidden="true"></div><span class="stamp">TAKUA PA<br><strong>Takua Pa</strong><br>OLD TOWN</span><a class="postcard postcard-main" href="/en/places/tao-ming/"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" width="1000" height="667" loading="eager"><span><b>01 / Old buildings</b> Tao Ming School ↗</span></a><a class="postcard postcard-left" href="/en/places/guan-yu/"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="eager"><span>Community faith ↗</span></a><a class="postcard postcard-right" href="/en/places/khun-in/"><img src="/assets/khun-in.webp" alt="บ้านขุนอินทร์" width="1000" height="1000" loading="eager"><span>A window into the past ↗</span></a><span class="collage-note">Collect stories along the way</span><span class="collage-spark" aria-hidden="true">✳</span></div></div><div class="hero-bottom"><span>Temples & Pagodas</span><i>✳</i><span>Shrine</span><i>✳</i><span>Old house</span><i>✳</i><span>Riverside market</span><a href="#start">Start reading ↓</a></div></section><nav class="quick-start" aria-label="เริ่มต้นใช้งาน"><h2 class="visually-hidden">Start Here</h2><a class="quick-card" href="/en/map/" data-qs="map"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>Open Map</b><small>See what is where</small></span></a><a class="quick-card" href="/en/places/" data-qs="places"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>Where to go</b><small>20 places in the old town</small></span></a><a class="quick-card" href="/en/eat/" data-qs="eat"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>What to eat</b><small>60 shops in the area</small></span></a><a class="quick-card" href="/en/trip/" data-qs="trip"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>Plan my trip</b><small>Save places and follow the route</small></span><span class="qs-badge" data-trip-count hidden>0</span></a></nav><section id="start" class="section"><div class="section-heading"><div><span class="chapter">01 / Read the town</span><h2>Start from your interests</h2></div><p>Three routes to read the city · Choose stops in your own way</p></div><div class="route-cards"><a class="route-card" href="/en/routes/#route-1"><div class="route-art"><img src="/assets/wat-boromthat.webp" alt="วัดบรมธาตุคีรีเขต (วัดลุ่ม)" width="1000" height="1000" loading="lazy"><span class="route-no">01</span></div><div class="route-copy"><span class="eyebrow">Read the city through faith</span><h3>Temples and Pagodas Route</h3><span class="route-footer">6 destinations <span aria-hidden="true">↗</span></span></div></a><a class="route-card" href="/en/routes/#route-2"><div class="route-art"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="lazy"><span class="route-no">02</span></div><div class="route-copy"><span class="eyebrow">Look at the story of the Chinese community</span><h3>Shrines and Vegetarian Halls Route</h3><span class="route-footer">4 destinations <span aria-hidden="true">↗</span></span></div></a><a class="route-card" href="/en/routes/#route-3"><div class="route-art"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" width="1000" height="667" loading="lazy"><span class="route-no">03</span></div><div class="route-copy"><span class="eyebrow">Trace buildings, trade, and people</span><h3>Old Buildings and Riverside Market Route</h3><span class="route-footer">6 destinations <span aria-hidden="true">↗</span></span></div></a><a class="route-card" href="/en/routes/#route-4"><div class="route-art"><img src="/assets/khun-in.webp" alt="บ้านขุนอินทร์" width="1000" height="1000" loading="lazy"><span class="route-no">04</span></div><div class="route-copy"><span class="eyebrow">Best for a half-day visit</span><h3>Short walk from wooden house</h3><span class="route-footer">4 destinations <span aria-hidden="true">↗</span></span></div></a></div></section><section class="section city-feed" id="city-feed"><div class="section-heading"><div><span class="chapter">02 / Read the town</span><h2>City topics and news</h2></div><p>Compiled stories and the latest updates in Takua Pa</p></div><div class="city-feed-grid"><div class="cf-stories"><h3 class="cf-title">Stories of the City</h3><div class="story-tiles"><a class="story-tile story-tile-lead" href="/en/stories/city/"><span class="sc-img"><img src="/assets/riverwalk.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">Know the city</span><b>Takua Pa: The Town That Moved with the River</b><p>From an ancient settlement on the trans-peninsular route to a market and mining town · Verified facts and questions waiting to be answered.</p><small>6 minutes</small></span></a><a class="story-tile" href="/en/stories/architecture/"><span class="sc-img"><img src="/assets/culture-street.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">Old houses and architecture</span><b>Buildings built with tin money and dredger steel · Architecture that remembers the town</b><p>Read Takua Pa through the shophouses on Culture Street, Boon Sung Iron Bridge, the governor's residence, and Tao Ming School · The transition embedded in brick, mortar, and steel structures</p><small>6 minutes</small></span></a><a class="story-tile" href="/en/stories/water-trade/"><span class="sc-img"><img src="/assets/iron-bridge.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">Waterways and trade</span><b>From Thung Tuk to the Takua Pa River: The Day the Waterway Built the Town</b><p>The river is not just a backdrop. It is a route, a connector of people, and the determiner of the town's fate, which had to relocate due to sedimentation.</p><small>7 minutes</small></span></a><a class="story-tile" href="/en/stories/food-people/"><span class="sc-img"><img src="/assets/food-center.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">People and flavors</span><b>Flavours of the Baba Community and the Old Market</b><p>Food serves as both household memories and evidence of cultural exchange · Read Takua Pa through the Baba cuisine, double-layered Tao Sor, and the Culture Street</p><small>7 minutes</small></span></a><a class="story-tile" href="/en/stories/kuapapoh/"><span class="sc-img"><img src="/assets/tao-ming.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">City topics</span><b>Kuapapoh: The Day Old Houses Stand Up to Tell Their Stories</b><p>A creative space project that revived houses number 78, 109, and 305 · What the new generation tells about the town, and what history still needs to uncover</p><small>6 minutes</small></span></a></div><a class="text-link" href="/en/stories/">Read all stories ↗</a></div><div class="cf-news"><h3 class="cf-title">Latest Updates</h3><ol class="news-list" data-news-list data-news-max="4" data-news-keep="10"><li class="news-row"><span class="news-date">4/5/2569</span><span class="news-main"><b>Praying for blessings at Kue Chai Tung Shrine, Phang Nga Province</b><span class="news-meta"><a href="/en/places/kue-chai/">Kue Chai Tung Shrine</a> · NBT2HD</span><a class="news-out" href="https://www.youtube.com/watch?v=q6K2Zl6700I" target="_blank" rel="noopener">Read original news ↗</a></span></li><li class="news-row"><span class="news-date">13/4/2569</span><span class="news-main"><b>Phang Nga Hosts Grand Songkran, Alms Giving in Takua Pa Old Town for Thai New Year Blessings</b><span class="news-meta"><a href="/en/traditions/">New Year's Dawn Almsgiving</a> · TOPNEWS</span><a class="news-out" href="https://www.topnews.co.th/news/1546452" target="_blank" rel="noopener">Read original news ↗</a></span></li><li class="news-row"><span class="news-date">13/4/2569</span><span class="news-main"><b>Takua Pa Blooms! Retracing Old Town Charm at Takuapa Oldtown Songkran Festival 2026</b><span class="news-meta"><a href="/en/traditions/">New Year's Dawn Almsgiving</a> · MGR Online</span><a class="news-out" href="https://mgronline.com/onlinesection/detail/9690000036775" target="_blank" rel="noopener">Read original news ↗</a></span></li><li class="news-row"><span class="news-date">8/3/2569</span><span class="news-main"><b>Takua Pa Khiri Khet School participates in Takua Pa Walk Rally 2026 (2569 BE)</b><span class="news-meta"><a href="/en/places/thung-phra/">Thung Phra Pho Park</a> · Takua Pa Khiri Khet School</span><a class="news-out" href="https://www.keereekatschool.ac.th/gallery-detail_1497" target="_blank" rel="noopener">Read original news ↗</a></span></li><li class="news-row"><span class="news-date">1/3/2569</span><span class="news-main"><b>Phang Nga hosts the 12th 'From Takola to Takua Pa' event</b><span class="news-meta"><a href="/en/places/museum/">Takua Pa Community Museum</a> · สถานีวิทยุกระจายเสียงแห่งประเทศไทย (Radio Thailand)</span><a class="news-out" href="https://radiothailand.prd.go.th/th/content/category/detail/id/9/iid/481052" target="_blank" rel="noopener">Read original news ↗</a></span></li><li class="news-row"><span class="news-date">21/2/2569</span><span class="news-main"><b>Old Town Storytelling Event at Tao Ming School, Takua Pa</b><span class="news-meta"><a href="/en/places/tao-ming/">Tao Ming School</a> · YOUPHUKET</span><a class="news-out" href="https://youphuket.club/author/admin/page/58/" target="_blank" rel="noopener">Read original news ↗</a></span></li><li class="news-row"><span class="news-date">30/1/2569</span><span class="news-main"><b>Inviting check-ins at Boon Soong iron bridge, mining heritage of Takua Pa town</b><span class="news-meta"><a href="/en/places/iron-bridge/">Boon Soong Iron Bridge</a> · NBT2HD</span><a class="news-out" href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">Read original news ↗</a></span></li><li class="news-row"><span class="news-date">5/11/2568</span><span class="news-main"><b>Loy Krathong activities at Khlong Takua Pa and Khlong Bang Muang</b><span class="news-meta"><a href="/en/traditions/">Loy Krathong</a> · กรมทรัพยากรทางทะเลและชายฝั่ง (Department of Marine and Coastal Resources)</span><a class="news-out" href="https://newweb.dmcr.go.th/detailAll/81026/nws/258" target="_blank" rel="noopener">Read original news ↗</a></span></li></ol><p class="small" data-news-updated hidden></p><a class="text-link" href="/en/news/">View all updates ↗</a><p class="small">Compiled from public news · Check schedule with organizers before visiting</p></div></div></section><section class="map-teaser"><div class="map-teaser-copy"><span class="chapter">Open the map / Then go out and know the city</span><h2>Which alley, which street<br><em>Has a story waiting</em></h2><p>From Yan Yao to the old town, open the municipal map and slowly look for the next destination</p><a class="button" href="/en/map/">Open the town map<span aria-hidden="true">↗</span></a><span class="map-caption">Uses the original municipal map image</span></div><a class="map-paper" href="/en/map/" aria-label="เปิดแผนที่เทศบาล"><img src="/assets/municipal-map.png" width="1358" height="1938" alt="แผนที่ท่องเที่ยวเมืองตะกั่วป่าจากเทศบาล" loading="lazy"><span class="paper-tag">TAKUA PA · TOWN MAP ↗</span></a><span class="map-compass" aria-hidden="true">✳</span></section><section id="places" class="section"><div class="section-heading"><div><span class="chapter">03 / Read the town</span><h2>One city, many angles to know</h2></div><p>All 20 places, from paper to stories of the city</p></div><div class="explorer" data-explorer><div class="explorer-tools"><div cl