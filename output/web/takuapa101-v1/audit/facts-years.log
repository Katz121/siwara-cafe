const fs=require('fs'), path=require('path');
const files=['data/places-enriched.json',...fs.readdirSync('data/stories').filter(x=>x.endsWith('.json')).map(x=>'data/stories/'+x)];
function walk(x,p,f){if(Array.isArray(x))x.forEach((v,i)=>walk(v,p+'['+i+']',f)); else if(x&&typeof x==='object')for(const [k,v] of Object.entries(x))walk(v,p+'.'+k,f); else if(typeof x==='string'&&(/(18|19|20)\\d{2}|(23|24|25|26)\\d{2}/.test(x)))console.log(f+':'+p+' = '+x)}
for(const f of files)walk(JSON.parse(fs.readFileSync(f)), '"'$'"', f);
console.log('--- YEAR FIELD CHECKS ---');
const p=JSON.parse(fs.readFileSync('data/places-enriched.json')); walk(p,'"'$'"','places');
function scan(x,p,f){if(Array.isArray(x))x.forEach((v,i)=>scan(v,p+'['+i+']',f)); else if(x&&typeof x==='object'){if('year_ce'in x||'year_be'in x) console.log(f+':'+p+' ce='+x.year_ce+' be='+x.year_be+' expected='+(Number(x.year_ce)+543));for(const [k,v] of Object.entries(x))scan(v,p+'.'+k,f)}} scan(p,'"'$'"','places');
