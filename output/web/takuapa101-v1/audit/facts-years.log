site\places\kue-chai\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ศาลเจ้ากู่ใช่ตึ๋ง · ศาลเจ้าพ่อกวนอู · ตะกั่วป่า 101</title><meta name="description" content="พื้นที่ฝากความหวังของผู้คน · ศาลเจ้าพ่อกวนอู ตะกั่วป่า · โรงพระตลาดเหนือ · ศาลเจ้าตะกั่วป่า"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="ศาลเจ้ากู่ใช่ตึ๋ง · ศาลเจ้าพ่อกวนอู"><meta property="og:description" content="พื้นที่ฝากความหวังของผู้คน · ศาลเจ้าพ่อกวนอู ตะกั่วป่า · โรงพระตลาดเหนือ · ศาลเจ้าตะกั่วป่า"><meta property="og:url" content="https://takuapa101.com/places/kue-chai/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/kue-chai.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/kue-chai.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/places/kue-chai/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "ศาลเจ้ากู่ใช่ตึ๋ง · ศาลเจ้าพ่อกวนอู", "item": "https://takuapa101.com/places/kue-chai/"}]}, {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "ศาลเจ้ากู่ใช่ตึ๋ง", "url": "https://takuapa101.com/places/kue-chai/", "image": "https://takuapa101.com/assets/kue-chai.webp", "description": "เอกสารกล่าวถึงการขอพรด้านสุขภาพและโชคลาภ", "address": {"@type": "PostalAddress", "streetAddress": "บ้านเลขที่ 87 ถนนศรีตะกั่วป่า", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8265089587, "longitude": 98.3647240165}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "ควรแต่งกายอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "แต่งกายสุภาพเมื่อเข้าสักการะ"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "เป็นศาลเจ้าแรกของอำเภอตะกั่วป่า และมีการเชิญองค์เทพจากเมืองจีนมาประดิษฐาน ตามเอกสารสภาวัฒนธรรม นายหง่อจกซื้อบ้านเลขที่ 87 ถนนศรีตะกั่วป่ามาทำเป็นศาลเจ้า หลังขอพรเรื่องผลผลิตเหมืองแร่และโชคลาภ"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "มีองค์เทพนาจาและองค์เทพอื่น ๆ สำหรับสักการะ เอกสารชุมชนเล่าความเชื่อมโยงของศาลเจ้ากับการขอพรให้ทำเหมืองแร่ได้แร่ดีและมีกำไร ในเทศกาลกินเจมีพิธีโก้ยห่าน ข้ามสะพาน และผูกสายสิญจน์เพื่อความเป็นสิริมงคล"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/places/kue-chai/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/places/kue-chai/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/places/kue-chai/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/" aria-current="page">สถานที่</a><a href="/stories/">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/places/kue-chai/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/">หน้าแรก</a> / <a href="/places/">สถานที่</a> / ศาลเจ้าและโรงเจ</div><header class="place-hero full-place-hero"><div><span class="chapter">บันทึกสถานที่ · ศาลเจ้าและโรงเจ</span><h1>ศาลเจ้ากู่ใช่ตึ๋ง</h1><p class="english">Kue Chai Tung Shrine</p><span class="fact-status confirmed">ยืนยันแล้ว 9 ข้อ</span><p><a class="text-link" href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้ ↓</a></p><p class="place-hero-actions"><button class="button" type="button" data-trip-add="kue-chai">เพิ่มลงทริป</button><a class="text-link" href="/trip/">ดูทริปของคุณ</a></p></div><div class="place-hero-art"><img src="/assets/kue-chai.webp" alt="ศาลเจ้ากู่ใช่ตึ๋ง" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>ข้อมูลใช้จริง</h2><dl><div><dt>พิกัด</dt><dd>8.8265089587, 98.3647240165 <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.8265089587,98.3647240165" target="_blank" rel="noopener">นำทางด้วย Google Maps ↗</a><a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">แหล่งพิกัด ↗</a></div><div><dt>เวลาเปิด</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ค่าเข้า</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ที่จอดรถ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ห้องน้ำ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>รถเข็น</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>การแต่งกาย</dt><dd>แต่งกายสุภาพเมื่อเข้าสักการะ <span class="fact-status unknown">ยังไม่ยืนยัน</span></dd></div><div><dt>โทรศัพท์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เพจ</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>เว็บไซต์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><dt>ไลน์</dt><dd><span class="muted">ยังไม่ยืนยัน</span></dd></div><div><a href="https://anyflip.com/tshcu/hnol/basic" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a><a href="https://www.thairath.co.th/news/local/south/1105465" target="_blank" rel="noopener">แหล่งข้อมูลการเข้าชม ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">ในบันทึกหน้านี้</span><a href="#visit">ข้อมูลใช้จริง</a><a href="#eras">ตอนนั้น · ก่อนหน้า · ตอนนี้</a><a href="#timeline">เส้นเวลาแบบจุด</a><a href="#highlights">จุดเด่นที่ควรดู</a><a href="#news">ข่าวและความเคลื่อนไหว</a><a href="#did_you_know">รู้หรือไม่</a><a href="#getting_there">วิธีเดินทาง</a><a href="#nearby">ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</a><a href="#faq">คำถามที่พบบ่อย</a><a href="#sources">ที่มาของข้อมูล</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>ตอนนั้น · ก่อนหน้า · ตอนนี้</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">ตอนนั้น</span><h3>จากบ้านของนายหง่อจกสู่ศาลเจ้าแรกของตะกั่วป่า</h3><p class="era-years">ไม่ปรากฏปีสร้างที่ยืนยันได้; เอกสารร่วมสมัยบางแหล่งระบุว่าเก่าแก่เกือบ 200 ปี</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>จุดเริ่มต้นที่มีหลักฐานชัดที่สุดยังไม่ใช่ปี พ.ศ. แต่เป็นเรื่องเล่าของชุมชน: นายหง่อจกซื้อบ้านเลขที่ 87 ถนนศรีตะกั่วป่า แล้วปรับบ้านให้เป็นศาลเจ้า หลังความศรัทธาจากการขอพรเรื่องผลผลิตเหมืองแร่และโชคลาภ เอกสารอีกชุดเรียกชื่อเดิมว่า ‘เทียนหวั่นเก้ง’ และชื่อที่ใช้ตามกฎหมายว่า ‘กู่ใช่ตึ๋ง’</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://anyflip.com/tshcu/hnol/basic" target="_blank" rel="noopener">สภาวัฒนธรรมตำบลตะกั่วป่า, ประเพณีกินผักตะกั่วป่า</a> · <a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม</a></div></article><article class="era-card" data-era="before"><span class="chapter">ก่อนหน้า</span><h3>ศาลเจ้าเติบโตไปพร้อมเมืองเหมือง และกลายเป็นพื้นที่พิธีกรรมของชุมชน</h3><p class="era-years">ไม่พบปีของการเปลี่ยนมือ บูรณะ หรือเหตุการณ์สึนามิที่ยืนยันเฉพาะสถานที่</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>บริบทของศาลเจ้าผูกกับชาวจีนฮกเกี้ยนที่อพยพเข้ามาทำเหมืองแร่ในตะกั่วป่า และนำองค์เทพจากเมืองจีนมาประดิษฐาน แหล่งข้อมูลท้องถิ่น/สื่อท่องเที่ยวอธิบายว่าศาลเจ้าอยู่ในย่านตลาดเก่าซึ่งมีอาคารเก่าและถนนวัฒนธรรม จึงทำหน้าที่มากกว่าสถานที่ไหว้พระ: เป็นหลักยึดของชุมชนจีนและพื้นที่ประกอบประเพณีถือศีลกินผัก</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม</a> · <a href="https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf" target="_blank" rel="noopener">โครงการกำหนดขอบเขตพื้นที่เมืองเก่าตะกั่วป่า</a> · <a href="https://wanderlog.com/th/place/details/11412698/san-chao-ku-chai-tueng" target="_blank" rel="noopener">Wanderlog (สรุปข้อมูลสถานที่/รีวิวผู้ใช้)</a></div></article><article class="era-card" data-era="now"><span class="chapter">ตอนนี้</span><h3>อ๊ามเหนือที่ยังมีชีวิตในเทศกาลกินผัก</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">ยืนยันแล้ว</span><p>หลักฐานล่าสุดที่ค้นพบคือข่าว NBT เผยแพร่เดือนพฤษภาคม 2569 ซึ่งพาศาลเจ้ากู่ใช่ตึ๋งหรือ ‘โรงพระตลาดเหนือ’ ในฐานะศูนย์รวมศรัทธาของชาวตะกั่วป่า และระบุว่ายังคงรักษาเอกลักษณ์วัฒนธรรมดั้งเดิมไว้ ข่าวเทศกาลปี 2566 ยังยืนยันว่าศาลเจ้ากู่ใช่ตึ๋งร่วมพิธีอิ้วเก้ง แห่พระรอบเมืองเก่าตะกั่วป่า</p><div class="era-sources">แหล่งอ้างอิง · <a href="https://www.youtube.com/watch?v=q6K2Zl6700I" target="_blank" rel="noopener">NBT2HD</a> · <a href="https://www.innews.news/news.php?n=48726" target="_blank" rel="noopener">Innews</a></div></article></div></section><section class="research-section" id="timeline"><h2>เส้นเวลาแบบจุด</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">13·21 ตุลาคม 2558</p><h3>พิธียกเสาโกเต้งในเทศกาลถือศีลกินผัก</h3><p>มีการประกอบพิธีอัญเชิญตะเกียง 9 ดวงและเทพประธานของเทศกาลกินผัก</p><a href="https://www.sanook.com/news/1881366/" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">23 ตุลาคม 2566</p><h3>ร่วมพิธีอิ้วเก้งแห่พระรอบเมืองเก่า</h3><p>ศาลเจ้ากู่ใช่ตึ๋งร่วมกับศาลเจ้าพ่อกวนอูซิ่นใช่ตึ๋งประกอบพิธีแห่พระในเทศกาลกินเจ</p><a href="https://www.innews.news/news.php?n=48726" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">4 พฤษภาคม 2569</p><h3>ปรากฏในข่าว NBT ในฐานะศูนย์รวมศรัทธา</h3><p>ข่าว NBT นำเสนอศาลเจ้าในฐานะโรงพระตลาดเหนือและกล่าวถึงประวัติยาวนานกว่า 200 ปี แต่ไม่ได้ให้ปีเริ่มก่อตั้งเป็นตัวเลข</p><a href="https://www.youtube.com/watch?v=q6K2Zl6700I" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">ไม่ระบุปี</p><h3>นายหง่อจกซื้อบ้านทำเป็นศาลเจ้า</h3><p>เอกสารสภาวัฒนธรรมเล่าว่าบ้านเลขที่ 87 ถนนศรีตะกั่วป่าถูกนำมาทำเป็นศาลเจ้า หลังการขอพรเรื่องเหมืองแร่และโชคลาภ</p><a href="https://anyflip.com/tshcu/hnol/basic" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li><li><span class="fact-status confirmed">ยืนยันแล้ว</span><p class="era-years">ไม่ระบุปี</p><h3>เชิญเทพจากเมืองจีนมาประดิษฐาน</h3><p>ศาลเจ้าถูกบันทึกว่าเป็นศาลเจ้าแรกของอำเภอตะกั่วป่า มีองค์เทพนาจาและเทพองค์อื่น ๆ เป็นที่สักการะ</p><a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></li></ol></section><p class="missing-photo">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่</p><section class="research-section" id="highlights"><h2>จุดเด่นที่ควรดู</h2><div class="research-cards"><article class="research-note"><h3>องค์เทพจีน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>มีองค์เทพนาจาและองค์เทพอื่น ๆ สำหรับสักการะ</p><a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ร่องรอยชุมชนเหมืองแร่</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>เอกสารชุมชนเล่าความเชื่อมโยงของศาลเจ้ากับการขอพรให้ทำเหมืองแร่ได้แร่ดีและมีกำไร</p><a href="https://anyflip.com/tshcu/hnol/basic" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>พิธีข้ามสะพานสะเดาะเคราะห์</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ในเทศกาลกินเจมีพิธีโก้ยห่าน ข้ามสะพาน และผูกสายสิญจน์เพื่อความเป็นสิริมงคล</p><a href="https://www.thairath.co.th/news/local/south/1105465" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>บริบทเมืองเก่าตะกั่วป่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ตั้งอยู่ในย่านถนนวัฒนธรรม/เมืองเก่าตะกั่วป่า ซึ่งมีอาคารเก่าและศิลปวัฒนธรรมชุมชน</p><a href="https://tatmediaassets.com/file/1097396" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="news"><h2>ข่าวและความเคลื่อนไหว</h2><div class="research-cards"><article class="research-note"><p class="muted">2026-05-04 · NBT2HD</p><h3>ไหว้พระขอพร ศาลเจ้ากู่ใช่ตึ๋ง จ.พังงา</h3><p>ข่าว NBT แนะนำศาลเจ้าและบทบาทศูนย์รวมศรัทธาของชาวตะกั่วป่า</p><a href="https://www.youtube.com/watch?v=q6K2Zl6700I" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><p class="muted">2023-10-23 · Innews</p><h3>ส่งท้ายดุ! กินเจพังงาแห่รอบเมืองตะกั่วป่า</h3><p>รายงานพิธีอิ้วเก้งที่ศาลเจ้ากู่ใช่ตึ๋งร่วมกับศาลเจ้าซิ่นใช่ตึ๋ง</p><a href="https://www.innews.news/news.php?n=48726" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>รู้หรือไม่</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ชื่อ ‘โรงพระตลาดเหนือ’ ใช้แยกศาลเจ้าแห่งนี้จากศาลเจ้าซิ่นใช่ตึ๋งหรือโรงพระตลาดใต้ในย่านเมืองเก่า</p><a href="https://th.readme.me/p/44374" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><span class="fact-status confirmed">ยืนยันแล้ว</span><p>ศาลเจ้านี้มีชื่อเดิมว่าเทียนหวั่นเก้ง และเอกสารชุมชนระบุชื่อทางกฎหมายว่ากู่ใช่ตึ๋ง</p><a href="https://anyflip.com/tshcu/hnol/basic" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>วิธีเดินทาง</h2><div class="research-cards"><article class="research-note"><h3>ตัวเมืองตะกั่วป่า</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ตั้งอยู่ในย่านเมืองเก่าตะกั่วป่า บนถนนศรีตะกั่วป่า; แหล่งข้อมูลที่อ่านพบไม่ระบุระยะทางหรือคำแนะนำเส้นทางโดยละเอียด</p><a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>ภูเก็ต</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ยังไม่พบแหล่งที่อ่านได้ซึ่งระบุเส้นทางหรือระยะทางถึงศาลเจ้าโดยตรง</p><a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>เขาหลัก</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ยังไม่พบแหล่งที่อ่านได้ซึ่งระบุเส้นทางหรือระยะทางถึงศาลเจ้าโดยตรง</p><a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article><article class="research-note"><h3>สนามบิน</h3><span class="fact-status unknown">ยังไม่ยืนยัน</span><p>ยังไม่พบแหล่งที่อ่านได้ซึ่งระบุเส้นทางหรือระยะทางถึงศาลเจ้าโดยตรง</p><a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">อ่านแหล่งอ้างอิง ↗</a></article></div></section><section class="research-section" id="nearby"><h2>ที่ใกล้เคียงและสถานที่ในหมวดเดียวกัน</h2><ul class="nearby-links"><li><a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a></li><li><a href="/places/pun-thao/">ศาลเจ้าปุนเถ่ากงอ๊า</a></li><li><a href="/places/rong-jae/">โรงเจในสวน</a></li></ul></section><section class="research-section" id="faq"><h2>คำถามที่พบบ่อย</h2><details><summary>ควรแต่งกายอย่างไร</summary><p>แต่งกายสุภาพเมื่อเข้าสักการะ</p></details><details><summary>สถานที่นี้มีประวัติความเป็นมาอย่างไร</summary><p>เป็นศาลเจ้าแรกของอำเภอตะกั่วป่า และมีการเชิญองค์เทพจากเมืองจีนมาประดิษฐาน ตามเอกสารสภาวัฒนธรรม นายหง่อจกซื้อบ้านเลขที่ 87 ถนนศรีตะกั่วป่ามาทำเป็นศาลเจ้า หลังขอพรเรื่องผลผลิตเหมืองแร่และโชคลาภ</p></details><details><summary>มีจุดเด่นอะไรให้ชม</summary><p>มีองค์เทพนาจาและองค์เทพอื่น ๆ สำหรับสักการะ เอกสารชุมชนเล่าความเชื่อมโยงของศาลเจ้ากับการขอพรให้ทำเหมืองแร่ได้แร่ดีและมีกำไร ในเทศกาลกินเจมีพิธีโก้ยห่าน ข้ามสะพาน และผูกสายสิญจน์เพื่อความเป็นสิริมงคล</p></details></section><section class="research-section" id="sources"><h2>ที่มาของข้อมูล</h2><div class="source-table"><table><thead><tr><th>ชื่อ</th><th>ประเภท</th><th>วันที่เข้าถึง</th><th>ลิงก์</th></tr></thead><tbody><tr><th scope="row">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4411" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">สภาวัฒนธรรมตำบลตะกั่วป่า, ประเพณีกินผักตะกั่วป่า</th><td>แหล่งข้อมูลอื่น</td><td>2026-09-07</td><td><a href="https://anyflip.com/tshcu/hnol/basic" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">ไทยรัฐ</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.thairath.co.th/news/local/south/1105465" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">TAT Media Assets</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://tatmediaassets.com/file/1097396" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">โครงการกำหนดขอบเขตพื้นที่เมืองเก่าตะกั่วป่า</th><td>หน่วยงานทางการ</td><td>2026-09-07</td><td><a href="https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">Innews</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.innews.news/news.php?n=48726" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">NBT2HD</th><td>ข่าว</td><td>2026-09-07</td><td><a href="https://www.youtube.com/watch?v=q6K2Zl6700I" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr><tr><th scope="row">Trip.com Moments</th><td>บล็อก</td><td>2026-09-07</td><td><a href="https://th.trip.com/moments/detail/takua-pa-14944-125098619/" target="_blank" rel="noopener">เปิดแหล่ง ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ไม่พบเวลาเปิด-ปิดจากแหล่งที่ยืนยันได้</li><li>ไม่พบค่าเข้าชมที่ยืนยันได้</li><li>ไม่พบเบอร์โทรศัพท์ เพจเฟซบุ๊ก เว็บไซต์ หรือ LINE رسميของศาลเจ้า</li><li>ไม่พบรหัสไปรษณีย์เฉพาะสถานที่จากแหล่งที่อ่านได้</li><li>ไม่พบข้อมูลยืนยันปีที่สร้างและผู้สร้างเป็นตัวเลข/ชื่อบุคคลที่แน่นอน</li><li>ไม่พบหลักฐานการขึ้นทะเบียนเป็นโบราณสถานของกรมศิลปากร</li><li>ไม่พบข้อมูลยืนยันรูปแบบสถาปัตยกรรมชิโน-โปรตุกีส/จีนของตัวอาคารโดยตรง</li><li>ไม่พบข้อมูลยืนยันที่จอดรถ ห้องน้ำ ทางลาด หรือการเข้าถึงรถเข็น</li><li>ไม่พบรายชื่อสถานที่ใกล้เคียงพร้อมเวลาการเดินที่ยืนยันได้</li><li>ไม่พบเส้นทางและระยะทางจากภูเก็ต เขาหลัก หรือสนามบินที่ระบุศาลเจ้านี้โดยตรง</li><li>ไม่พบปีสร้างที่ระบุเป็นตัวเลขและหลักฐานยืนยันผู้สร้างนอกเหนือจากเรื่องเล่านายหง่อจก</li><li>ไม่พบหลักฐานยืนยันการเปลี่ยนมือ การร้าง หรือการบูรณะพร้อมปี</li><li>ไม่พบหลักฐานว่าศาลเจ้าได้รับผลกระทบจากสึนามิ พ.ศ. 2547</li><li>ไม่พบปีขึ้นทะเบียนโบราณสถานของกรมศิลปากร</li><li>ไม่พบข้อมูลผู้ดูแลปัจจุบัน เวลาเปิด-ปิด ค่าเข้าชม สภาพโครงสร้าง และโครงการบูรณะล่าสุด</li><li>ไม่พบภาพเก่าหรือภาพจดหมายเหตุที่ยืนยันว่าเป็นศาลเจ้านี้โดยตรง</li><li>ข่าวย้อนหลัง 5 ปีที่พบมีจำกัด; ไม่พบข่าวบูรณะหรือรางวัลเฉพาะสถานที่</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
