data/places-enriched.json:$[11].eras.before.body_th = หลักฐานที่ค้นพบไม่ได้บันทึกการเปลี่ยนมือ การถูกทิ้งร้าง หรือการบูรณะสวนเป็นช่วงเวลา จึงยังตอบไม่ได้ว่าสวนผ่านเหตุการณ์เหล่านั้นหรือไม่ เช่นเดียวกับผลกระทบจากสึนามิ พ.ศ. 2547 ซึ่งไม่พบรายงานเฉพาะเจาะจงถึงสวนแห่งนี้

ในช่วงที่มีข้อมูล สวนทำหน้าที่กว้างขึ้นจากจุดสักการะเป็นพื้นที่สาธารณะของเมือง ใช้จัดกิจกรรมวัฒนธรรม สันทนาการ งานประเพณี งานวันเด็ก และเป็นสนามเด็กเล่น โดยเทศบาลเมืองตะกั่วป่าดูแลบริหารจัดการ

เอกสารเมืองเก่าระบุสถานที่และโบราณสถานหลายแห่งในเขตเทศบาล แต่ไม่พบประกาศกรมศิลปากรที่ขึ้นทะเบียน “สวนสาธารณะอุทยานพระนารายณ์” เป็นโบราณสถานโดยตรง จึงแยกสวนออกจากโบราณสถานใกล้เคียงอย่างระมัดระวัง
data/places-enriched.json:$[11].eras.before.sources[0].url = https://m-culture.in.th/album/120992/%E0%B8%AA%E0%B8%A7%E0%B8%99%E0%B8%AA%E0%B8%B2%E0%B8%98%E0%B8%B2%E0%B8%A3%E0%B8%93%E0%B8%B0%E0%B8%AD%E0%B8%B8%E0%B8%97%E0%B8%A2%E0%B8%B2%E0%B8%99%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B8%99%E0%B8%B2%E0%B8%A3%E0%B8%B2%E0%B8%A2%E0%B8%93์
data/places-enriched.json:$[11].eras.before.sources[1].url = https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf
data/places-enriched.json:$[11].eras.now.years_th = 2569 / 2026
data/places-enriched.json:$[11].eras.now.body_th = ข้อมูลล่าสุดที่เปิดเผยยืนยันว่า สวนยังเป็นพื้นที่สาธารณะและอยู่ภายใต้การดูแลของเทศบาลเมืองตะกั่วป่า ภายในมีเทวรูปพระนารายณ์และเทพบริวารสำหรับสักการะ รวมทั้งสนามเด็กเล่นและพื้นที่พักผ่อนของชุมชน

สวนยังทำหน้าที่เป็นเวทีกลางของเมือง งานบวงสรวงพระนารายณ์และของดีเมืองตะกั่วป่าจัดที่นี่ใน พ.ศ. 2568 และมีข่าวกิจกรรมของดีเมืองตะกั่วป่าที่เวทีกลางสวน ส่วนงานประจำปี พ.ศ. 2566 จัดระหว่าง 27 มีนาคม–5 เมษายน

ยังไม่มีข้อมูลทางการที่ยืนยันเวลาเปิด–ปิด ค่าเข้า สภาพกายภาพล่าสุด หรือโครงการก่อสร้างที่เสร็จแล้ว สำหรับแนวคิดพัฒนา “Narai Hub & Commercial Center” พบเพียงข่าวนโยบาย/แนวทางของผู้บริหารเทศบาล จึงยังไม่ถือว่าเป็นโครงการที่ดำเนินการเสร็จสมบูรณ์
