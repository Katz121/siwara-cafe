def render_news():
    news_data = json.loads((DATA/'news-feed.json').read_text(encoding='utf-8'))
    places = sorted(list(set(n['place_name'] for n in news_data if n.get('place_name'))))
    years = sorted(list(set(n.get('date','')[:4] for n in news_data if n.get('date'))), reverse=True)
    
    tabs = '<button type="button" data-news-filter="all" aria-pressed="true">à¸—à¸±à¹‰à¸‡à¸«à¸¡à¸”</button>'
    for p in places: tabs += f'<button type="button" data-news-filter="{esc(p)}" aria-pressed="false">{esc(p)}</button>'
    for y in years: tabs += f'<button type="button" data-news-filter="{y}" aria-pressed="false">à¸›à¸µ {int(y)+543}</button>'
    
    items_html = ''
    jsonld_items = []
    
    for i, n in enumerate(news_data):
        d = n.get('date', '')
        d_th = ''
        y = d[:4] if d else ''
        if d:
            try:
                yx, m, dd = d.split('-')
                months = ['à¸¡.à¸„.', 'à¸.à¸ž.', 'à¸¡à¸µ.à¸„.', 'à¹€à¸¡.à¸¢.', 'à¸ž.à¸„.', 'à¸¡à¸´.à¸¢.', 'à¸.à¸„.', 'à¸ª.à¸„.', 'à¸.à¸¢.', 'à¸•.à¸„.', 'à¸ž.à¸¢.', 'à¸˜.à¸„.']
                d_th = f'{int(dd)} {months[int(m)-1]} {int(yx)+543}'
            except:
                pass
                
        place_link = f'<a href="{esc(n["place_url"])}">{esc(n["place_name"])}</a>' if n.get("place_url") else ''
        title = esc(n.get("title_th", ""))
        summary = esc(n.get("summary_th", ""))
        outlet = esc(n.get("outlet", ""))
        url_link = esc(n.get("url", ""))
        link = (f'<span class="news-out news-out-offline">à¸‚à¹ˆà¸²à¸§à¸•à¹‰à¸™à¸—à¸²à¸‡à¸–à¸¹à¸à¸–à¸­à¸”à¸­à¸­à¸à¹à¸¥à¹‰à¸§ Â· à¸•à¸£à¸§à¸ˆà¹€à¸¡à¸·à¹ˆà¸­ 8 à¸.à¸¢. 2569</span>'
                if is_dead(url_link) else
                f'<a class="news-out" href="{url_link}" target="_blank" rel="noopener">à¸­à¹ˆà¸²à¸™à¸‚à¹ˆà¸²à¸§à¸•à¹‰à¸™à¸—à¸²à¸‡ â†—</a>') if url_link else ''
        
        items_html += f'<article class="news-item" data-place="{esc(n.get("place_name",""))}" data-year="{y}"><time datetime="{d}">{d_th}</time><div class="news-content"><h2>{title}</h2><p>{summary}</p><div class="news-meta">{place_link}{" Â· " if place_link and outlet else ""}{outlet}</div>{link}</div></article>'
        
