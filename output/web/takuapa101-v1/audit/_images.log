"""Presentation layer for the 2026-09-07 editorial redesign."""
from html import escape as e
import re
from dead_sources import source_link, is_dead

# ---- Photo registry guard ----
# Nothing renders a photograph unless the registry says that photo depicts this
# subject. A caption always comes from the registry, never from the page that is
# placing it, so a picture cannot be relabelled to fit a heading.
_PHOTO_REG = None


def photo_for(subject, file=None, era=None):
    """Return a renderable photo dict for this subject, or None."""
    global _PHOTO_REG
    import json as _j, os as _o
    if _PHOTO_REG is None:
        fp = _o.path.join(_o.path.dirname(_o.path.abspath(__file__)), 'data', 'photo-registry.json')
        try:
            reg = _j.load(open(fp, encoding='utf-8'))
        except Exception:
            reg = {'photos': []}
        _PHOTO_REG = {p['file']: p for p in reg.get('photos', [])}
    if file:
        p = _PHOTO_REG.get(file)
        return p if p and subject in p.get('allowed_on', []) else None
    for p in _PHOTO_REG.values():
        if subject in p.get('allowed_on', []) and (era is None or p.get('era') == era):
            return p
    return None


GROUPS = [('temple','à¸§à¸±à¸”à¹à¸¥à¸°à¹€à¸ˆà¸”à¸µà¸¢à¹Œ',['wat-boromthat','wat-khuha','wat-pathum','wat-kongkha','wat-nikorn','wat-sena']),('shrine','à¸¨à¸²à¸¥à¹€à¸ˆà¹‰à¸²à¹à¸¥à¸°à¹‚à¸£à¸‡à¹€à¸ˆ',['guan-yu','pun-thao','kue-chai','rong-jae']),('heritage','à¸•à¸¶à¸à¹€à¸à¹ˆà¸²à¹à¸¥à¸°à¸£à¹ˆà¸­à¸‡à¸£à¸­à¸¢à¹€à¸¡à¸·à¸­à¸‡',['iron-bridge','governor-wall','khun-in','tao-ming']),('park','à¸ªà¸§à¸™à¹à¸¥à¸°à¸žà¸·à¹‰à¸™à¸—à¸µà¹ˆà¸ªà¸²à¸˜à¸²à¸£à¸“à¸°',['phra-narai','thung-phra']),('market','à¸•à¸¥à¸²à¸”à¹à¸¥à¸°à¸‚à¸­à¸‡à¸à¸´à¸™',['riverwalk','culture-street','food-center']),('museum','à¸žà¸´à¸žà¸´à¸˜à¸ à¸±à¸“à¸‘à¹Œ',['museum'])]
MAP_NOTE = 'à¹à¸œà¸™à¸—à¸µà¹ˆà¸›à¸£à¸°à¸Šà¸²à¸ªà¸±à¸¡à¸žà¸±à¸™à¸˜à¹Œà¸‚à¸­à¸‡à¹€à¸—à¸¨à¸šà¸²à¸¥à¹€à¸¡à¸·à¸­à¸‡à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸² à¸£à¸°à¸¢à¸°à¹à¸¥à¸°à¸ªà¸±à¸”à¸ªà¹ˆà¸§à¸™à¹„à¸¡à¹ˆà¸•à¸£à¸‡à¸•à¸²à¸¡à¸žà¸·à¹‰à¸™à¸—à¸µà¹ˆà¸ˆà¸£à¸´à¸‡'

def cta(href, label):
