            src = (r.get('sources') or [{}])[0].get('url')
            tag = 'à¸£à¹‰à¸²à¸™à¸‚à¸­à¸‡à¸œà¸¹à¹‰à¸ˆà¸±à¸”à¸—à¸³' if r.get('provenance') == 'first-party' else ('à¹€à¸žà¸´à¹ˆà¸¡à¹‚à¸”à¸¢à¸œà¸¹à¹‰à¸”à¸¹à¹à¸¥' if r.get('provenance') == 'owner-added' else 'à¸ˆà¸²à¸à¸à¸²à¸£à¸„à¹‰à¸™à¸«à¸²')
            if src:
                bits.append(f'<span class="shop-src">{source_link(src, tag)}</span>')
            else:
                bits.append(f'<span class="shop-src">{tag}</span>')
            if r.get('status') == 'uncertain':
                bits.append('<span class="shop-warn">à¸¢à¸±à¸‡à¹„à¸¡à¹ˆà¸¢à¸·à¸™à¸¢à¸±à¸™à¸§à¹ˆà¸²à¹€à¸›à¸´à¸”à¸­à¸¢à¸¹à¹ˆ</span>')
