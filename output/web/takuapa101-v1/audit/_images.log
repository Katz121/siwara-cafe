        result=hero+'<div class="story-layout">'+aside+'<article class="story" id="story">'+text+mini+source()+'</article></div><section id="related" class="section related-section">'+heading('à¸­à¹ˆà¸²à¸™à¸•à¹ˆà¸­','à¸­à¸µà¸à¸¡à¸¸à¸¡à¸‚à¸­à¸‡à¹€à¸¡à¸·à¸­à¸‡')+'<div class="related-grid">'+''.join(card(x,ctx) for x in rel_places)+'</div>'
        if rel_events: result+='<div class="related-events"><span class="eyebrow">à¸›à¸£à¸°à¹€à¸žà¸“à¸µà¸—à¸µà¹ˆà¹€à¸à¸µà¹ˆà¸¢à¸§à¸‚à¹‰à¸­à¸‡</span>'+''.join(ctx['a'](byid[x]) for x in rel_events)+'</div>'
