+_IMG_RE = re.compile(r'<img\b(?P<attrs>[^>]*?)\bsrc="(?P<src>[^"]+)"(?P<tail>[^>]*)>', re.I)
+for _fp in OUT.rglob('*.html'):
+ _html = _fp.read_text(encoding='utf-8')
+ def _dimensions(m):
+  if 'width=' in (m.group('attrs') + m.group('tail')) or not m.group('src').startswith('/assets/'):
