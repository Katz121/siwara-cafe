        if related: result+='<section class="section">'+heading('à¸­à¹ˆà¸²à¸™à¸•à¹ˆà¸­','à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆà¸—à¸µà¹ˆà¹€à¸à¸µà¹ˆà¸¢à¸§à¸‚à¹‰à¸­à¸‡')+'<div class="related-grid">'+''.join(card(x,ctx) for x in related)+'</div></section>'
