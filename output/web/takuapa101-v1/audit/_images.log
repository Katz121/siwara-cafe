def heading(no, title, detail=''):
    return f'<div class="section-heading"><div><span class="chapter">{no} / à¹€à¸›à¸´à¸”à¸­à¹ˆà¸²à¸™à¹€à¸¡à¸·à¸­à¸‡</span><h2>{title}</h2></div><p>{detail}</p></div>'

def card(id, ctx):
    r=ctx['byid'][id]; key,label=next((k,l) for k,l,ids in GROUPS if id in ids)
    return f'<article class="place-card" data-place-card data-category="{key}" data-name="{e(r["name_th"])}"><a class="place-image" href="{ctx["url"](r)}">{ctx["pic"](id)}<span class="card-index">{ctx["places"].index(r)+1:02d}</span><span class="image-arrow" aria-hidden="true">â†—</span></a><div class="card-copy"><span class="eyebrow">{label}</span><h3>{ctx["a"](r)}</h3><p>{e(ctx["copy"][id]["kicker"])}</p></div></article>'

LEAFLET_SHOPS = 59            # à¸ˆà¸²à¸à¹à¸œà¹ˆà¸™à¸žà¸±à¸šà¹€à¸—à¸¨à¸šà¸²à¸¥ Â· à¹€à¸›à¹‡à¸™à¸—à¸µà¹ˆà¸¡à¸²à¸‚à¸­à¸‡à¸£à¸²à¸¢à¸Šà¸·à¹ˆà¸­à¸Šà¸¸à¸”à¹à¸£à¸
def _shop_total():
    """à¸ˆà¸³à¸™à¸§à¸™à¸£à¹‰à¸²à¸™à¸—à¸±à¹‰à¸‡à¸«à¸¡à¸”à¸—à¸µà¹ˆà¹à¸ªà¸”à¸‡à¸šà¸™ /eat/ Â· à¹à¸œà¹ˆà¸™à¸žà¸±à¸š + à¸—à¸µà¹ˆà¸„à¹‰à¸™à¹€à¸žà¸´à¹ˆà¸¡à¹à¸¥à¸°à¸£à¸°à¸šà¸¸à¹à¸«à¸¥à¹ˆà¸‡à¸—à¸µà¹ˆà¸¡à¸²à¹à¸¥à¹‰à¸§"""
    import json as _j, os as _o
    n = LEAFLET_SHOPS
    fp = _o.path.join(_o.path.dirname(_o.path.abspath(__file__)), 'data', 'shops-extra.json')
    try:
        d = _j.load(open(fp, encoding='utf-8'))
        n += len(d if isinstance(d, list) else d.get('shops', []))
    except Exception:
        pass
    return n
SHOP_TOTAL = _shop_total()

def explorer(ctx, search=False):
    tabs='<button type="button" data-filter="all" aria-pressed="true">à¸—à¸±à¹‰à¸‡à¸«à¸¡à¸” <sup>20</sup></button>'+''.join(f'<button type="button" data-filter="{key}" aria-pressed="false">{label} <sup>{len(ids)}</sup></button>' for key,label,ids in GROUPS)
    field='<label class="search-label">à¸„à¹‰à¸™à¸«à¸²à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆ<input type="search" data-place-search placeholder="à¸Šà¸·à¹ˆà¸­à¸§à¸±à¸” à¸¨à¸²à¸¥à¹€à¸ˆà¹‰à¸² à¸«à¸£à¸·à¸­à¸ˆà¸¸à¸”à¸—à¸µà¹ˆà¸­à¸¢à¸²à¸à¹„à¸›" autocomplete="off"></label>' if search else ''
    return f'<div class="explorer" data-explorer><div class="explorer-tools">{field}<div class="filter-tabs" role="group" aria-label="à¸«à¸¡à¸§à¸”à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆ">{tabs}</div></div><div class="explorer-status"><span data-place-count role="status" aria-live="polite">20 à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆà¹ƒà¸«à¹‰à¸„à¹ˆà¸­à¸¢ à¹† à¸£à¸¹à¹‰à¸ˆà¸±à¸</span><span>à¹€à¸¥à¸·à¸­à¸à¸ à¸²à¸žà¹€à¸žà¸·à¹ˆà¸­à¹€à¸›à¸´à¸”à¸­à¹ˆà¸²à¸™ â†—</span></div><h2 class="visually-hidden">à¸£à¸²à¸¢à¸Šà¸·à¹ˆà¸­à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆà¸—à¸±à¹‰à¸‡à¸«à¸¡à¸”</h2><div class="places-grid">'+''.join(card(id,ctx) for _,_,ids in GROUPS for id in ids)+'</div><div class="empty-state" data-place-empty hidden><h3>à¸¢à¸±à¸‡à¹„à¸¡à¹ˆà¹€à¸ˆà¸­à¸ˆà¸¸à¸”à¸«à¸¡à¸²à¸¢à¸™à¸µà¹‰</h3><p>à¸¥à¸­à¸‡à¸„à¸³à¸„à¹‰à¸™à¸­à¸·à¹ˆà¸™ à¸«à¸£à¸·à¸­à¹€à¸¥à¸·à¸­à¸à¸”à¸¹à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆà¸—à¸±à¹‰à¸‡à¸«à¸¡à¸”</p><button type="button" data-clear-places>à¸¥à¹‰à¸²à¸‡à¸•à¸±à¸§à¸à¸£à¸­à¸‡</button></div></div>'

def route_cards(ctx):
    arts=['wat-boromthat','guan-yu','tao-ming','khun-in']; angles=['à¸­à¹ˆà¸²à¸™à¹€à¸¡à¸·à¸­à¸‡à¸œà¹ˆà¸²à¸™à¸¨à¸£à¸±à¸—à¸˜à¸²','à¸¡à¸­à¸‡à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸£à¸²à¸§à¸‚à¸­à¸‡à¸Šà¸¸à¸¡à¸Šà¸™à¸ˆà¸µà¸™','à¸•à¸²à¸¡à¸£à¸­à¸¢à¸­à¸²à¸„à¸²à¸£ à¸à¸²à¸£à¸„à¹‰à¸² à¹à¸¥à¸°à¸œà¸¹à¹‰à¸„à¸™','à¹€à¸«à¸¡à¸²à¸°à¸à¸±à¸šà¸„à¸™à¸¡à¸µà¹€à¸§à¸¥à¸²à¸„à¸£à¸¶à¹ˆà¸‡à¸§à¸±à¸™']
    return '<div class="route-cards">'+''.join(f'<a class="route-card" href="/routes/#route-{i}"><div class="route-art">{ctx["pic"](arts[i-1])}<span class="route-no">0{i}</span></div><div class="route-copy"><span class="eyebrow">{angles[i-1]}</span><h3>{name}</h3><span class="route-footer">{len(ids)} à¸ˆà¸¸à¸”à¸«à¸¡à¸²à¸¢ <span aria-hidden="true">â†—</span></span></div></a>' for i,(name,ids) in enumerate(ctx['routes'],1))+'</div>'

def map_teaser():
    return f'<section class="map-teaser"><div class="map-teaser-copy"><span class="chapter">à¸à¸²à¸‡à¹à¸œà¸™à¸—à¸µà¹ˆ / à¹à¸¥à¹‰à¸§à¸­à¸­à¸à¹„à¸›à¸£à¸¹à¹‰à¸ˆà¸±à¸à¹€à¸¡à¸·à¸­à¸‡</span><h2>à¸•à¸£à¸­à¸à¹„à¸«à¸™ à¸–à¸™à¸™à¹„à¸«à¸™<br><em>à¸¡à¸µà¹€à¸£à¸·à¹ˆà¸­à¸‡à¸£à¸­à¸­à¸¢à¸¹à¹ˆ</em></h2><p>à¸ˆà¸²à¸à¸¢à¹ˆà¸²à¸™à¸¢à¸²à¸§à¸–à¸¶à¸‡à¹€à¸¡à¸·à¸­à¸‡à¹€à¸à¹ˆà¸² à¹€à¸›à¸´à¸”à¹à¸œà¸™à¸—à¸µà¹ˆà¹€à¸—à¸¨à¸šà¸²à¸¥à¹à¸¥à¹‰à¸§à¸„à¹ˆà¸­à¸¢ à¹† à¸¡à¸­à¸‡à¸«à¸²à¸ˆà¸¸à¸”à¸«à¸¡à¸²à¸¢à¸–à¸±à¸”à¹„à¸›</p>{cta("/map/","à¸à¸²à¸‡à¹à¸œà¸™à¸—à¸µà¹ˆà¹€à¸¡à¸·à¸­à¸‡")}<span class="map-caption">à¹ƒà¸Šà¹‰à¸ à¸²à¸žà¹à¸œà¸™à¸—à¸µà¹ˆà¹€à¸—à¸¨à¸šà¸²à¸¥à¸‰à¸šà¸±à¸šà¸•à¹‰à¸™à¸—à¸²à¸‡</span></div><a class="map-paper" href="/map/" aria-label="à¹€à¸›à¸´à¸”à¹à¸œà¸™à¸—à¸µà¹ˆà¹€à¸—à¸¨à¸šà¸²à¸¥"><img src="/assets/municipal-map.png" width="1358" height="1938" alt="à¹à¸œà¸™à¸—à¸µà¹ˆà¸—à¹ˆà¸­à¸‡à¹€à¸—à¸µà¹ˆà¸¢à¸§à¹€à¸¡à¸·à¸­à¸‡à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸²à¸ˆà¸²à¸à¹€à¸—à¸¨à¸šà¸²à¸¥" loading="lazy"><span class="paper-tag">TAKUA PA Â· TOWN MAP â†—</span></a><span class="map-compass" aria-hidden="true">âœ³</span></section>'

def traditions(ctx):
    order=['new-year-alms','ruler-ceremony','relic-procession','narai-ceremony','vegetarian','chak-phra','loy-krathong']; rows=[]
    for i,id in enumerate(order,1):
        r=ctx['byid'][id]; related=ctx['links'].get(id,[])
        content='<p>à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆà¸—à¸µà¹ˆà¹€à¸à¸µà¹ˆà¸¢à¸§à¸‚à¹‰à¸­à¸‡: '+' Â· '.join(ctx['a'](ctx['byid'][x]) for x in related)+'</p>' if related else '<p>à¸à¸´à¸ˆà¸à¸£à¸£à¸¡à¹ƒà¸™à¸«à¸¡à¸§à¸”à¸›à¸£à¸°à¹€à¸žà¸“à¸µà¸‚à¸­à¸‡à¹€à¸­à¸à¸ªà¸²à¸£à¹€à¸—à¸¨à¸šà¸²à¸¥à¹€à¸¡à¸·à¸­à¸‡à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸²</p>'
        rows.append(f'<details class="tradition"><summary><span class="event-no">0{i}</span><span class="event-name">{e(r["name_th"])}</span><span class="event-period">{ctx["period"](r)}</span><span class="expand-icon" aria-hidden="true">+</span></summary><div class="event-body">{content}<a class="text-link" href="{ctx["url"](r)}">à¸­à¹ˆà¸²à¸™à¸£à¸²à¸¢à¸¥à¸°à¹€à¸­à¸µà¸¢à¸”à¸ˆà¸²à¸à¹€à¸­à¸à¸ªà¸²à¸£ â†—</a></div></details>')
    return '<div class="traditions-list">'+''.join(rows)+'</div>'

def transform(path,body,ctx,record):
    import place_pages
    if record and record['type']=='place': return place_pages.render(record,ctx,GROUPS)
    if path=='/stories/kuapapoh/': return body+place_pages.story_gallery()
    pic=ctx['pic']; intro=ctx['intro']; source=ctx['source']; byid=ctx['byid']
    if path=='/':
        hero=f'''<section class="hero"><div class="hero-topline"><span>PHANG NGA, THAILAND</span><span>à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸‚à¸­à¸‡à¹€à¸¡à¸·à¸­à¸‡ / à¸‰à¸šà¸±à¸šà¸—à¸µà¹ˆ à¹‘</span></div><div class="hero-layout"><div class="hero-copy"><span class="hero-eyebrow"><i></i> à¸„à¸¹à¹ˆà¸¡à¸·à¸­à¹€à¸¡à¸·à¸­à¸‡à¹€à¸à¹ˆà¸²à¸—à¸µà¹ˆà¸Šà¸§à¸™à¸„à¸¸à¸“à¸„à¹ˆà¸­à¸¢ à¹† à¹€à¸”à¸´à¸™</span><h1>à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸²<span class="hero-title-bottom">à¹€à¸¡à¸·à¸­à¸‡à¹€à¸¥à¹ˆà¸²à¹€à¸£à¸·à¹ˆà¸­à¸‡<em>101</em></span></h1><p>à¸œà¹ˆà¸²à¸™à¸›à¸£à¸°à¸•à¸¹à¸¨à¸²à¸¥à¹€à¸ˆà¹‰à¸² à¸¡à¸­à¸‡à¸«à¸™à¹‰à¸²à¸•à¹ˆà¸²à¸‡à¸šà¹‰à¸²à¸™à¹€à¸à¹ˆà¸²<br>à¹à¸¥à¹‰à¸§à¸£à¸¹à¹‰à¸ˆà¸±à¸à¹€à¸¡à¸·à¸­à¸‡à¸­à¸µà¸à¸™à¸´à¸” à¹ƒà¸™à¸—à¸¸à¸à¸ˆà¸¸à¸”à¸—à¸µà¹ˆà¹à¸§à¸°</p><div class="hero-actions">{cta('#places','à¹€à¸¥à¸·à¸­à¸à¸ˆà¸¸à¸”à¸«à¸¡à¸²à¸¢à¸‚à¸­à¸‡à¸„à¸¸à¸“')}<a class="text-link" href="/map/">à¹€à¸›à¸´à¸”à¹à¸œà¸™à¸—à¸µà¹ˆ â†—</a></div><div class="hero-footnote"><span class="tiny-star" aria-hidden="true">âœ³</span><span>20 à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆ Â· 7 à¸›à¸£à¸°à¹€à¸žà¸“à¸µ Â· {SHOP_TOTAL} à¸£à¹‰à¸²à¸™<br>à¸•à¸±à¹‰à¸‡à¸•à¹‰à¸™à¸ˆà¸²à¸à¹à¸œà¹ˆà¸™à¸žà¸±à¸šà¹€à¸—à¸¨à¸šà¸²à¸¥à¹€à¸¡à¸·à¸­à¸‡à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸² à¹à¸¥à¹‰à¸§à¸„à¹‰à¸™à¹€à¸žà¸´à¹ˆà¸¡à¸žà¸£à¹‰à¸­à¸¡à¹à¸«à¸¥à¹ˆà¸‡à¸—à¸µà¹ˆà¸¡à¸²</span></div></div><div class="hero-collage"><div class="collage-ring" aria-hidden="true"></div><span class="stamp">TAKUA PA<br><strong>à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸²</strong><br>OLD TOWN</span><a class="postcard postcard-main" href="/places/tao-ming/">{pic('tao-ming',True)}<span><b>01 / à¸•à¸¶à¸à¹€à¸à¹ˆà¸²</b> à¹‚à¸£à¸‡à¹€à¸£à¸µà¸¢à¸™à¹€à¸•à¹‰à¸²à¸«à¸¡à¸´à¸‡ â†—</span></a><a class="postcard postcard-left" href="/places/guan-yu/">{pic('guan-yu',True)}<span>à¸¨à¸£à¸±à¸—à¸˜à¸²à¸‚à¸­à¸‡à¸Šà¸¸à¸¡à¸Šà¸™ â†—</span></a><a class="postcard postcard-right" href="/places/khun-in/">{pic('khun-in',True)}<span>à¸«à¸™à¹‰à¸²à¸•à¹ˆà¸²à¸‡à¸ªà¸¹à¹ˆà¸§à¸±à¸™à¸§à¸²à¸™ â†—</span></a><span class="collage-note">à¹€à¸à¹‡à¸šà¹€à¸£à¸·à¹ˆà¸­à¸‡à¸