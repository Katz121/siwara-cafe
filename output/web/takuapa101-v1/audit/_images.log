tItem", "position": 22, "url": "https://takuapa101.com/places/phra-narai/"}, {"@type": "ListItem", "position": 23, "url": "https://takuapa101.com/places/riverwalk/"}, {"@type": "ListItem", "position": 24, "url": "https://takuapa101.com/places/culture-street/"}, {"@type": "ListItem", "position": 25, "url": "https://takuapa101.com/places/food-center/"}, {"@type": "ListItem", "position": 26, "url": "https://takuapa101.com/traditions/new-year-alms/"}, {"@type": "ListItem", "position": 27, "url": "https://takuapa101.com/traditions/ruler-ceremony/"}, {"@type": "ListItem", "position": 28, "url": "https://takuapa101.com/traditions/relic-procession/"}, {"@type": "ListItem", "position": 29, "url": "https://takuapa101.com/traditions/narai-ceremony/"}, {"@type": "ListItem", "position": 30, "url": "https://takuapa101.com/traditions/vegetarian/"}, {"@type": "ListItem", "position": 31, "url": "https://takuapa101.com/traditions/chak-phra/"}, {"@type": "ListItem", "position": 32, "url": "https://takuapa101.com/traditions/loy-krathong/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/"></head><body class="home"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><section class="hero"><div class="hero-topline"><span>PHANG NGA, THAILAND</span><span>เรื่องของเมือง / ฉบับที่ ๑</span></div><div class="hero-layout"><div class="hero-copy"><span class="hero-eyebrow"><i></i> คู่มือเมืองเก่าที่ชวนคุณค่อย ๆ เดิน</span><h1>ตะกั่วป่า<span class="hero-title-bottom">เมืองเล่าเรื่อง<em>101</em></span></h1><p>ผ่านประตูศาลเจ้า มองหน้าต่างบ้านเก่า<br>แล้วรู้จักเมืองอีกนิด ในทุกจุดที่แวะ</p><div class="hero-actions"><a class="button" href="#places">เลือกจุดหมายของคุณ<span aria-hidden="true">↗</span></a><a class="text-link" href="/map/">เปิดแผนที่ ↗</a></div><div class="hero-footnote"><span class="tiny-star" aria-hidden="true">✳</span><span>20 สถานที่ · 7 ประเพณี · 108 ร้าน<br>ตั้งต้นจากแผ่นพับเทศบาลเมืองตะกั่วป่า แล้วค้นเพิ่มพร้อมแหล่งที่มา</span></div></div><div class="hero-collage"><div class="collage-ring" aria-hidden="true"></div><span class="stamp">TAKUA PA<br><strong>ตะกั่วป่า</strong><br>OLD TOWN</span><a class="postcard postcard-main" href="/places/tao-ming/"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" width="1000" height="667" loading="eager"><span><b>01 / ตึกเก่า</b> โรงเรียนเต้าหมิง ↗</span></a><a class="postcard postcard-left" href="/places/guan-yu/"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="eager"><span>ศรัทธาของชุมชน ↗</span></a><a class="postcard postcard-right" href="/places/khun-in/"><img src="/assets/khun-in.webp" alt="บ้านขุนอินทร์" width="1000" height="1000" loading="eager"><span>หน้าต่างสู่วันวาน ↗</span></a><span class="collage-note">เก็บเรื่องราวระหว่างทาง</span><span class="collage-spark" aria-hidden="true">✳</span></div></div><div class="hero-bottom"><span>วัดและเจดีย์</span><i>✳</i><span>ศาลเจ้า</span><i>✳</i><span>บ้านเก่า</span><i>✳</i><span>ตลาดริมน้ำ</span><a href="#start">เริ่มเปิดอ่าน ↓</a></div></section><nav class="quick-start" aria-label="เริ่มต้นใช้งาน"><h2 class="visually-hidden">เริ่มที่นี่</h2><a class="quick-card" href="/map/" data-qs="map"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>กางแผนที่</b><small>ดูว่าอะไรอยู่ตรงไหน</small></span></a><a class="quick-card" href="/places/" data-qs="places"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>เที่ยวไหนดี</b><small>20 สถานที่ในเมืองเก่า</small></span></a><a class="quick-card" href="/eat/" data-qs="eat"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>กินอะไรดี</b><small>108 ร้านในย่าน</small></span></a><a class="quick-card" href="/trip/" data-qs="trip"><span class="qs-icon" aria-hidden="true"></span><span class="qs-text"><b>จัดทริปของฉัน</b><small>เลือกเก็บไว้ แล้วเดินตามลำดับ</small></span><span class="qs-badge" data-trip-count hidden>0</span></a></nav><section id="start" class="section"><div class="section-heading"><div><span class="chapter">01 / เปิดอ่านเมือง</span><h2>เริ่มจากเรื่องที่คุณสนใจ</h2></div><p>สามเส้นทางอ่านเมือง · เลือกจุดแวะในแบบของคุณ</p></div><div class="route-cards"><a class="route-card" href="/routes/#route-1"><div class="route-art"><img src="/assets/wat-boromthat.webp" alt="วัดบรมธาตุคีรีเขต (วัดลุ่ม)" width="1000" height="1000" loading="lazy"><span class="route-no">01</span></div><div class="route-copy"><span class="eyebrow">อ่านเมืองผ่านศรัทธา</span><h3>เส้นวัดและเจดีย์</h3><span class="route-footer">6 จุดหมาย <span aria-hidden="true">↗</span></span></div></a><a class="route-card" href="/routes/#route-2"><div class="route-art"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="lazy"><span class="route-no">02</span></div><div class="route-copy"><span class="eyebrow">มองเรื่องราวของชุมชนจีน</span><h3>เส้นศาลเจ้าและโรงเจ</h3><span class="route-footer">4 จุดหมาย <span aria-hidden="true">↗</span></span></div></a><a class="route-card" href="/routes/#route-3"><div class="route-art"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" width="1000" height="667" loading="lazy"><span class="route-no">03</span></div><div class="route-copy"><span class="eyebrow">ตามรอยอาคาร การค้า และผู้คน</span><h3>เส้นตึกเก่าและตลาดริมน้ำ</h3><span class="route-footer">6 จุดหมาย <span aria-hidden="true">↗</span></span></div></a><a class="route-card" href="/routes/#route-4"><div class="route-art"><img src="/assets/khun-in.webp" alt="บ้านขุนอินทร์" width="1000" height="1000" loading="lazy"><span class="route-no">04</span></div><div class="route-copy"><span class="eyebrow">เหมาะกับคนมีเวลาครึ่งวัน</span><h3>เดินสั้นจากบ้านไม้</h3><span class="route-footer">4 จุดหมาย <span aria-hidden="true">↗</span></span></div></a></div></section><section class="section city-feed" id="city-feed"><div class="section-heading"><div><span class="chapter">02 / เปิดอ่านเมือง</span><h2>กระทู้และข่าวสารของเมือง</h2></div><p>เรื่องเล่าที่เรียบเรียงไว้ และความเคลื่อนไหวล่าสุดในตะกั่วป่า</p></div><div class="city-feed-grid"><div class="cf-stories"><h3 class="cf-title">เรื่องเล่าของเมือง</h3><div class="story-tiles"><a class="story-tile story-tile-lead" href="/stories/city/"><span class="sc-img"><img src="/assets/riverwalk.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">รู้จักเมือง</span><b>ตะกั่วป่า เมืองที่ย้ายตัวเองตามสายน้ำ</b><p>จากชุมชนโบราณบนเส้นทางข้ามคาบสมุทร สู่เมืองตลาดและเมืองเหมืองแร่ · เรื่องที่ยืนยันได้และปริศนาที่ยังรอคำตอบ</p><small>6 นาที</small></span></a><a class="story-tile" href="/stories/architecture/"><span class="sc-img"><img src="/assets/culture-street.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">บ้านเก่าและสถาปัตยกรรม</span><b>ตึกที่สร้างด้วยเงินดีบุกและเหล็กจากเรือขุดแร่ · สถาปัตยกรรมที่จำเมืองไว้</b><p>อ่านเมืองตะกั่วป่าผ่านตึกแถวบนถนนสายวัฒนธรรม สะพานเหล็กบุญสูง จวนเจ้าเมือง และโรงเรียนเต้าหมิง · การเปลี่ยนผ่านที่ฝังอยู่ในอิฐ ปูน และโครงสร้างเหล็ก</p><small>6 นาที</small></span></a><a class="story-tile" href="/stories/water-trade/"><span class="sc-img"><img src="/assets/iron-bridge.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">สายน้ำและการค้า</span><b>จากทุ่งตึกถึงแม่น้ำตะกั่วป่า: วันที่สายน้ำสร้างเมือง</b><p>สายน้ำไม่ได้เป็นเพียงฉากหลัง แต่มันคือเส้นทาง ผู้เชื่อมคน และตัวกำหนดชะตาเมืองที่ต้องย้ายตามตะกอนน้ำ</p><small>7 นาที</small></span></a><a class="story-tile" href="/stories/food-people/"><span class="sc-img"><img src="/assets/food-center.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">ผู้คนและรสชาติ</span><b>รสชาติของชุมชนบาบ๋าและตลาดเก่า</b><p>อาหารเป็นทั้งความทรงจำของครัวเรือนและหลักฐานของการแลกเปลี่ยน · ลองอ่านตะกั่วป่าผ่านสำรับบาบ๋า เต้าส้อสองชั้น และถนนสายวัฒนธรรม</p><small>7 นาที</small></span></a><a class="story-tile" href="/stories/kuapapoh/"><span class="sc-img"><img src="/assets/tao-ming.webp" alt="" loading="lazy"></span><span class="sc-body"><span class="chapter">กระทู้เมือง</span><b>กั่วป่าโพ้: วันที่บ้านเก่าลุกขึ้นมาเล่าเรื่องตัวเอง</b><p>โครงการพื้นที่สร้างสรรค์ที่ปลุกบ้านเลขที่ 78, 109 และ 305 ให้กลับมามีลมหายใจ · สิ่งที่คนรุ่นใหม่เล่าเมือง และสิ่งที่ประวัติศาสตร์ยังต้องค้นหา</p><small>6 นาที</small></span></a></div><a class="text-link" href="/stories/">อ่านเรื่องเล่าทั้งหมด ↗</a></div><div class="cf-news"><h3 class="cf-title">ความเคลื่อนไหวล่าสุด</h3><ol class="news-list" data-news-list data-news-max="4" data-news-keep="10"><li class="news-row"><span class="news-date">4/5/2569</span><span class="news-main"><b>ไหว้พระขอพร ศาลเจ้ากู่ใช่ตึ๋ง จ.พังงา</b><span class="news-meta"><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a> · NBT2HD</span><a class="news-out" href="https://www.youtube.com/watch?v=q6K2Zl6700I" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">13/4/2569</span><span class="news-main"><b>พังงาจัดใหญ่ สืบสานสงกรานต์ ตักบาตรเมืองเก่าตะกั่วป่า เสริมสิริมงคลปีใหม่ไทย</b><span class="news-meta"><a href="/traditions/">ตักบาตรยามรุ่ง รับอรุณปีใหม่</a> · TOPNEWS</span><a class="news-out" href="https://www.topnews.co.th/news/1546452" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">13/4/2569</span><span class="news-main"><b>ตะกั่วป่าสะพรั่ง! ย้อนรอยเสน่ห์เมืองเก่าในงาน Takuapa Oldtown Songkran Festival 2026</b><span class="news-meta"><a href="/traditions/">ตักบาตรยามรุ่ง รับอรุณปีใหม่</a> · MGR Online</span><a class="news-out" href="https://mgronline.com/onlinesection/detail/9690000036775" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">8/3/2569</span><span class="news-main"><b>โรงเรียนตะกั่วป่าคีรีเขตร่วมกิจกรรม Takuapa Walk Rally 2026</b><span class="news-meta"><a href="/places/thung-phra/">สวนสาธารณะทุ่งพระโพธิ์</a> · โรงเรียนตะกั่วป่าคีรีเขต</span><a class="news-out" href="https://www.keereekatschool.ac.th/gallery-detail_1497" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">1/3/2569</span><span class="news-main"><b>จังหวัดพังงาจัดงาน จากตะโกลา สู่ตะกั่วป่า ครั้งที่ 12</b><span class="news-meta"><a href="/places/museum/">พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า</a> · สถานีวิทยุกระจายเสียงแห่งประเทศไทย</span><span class="news-out news-out-offline">ข่าวต้นทางถูกถอดออกแล้ว · ตรวจเมื่อ 8 ก.ย. 2569</span></span></li><li class="news-row"><span class="news-date">21/2/2569</span><span class="news-main"><b>งานเมืองเก่าเล่าเรื่อง ณ โรงเรียนเต้าหมิง ตะกั่วป่า</b><span class="news-meta"><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a> · YOUPHUKET</span><a class="news-out" href="https://youphuket.club/author/admin/page/58/" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">30/1/2569</span><span class="news-main"><b>ชวนเช็กอิน สะพานเหล็กบุญสูง มรดกเหมืองแร่ เมืองตะกั่วป่า</b><span class="news-meta"><a href="/places/iron-bridge/">สะพานเหล็กบุญสูง</a> · NBT2HD</span><a class="news-out" href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li><li class="news-row"><span class="news-date">5/11/2568</span><span class="news-main"><b>กิจกรรมลอยกระทงที่คลองตะกั่วป่าและคลองบางม่วง</b><span class="news-meta"><a href="/traditions/">ลอยกระทง</a> · กรมทรัพยากรทางทะเลและชายฝั่ง</span><a class="news-out" href="https://newweb.dmcr.go.th/detailAll/81026/nws/258" target="_blank" rel="noopener">อ่านข่าวต้นทาง ↗</a></span></li></ol><p class="small" data-news-updated hidden></p><a class="text-link" href="/news/">ดูความเคลื่อนไหวทั้งหมด ↗</a><p class="small">รวบรวมจากข่าวสาธารณะ · ตรวจกำหนดการกับผู้จัดก่อนเดินทาง</p></div></div></section><section class="map-teaser"><div class="map-teaser-copy"><span class="chapter">กางแผนที่ / แล้วออกไปรู้จักเมือง</span><h2>ตรอกไหน ถนนไหน<br><em>มีเรื่องรออยู่</em></h2><p>จากย่านยาวถึงเมืองเก่า เปิดแผนที่เทศบาลแล้วค่อย ๆ มองหาจุดหมายถัดไป</p><a class="button" href="/map/">กางแผนที่เมือง<span aria-hidden="true">↗</span></a><span class="map-caption">ใช้ภาพแผนที่เทศบาลฉบับต้นทาง</span></div><a class="map-paper" href="/map/" aria-label="เปิดแผนที่เทศบาล"><img src="/assets/municipal-map.png" width="1358" height="1938" alt="แผนที่ท่องเที่ยวเมืองตะกั่วป่าจากเทศบาล" loading="lazy"><span class="paper-tag">TAKUA PA · TOWN MAP ↗</span></a><span class="map-compass" aria-hidden="true">✳</span></section><section id="places" class="section"><div class="section-heading"><div><span class="chapter">03 / เปิดอ่านเมือง</span><h2>เมืองเดียว หลายมุมให้รู้จัก</h2></div><p>สถานที่ทั้ง 20 แห่ง จากหน้ากระดาษสู่เรื่องเล่าของเมือง</p></div><div class="explorer" data-explorer><div class="explorer-tools"><div class="filter-tabs" role="group" aria-label="หมวดสถานที่"><button type="button" data-filter="all" aria-pressed="true">ทั้งหมด <sup>20</sup></button><button type="button" data-filter="temple" aria-pressed="false">วัดและเจดีย์ <sup>6</sup></button><button type="button" data-filter="shrine" aria-pressed="false">ศาลเจ้าและโรงเจ <sup>4</sup></button><button type="button" data-filter="heritage" aria-pressed="false">ตึกเก่าและร่องรอยเมือง <sup>4</sup></button><button type="button" data-filter="park" aria-pressed="false">สวนและพื้นที่สาธารณะ <sup>2</sup></button><button type="button" data-filter="market" aria-pressed="false">ตลาดและของกิน <sup>3</sup></button><button type="button" data-filter="museum" aria-pressed="false">พิพิธภัณฑ์ <sup>1</sup></button></div></div><div class="explorer-status"><span data-place-count role="status" aria-live="polite">20 สถานที่ให้ค่อย ๆ รู้จัก</span><span>เลือกภาพเพื่อเปิดอ่าน ↗</span></div><h2 class="visually-hidden">รายชื่อสถานที่ทั้งหมด</h2><div class="places-grid"><article class="place-card" data-place-card data-category="temple" data-name="วัดบรมธาตุคีรีเขต (วัดลุ่ม)"><a class="place-image" href="/places/wat-boromthat/"><img src="/assets/wat-boromthat.webp" alt="วัดบรมธาตุคีรีเขต (วัดลุ่ม)" width="1000" height="1000" loading="lazy"><span class="card-index">01</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-boromthat/">วัดบรมธาตุคีรีเขต (วัดลุ่ม)</a></h3><p>เจดีย์สีขาวกับศรัทธาของเมือง</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดคุหาภิมุข (วัดควนถ้ำ)"><a class="place-image" href="/places/wat-khuha/"><img src="/assets/wat-khuha.webp" alt="วัดคุหาภิมุข (วัดควนถ้ำ)" width="1000" height="1000" loading="lazy"><span class="card-index">02</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-khuha/">วัดคุหาภิมุข (วัดควนถ้ำ)</a></h3><p>รายละเอียดเล็กที่ชวนให้หยุดมอง</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดปทุมธารา (วัดหน้าเมือง)"><a class="place-image" href="/places/wat-pathum/"><img src="/assets/wat-pathum.webp" alt="วัดปทุมธารา (วัดหน้าเมือง)" width="1000" height="1000" loading="lazy"><span class="card-index">03</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-pathum/">วัดปทุมธารา (วัดหน้าเมือง)</a></h3><p>โบสถ์เก่ากับเรื่องราวทางน้ำ</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดคงคาภิมุข (วัดคงคา)"><a class="place-image" href="/places/wat-kongkha/"><img src="/assets/wat-kongkha.webp" alt="วัดคงคาภิมุข (วัดคงคา)" width="1000" height="1000" loading="lazy"><span class="card-index">04</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-kongkha/">วัดคงคาภิมุข (วัดคงคา)</a></h3><p>เส้นสายอุโบสถแบบปักษ์ใต้</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดนิกรวราราม (วัดย่านยาว)"><a class="place-image" href="/places/wat-nikorn/"><img src="/assets/wat-nikorn.webp" alt="วัดนิกรวราราม (วัดย่านยาว)" width="1000" height="726" loading="lazy"><span class="card-index">05</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a></h3><p>วัดกับความทรงจำของชุมชน</p></div></article><article class="place-card" data-place-card data-category="temple" data-name="วัดเสนานุชรังสรรค์ (วัดใหม่)"><a class="place-image" href="/places/wat-sena/"><img src="/assets/wat-sena.webp" alt="วัดเสนานุชรังสรรค์ (วัดใหม่)" width="1000" height="1000" loading="lazy"><span class="card-index">06</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">วัดและเจดีย์</span><h3><a href="/places/wat-sena/">วัดเสนานุชรังสรรค์ (วัดใหม่)</a></h3><p>ร่องรอยไทยและจีนในอาคารเดียวกัน</p></div></article><article class="place-card" data-place-card data-category="shrine" data-name="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง"><a class="place-image" href="/places/guan-yu/"><img src="/assets/guan-yu.webp" alt="ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง" width="1000" height="1000" loading="lazy"><span class="card-index">08</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ศาลเจ้าและโรงเจ</span><h3><a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a></h3><p>ประตูสีแดงกับศรัทธาของชุมชน</p></div></article><article class="place-card" data-place-card data-category="shrine" data-name="ศาลเจ้าปุนเถ่ากงอ๊า"><a class="place-image" href="/places/pun-thao/"><img src="/assets/pun-thao.webp" alt="ศาลเจ้าปุนเถ่ากงอ๊า" width="1000" height="1000" loading="lazy"><span class="card-index">09</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ศาลเจ้าและโรงเจ</span><h3><a href="/places/pun-thao/">ศาลเจ้าปุนเถ่ากงอ๊า</a></h3><p>ศรัทธาในย่านท่าเรือเก่า</p></div></article><article class="place-card" data-place-card data-category="shrine" data-name="ศาลเจ้ากู่ใช่ตึ๋ง"><a class="place-image" href="/places/kue-chai/"><img src="/assets/kue-chai.webp" alt="ศาลเจ้ากู่ใช่ตึ๋ง" width="1000" height="1000" loading="lazy"><span class="card-index">10</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ศาลเจ้าและโรงเจ</span><h3><a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a></h3><p>พื้นที่ฝากความหวังของผู้คน</p></div></article><article class="place-card" data-place-card data-category="shrine" data-name="โรงเจในสวน"><a class="place-image" href="/places/rong-jae/"><img src="/assets/rong-jae.webp" alt="โรงเจในสวน" width="1000" height="1000" loading="lazy"><span class="card-index">11</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ศาลเจ้าและโรงเจ</span><h3><a href="/places/rong-jae/">โรงเจในสวน</a></h3><p>ประเพณีที่ส่งต่อผ่านสถานที่</p></div></article><article class="place-card" data-place-card data-category="heritage" data-name="สะพานเหล็กบุญสูง"><a class="place-image" href="/places/iron-bridge/"><img src="/assets/iron-bridge.webp" alt="สะพานเหล็กบุญสูง" width="1000" height="1000" loading="lazy"><span class="card-index">16</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ตึกเก่าและร่องรอยเมือง</span><h3><a href="/places/iron-bridge/">สะพานเหล็กบุญสูง</a></h3><p>โครงเหล็กที่เชื่อมเรื่องเหมืองแร่</p></div></article><article class="place-card" data-place-card data-category="heritage" data-name="กำแพงจวนเจ้าเมืองตะกั่วป่า"><a class="place-image" href="/places/governor-wall/"><img src="/assets/governor-wall.webp" alt="กำแพงจวนเจ้าเมืองตะกั่วป่า" width="1000" height="1000" loading="lazy"><span class="card-index">17</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ตึกเก่าและร่องรอยเมือง</span><h3><a href="/places/governor-wall/">กำแพงจวนเจ้าเมืองตะกั่วป่า</a></h3><p>ร่องรอยบนกำแพงที่เล่าเรื่องเมือง</p></div></article><article class="place-card" data-place-card data-category="heritage" data-name="บ้านขุนอินทร์"><a class="place-image" href="/places/khun-in/"><img src="/assets/khun-in.webp" alt="บ้านขุนอินทร์" width="1000" height="1000" loading="lazy"><span class="card-index">18</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ตึกเก่าและร่องรอยเมือง</span><h3><a href="/places/khun-in/">บ้านขุนอินทร์</a></h3><p>หน้าต่างและระเบียงชวนมองอดีต</p></div></article><article class="place-card" data-place-card data-category="heritage" data-name="โรงเรียนเต้าหมิง"><a class="place-image" href="/places/tao-ming/"><img src="/assets/tao-ming.webp" alt="โรงเรียนเต้าหมิง" width="1000" height="667" loading="lazy"><span class="card-index">19</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ตึกเก่าและร่องรอยเมือง</span><h3><a href="/places/tao-ming/">โรงเรียนเต้าหมิง</a></h3><p>อาคารที่ส่งต่อภาษาและวัฒนธรรม</p></div></article><article class="place-card" data-place-card data-category="park" data-name="สวนสาธารณะพระนารายณ์"><a class="place-image" href="/places/phra-narai/"><img src="/assets/phra-narai.webp" alt="สวนสาธารณะพระนารายณ์" width="1000" height="1000" loading="lazy"><span class="card-index">12</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">สวนและพื้นที่สาธารณะ</span><h3><a href="/places/phra-narai/">สวนสาธารณะพระนารายณ์</a></h3><p>พื้นที่พักกับเรื่องราวความเชื่อ</p></div></article><article class="place-card" data-place-card data-category="park" data-name="สวนสาธารณะทุ่งพระโพธิ์"><a class="place-image" href="/places/thung-phra/"><img src="/assets/thung-phra.webp" alt="สวนสาธารณะทุ่งพระโพธิ์" width="1000" height="1000" loading="lazy"><span class="card-index">13</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">สวนและพื้นที่สาธารณะ</span><h3><a href="/places/thung-phra/">สวนสาธารณะทุ่งพระโพธิ์</a></h3><p>ร่องรอยเรือกลไฟกลางสวน</p></div></article><article class="place-card" data-place-card data-category="market" data-name="ตลาดริมน้ำตะกั่วป่า"><a class="place-image" href="/places/riverwalk/"><img src="/assets/riverwalk.webp" alt="ตลาดริมน้ำตะกั่วป่า" width="1000" height="1000" loading="lazy"><span class="card-index">14</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ตลาดและของกิน</span><h3><a href="/places/riverwalk/">ตลาดริมน้ำตะกั่วป่า</a></h3><p>อาหารและชีวิตริมแม่น้ำ</p></div></article><article class="place-card" data-place-card data-category="market" data-name="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า"><a class="place-image" href="/places/culture-street/"><img src="/assets/culture-street.webp" alt="ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า" width="1000" height="1000" loading="lazy"><span class="card-index">15</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ตลาดและของกิน</span><h3><a href="/places/culture-street/">ถนนสายวัฒนธรรมเมืองเก่าตะกั่วป่า</a></h3><p>เดินอ่านเมืองผ่านอาคารและผู้คน</p></div></article><article class="place-card" data-place-card data-category="market" data-name="ศูนย์อาหารลานโล่งตะกั่วป่า"><a class="place-image" href="/places/food-center/"><img src="/assets/food-center.webp" alt="ศูนย์อาหารลานโล่งตะกั่วป่า" width="1000" height="1000" loading="lazy"><span class="card-index">20</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">ตลาดและของกิน</span><h3><a href="/places/food-center/">ศูนย์อาหารลานโล่งตะกั่วป่า</a></h3><p>หลายรสชาติในจุดหมายเดียว</p></div></article><article class="place-card" data-place-card data-category="museum" data-name="พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า"><a class="place-image" href="/places/museum/"><img src="/assets/museum.webp" alt="พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า" width="1000" height="1000" loading="lazy"><span class="card-index">07</span><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-copy"><span class="eyebrow">พิพิธภัณฑ์</span><h3><a href="/places/museum/">พิพิธภัณฑ์เสนานุชรังสรรค์ชุมชนตะกั่วป่า</a></h3><p>เก็บเรื่องเล่าของเมืองไว้ด้วยกัน</p></div></article></div><div class="empty-state" data-place-empty hidden><h3>ยังไม่เจอจุดหมายนี้</h3><p>ลองคำค้นอื่น หรือเลือกดูสถานที่ทั้งหมด</p><button type="button" data-clear-places>ล้างตัวกรอง</button></div></div><a class="text-link index-link" href="/places/">เปิดดัชนีและค้นหาสถานที่ ↗</a></section><section class="section traditions-section"><div class="section-heading"><div><span class="chapter">04 / เปิดอ่านเมือง</span><h2>เมื่อเมืองมีนัดหมาย</h2></div><p>ประเพณีตลอดปี · ช่วงเวลาตามเอกสารต้นทาง</p></div><div class="traditions-list"><details class="tradition"><summary><span class="event-no">01</span><span class="event-name">ตักบาตรยามรุ่ง รับอรุณปีใหม่</span><span class="event-period">1 มกราคม</span><span class="expand-icon" aria-hidden="true">+</span></summary><div class="event-body"><p>กิจกรรมในหมวดประเพณีของเอกสารเทศบาลเมืองตะกั่วป่า</p><a class="text-link" href="/traditions/new-year-alms/">อ่านรายละเอียดจากเอกสาร ↗</a></div></details><details class="tradition"><summary><span class="event-no">02</span><span class="event-name">พิธีบวงสรวงเจ้าเมืองตะกั่วป่า</span><span class="event-period">กุมภาพันธ์</span><span class="expand-icon" aria-hidden="true">+</span></summary><div class="event-body"><p>สถานที่ที่เกี่ยวข้อง: <a href="/places/governor-wall/">กำแพงจวนเจ้าเมืองตะกั่วป่า</a></p><a class="text-link" href="/traditions/ruler-ceremony/">อ่านรายละเอียดจากเอกสาร ↗</a></div></details><details class="tradition"><summary><span class="event-no">03</span><span class="event-name">ขบวนแห่อัญเชิญพระบรมสารีริกธาตุขึ้นเขาพระบาท</span><span class="event-period">วันมาฆบูชา</span><span class="expand-icon" aria-hidden="true">+</span></summary><div class="event-body"><p>สถานที่ที่เกี่ยวข้อง: <a href="/places/wat-boromthat/">วัดบรมธาตุคีรีเขต (วัดลุ่ม)</a></p><a class="text-link" href="/traditions/relic-procession/">อ่านรายละเอียดจากเอกสาร ↗</a></div></details><details class="tradition"><summary><span class="event-no">04</span><span class="event-name">พิธีบวงสรวงองค์เทวรูปพระนารายณ์และเทพบริวาร</span><span class="event-period">มีนาคม · เมษายน</span><span class="expand-icon" aria-hidden="true">+</span></summary><div class="event-body"><p>สถานที่ที่เกี่ยวข้อง: <a href="/places/phra-narai/">สวนสาธารณะพระนารายณ์</a></p><a class="text-link" href="/traditions/narai-ceremony/">อ่านรายละเอียดจากเอกสาร ↗</a></div></details><details class="tradition"><summary><span class="event-no">05</span><span class="event-name">ประเพณีกินผัก (เจี๊ยะกิ๊วอ๋องฉ่าย)</span><span class="event-period">วันที่ 1 ถึง 9 เดือน 9 ตามปฏิทินจีน · โดยมากกันยายนถึงตุลาคม</span><span class="expand-icon" aria-hidden="true">+</span></summary><div class="event-body"><p>สถานที่ที่เกี่ยวข้อง: <a href="/places/guan-yu/">ศาลเจ้าพ่อกวนอู ซิ่นไช่ตึ๋ง</a> · <a href="/places/pun-thao/">ศาลเจ้าปุนเถ่ากงอ๊า</a> · <a href="/places/kue-chai/">ศาลเจ้ากู่ใช่ตึ๋ง</a> · <a href="/places/rong-jae/">โรงเจในสวน</a></p><a class="text-link" href="/traditions/vegetarian/">อ่านรายละเอียดจากเอกสาร ↗</a></div></details><details class="tradition"><summary><span class="event-no">06</span><span class="event-name">ประเพณีชักพระ</span><span class="event-period">วันถัดจากวันออกพรรษา</span><span class="expand-icon" aria-hidden="true">+</span></summary><div class="event-body"><p>สถานที่ที่เกี่ยวข้อง: <a href="/places/wat-boromthat/">วัดบรมธาตุคีรีเขต (วัดลุ่ม)</a> · <a href="/places/wat-khuha/">วัดคุหาภิมุข (วัดควนถ้ำ)</a> · <a href="/places/wat-pathum/">วัดปทุมธารา (วัดหน้าเมือง)</a> · <a href="/places/wat-kongkha/">วัดคงคาภิมุข (วัดคงคา)</a> · <a href="/places/wat-nikorn/">วัดนิกรวราราม (วัดย่านยาว)</a> · <a href="/places/wat-sena/">วัดเสนานุชรังสรรค์ (วัดใหม่)</a></p><a class="text-link" href="/traditions/chak-phra/">อ่านรายละเอียดจากเอกสาร ↗</a></div></details><details class="tradition"><summary><span class="event-no">07</span><span class="event-name">ลอยกระทง</span><span class="event-period">ขึ้น 15 ค่ำ เดือน 12 · เอกสารระบุพฤศจิกายน</span><span class="expand-icon" aria-hidden="true">+</span></summary><div class="event-body"><p>สถานที่ที่เกี่ยวข้อง: <a href="/places/riverwalk/">ตลาดริมน้ำตะกั่วป่า</a></p><a class="text-link" href="/traditions/loy-krathong/">อ่านรายละเอียดจากเอกสาร ↗</a></div></details></div><p class="small">ตรวจสอบกำหนดการของแต่ละปีก่อนเดินทาง</p></section><section class="food-feature"><div class="food-feature-image"><img src="/assets/food-center.webp" alt="ศูนย์อาหารลานโล่งตะกั่วป่า" width="1000" height="1000" loading="lazy"><span class="food-stamp">LOCAL<br>FLAVOURS</span></div><div class="food-feature-copy"><span class="chapter">05 / กินและซื้อของฝากในย่าน</span><h2>รู้จักเมือง<br>ผ่านอีกรสชาติ</h2><p>เปิดรายชื่อร้านอาหาร เครื่องดื่ม และของฝาก<br>108 ร้าน เริ่มจากแผ่นพับเทศบาลแล้วค้นเพิ่ม</p><div class="food-counts"><span><b>32</b>อาหาร</span><span><b>20</b>เครื่องดื่ม</span><span><b>08</b>ของฝาก</span></div><a class="button" href="/eat/">หาร้านในย่าน<span aria-hidden="true">↗</span></a></div></section><section class="about-strip"><span class="chapter">บันทึกจากบ้านศิวรา</span><h2>เรื่องของเมือง<br>ที่อยากชวนคุณรู้จัก</h2><div><p>ตะกั่วป่า 101 รวบรวมข้อมูลจากแผ่นพับเทศบาลเมืองตะกั่วป่า พร้อมที่มาและขอบเขตข้อมูลให้คุณอ่านต่อได้</p><a class="text-link" href="/about/">รู้จักคู่มือเล่มนี้ ↗</a></div></section></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/" aria-current="page"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
site\stories\water-trade\index.html:1:<!doctype html><html lang="th" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ทุ่งตึกและแม่น้ำตะกั่วป่า เส้นทางการค้าโบราณ · ตะกั่วป่า 101</title><meta name="description" content="สายน้ำไม่ได้เป็นเพียงฉากหลัง แต่มันคือเส้นทาง ผู้เชื่อมคน และตัวกำหนดชะตาเมืองที่ต้องย้ายตามตะกอนน้ำ"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="ทุ่งตึกและแม่น้ำตะกั่วป่า เส้นทางการค้าโบราณ"><meta property="og:description" content="สายน้ำไม่ได้เป็นเพียงฉากหลัง แต่มันคือเส้นทาง ผู้เชื่อมคน และตัวกำหนดชะตาเมืองที่ต้องย้ายตามตะกอนน้ำ"><meta property="og:url" content="https://takuapa101.com/stories/water-trade/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/default.png"><meta property="og:locale" content="th_TH"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/default.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/stories/water-trade/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "ทุ่งตึกและแม่น้ำตะกั่วป่า เส้นทางการค้าโบราณ", "item": "https://takuapa101.com/stories/water-trade/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/stories/water-trade/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/stories/water-trade/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/stories/water-trade/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/" aria-current="page">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/stories/water-trade/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="story-article-v2"><header class="story-hero-v2"><div class="breadcrumbs"><a href="/">หน้าแรก</a><span>/</span><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><span>/</span><span>สายน้ำและการค้า</span></div><span class="eyebrow">เรื่องเล่าตะกั่วป่า · สายน้ำและการค้า</span><h1>จากทุ่งตึกถึงแม่น้ำตะกั่วป่า: วันที่สายน้ำสร้างเมือง</h1><p class="lead">สายน้ำไม่ได้เป็นเพียงฉากหลัง แต่มันคือเส้นทาง ผู้เชื่อมคน และตัวกำหนดชะตาเมืองที่ต้องย้ายตามตะกอนน้ำ</p><p class="story-meta">ปรับปรุงเมื่อ 2026-09-07 · เวลาอ่าน 7 นาที</p></header><figure class="hero-photo-v2"><img src="/assets/photos/kuapapoh-port.webp" alt="ภาพเก่า เรือจอดที่ท่าน้ำตะกั่วป่า" loading="eager"><figcaption><span>ภาพเก่า เรือจอดที่ท่าน้ำตะกั่วป่า</span><span class="credit">คลังภาพโครงการกั่วป่าโพ้</span></figcaption></figure><div class="story-layout-v2"><div class="story-main-v2"><div class="story-lede-v2"><p>ถ้าคุณยืนอยู่ริมแม่น้ำตะกั่วป่าในวันนี้ สายน้ำที่ไหลเอื่อยและเงียบสงบอาจดูเหมือนเป็นเพียงฉากหลังของภูมิทัศน์เมืองเก่า แต่หากเรามองย้อนกลับไปในหน้าประวัติศาสตร์ แม่น้ำสายนี้ไม่เคยหลับใหล มันคือเส้นเลือดใหญ่ที่สูบฉีดความเจริญ ผู้คน และทรัพยากรเข้าสู่พื้นที่มาหลายศตวรรษ</p><p>เมืองตะกั่วป่าไม่ได้ตั้งอยู่ตรงพิกัดเดิมมาตั้งแต่ต้น แต่มันขยับและเติบโตตามเส้นทางน้ำ จากบริเวณพื้นที่ราบใกล้ปากน้ำสู่ย่านตลาดใหญ่ จนถึงวันที่ตะกอนแม่น้ำบีบให้ศูนย์กลางเมืองต้องย้ายอีกครั้ง</p><p>สายน้ำตะกั่วป่าจึงไม่ใช่แค่ภูมิประเทศทางธรรมชาติ แต่เป็นผู้เขียนประวัติศาสตร์ตัวจริงที่พัดพาพาณิชย์นาวีจากทั่วโลกมาเยือน และเป็นผู้กำหนดชะตากรรมของเมืองในวันที่สายน้ำตื้นเขินลง</p></div><section class="story-section-v2"><h2 id="section-0">ทุ่งตึก ท่าเรือก่อนมีเมือง</h2><figure class="section-photo-v2"><img src="/assets/riverwalk.webp" alt="ตลาดริมน้ำตะกั่วป่า" loading="lazy"><figcaption><span>ตลาดริมน้ำตะกั่วป่า</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>ก่อนที่ภาพจำของเมืองตะกั่วป่าจะเป็นอาคารก่ออิฐถือปูนหรือย่านการค้าชิโน-โปรตุกีสอย่างที่เราเห็นในปัจจุบัน ศูนย์กลางการค้าดั้งเดิมของพื้นที่นี้ตั้งอยู่ที่ทุ่งตึก บริเวณที่ราบใกล้ปากแม่น้ำ ทุ่งตึกทำหน้าที่เป็นเมืองท่าการค้าโบราณที่คึกคักบนเส้นทางข้ามคาบสมุทร</p><p>พื้นที่บริเวณปากแม่น้ำแห่งนี้ไม่ได้เติบโตอย่างโดดเดี่ยว แต่เป็นจิ๊กซอว์ชิ้นสำคัญที่เชื่อมโยงกับเครือข่ายการค้าทางทะเลที่กว้างขวาง มันคือจุดแวะพักและสถานที่แลกเปลี่ยนสินค้าของนักเดินทางจากหลากหลายเชื้อชาติ ที่อาศัยกระแสน้ำและลมมรสุมตามฤดูกาลในการสัญจร</p><p>ลำน้ำตะกั่วป่าในยุคนั้นไม่ได้มีไว้เพื่อการสัญจรของคนในท้องถิ่นเพียงอย่างเดียว แต่ถูกใช้เป็นเส้นทางหลักในการเดินทางข้ามคาบสมุทรระหว่างฝั่งทะเลอันดามันและอ่าวไทย ด้วยระยะระหว่างต้นน้ำสองฝั่งที่เอื้ออำนวย เส้นทางนี้ช่วยลดเวลาเดินทางลงได้อย่างมหาศาล</p><p>ที่สำคัญ การใช้เส้นทางแม่น้ำยังช่วยให้นักเดินเรือหลีกเลี่ยงอันตรายและความเสี่ยงจากการต้องเดินเรืออ้อมช่องแคบมะละกาที่ยาวไกล สายน้ำจึงทำหน้าที่เสมือนสะพานเชื่อมสองฝั่งมหาสมุทร พาผู้คน สินค้า และวัฒนธรรมไหลเวียนเข้าสู่พื้นที่อย่างต่อเนื่อง นี่คือปฐมบทของเมืองท่า ก่อนที่ศูนย์กลางความเจริญจะขยับขยายลึกเข้ามาในแผ่นดินตามสายน้ำ</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">ข้อสันนิษฐานสถานะท่าเรือโบราณ</span></div></section><blockquote class="pull-quote-v2"><p>เมืองตะกั่วป่าไม่ได้ตั้งอยู่ตรงพิกัดเดิมมาตั้งแต่ต้น แต่มันขยับและเติบโตตามเส้นทางน้ำ</p></blockquote><section class="story-section-v2"><h2 id="section-1">หม้อไอน้ำกับความรุ่งเรืองของตลาดใหญ่</h2><figure class="section-photo-v2"><img src="/assets/iron-bridge.webp" alt="สะพานเหล็กบุญสูง" loading="lazy"><figcaption><span>สะพานเหล็กบุญสูง</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>เมื่อยุคสมัยเปลี่ยนผ่านและการค้าทางทะเลขยับเข้ามาสู่พื้นที่ด้านใน ศูนย์กลางของเมืองได้ย้ายมาที่ชุมชนตลาดใหญ่ในยุคฟื้นฟูเมืองสมัยรัชกาลที่สาม พื้นที่บริเวณนี้มีแม่น้ำล้อมรอบถึงสามด้าน ซึ่งเหมาะอย่างยิ่งทั้งสำหรับการป้องกันเมืองและการสัญจรทางน้ำ</p><p>การค้าทางน้ำของตะกั่วป่ายังคงเฟื่องฟูและทิ้งร่องรอยทางวัตถุเอาไว้ให้เราเห็นจนถึงปัจจุบัน หากคุณเดินทางไปยังวัดปทุมธาราหรือวัดหน้าเมืองในย่านตลาดใหญ่ คุณจะพบกับหม้อไอน้ำขนาดใหญ่ตั้งอยู่ ชิ้นส่วนโลหะนี้ไม่ใช่เครื่องจักรทำเหมือง แต่เป็นชิ้นส่วนสำคัญของเรือกลไฟในอดีต</p><p>พระยาเสนานุชิต (นุช ณ นคร) ได้ร่วมทุนกับพระยาวิชิตสงครามซื้อเรือกลไฟลำนี้มาใน พ.ศ. 2410 เพื่อใช้ขนส่งสินค้าและปราบปรามโจรสลัดในน่านน้ำ มันเป็นเครื่องยืนยันถึงความมั่งคั่งและปริมาณการสัญจรที่หนาแน่นในยุคนั้น</p><p>แม้ในเวลาต่อมาเรือกลไฟจะเสื่อมสภาพและจมลงในลำน้ำตะกั่วป่า แต่หม้อไอน้ำที่กู้ขึ้นมาได้ก็ยังคงตั้งตระหง่านเป็นประจักษ์พยาน ความคึกคักของชุมชนตลาดใหญ่ในเวลานั้นผูกพันอยู่กับแม่น้ำอย่างแยกไม่ออก วิถีชีวิตของผู้คนต่างพึ่งพาสายน้ำที่ทำหน้าที่เสมือนถนนสายหลักของเมือง</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">บทบาทวัดกับการค้า</span></div></section><section class="story-section-v2"><h2 id="section-2">วันที่ตะกอนทับถมและเมืองต้องขยับ</h2><figure class="section-photo-v2"><img src="/assets/wat-pathum.webp" alt="วัดปทุมธารา (วัดหน้าเมือง)" loading="lazy"><figcaption><span>วัดปทุมธารา (วัดหน้าเมือง)</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>แต่สายน้ำเป็นสิ่งที่ไม่เคยหยุดนิ่ง และธรรมชาติก็มีบทบาทในการกำหนดชะตาเมืองเสมอ เมื่อเวลาผ่านไป ตะกอนดินจากการทำเหมืองแร่ที่เติบโตขึ้นอย่างรวดเร็วและปรากฏการณ์ทางธรรมชาติ ได้ทับถมจนลำน้ำตะกั่วป่าเริ่มตื้นเขินขึ้นเรื่อย·</p><p>การเปลี่ยนแปลงทางภูมิศาสตร์นี้ส่งผลกระทบโดยตรงต่อโครงสร้างเศรษฐกิจของเมือง การเดินเรือที่เคยสะดวกสบายกลับลดลงและยากลำบากขึ้น เรือสินค้าขนาดใหญ่ที่เคยนำความมั่งคั่งมาให้ ไม่สามารถเทียบท่าได้สะดวกเหมือนในอดีต ทำให้ความคึกคักของชุมชนตลาดใหญ่เริ่มถดถอย</p><p>ในที่สุด ศูนย์กลางของเมืองก็จำต้องย้ายออกจากพื้นที่เดิมบริเวณบ้านตลาดใหญ่ ไปยังย่านใหม่ที่เรียกว่าย่านย่านยาว ใน พ.ศ. 2456 การย้ายเมืองครั้งนี้ไม่ได้เกิดจากภัยสงครามหรือโรคระบาด แต่เกิดจากขีดจำกัดของสายน้ำที่เปลี่ยนแปลงไปจนไม่เอื้อต่อการค้าอีกต่อไป</p><p>เหตุการณ์ประวัติศาสตร์นี้พิสูจน์ให้เห็นว่าสายน้ำมีอิทธิพลเหนือการตั้งถิ่นฐานของผู้คนอย่างสมบูรณ์ วันที่น้ำตื้นเขิน คือวันที่เมืองต้องเก็บข้าวของและเดินทางไปสร้างลมหายใจใหม่ในพื้นที่ที่สามารถรองรับความเปลี่ยนแปลงได้ดีกว่า</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">วันที่และสาเหตุการย้ายเมือง</span></div></section><section class="story-section-v2"><h2 id="section-3">สะพานเหล็กบุญสูง ทางเชื่อมของคนเหมือง</h2><figure class="section-photo-v2"><img src="/assets/thung-phra.webp" alt="สวนสาธารณะทุ่งพระโพธิ์" loading="lazy"><figcaption><span>สวนสาธารณะทุ่งพระโพธิ์</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>เมื่อศูนย์กลางเมืองเปลี่ยนผ่านจากยุคท่าเรือพาณิชย์มาสู่ยุคทองของการทำเหมืองดีบุก ภูมิทัศน์และโครงสร้างพื้นฐานริมแม่น้ำก็ถูกปรับเปลี่ยนตามไปด้วย ในอดีต คลองตะกั่วป่ามีความกว้างกว่าสี่สิบเมตร เป็นอุปสรรคทางธรรมชาติที่ขวางกั้นพื้นที่</p><p>ความกว้างของลำน้ำทำให้คนงานเหมืองและชาวบ้านต้องพายเรือแจวข้ามไปมาระหว่างฝั่งตลาดเก่ากับพื้นที่ของบริษัทเหมืองแร่ เพื่อแก้ปัญหาการสัญจรที่ยากลำบาก โดยเฉพาะในฤดูน้ำหลากที่กระแสน้ำเชี่ยวกราก นายจุติ บุญสูง ผู้ก่อตั้งบริษัทเรือขุดแร่ จึงได้ริเริ่มสร้างสะพานไม้ขึ้นก่อน เพื่อให้คนสามารถเดินและขี่จักรยานข้ามได้</p><p>จนกระทั่งใน พ.ศ. 2511 ได้มีการปรับปรุงสะพานครั้งใหญ่ โดยนำเอาเหล็กจากเรือขุดแร่ที่เลิกใช้งานแล้ว มาประกอบสร้างขึ้นใหม่เป็นสะพานเหล็กโคกขนุน หรือที่เราคุ้นเคยกันในชื่อสะพานเหล็กบุญสูง ด้วยความยาวที่ทอดข้ามแม่น้ำกว่าสองร้อยเมตร</p><p>สะพานเหล็กแห่งนี้จึงไม่ได้เป็นแค่วัตถุก่อสร้างหรือโครงสร้างทางวิศวกรรม แต่มันคือทางลัดที่ย่นระยะเวลาของแรงงาน เป็นเส้นทางขนส่งสินค้า และเป็นทางเชื่อมชีวิตประจำวัน สัญลักษณ์ชิ้นนี้บอกเล่าการเปลี่ยนผ่านจากยุคเรือแจวมาสู่ยุคอุตสาหกรรมเหมืองแร่ที่หล่อเลี้ยงเศรษฐกิจของเมืองอย่างทรงพลัง</p></section><section class="story-section-v2"><h2 id="section-4">พื้นที่รับน้ำและงานบุญที่ทุ่งพระโพธิ์</h2><p>สายน้ำตะกั่วป่าไม่เพียงแต่หล่อเลี้ยงเศรษฐกิจ แต่ยังผูกพันกับชีวิตประจำวันและการรับมือกับธรรมชาติของชาวเมือง พื้นที่ริมน้ำอย่างสวนสาธารณะทุ่งพระโพธิ์ เป็นตัวอย่างที่ชัดเจนของการปรับตัวให้อยู่ร่วมกับระบบน้ำของเมืองเก่า</p><p>เอกสารแผนงานของเทศบาลระบุว่าพื้นที่ทุ่งพระโพธิ์มีความสำคัญในฐานะโครงสร้างพื้นฐานในการจัดการน้ำ โดยมีโครงการขุดลอกคลองส่งน้ำและก่อสร้างท่าน้ำ ในช่วงเวลาที่เมืองเผชิญปัญหาน้ำท่วม พื้นที่นี้ยังถูกใช้เป็นจุดติดตั้งเครื่องสูบน้ำเพื่อบรรเทาอุทกภัยให้แก่ชุมชน</p><p>แต่นอกจากมิติของการรับมือภัยธรรมชาติแล้ว ทุ่งพระโพธิ์ยังเป็นพื้นที่เปิดโล่งสำหรับกิจกรรมทางวัฒนธรรม ในวันเพ็ญเดือนสิบสองของทุกปี ลานกว้างริมน้ำแห่งนี้จะถูกใช้เป็นสถานที่จัดงานประเพณีลอยกระทงประจำปีของเทศบาล</p><p>การใช้งานที่หลากหลายนี้สะท้อนให้เห็นว่า พื้นที่ริมสายน้ำไม่ได้ถูกทิ้งร้างหลังยุคเหมืองแร่ แต่ถูกปรับเปลี่ยนหน้าที่ให้กลายเป็นทั้งกลไกป้องกันเมืองและลานกิจกรรมที่รวมผู้คนเข้าไว้ด้วยกันในวันงานบุญ</p></section><section class="story-section-v2"><h2 id="section-5">ร่องรอยที่ยังไหลเวียนในภูมิทัศน์ปัจจุบัน</h2><p>วันนี้ แม้เหมืองแร่จะปิดตัวลงและการค้าทางเรือขนาดใหญ่จะกลายเป็นเพียงอดีตที่ถูกบันทึกไว้ในหน้ากระดาษ แต่สถานที่ริมน้ำหลายแห่งยังคงมีชีวิตและอยู่ร่วมกับลมหายใจของคนเมืองเก่าตะกั่วป่าอย่างกลมกลืน</p><p>สะพานเหล็กบุญสูงยังคงทำหน้าที่เป็นทางสัญจรของชุมชน ที่ชาวบ้านยังคงใช้เดินเท้าและขี่รถจักรยานยนต์ผ่านไปมา ในขณะเดียวกัน มันก็ได้กลายเป็นแลนด์มาร์กที่ผู้คนมาชมวิวและถ่ายภาพร่องรอยของโรงขุดแร่เก่าที่ยังมองเห็นได้จากบนสะพาน หรือแม้แต่ถูกใช้เป็นสถานที่ถ่ายทำภาพยนตร์ต่างประเทศ</p><p>บริเวณริมคลองใกล้กับวัดย่านยาว ก็ได้มีการริเริ่มพื้นที่ตลาดชุมชนในชื่อตลาดริมน้ำตะกั่วป่า เพื่อช่วยปลุกบรรยากาศเก่า· ให้ผู้คนได้กลับมาสัมผัสวิถีชีวิตริมน้ำอีกครั้ง และมีการจัดเทศกาลอาหารทะเลตามปฏิทินวัฒนธรรม</p><p>สายน้ำตะกั่วป่ายังคงไหลเอื่อย เป็นผู้พิทักษ์ความทรงจำตั้งแต่วันที่เป็นเมืองท่าระดับโลกที่คลาคล่ำไปด้วยเรือสินค้า จนถึงวันที่เป็นจุดชมวิวที่สงบงามของเมืองเก่าที่เราเห็นในปัจจุบัน</p></section><section class="story-places-v2"><h2>ไปดูของจริงได้ที่ไหน</h2><div class="mini-cards-v2"><div class="place-card-mini"><div><h3>ตลาดริมน้ำตะกั่วป่า</h3><button class="button button-outline" data-trip-add="riverwalk">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>สะพานเหล็กบุญสูง</h3><button class="button button-outline" data-trip-add="iron-bridge">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>วัดปทุมธารา (วัดหน้าเมือง)</h3><button class="button button-outline" data-trip-add="wat-pathum">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h3>สวนสาธารณะทุ่งพระโพธิ์</h3><button class="button button-outline" data-trip-add="thung-phra">เพิ่มลงทริป</button></div></div></div></section><details class="unknowns-box-v2"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ลักษณะสถาปัตยกรรมและรายละเอียดผังเมืองของท่าเรือทุ่งตึกในยุคก่อนการค้าเหมืองแร่ดีบุก</li><li>ภาพถ่ายร่วมสมัยที่สามารถระบุสิทธิ์การใช้งานได้ชัดเจน ซึ่งแสดงความคับคั่งของการจราจรทางน้ำในยุคที่เรือกลไฟยังแล่นได้</li><li>เอกสารบันทึกเหตุการณ์วันที่ย้ายเมืองไปย่านยาวอย่างเป็นทางการ และเสียงสะท้อนของชาวบ้านในชุมชนตลาดใหญ่ในขณะนั้น</li></ul></details><section class="story-sources-v2"><h2>แหล่งข้อมูล</h2><ol><li><cite>ทุ่งตึกเมืองท่าการค้าโบราณ</cite> · กรมศิลปากร · บทความแหล่งโบราณคดีทุ่งตึก · <a href="https://www.finearts.go.th/architecture/view/35708-ทุ่งตึกเมืองท่าการค้าโบราณ" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>เอกสารเมืองเก่าตะกั่วป่า</cite> · สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (สผ.) · PDF หน้า 11 ถึง 13, 55 ถึง 56, 58 · <a href="https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ฐานข้อมูลแหล่งโบราณคดี: ชุมชนตลาดใหญ่</cite> · ศูนย์มานุษยวิทยาสิรินธร · ข้อมูลประวัติศาสตร์ชุมชน · <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>สะพานเหล็กบุญสูง (โคกขนุน)</cite> · ฐานข้อมูลท้องถิ่นภาคใต้ มหาวิทยาลัยสงขลานครินทร์ · หน้าประวัติและภาพรวม · <a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>เอกสารแผนการดำเนินงานด้านสิ่งแวดล้อม พ.ศ.2565</cite> · เทศบาลเมืองตะกั่วป่า · ระเบียนโครงการและการจัดการน้ำ · <a href="https://www.takuapacity.go.th/files/com_strategy/2022-12_231dcd9d5169573.pdf" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ข่าวน้ำท่วมตะกั่วป่าและการติดตั้งเครื่องสูบน้ำ</cite> · MGR Online · ข่าวภูมิภาค · <a href="https://mgronline.com/south/detail/9560000096203" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ตลาดริมน้ำตะกั่วป่า ร่วมใจประชารัฐ</cite> · กรมการค้าภายใน กระทรวงพาณิชย์ · ข้อมูลตลาดต้องชม · <span class="source-offline">ดูแหล่งที่มา <small>แหล่งเดิมออฟไลน์ · ตรวจเมื่อ 8 ก.ย. 2569</small></span> (เข้าถึง 2026-09-07)</li><li><cite>ข่าวเช้า: สะพานเหล็กบุญสูง</cite> · NBT2HD · รายการข่าว 30 มกราคม 2569 · <a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ปฏิทินเทศกาลอาหารทะเล ตลาดริมน้ำตะกั่วป่า</cite> · กระทรวงวัฒนธรรม · ปฏิทินกิจกรรมวัฒนธรรม · <a href="https://calendar.m-culture.go.th/events/103651" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li></ol></section></div><div class="story-sidebar-v2"><aside class="evidence-box-v2"><h3>หลักฐานอยู่ตรงไหน</h3><ul class="ev-items-v2"><li><div class="ev-claim">ระยะทางข้ามคาบสมุทรและจุดเริ่มต้นของทุ่งตึก</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">ตัวเลขระยะทางเป็นข้อมูลจากรายงาน สผ. และการจัดตั้งทุ่งตึกอ้างอิงจากคำอธิบายของกรมศิลปากร ซึ่งเว็บไซต์คงระดับข้อความไว้ตามเอกสารต้นฉบับ ไม่ได้ยืนยันข้อสรุปใหม่ <a href="https://www.finearts.go.th/architecture/view/35708-ทุ่งตึกเมืองท่าการค้าโบราณ" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">การย้ายเมืองเพราะแม่น้ำตื้นเขิน</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">วันที่และเหตุผลการย้ายเมืองใน พ.ศ. 2456 เป็นการรวบรวมข้อมูลตามรายงาน สผ. ซึ่งควรอ้างอิงตามรายงานฉบับต้นทางเมื่อใช้ในงานวิชาการ <a href="https://culturalenvi.onep.go.th/site/detail/4428" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">ที่มาของหม้อไอน้ำวัดหน้าเมือง</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">ข้อมูลจากฐานข้อมูลศูนย์มานุษยวิทยาสิรินธรระบุถึงการซื้อเรือกลไฟใน พ.ศ. 2410 แต่หลักฐานชิ้นนี้ไม่ได้ยืนยันว่าวัดเป็นผู้ดำเนินกิจการเหมืองแร่โดยตรง <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li></ul></aside><nav class="story-toc-v2 scrollspy" id="story-toc"><h2>เนื้อหาในบทความ</h2><ul class="scrollspy-nav"><li><a href="#section-0">ทุ่งตึก ท่าเรือก่อนมีเมือง</a></li><li><a href="#section-1">หม้อไอน้ำกับความรุ่งเรืองของตลาดใหญ่</a></li><li><a href="#section-2">วันที่ตะกอนทับถมและเมืองต้องขยับ</a></li><li><a href="#section-3">สะพานเหล็กบุญสูง ทางเชื่อมของคนเหมือง</a></li><li><a href="#section-4">พื้นที่รับน้ำและงานบุญที่ทุ่งพระโพธิ์</a></li><li><a href="#section-5">ร่องรอยที่ยังไหลเวียนในภูมิทัศน์ปัจจุบัน</a></li></ul></nav></div></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
