        hero=f'<div class="breadcrumbs"><a href="/">à¸«à¸™à¹‰à¸²à¹à¸£à¸</a><span>/</span><a href="/places/">à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆ</a><span>/</span><span>{label}</span></div><header class="place-hero"><div class="place-hero-copy"><span class="chapter">FIELD NOTE {idx+1:02d} / {label}</span><h1>{e(record["name_th"])}</h1><p class="english">{e(record.get("name_en",""))}</p><p class="place-lead">{e(ctx["copy"][id]["kicker"])}</p><a class="text-link" href="#story">à¹€à¸›à¸´à¸”à¸­à¹ˆà¸²à¸™à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸‚à¸­à¸‡à¸—à¸µà¹ˆà¸™à¸µà¹ˆ â†“</a></div><figure class="place-hero-art">{pic(id,True)}<figcaption><span>TAKUA PA / {idx+1:02d}</span><span>à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆà¹ƒà¸™à¹€à¸¡à¸·à¸­à¸‡à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸²</span></figcaption></figure></header>'
        text=body[body.index('<h2>à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸‚à¸­à¸‡à¸—à¸µà¹ˆà¸™à¸µà¹ˆ</h2>'):body.index('<h2>à¸­à¸¢à¸¹à¹ˆà¸•à¸£à¸‡à¹„à¸«à¸™à¹ƒà¸™à¸¢à¹ˆà¸²à¸™</h2>')]
        text=text.replace('<h2>à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸‚à¸­à¸‡à¸—à¸µà¹ˆà¸™à¸µà¹ˆ</h2>',f'<span class="chapter">à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸‚à¸­à¸‡à¸—à¸µà¹ˆà¸™à¸µà¹ˆ</span><h2>{e(ctx["copy"][id]["kicker"])}</h2>',1)
        text=text.replace('<h2>à¸£à¸²à¸¢à¸¥à¸°à¹€à¸­à¸µà¸¢à¸”à¸ˆà¸²à¸à¹€à¸­à¸à¸ªà¸²à¸£</h2>','<h2 id="details">à¸£à¸²à¸¢à¸¥à¸°à¹€à¸­à¸µà¸¢à¸”à¸ˆà¸²à¸à¹€à¸­à¸à¸ªà¸²à¸£</h2>')
