+  return f'<img{m.group("attrs")}src="{m.group("src")}" width="{_w}" height="{_h}"{m.group("tail")}>'
+ _updated = _IMG_RE.sub(_dimensions, _html)
+ if _updated != _html: _fp.write_text(_updated, encoding='utf-8')
