        body=hero+quick_start()
        body+='<section id="start" class="section">'+heading('01','à¹€à¸£à¸´à¹ˆà¸¡à¸ˆà¸²à¸à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸—à¸µà¹ˆà¸„à¸¸à¸“à¸ªà¸™à¹ƒà¸ˆ','à¸ªà¸²à¸¡à¹€à¸ªà¹‰à¸™à¸—à¸²à¸‡à¸­à¹ˆà¸²à¸™à¹€à¸¡à¸·à¸­à¸‡ Â· à¹€à¸¥à¸·à¸­à¸à¸ˆà¸¸à¸”à¹à¸§à¸°à¹ƒà¸™à¹à¸šà¸šà¸‚à¸­à¸‡à¸„à¸¸à¸“')+route_cards(ctx)+'</section>'
        body+=city_feed(ctx)+map_teaser()
        body+='<section id="places" class="section">'+heading('03','à¹€à¸¡à¸·à¸­à¸‡à¹€à¸”à¸µà¸¢à¸§ à¸«à¸¥à¸²à¸¢à¸¡à¸¸à¸¡à¹ƒà¸«à¹‰à¸£à¸¹à¹‰à¸ˆà¸±à¸','à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆà¸—à¸±à¹‰à¸‡ 20 à¹à¸«à¹ˆà¸‡ à¸ˆà¸²à¸à¸«à¸™à¹‰à¸²à¸à¸£à¸°à¸”à¸²à¸©à¸ªà¸¹à¹ˆà¹€à¸£à¸·à¹ˆà¸­à¸‡à¹€à¸¥à¹ˆà¸²à¸‚à¸­à¸‡à¹€à¸¡à¸·à¸­à¸‡')+explorer(ctx)+'<a class="text-link index-link" href="/places/">à¹€à¸›à¸´à¸”à¸”à¸±à¸Šà¸™à¸µà¹à¸¥à¸°à¸„à¹‰à¸™à¸«à¸²à¸ªà¸–à¸²à¸™à¸—à¸µà¹ˆ â†—</a></section>'
        body+='<section class="section traditions-section">'+heading('04','à¹€à¸¡à¸·à¹ˆà¸­à¹€à¸¡à¸·à¸­à¸‡à¸¡à¸µà¸™à¸±à¸”à¸«à¸¡à¸²à¸¢','à¸›à¸£à¸°à¹€à¸žà¸“à¸µà¸•à¸¥à¸­à¸”à¸›à¸µ Â· à¸Šà¹ˆà¸§à¸‡à¹€à¸§à¸¥à¸²à¸•à¸²à¸¡à¹€à¸­à¸à¸ªà¸²à¸£à¸•à¹‰à¸™à¸—à¸²à¸‡')+traditions(ctx)+'<p class="small">à¸•à¸£à¸§à¸ˆà¸ªà¸­à¸šà¸à¸³à¸«à¸™à¸”à¸à¸²à¸£à¸‚à¸­à¸‡à¹à¸•à¹ˆà¸¥à¸°à¸›à¸µà¸à¹ˆà¸­à¸™à¹€à¸”à¸´à¸™à¸—à¸²à¸‡</p></section>'
        body+=f'<section class="food-feature"><div class="food-feature-image">{pic("food-center")}<span class="food-stamp">LOCAL<br>FLAVOURS</span></div><div class="food-feature-copy"><span class="chapter">05 / à¸à¸´à¸™à¹à¸¥à¸°à¸‹à¸·à¹‰à¸­à¸‚à¸­à¸‡à¸à¸²à¸à¹ƒà¸™à¸¢à¹ˆà¸²à¸™</span><h2>à¸£à¸¹à¹‰à¸ˆà¸±à¸à¹€à¸¡à¸·à¸­à¸‡<br>à¸œà¹ˆà¸²à¸™à¸­à¸µà¸à¸£à¸ªà¸Šà¸²à¸•à¸´</h2><p>à¹€à¸›à¸´à¸”à¸£à¸²à¸¢à¸Šà¸·à¹ˆà¸­à¸£à¹‰à¸²à¸™à¸­à¸²à¸«à¸²à¸£ à¹€à¸„à¸£à¸·à¹ˆà¸­à¸‡à¸”à¸·à¹ˆà¸¡ à¹à¸¥à¸°à¸‚à¸­à¸‡à¸à¸²à¸<br>{SHOP_TOTAL} à¸£à¹‰à¸²à¸™ à¹€à¸£à¸´à¹ˆà¸¡à¸ˆà¸²à¸à¹à¸œà¹ˆà¸™à¸žà¸±à¸šà¹€à¸—à¸¨à¸šà¸²à¸¥à¹à¸¥à¹‰à¸§à¸„à¹‰à¸™à¹€à¸žà¸´à¹ˆà¸¡</p><div class="food-counts"><span><b>32</b>à¸­à¸²à¸«à¸²à¸£</span><span><b>20</b>à¹€à¸„à¸£à¸·à¹ˆà¸­à¸‡à¸”à¸·à¹ˆà¸¡</span><span><b>08</b>à¸‚à¸­à¸‡à¸à¸²à¸</span></div>{cta("/eat/","à¸«à¸²à¸£à¹‰à¸²à¸™à¹ƒà¸™à¸¢à¹ˆà¸²à¸™")}</div></section>'
        return body+'<section class="about-strip"><span class="chapter">à¸šà¸±à¸™à¸—à¸¶à¸à¸ˆà¸²à¸à¸šà¹‰à¸²à¸™à¸¨à¸´à¸§à¸£à¸²</span><h2>à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸‚à¸­à¸‡à¹€à¸¡à¸·à¸­à¸‡<br>à¸—à¸µà¹ˆà¸­à¸¢à¸²à¸à¸Šà¸§à¸™à¸„à¸¸à¸“à¸£à¸¹à¹‰à¸ˆà¸±à¸</h2><div><p>à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸² 101 à¸£à¸§à¸šà¸£à¸§à¸¡à¸‚à¹‰à¸­à¸¡à¸¹à¸¥à¸ˆà¸²à¸à¹à¸œà¹ˆà¸™à¸žà¸±à¸šà¹€à¸—à¸¨à¸šà¸²à¸¥à¹€à¸¡à¸·à¸­à¸‡à¸•à¸°à¸à¸±à¹ˆà¸§à¸›à¹ˆà¸² à¸žà¸£à¹‰à¸­à¸¡à¸—à¸µà¹ˆà¸¡à¸²à¹à¸¥à¸°à¸‚à¸­à¸šà¹€à¸‚à¸•à¸‚à¹‰à¸­à¸¡à¸¹à¸¥à¹ƒà¸«à¹‰à¸„à¸¸à¸“à¸­à¹ˆà¸²à¸™à¸•à¹ˆà¸­à¹„à¸”à¹‰</p><a class="text-link" href="/about/">à¸£à¸¹à¹‰à¸ˆà¸±à¸à¸„à¸¹à¹ˆà¸¡à¸·à¸­à¹€à¸¥à¹ˆà¸¡à¸™à¸µà¹‰ â†—</a></div></section>'
    if path=='/places/':
        return intro('à¹€à¸¥à¸·à¸­à¸à¹€à¸›à¸´à¸”à¹€à¸£à¸·à¹ˆà¸­à¸‡à¸‚à¸­à¸‡à¹€à¸¡à¸·à¸­à¸‡','20 à¸ˆà¸¸à¸”à¸«à¸¡à¸²à¸¢ Â· à¸§à¸±à¸” à¸¨à¸²à¸¥à¹€à¸ˆà¹‰à¸² à¸•à¸¶à¸à¹€à¸à¹ˆà¸² à¹à¸¥à¸°à¸Šà¸µà¸§à¸´à¸•à¸£à¸´à¸¡à¸—à¸²à¸‡')+explorer(ctx,True)+source()
    if path=='/map/':
        import seo
        import json
        records = list(seo.ENRICHED.values())
        map_data = []
        for r in records:
            g = r.get('geo') or {}
            coords = [g['lng'], g['lat']] if isinstance(g.get('lat'), (int,float)) and isinstance(g.get('lng'), (int,float)) else None
            photos = [p for p in (r.get('photos', {}).get('usable', []) or []) if photo_for(r['id'], p.get('file'))]
            hero_photo = next((p for p in photos if p.get('era') in ('current','now')), photos[0] if photos else None)
            if hero_photo:
                photo_src = hero_photo.get('file') or hero_photo.get('local_path') or hero_photo.get('url')
            else:
                import os as _os
                _cand = r['id']
                if not _os.path.exists(f"site/assets/{_cand}.webp"):
                    _linked = (ctx.get('links') or {}).get(r['id']) or []
                    _cand = next((x for x in _linked if _os.path.exists(f"site/assets/{x}.webp")), 'culture-street')
                photo_src = f"/assets/{_cand}.webp"
            kicker = ctx['copy'][r['id']]['kicker'] if r['id'] in ctx['copy'] else (ctx['period'](r) if r['type']=='event' else '')
            a = r.get('address') or {}
            address_th = ' Â· '.join(filter(None, [a.get('line_th'), a.get('district')])) if a else ''
            from seo_config import BASE_PATH as _BP
            _abs = lambda u: (_BP + u) if isinstance(u, str) and u.startswith('/') and not u.startswith(_BP + '/') else u
            map_data.append({'id': r['id'], 'name': r['name_th'], 'category': r.get('category'), 'coords': coords, 'photo': _abs(photo_src), 'kicker': kicker, 'url': _abs(ctx['url'](r)), 'address': address_th})
        map_json = json.dumps(map_data, ensure_ascii=False)
        body=intro('à¸à¸²à¸‡à¹à¸œà¸™à¸—à¸µà¹ˆ à¹à¸¥à¹‰à¸§à¸„à¹ˆà¸­à¸¢ à¹† à¹„à¸›','à¸ˆà¸²à¸à¸¢à¹ˆà¸²à¸™à¸¢à¸²à¸§à¸–à¸¶à¸‡à¹€à¸¡à¸·à¸­à¸‡à¹€à¸à¹ˆà¸² Â· à¸ à¸²à¸žà¹à¸œà¸™à¸—à¸µà¹ˆà¸ˆà¸£à¸´à¸‡à¸žà¸£à¹‰à¸­à¸¡à¸ à¸²à¸žà¹€à¸—à¸¨à¸šà¸²à¸¥à¸‹à¹‰à¸­à¸™à¸—à¸±à¸š')
        body+=f'<div id="interactive-map-app" data-map-data="{e(map_json)}"></div>'
