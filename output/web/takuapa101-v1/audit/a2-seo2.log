print('SITEMAP\\n',sm); print('ROBOTS\\n',rb)
# sitemap paths
urls=re.findall(r'<loc>(.*?)</loc>',sm)
for u in urls:
 p=urlparse(u).path.strip('/')
 f=root/(p/'index.html' if p else 'index.html')
 print('SM',u,'=>',f.exists(),f)
print('\\nPAGE AUDIT')
alljson=[]; titles={}; descs={}; ogimgs=[]; links=[]; kw={k:[] for k in ['ตะกั่วป่า','takuapa','Takua Pa']}
for f in files:
 s=f.read_text(encoding='utf8'); rel=f.as_posix()
 title=re.search(r'<title["'^>]*>(.*?)</title>'"',s,re.S|re.I); title=html.unescape(re.sub(r'<.*?>','',title.group(1)).strip()) if title else ''
 d=re.search(r'<meta["'^>]+name=["'"\\']description[\"\\']["'^>]+content=["'"\\'](.*?)[\"\\']',s,re.S|re.I); d=d.group(1).strip() if d else ''
 # alternate attr ordering
 if not d:
  d2=re.search(r'<meta["'^>]+content=["'"\\'](.*?)[\"\\']["'^>]+name=["'"\\']description[\"\\']',s,re.S|re.I); d=d2.group(1).strip() if d2 else ''
 titles.setdefault(title,[]).append(rel); descs.setdefault(d,[]).append(rel)
 metas={m.group(1).lower():m.group(2) for m in re.finditer(r'<meta["'^>]+(?:property|name)=["'"\\'](["'^"'"\\']+)[\"\\']["'^>]+content=["'"\\'](["'^"'"\\']*)[\"\\']',s,re.I)}
 miss=[x for x in ['og:title','og:description','og:url','og:type','og:image','twitter:card','twitter:title','twitter:description','twitter:image'] if x not in metas]
 if miss: print('META',rel,'missing',','.join(miss))
 if 'og:image' in metas:
  u=metas['og:image']; path=urlparse(u).path if urlparse(u).scheme else u
  if path.startswith('/'): path=path[1:]
  ogimgs.append((rel,u,(root/path).exists(),root/path))
 for block in re.findall(r'<script["'^>]+type=["'"\\']application/ld\\+json[\"\\']["'^>]*>(.*?)</script>'"',s,re.S|re.I):
  try:
   j=json.loads(html.unescape(block)); alljson.append((rel,j))
  except Exception as e: print('JSONBAD',rel,str(e))
 for a in re.finditer(r'<a\\s["'^>]*href=["'"\\'](["'^"'"\\']+)[\"\\']["'^>]*>(.*?)</a>'"',s,re.S|re.I):
  href=a.group(1); txt=re.sub(r'<.*?>',' ',a.group(2)); txt=' '.join(html.unescape(txt).split())
  if 'siwaracafe.com' in href: links.append((rel,href,txt))
 text=re.sub(r'<script.*?</script>|<style.*?</style>',' ',s,flags=re.S|re.I)
 for k in kw: 
  n=len(re.findall(re.escape(k),text,re.I if k"'!='"'ตะกั่วป่า' else 0));
  if n: kw[k].append((rel,n))
print('\\nJSONLD',len(alljson))
for rel,j in alljson:
 def walk(x):
  if isinstance(x,dict):
   typ=x.get('@type'); empt=[k for k,v in x.items() if v is None or v=='' or v==[]]
   if empt or typ is None: print('JSONFIELD',rel,'type',typ,'empty',empt)
   if typ: print('JSONTYPE',rel,typ)
  elif isinstance(x,list):
   for q in x: walk(q)
 walk(j)
print('\\nDUP TITLES'); [print(k,len(v),v[:4]) for k,v in titles.items() if len(v)>1]
print('LONG TITLES'); [print(len(k),v[0],k) for k,v in titles.items() if len(k)>60]
print('LONG DESC'); [print(len(k),v[0]) for k,v in descs.items() if len(k)>160]
print('DUP DESC'); [print(len(v),k[:80],v[:4]) for k,v in descs.items() if len(v)>1]
print('OG'); [print(x) for x in ogimgs if not x[2]]
print('LINKS',len(links)); [print(x) for x in links]
print('KEYWORDS'); [print(k,sum(n for _,n in v),len(v),v[:10]) for k,v in kw.items()]
