import asyncio, json
from playwright.async_api import async_playwright
paths=['/','/places/tao-ming/','/map/','/rest/','/eat/','/news/','/trip/','/en/']
async def main():
 async with async_playwright() as p:
  b=await p.chromium.launch(headless=True)
  for w,h in [(1440,900),(390,844)]:
   for path in paths:
    page=await b.new_page(viewport={'width':w,'height':h}); errors=[]; bad=[]
    page.on('console',lambda m: errors.append(m.text) if m.type=='error' else None)
    page.on('pageerror',lambda e: errors.append('PAGEERROR '+str(e)))
    page.on('response',lambda r: bad.append(f'{r.status} {r.url}') if r.status>=400 else None)
    try:
     await page.goto('https://takuapa101.com'+path,wait_until='networkidle',timeout=30000); await page.wait_for_timeout(300)
     ov=await page.evaluate('''() => ({sw:document.documentElement.scrollWidth,cw:document.documentElement.clientWidth,bs:document.body.scrollWidth})''')
     print(json.dumps({'vp':f'{w}x{h}','path':path,'errors':errors,'bad':bad,'overflow':ov},ensure_ascii=False))
    except Exception as e: print(json.dumps({'vp':f'{w}x{h}','path':path,'fatal':str(e),'errors':errors,'bad':bad},ensure_ascii=False))
    await page.close()
  # theme persistence
  page=await b.new_page(viewport={'width':390,'height':844}); await page.goto('https://takuapa101.com/',wait_until='networkidle')
  buttons=await page.locator('button').all_text_contents(); before=await page.locator('html').get_attribute('data-theme');
  toggles=page.locator('[data-theme-toggle], .theme-toggle, button[aria-label*=\"ธีม\"], button[aria-label*=\"theme\"], button:has-text(\"กลางคืน\")')
  print(json.dumps({'theme_before':before,'buttons':buttons[:20],'toggle_count':await toggles.count()},ensure_ascii=False))
  if await toggles.count():
   await toggles.first.click(); await page.wait_for_timeout(100); after=await page.locator('html').get_attribute('data-theme');
   await page.goto('https://takuapa101.com/rest/',wait_until='networkidle'); persisted=await page.locator('html').get_attribute('data-theme'); print(json.dumps({'theme_after_click':after,'theme_after_nav':persisted},ensure_ascii=False))
  await b.close()
asyncio.run(main())
