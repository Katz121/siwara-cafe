assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/trip.js" defer></script><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/stories/water-trade/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/stories/water-trade/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/stories/water-trade/"></head><body class="inner-page"><a class="skip" href="#main">ข้ามไปเนื้อหา</a><header class="site-header"><a class="brand" href="/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">๑๐๑</span><span>ตะกั่วป่า<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/places/">สถานที่</a><a href="/stories/" aria-current="page">เรื่องเล่า</a><a href="/map/">แผนที่</a><a href="/rest/">กินเที่ยว</a><a href="/news/">ความเคลื่อนไหว</a><a href="/trip/">ทริปของคุณ</a><a href="/traditions/" class="nav-more">ประเพณี</a><a href="/eat/" class="nav-more">กินและของฝาก</a><a href="/routes/" class="nav-more">เส้นทางเดิน</a><a href="/leaflet/" class="nav-more">แผ่นพับ</a><a href="/about/" class="nav-more">เกี่ยวกับ</a></nav><div class="header-tools"><a class="lang-switch" href="/en/stories/water-trade/" hreflang="en" lang="en">EN</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/map/">เปิดแผนที่ ↗</a></div></header><main id="main"><div class="story-article-v2"><header class="story-hero-v2"><div class="breadcrumbs"><a href="/">หน้าแรก</a><span>/</span><a href="/stories/">เรื่องเล่าตะกั่วป่า</a><span>/</span><span>สายน้ำและการค้า</span></div><span class="eyebrow">เรื่องเล่าตะกั่วป่า · สายน้ำและการค้า</span><h1>จากทุ่งตึกถึงแม่น้ำตะกั่วป่า: วันที่สายน้ำสร้างเมือง</h1><p class="lead">สายน้ำไม่ได้เป็นเพียงฉากหลัง แต่มันคือเส้นทาง ผู้เชื่อมคน และตัวกำหนดชะตาเมืองที่ต้องย้ายตามตะกอนน้ำ</p><p class="story-meta">ปรับปรุงเมื่อ 2026-09-07 · เวลาอ่าน 7 นาที</p></header><figure class="hero-photo-v2"><img src="/assets/photos/kuapapoh-port.webp" alt="ภาพเก่า เรือจอดที่ท่าน้ำตะกั่วป่า" loading="eager"><figcaption><span>ภาพเก่า เรือจอดที่ท่าน้ำตะกั่วป่า</span><span class="credit">คลังภาพโครงการกั่วป่าโพ้</span></figcaption></figure><div class="story-layout-v2"><div class="story-main-v2"><div class="story-lede-v2"><p>ถ้าคุณยืนอยู่ริมแม่น้ำตะกั่วป่าในวันนี้ สายน้ำที่ไหลเอื่อยและเงียบสงบอาจดูเหมือนเป็นเพียงฉากหลังของภูมิทัศน์เมืองเก่า แต่หากเรามองย้อนกลับไปในหน้าประวัติศาสตร์ แม่น้ำสายนี้ไม่เคยหลับใหล มันคือเส้นเลือดใหญ่ที่สูบฉีดความเจริญ ผู้คน และทรัพยากรเข้าสู่พื้นที่มาหลายศตวรรษ</p><p>เมืองตะกั่วป่าไม่ได้ตั้งอยู่ตรงพิกัดเดิมมาตั้งแต่ต้น แต่มันขยับและเติบโตตามเส้นทางน้ำ จากบริเวณพื้นที่ราบใกล้ปากน้ำสู่ย่านตลาดใหญ่ จนถึงวันที่ตะกอนแม่น้ำบีบให้ศูนย์กลางเมืองต้องย้ายอีกครั้ง</p><p>สายน้ำตะกั่วป่าจึงไม่ใช่แค่ภูมิประเทศทางธรรมชาติ แต่เป็นผู้เขียนประวัติศาสตร์ตัวจริงที่พัดพาพาณิชย์นาวีจากทั่วโลกมาเยือน และเป็นผู้กำหนดชะตากรรมของเมืองในวันที่สายน้ำตื้นเขินลง</p></div><section class="story-section-v2"><h2 id="section-0">ทุ่งตึก ท่าเรือก่อนมีเมือง</h2><figure class="section-photo-v2"><img src="/assets/riverwalk.webp" alt="ตลาดริมน้ำตะกั่วป่า" loading="lazy"><figcaption><span>ตลาดริมน้ำตะกั่วป่า</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>ก่อนที่ภาพจำของเมืองตะกั่วป่าจะเป็นอาคารก่ออิฐถือปูนหรือย่านการค้าชิโน-โปรตุกีสอย่างที่เราเห็นในปัจจุบัน ศูนย์กลางการค้าดั้งเดิมของพื้นที่นี้ตั้งอยู่ที่ทุ่งตึก บริเวณที่ราบใกล้ปากแม่น้ำ ทุ่งตึกทำหน้าที่เป็นเมืองท่าการค้าโบราณที่คึกคักบนเส้นทางข้ามคาบสมุทร</p><p>พื้นที่บริเวณปากแม่น้ำแห่งนี้ไม่ได้เติบโตอย่างโดดเดี่ยว แต่เป็นจิ๊กซอว์ชิ้นสำคัญที่เชื่อมโยงกับเครือข่ายการค้าทางทะเลที่กว้างขวาง มันคือจุดแวะพักและสถานที่แลกเปลี่ยนสินค้าของนักเดินทางจากหลากหลายเชื้อชาติ ที่อาศัยกระแสน้ำและลมมรสุมตามฤดูกาลในการสัญจร</p><p>ลำน้ำตะกั่วป่าในยุคนั้นไม่ได้มีไว้เพื่อการสัญจรของคนในท้องถิ่นเพียงอย่างเดียว แต่ถูกใช้เป็นเส้นทางหลักในการเดินทางข้ามคาบสมุทรระหว่างฝั่งทะเลอันดามันและอ่าวไทย ด้วยระยะระหว่างต้นน้ำสองฝั่งที่เอื้ออำนวย เส้นทางนี้ช่วยลดเวลาเดินทางลงได้อย่างมหาศาล</p><p>ที่สำคัญ การใช้เส้นทางแม่น้ำยังช่วยให้นักเดินเรือหลีกเลี่ยงอันตรายและความเสี่ยงจากการต้องเดินเรืออ้อมช่องแคบมะละกาที่ยาวไกล สายน้ำจึงทำหน้าที่เสมือนสะพานเชื่อมสองฝั่งมหาสมุทร พาผู้คน สินค้า และวัฒนธรรมไหลเวียนเข้าสู่พื้นที่อย่างต่อเนื่อง นี่คือปฐมบทของเมืองท่า ก่อนที่ศูนย์กลางความเจริญจะขยับขยายลึกเข้ามาในแผ่นดินตามสายน้ำ</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">ข้อสันนิษฐานสถานะท่าเรือโบราณ</span></div></section><blockquote class="pull-quote-v2"><p>เมืองตะกั่วป่าไม่ได้ตั้งอยู่ตรงพิกัดเดิมมาตั้งแต่ต้น แต่มันขยับและเติบโตตามเส้นทางน้ำ</p></blockquote><section class="story-section-v2"><h2 id="section-1">หม้อไอน้ำกับความรุ่งเรืองของตลาดใหญ่</h2><figure class="section-photo-v2"><img src="/assets/iron-bridge.webp" alt="สะพานเหล็กบุญสูง" loading="lazy"><figcaption><span>สะพานเหล็กบุญสูง</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>เมื่อยุคสมัยเปลี่ยนผ่านและการค้าทางทะเลขยับเข้ามาสู่พื้นที่ด้านใน ศูนย์กลางของเมืองได้ย้ายมาที่ชุมชนตลาดใหญ่ในยุคฟื้นฟูเมืองสมัยรัชกาลที่สาม พื้นที่บริเวณนี้มีแม่น้ำล้อมรอบถึงสามด้าน ซึ่งเหมาะอย่างยิ่งทั้งสำหรับการป้องกันเมืองและการสัญจรทางน้ำ</p><p>การค้าทางน้ำของตะกั่วป่ายังคงเฟื่องฟูและทิ้งร่องรอยทางวัตถุเอาไว้ให้เราเห็นจนถึงปัจจุบัน หากคุณเดินทางไปยังวัดปทุมธาราหรือวัดหน้าเมืองในย่านตลาดใหญ่ คุณจะพบกับหม้อไอน้ำขนาดใหญ่ตั้งอยู่ ชิ้นส่วนโลหะนี้ไม่ใช่เครื่องจักรทำเหมือง แต่เป็นชิ้นส่วนสำคัญของเรือกลไฟในอดีต</p><p>พระยาเสนานุชิต (นุช ณ นคร) ได้ร่วมทุนกับพระยาวิชิตสงครามซื้อเรือกลไฟลำนี้มาใน พ.ศ. 2410 เพื่อใช้ขนส่งสินค้าและปราบปรามโจรสลัดในน่านน้ำ มันเป็นเครื่องยืนยันถึงความมั่งคั่งและปริมาณการสัญจรที่หนาแน่นในยุคนั้น</p><p>แม้ในเวลาต่อมาเรือกลไฟจะเสื่อมสภาพและจมลงในลำน้ำตะกั่วป่า แต่หม้อไอน้ำที่กู้ขึ้นมาได้ก็ยังคงตั้งตระหง่านเป็นประจักษ์พยาน ความคึกคักของชุมชนตลาดใหญ่ในเวลานั้นผูกพันอยู่กับแม่น้ำอย่างแยกไม่ออก วิถีชีวิตของผู้คนต่างพึ่งพาสายน้ำที่ทำหน้าที่เสมือนถนนสายหลักของเมือง</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">บทบาทวัดกับการค้า</span></div></section><section class="story-section-v2"><h2 id="section-2">วันที่ตะกอนทับถมและเมืองต้องขยับ</h2><figure class="section-photo-v2"><img src="/assets/wat-pathum.webp" alt="วัดปทุมธารา (วัดหน้าเมือง)" loading="lazy"><figcaption><span>วัดปทุมธารา (วัดหน้าเมือง)</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>แต่สายน้ำเป็นสิ่งที่ไม่เคยหยุดนิ่ง และธรรมชาติก็มีบทบาทในการกำหนดชะตาเมืองเสมอ เมื่อเวลาผ่านไป ตะกอนดินจากการทำเหมืองแร่ที่เติบโตขึ้นอย่างรวดเร็วและปรากฏการณ์ทางธรรมชาติ ได้ทับถมจนลำน้ำตะกั่วป่าเริ่มตื้นเขินขึ้นเรื่อย·</p><p>การเปลี่ยนแปลงทางภูมิศาสตร์นี้ส่งผลกระทบโดยตรงต่อโครงสร้างเศรษฐกิจของเมือง การเดินเรือที่เคยสะดวกสบายกลับลดลงและยากลำบากขึ้น เรือสินค้าขนาดใหญ่ที่เคยนำความมั่งคั่งมาให้ ไม่สามารถเทียบท่าได้สะดวกเหมือนในอดีต ทำให้ความคึกคักของชุมชนตลาดใหญ่เริ่มถดถอย</p><p>ในที่สุด ศูนย์กลางของเมืองก็จำต้องย้ายออกจากพื้นที่เดิมบริเวณบ้านตลาดใหญ่ ไปยังย่านใหม่ที่เรียกว่าย่านย่านยาว ใน พ.ศ. 2456 การย้ายเมืองครั้งนี้ไม่ได้เกิดจากภัยสงครามหรือโรคระบาด แต่เกิดจากขีดจำกัดของสายน้ำที่เปลี่ยนแปลงไปจนไม่เอื้อต่อการค้าอีกต่อไป</p><p>เหตุการณ์ประวัติศาสตร์นี้พิสูจน์ให้เห็นว่าสายน้ำมีอิทธิพลเหนือการตั้งถิ่นฐานของผู้คนอย่างสมบูรณ์ วันที่น้ำตื้นเขิน คือวันที่เมืองต้องเก็บข้าวของและเดินทางไปสร้างลมหายใจใหม่ในพื้นที่ที่สามารถรองรับความเปลี่ยนแปลงได้ดีกว่า</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">วันที่และสาเหตุการย้ายเมือง</span></div></section><section class="story-section-v2"><h2 id="section-3">สะพานเหล็กบุญสูง ทางเชื่อมของคนเหมือง</h2><figure class="section-photo-v2"><img src="/assets/thung-phra.webp" alt="สวนสาธารณะทุ่งพระโพธิ์" loading="lazy"><figcaption><span>สวนสาธารณะทุ่งพระโพธิ์</span><span class="credit">ภาพวาดประกอบ</span></figcaption></figure><p>เมื่อศูนย์กลางเมืองเปลี่ยนผ่านจากยุคท่าเรือพาณิชย์มาสู่ยุคทองของการทำเหมืองดีบุก ภูมิทัศน์และโครงสร้างพื้นฐานริมแม่น้ำก็ถูกปรับเปลี่ยนตามไปด้วย ในอดีต คลองตะกั่วป่ามีความกว้างกว่าสี่สิบเมตร เป็นอุปสรรคทางธรรมชาติที่ขวางกั้นพื้นที่</p><p>ความกว้างของลำน้ำทำให้คนงานเหมืองและชาวบ้านต้องพายเรือแจวข้ามไปมาระหว่างฝั่งตลาดเก่ากับพื้นที่ของบริษัทเหมืองแร่ เพื่อแก้ปัญหาการสัญจรที่ยากลำบาก โดยเฉพาะในฤดูน้ำหลากที่กระแสน้ำเชี่ยวกราก นายจุติ บุญสูง ผู้ก่อตั้งบริษัทเรือขุดแร่ จึงได้ริเริ่มสร้างสะพานไม้ขึ้นก่อน เพื่อให้คนสามารถเดินและขี่จักรยานข้ามได้</p><p>จนกระทั่งใน พ.ศ. 2511 ได้มีการปรับปรุงสะพานครั้งใหญ่ โดยนำเอาเหล็กจากเรือขุดแร่ที่เลิกใช้งานแล้ว มาประกอบสร้างขึ้นใหม่เป็นสะพานเหล็กโคกขนุน หรือที่เราคุ้นเคยกันในชื่อสะพานเหล็กบุญสูง ด้วยความยาวที่ทอดข้ามแม่น้ำกว่าสองร้อยเมตร</p><p>สะพานเหล็กแห่งนี้จึงไม่ได้เป็นแค่วัตถุก่อสร้างหรือโครงสร้างทางวิศวกรรม แต่มันคือทางลัดที่ย่นระยะเวลาของแรงงาน เป็นเส้นทางขนส่งสินค้า และเป็นทางเชื่อมชีวิตประจำวัน สัญลักษณ์ชิ้นนี้บอกเล่าการเปลี่ยนผ่านจากยุคเรือแจวมาสู่ยุคอุตสาหกรรมเหมืองแร่ที่หล่อเลี้ยงเศรษฐกิจของเมืองอย่างทรงพลัง</p></section><section class="story-section-v2"><h2 id="section-4">พื้นที่รับน้ำและงานบุญที่ทุ่งพระโพธิ์</h2><p>สายน้ำตะกั่วป่าไม่เพียงแต่หล่อเลี้ยงเศรษฐกิจ แต่ยังผูกพันกับชีวิตประจำวันและการรับมือกับธรรมชาติของชาวเมือง พื้นที่ริมน้ำอย่างสวนสาธารณะทุ่งพระโพธิ์ เป็นตัวอย่างที่ชัดเจนของการปรับตัวให้อยู่ร่วมกับระบบน้ำของเมืองเก่า</p><p>เอกสารแผนงานของเทศบาลระบุว่าพื้นที่ทุ่งพระโพธิ์มีความสำคัญในฐานะโครงสร้างพื้นฐานในการจัดการน้ำ โดยมีโครงการขุดลอกคลองส่งน้ำและก่อสร้างท่าน้ำ ในช่วงเวลาที่เมืองเผชิญปัญหาน้ำท่วม พื้นที่นี้ยังถูกใช้เป็นจุดติดตั้งเครื่องสูบน้ำเพื่อบรรเทาอุทกภัยให้แก่ชุมชน</p><p>แต่นอกจากมิติของการรับมือภัยธรรมชาติแล้ว ทุ่งพระโพธิ์ยังเป็นพื้นที่เปิดโล่งสำหรับกิจกรรมทางวัฒนธรรม ในวันเพ็ญเดือนสิบสองของทุกปี ลานกว้างริมน้ำแห่งนี้จะถูกใช้เป็นสถานที่จัดงานประเพณีลอยกระทงประจำปีของเทศบาล</p><p>การใช้งานที่หลากหลายนี้สะท้อนให้เห็นว่า พื้นที่ริมสายน้ำไม่ได้ถูกทิ้งร้างหลังยุคเหมืองแร่ แต่ถูกปรับเปลี่ยนหน้าที่ให้กลายเป็นทั้งกลไกป้องกันเมืองและลานกิจกรรมที่รวมผู้คนเข้าไว้ด้วยกันในวันงานบุญ</p></section><section class="story-section-v2"><h2 id="section-5">ร่องรอยที่ยังไหลเวียนในภูมิทัศน์ปัจจุบัน</h2><p>วันนี้ แม้เหมืองแร่จะปิดตัวลงและการค้าทางเรือขนาดใหญ่จะกลายเป็นเพียงอดีตที่ถูกบันทึกไว้ในหน้ากระดาษ แต่สถานที่ริมน้ำหลายแห่งยังคงมีชีวิตและอยู่ร่วมกับลมหายใจของคนเมืองเก่าตะกั่วป่าอย่างกลมกลืน</p><p>สะพานเหล็กบุญสูงยังคงทำหน้าที่เป็นทางสัญจรของชุมชน ที่ชาวบ้านยังคงใช้เดินเท้าและขี่รถจักรยานยนต์ผ่านไปมา ในขณะเดียวกัน มันก็ได้กลายเป็นแลนด์มาร์กที่ผู้คนมาชมวิวและถ่ายภาพร่องรอยของโรงขุดแร่เก่าที่ยังมองเห็นได้จากบนสะพาน หรือแม้แต่ถูกใช้เป็นสถานที่ถ่ายทำภาพยนตร์ต่างประเทศ</p><p>บริเวณริมคลองใกล้กับวัดย่านยาว ก็ได้มีการริเริ่มพื้นที่ตลาดชุมชนในชื่อตลาดริมน้ำตะกั่วป่า เพื่อช่วยปลุกบรรยากาศเก่า· ให้ผู้คนได้กลับมาสัมผัสวิถีชีวิตริมน้ำอีกครั้ง และมีการจัดเทศกาลอาหารทะเลตามปฏิทินวัฒนธรรม</p><p>สายน้ำตะกั่วป่ายังคงไหลเอื่อย เป็นผู้พิทักษ์ความทรงจำตั้งแต่วันที่เป็นเมืองท่าระดับโลกที่คลาคล่ำไปด้วยเรือสินค้า จนถึงวันที่เป็นจุดชมวิวที่สงบงามของเมืองเก่าที่เราเห็นในปัจจุบัน</p></section><section class="story-places-v2"><h2>ไปดูของจริงได้ที่ไหน</h2><div class="mini-cards-v2"><div class="place-card-mini"><div><h4>ตลาดริมน้ำตะกั่วป่า</h4><button class="button button-outline" data-trip-add="riverwalk">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h4>สะพานเหล็กบุญสูง</h4><button class="button button-outline" data-trip-add="iron-bridge">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h4>วัดปทุมธารา (วัดหน้าเมือง)</h4><button class="button button-outline" data-trip-add="wat-pathum">เพิ่มลงทริป</button></div></div><div class="place-card-mini"><div><h4>สวนสาธารณะทุ่งพระโพธิ์</h4><button class="button button-outline" data-trip-add="thung-phra">เพิ่มลงทริป</button></div></div></div></section><details class="unknowns-box-v2"><summary>ข้อมูลที่ยังหาไม่เจอ</summary><ul><li>ลักษณะสถาปัตยกรรมและรายละเอียดผังเมืองของท่าเรือทุ่งตึกในยุคก่อนการค้าเหมืองแร่ดีบุก</li><li>ภาพถ่ายร่วมสมัยที่สามารถระบุสิทธิ์การใช้งานได้ชัดเจน ซึ่งแสดงความคับคั่งของการจราจรทางน้ำในยุคที่เรือกลไฟยังแล่นได้</li><li>เอกสารบันทึกเหตุการณ์วันที่ย้ายเมืองไปย่านยาวอย่างเป็นทางการ และเสียงสะท้อนของชาวบ้านในชุมชนตลาดใหญ่ในขณะนั้น</li></ul></details><section class="story-sources-v2"><h2>แหล่งข้อมูล</h2><ol><li><cite>ทุ่งตึกเมืองท่าการค้าโบราณ</cite> · กรมศิลปากร · บทความแหล่งโบราณคดีทุ่งตึก · <a href="https://www.finearts.go.th/architecture/view/35708-ทุ่งตึกเมืองท่าการค้าโบราณ" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>เอกสารเมืองเก่าตะกั่วป่า</cite> · สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (สผ.) · PDF หน้า 11–13, 55–56, 58 · <a href="https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ฐานข้อมูลแหล่งโบราณคดี: ชุมชนตลาดใหญ่</cite> · ศูนย์มานุษยวิทยาสิรินธร · ข้อมูลประวัติศาสตร์ชุมชน · <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>สะพานเหล็กบุญสูง (โคกขนุน)</cite> · ฐานข้อมูลท้องถิ่นภาคใต้ มหาวิทยาลัยสงขลานครินทร์ · หน้าประวัติและภาพรวม · <a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>เอกสารแผนการดำเนินงานด้านสิ่งแวดล้อม พ.ศ.2565</cite> · เทศบาลเมืองตะกั่วป่า · ระเบียนโครงการและการจัดการน้ำ · <a href="https://www.takuapacity.go.th/files/com_strategy/2022-12_231dcd9d5169573.pdf" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ข่าวน้ำท่วมตะกั่วป่าและการติดตั้งเครื่องสูบน้ำ</cite> · MGR Online · ข่าวภูมิภาค · <a href="https://mgronline.com/south/detail/9560000096203" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ตลาดริมน้ำตะกั่วป่า ร่วมใจประชารัฐ</cite> · กรมการค้าภายใน กระทรวงพาณิชย์ · ข้อมูลตลาดต้องชม · <a href="https://www.dit.go.th/FILE/CONTENT_FILE/256202181736250948974.pdf" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ข่าวเช้า: สะพานเหล็กบุญสูง</cite> · NBT2HD · รายการข่าว 30 มกราคม 2569 · <a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li><li><cite>ปฏิทินเทศกาลอาหารทะเล ตลาดริมน้ำตะกั่วป่า</cite> · กระทรวงวัฒนธรรม · ปฏิทินกิจกรรมวัฒนธรรม · <a href="https://calendar.m-culture.go.th/events/103651" target="_blank" rel="noopener">ดูแหล่งที่มา</a> (เข้าถึง 2026-09-07)</li></ol></section></div><div class="story-sidebar-v2"><aside class="evidence-box-v2"><h3>หลักฐานอยู่ตรงไหน</h3><ul class="ev-items-v2"><li><div class="ev-claim">ระยะทางข้ามคาบสมุทรและจุดเริ่มต้นของทุ่งตึก</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">ตัวเลขระยะทางเป็นข้อมูลจากรายงาน สผ. และการจัดตั้งทุ่งตึกอ้างอิงจากคำอธิบายของกรมศิลปากร ซึ่งเว็บไซต์คงระดับข้อความไว้ตามเอกสารต้นฉบับ ไม่ได้ยืนยันข้อสรุปใหม่ <a href="https://www.finearts.go.th/architecture/view/35708-ทุ่งตึกเมืองท่าการค้าโบราณ" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">การย้ายเมืองเพราะแม่น้ำตื้นเขิน</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">วันที่และเหตุผลการย้ายเมืองใน พ.ศ. 2456 เป็นการรวบรวมข้อมูลตามรายงาน สผ. ซึ่งควรอ้างอิงตามรายงานฉบับต้นทางเมื่อใช้ในงานวิชาการ <a href="https://culturalenvi.onep.go.th/site/detail/4428" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li><li><div class="ev-claim">ที่มาของหม้อไอน้ำวัดหน้าเมือง</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">ข้อมูลจากฐานข้อมูลศูนย์มานุษยวิทยาสิรินธรระบุถึงการซื้อเรือกลไฟใน พ.ศ. 2410 แต่หลักฐานชิ้นนี้ไม่ได้ยืนยันว่าวัดเป็นผู้ดำเนินกิจการเหมืองแร่โดยตรง <a href="https://wikicommunity.sac.or.th/community/1527" target="_blank" rel="noopener">อ้างอิง ↗</a></div></li></ul></aside><nav class="story-toc-v2 scrollspy" id="story-toc"><h2>เนื้อหาในบทความ</h2><ul class="scrollspy-nav"><li><a href="#section-0">ทุ่งตึก ท่าเรือก่อนมีเมือง</a></li><li><a href="#section-1">หม้อไอน้ำกับความรุ่งเรืองของตลาดใหญ่</a></li><li><a href="#section-2">วันที่ตะกอนทับถมและเมืองต้องขยับ</a></li><li><a href="#section-3">สะพานเหล็กบุญสูง ทางเชื่อมของคนเหมือง</a></li><li><a href="#section-4">พื้นที่รับน้ำและงานบุญที่ทุ่งพระโพธิ์</a></li><li><a href="#section-5">ร่องรอยที่ยังไหลเวียนในภูมิทัศน์ปัจจุบัน</a></li></ul></nav></div></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/" class="footer-name">ตะกั่วป่า <em>101</em></a><p>เมืองหนึ่งเมือง<br>มีเรื่องให้ค่อย ๆ รู้จัก</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">จัดทำโดยบ้านศิวรา ตะกั่วป่า</a><span>คู่มือเมืองเก่า · จังหวัดพังงา</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">แผ่นพับต้นทาง ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/"><span class="tb-glyph" aria-hidden="true">⌂</span>หน้าแรก</a><a href="/map/"><span class="tb-glyph" aria-hidden="true">◈</span>แผนที่</a><a href="/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>กินอะไร</a><a href="/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>ทริป<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>
