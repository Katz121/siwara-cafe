LEAFLET_SHOPS = 59            # à¸ˆà¸²à¸à¹à¸œà¹ˆà¸™à¸žà¸±à¸šà¹€à¸—à¸¨à¸šà¸²à¸¥ Â· à¹€à¸›à¹‡à¸™à¸—à¸µà¹ˆà¸¡à¸²à¸‚à¸­à¸‡à¸£à¸²à¸¢à¸Šà¸·à¹ˆà¸­à¸Šà¸¸à¸”à¹à¸£à¸
def _shop_total():
    """à¸ˆà¸³à¸™à¸§à¸™à¸£à¹‰à¸²à¸™à¸—à¸±à¹‰à¸‡à¸«à¸¡à¸”à¸—à¸µà¹ˆà¹à¸ªà¸”à¸‡à¸šà¸™ /eat/ Â· à¹à¸œà¹ˆà¸™à¸žà¸±à¸š + à¸—à¸µà¹ˆà¸„à¹‰à¸™à¹€à¸žà¸´à¹ˆà¸¡à¹à¸¥à¸°à¸£à¸°à¸šà¸¸à¹à¸«à¸¥à¹ˆà¸‡à¸—à¸µà¹ˆà¸¡à¸²à¹à¸¥à¹‰à¸§"""
    import json as _j, os as _o
    n = LEAFLET_SHOPS
    fp = _o.path.join(_o.path.dirname(_o.path.abspath(__file__)), 'data', 'shops-extra.json')
    try:
        d = _j.load(open(fp, encoding='utf-8'))
        n += len(d if isinstance(d, list) else d.get('shops', []))
    except Exception:
        pass
    return n
SHOP_TOTAL = _shop_total()

