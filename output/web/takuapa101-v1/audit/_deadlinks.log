.\place_pages.py:56:    facts+='<div>'+''.join(link(u,'แหล่งข้อมูลการเข้าชม ↗') for u in v.get('source_urls',[]))+link(c.get('source_url'),'แหล่งข้อมูลติดต่อ ↗')+'</div>'
.\place_pages.py:65:        eras+=f'<article class="era-card" data-era="{key}"><span class="chapter">{label}</span><h3>{text(era.get("headline_th") or label)}</h3><p class="era-years">{text(era.get("years_th"))}</p>'+badge(era.get('status'))+paragraphs(era.get('body_th'))+(photo(matching[0]) if matching else '')+'<div class="era-sources">แหล่งอ้างอิง · '+ ' · '.join(link(s.get('url'),s.get('name') or 'แหล่งข้อมูล') for s in era.get('sources',[]))+'</div></article>'
