        out+=f'<div id="gallery-{key}" data-panel="{key}"><h3>{label}</h3><div class="photo-grid">'+(''.join(photo(p,zoom=True) for p in items) or '<p class="muted">ยังไม่มีภาพที่ได้รับอนุญาตให้เผยแพร่ในหมวดนี้</p>')+'</div></div>'
