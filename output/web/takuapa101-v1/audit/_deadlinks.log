def story_outro(sid):
    hit = STORY_OUTRO.get(sid)
    if not hit:
        return ''
    href, body, label = hit
    return (f'<aside class="story-outro"><p>{escape(body)}</p>'
            f'<a class="text-link" href="{escape(href)}" target="_blank" rel="noopener">{escape(label)}</a></aside>')


def article(story, ctx):
    is_new = 'lede' in story
    if not is_new:
        sections = ''.join(f'<section><span class="chapter">à¸«à¸¥à¸±à¸à¸à¸²à¸™à¸Šà¹ˆà¸§à¸‡à¸—à¸µà¹ˆ {i:02d}</span><h2>{escape(h)}</h2><p>{escape(p)}</p></section>' for i, (h, p) in enumerate(story['sections'], 1))
