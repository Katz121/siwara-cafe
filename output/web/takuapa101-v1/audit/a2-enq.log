1:<!doctype html><html lang="en" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Boon Soong Iron Bridge, Takua Pa · Takua Pa 101</title><meta name="description" content="Looking at the steel frame and recalling the miners&#x27; journey · Khok Khanoon Iron Bridge · Takua Pa attractions · Phang Nga heritage"><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="Boon Soong Iron Bridge, Takua Pa"><meta property="og:description" content="Looking at the steel frame and recalling the miners&#x27; journey · Khok Khanoon Iron Bridge · Takua Pa attractions · Phang Nga heritage"><meta property="og:url" content="https://takuapa101.com/places/iron-bridge/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/iron-bridge.png"><meta property="og:locale" content="en_US"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/iron-bridge.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/en/places/iron-bridge/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "inLanguage": "en", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "หน้าแรก", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "สะพานเหล็กบุญสูง · สะพานเหล็กโคกขนุน", "item": "https://takuapa101.com/places/iron-bridge/"}]}, {"@context": "https://schema.org", "inLanguage": "en", "@type": "TouristAttraction", "name": "สะพานเหล็กบุญสูง", "url": "https://takuapa101.com/places/iron-bridge/", "image": "https://takuapa101.com/assets/iron-bridge.webp", "description": "สะพานมีความเกี่ยวข้องกับการเดินทางและการขนส่งในยุคเหมืองแร่", "address": {"@type": "PostalAddress", "streetAddress": "ถนนราษฎร์บำรุง บ้านโคกขนุน", "addressLocality": "ตะกั่วป่า", "addressRegion": "พังงา", "postalCode": "82110", "addressCountry": "TH"}, "geo": {"@type": "GeoCoordinates", "latitude": 8.8531719567, "longitude": 98.3540239936}}, {"@context": "https://schema.org", "inLanguage": "en", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "เปิดให้เข้าชมเวลาใด", "acceptedAnswer": {"@type": "Answer", "text": "ข้อมูลยังไม่ยืนยัน · เข้าชมได้ตลอดทั้งวัน (ข้อมูลจากแหล่งท่องเที่ยวรอง)"}}, {"@type": "Question", "name": "มีที่จอดรถไหม", "acceptedAnswer": {"@type": "Answer", "text": "มีข้อมูลจากรีวิวว่าจอดริมถนนได้และมีพื้นที่จำกัด แต่ไม่มีข้อมูลทางการยืนยัน"}}, {"@type": "Question", "name": "เดินทางจากตัวเมืองตะกั่วป่าอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "เดินทางตามถนนราษฎร์บำรุงไปทางเมืองเก่าตะกั่วป่า สะพานอยู่ด้านซ้ายมือ ห่างจากตัวเมืองประมาณ 2 กิโลเมตร"}}, {"@type": "Question", "name": "สถานที่นี้มีประวัติความเป็นมาอย่างไร", "acceptedAnswer": {"@type": "Answer", "text": "พ.ศ. 2511 มีการนำเหล็กจากเรือขุดแร่มาสร้างสะพานเหล็กโคกขนุน ความยาวกว่า 200 เมตร ข้ามแม่น้ำตะกั่วป่า ผู้ริเริ่มคือ นายจุติ บุญสูง เจ้าของกิจการบริษัทเรือขุดแร่จุติบุญสูง จำกัด ซึ่งก่อตั้งบริษัทใน พ.ศ. 2503"}}, {"@type": "Question", "name": "มีจุดเด่นอะไรให้ชม", "acceptedAnswer": {"@type": "Answer", "text": "สะพานทอดข้ามแม่น้ำตะกั่วป่าและเชื่อมพื้นที่ถนนหลักกับบริเวณโรงขุดแร่เก่า ใช้เหล็กจากเรือขุดแร่ที่ไม่ใช้งานแล้ว และปลายทางยังมองเห็นโรงขุดแร่เก่า จากสะพานเห็นทุ่งสีเขียว ต้นไม้ และทิวเขา เหมาะกับการชมวิวและถ่ายภาพ"}}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/places/iron-bridge/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/places/iron-bridge/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/places/iron-bridge/"></head><body class="inner-page"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/en/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">101</span><span>Takua Pa<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/en/places/" aria-current="page">Places</a><a href="/en/stories/">Stories</a><a href="/en/map/">Map</a><a href="/en/rest/">Eat and explore</a><a href="/en/news/">Updates</a><a href="/en/trip/">Your trip</a><a href="/en/traditions/" class="nav-more">Traditions</a><a href="/en/eat/" class="nav-more">Eat & Souvenirs</a><a href="/en/routes/" class="nav-more">Walking Routes</a><a href="/en/leaflet/" class="nav-more">Leaflet</a><a href="/en/about/" class="nav-more">About</a></nav><div class="header-tools"><a class="lang-switch" href="/places/iron-bridge/" hreflang="th" lang="th">ไทย</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/en/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/en/map/">Open map ↗</a></div></header><main id="main"><div class="breadcrumbs"><a href="/en/">Home</a> / <a href="/en/places/">Places</a> / Old Buildings & City Traces</div><header class="place-hero full-place-hero"><div><span class="chapter">Place record · Old buildings and city traces</span><h1>Boon Soong Iron Bridge</h1><p class="english">Boon Soong Iron Bridge</p><span class="fact-status confirmed">9 items verified</span><p><a class="text-link" href="#eras">Then · Before · Now ↓</a></p><p class="place-hero-actions"><button class="button" type="button" data-trip-add="iron-bridge">Add to trip</button><a class="text-link" href="/en/trip/">View your trip</a></p></div><div class="place-hero-art"><img src="/assets/iron-bridge.webp" alt="สะพานเหล็กบุญสูง" width="1000" height="1000" loading="eager"></div></header><div class="research-layout"><aside class="visit-card" id="visit"><h2>Practical information</h2><dl><div><dt>Location</dt><dd>8.8531719567, 98.3540239936 <span class="fact-status unknown">Not verified</span></dd></div><div class="directions"><a href="https://www.google.com/maps/search/?api=1&amp;query=8.8531719567,98.3540239936" target="_blank" rel="noopener">Navigate with Google Maps ↗</a><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">Coordinates source ↗</a></div><div><dt>Opening hours</dt><dd>Open all day (information from secondary tourist sources) <span class="fact-status unverified">Not verified</span></dd></div><div><dt>Admission fee</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Parking</dt><dd>Reviews state that roadside parking is available with limited space, but this is not verified by official sources <span class="fact-status unknown">Not verified</span></dd></div><div><dt>Restrooms</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Wheelchair access</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Dress code</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Phone</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Page</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>Website</dt><dd><span class="muted">Not verified</span></dd></div><div><dt>LINE</dt><dd><span class="muted">Not verified</span></dd></div><div><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">Visitor information sources ↗</a><a href="https://www.wongnai.com/attractions/583288JQ-%E0%B8%9E%E0%B8%B2%E0%B8%99%E0%B9%80%E0%B8%AB%E0%B8%A5%E0%B9%87%E0%B8%81-%E0%B8%9A%E0%B8%B8%E0%B8%8D%E0%B8%AA%E0%B8%B9%E0%B8%87" target="_blank" rel="noopener">Visitor information sources ↗</a><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">Contact information ↗</a></div></dl></aside><nav class="research-rail" aria-label="สารบัญหน้านี้"><span class="chapter">On this page</span><a href="#visit">Practical information</a><a href="#eras">Then · Before · Now</a><a href="#timeline">Dot timeline</a><a href="#highlights">Highlights to see</a><a href="#news">News and updates</a><a href="#did_you_know">Did you know</a><a href="#getting_there">Getting there</a><a href="#nearby">Nearby and similar places</a><a href="#faq">FAQ</a><a href="#sources">Data Sources</a></nav><div class="research-body"><section class="research-section" id="eras"><h2>Then · Before · Now</h2><div class="era-axis"><article class="era-card" data-era="then"><span class="chapter">Then</span><h3>From a tin dredger to a workers' bridge</h3><p class="era-years">1960-1968 CE (2503-2511 BE)</p><span class="fact-status confirmed">Verified</span><p>The bridge's story began in Takua Pa during the tin-mining era, when the Boonsung dredging company stood on the opposite bank from the old market. The Takua Pa canal was more than 40 metres wide, so workers and residents had to row across, especially when floodwaters rose. The local database of Prince of Songkla University states that mining operator Juti Boonsung therefore first initiated a wooden bridge for walking and cycling</p><p>Later, in 1968 CE (2511 BE), steel from a decommissioned dredger was assembled into Khok Khanuen Iron Bridge, more than 200 metres long, across the Takua Pa River. The bridge was therefore not only industrial infrastructure, but also a shortcut for workers, a goods route, and a daily connection between the old market and the town's tin-driven mining area. Verifiable evidence confirms the mining and transport roles, but no contemporary document has been found directly linking this bridge to details about maritime trade, Hokkien Chinese people, or the town-governor system</p><div class="era-sources">References · <a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">ฐานข้อมูลท้องถิ่นภาคใต้ มหาวิทยาลัยสงขลานครินทร์ (Southern Thai Local Database, Prince of Songkla University)</a> · <a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (Office of Natural Resources and Environmental Policy and Planning)</a></div></article><article class="era-card" data-era="before"><span class="chapter">Before</span><h3>When the mines went quiet, the bridge became a mining town trace</h3><p class="era-years">After 1968 CE (2511 BE) and before 2026 CE (2569 BE)</p><span class="fact-status confirmed">Verified</span><p>When mining ended, the bridge did not disappear with the dredging plant. It changed from a work structure into a community route and evidence of the industrial landscape. ONEP sources state that the old dredging plant, preserved in its original condition, can still be seen from the bridge area, while contemporary tourism sources call the bridge a symbol of Takua Pa's mining-town past</p><p>Later, the bridge was described and presented as a tourist and photography spot, and it also appeared as a location in the film Wonderful Town (2007), according to an article tracking filming locations. However, this review found no evidence confirming when the mine closed, when major repairs took place, any direct impact from the 2004 tsunami, or registration as a historic site by the Fine Arts Department. These events should therefore not be added as facts</p><div class="era-sources">References · <a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (Office of Natural Resources and Environmental Policy and Planning)</a> · <a href="https://th.readme.me/p/40233" target="_blank" rel="noopener">Wonderful Town filming locations</a> · <a href="https://www.takuapacity.go.th/travel" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality): Tourist attractions</a></div></article><article class="era-card" data-era="now"><span class="chapter">Now</span><h3>A mining heritage that remains a passageway and destination</h3><p class="era-years">2569 / 2026</p><span class="fact-status confirmed">Verified</span><p>Today, Boonsung Iron Bridge still serves as a community route. Field information and reviews say that residents use it for travel and motorcycles pass through. At the same time, Takua Pa Municipality classifies it as a tourist attraction, and a TAT tourism source has current images of the site. The bridge thus stands between functioning infrastructure and a landmark for walking, views, and photography</p><p>The latest evidence found is an NBT report dated 30 January 2026, which introduces the bridge as mining heritage associated with Takua Pa and says it was temporarily closed at that time to accommodate a foreign film shoot. In addition, a municipal budget document found includes items for maintaining and improving the bridge entrance area, but no document has been found confirming a restoration project for the structure itself. Opening and closing hours, admission fees, an activity-specific custodian, and the latest safety condition therefore still need to be checked on site</p><div class="era-sources">References · <a href="https://www.takuapacity.go.th/travel" target="_blank" rel="noopener">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality): Tourist attractions</a> · <a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">NBT2HD, Morning News, 30 January 2026</a> · <a href="https://www.takuapacity.go.th/files/com_news_form/2020-07_bc4d766e789d542.pdf" target="_blank" rel="noopener">เทศบัญญัติงบประมาณเทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality Budget Ordinance)</a></div></article></div></section><section class="research-section" id="timeline"><h2>Dot timeline</h2><ol class="point-timeline" tabindex="0" aria-label="เส้นเวลา เลื่อนเพื่ออ่านเหตุการณ์"><li><span class="fact-status confirmed">Verified</span><p class="era-years">1960 CE (2503 BE)</p><h3>Juti Boon Soong took over the mining business</h3><p>Local databases indicate that Mr. Juti Boon Soong bought the Takua Pa Valley dredging company and discovered commuting difficulties for workers and locals between the old market and the company area.</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">1968 CE (2511 BE)</p><h3>Construction of Khok Khanoon iron bridge</h3><p>Iron from a decommissioned tin dredger was used to build a bridge over 200 metres long across the Takua Pa River, connecting the town with the mining area and factory.</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status unverified">Not verified</span><p class="era-years">2007 (2550)</p><h3>Featured as a location in the film Wonderful Town</h3><p>Articles tracking filming locations state that the bridge was a setting in the Thai film Wonderful Town. This is not verified by official production documents, only by audience articles.</p><a href="https://th.readme.me/p/40233" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">2020 (2563 BE)</p><h3>Municipality included the bridge entrance area in budget documents</h3><p>Discovered municipal budget documents contain an item for the maintenance and improvement of land and structures around the entrance of the Boon Soong iron bridge. This is not evidence of a restoration of the bridge itself.</p><a href="https://www.takuapacity.go.th/files/com_news_form/2020-07_bc4d766e789d542.pdf" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">30 January 2026</p><h3>NBT reported the bridge as a mining heritage site</h3><p>NBT reported that the bridge is a historical landmark and was temporarily closed that week to accommodate the filming of a foreign movie.</p><a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">Read source ↗</a></li><li><span class="fact-status confirmed">Verified</span><p class="era-years">Year unspecified</p><h3>The wooden bridge came first</h3><p>A wooden bridge was built for workers to walk and cycle across the canal, as well as for locals to transport goods, but the reviewed sources do not specify the exact year.</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">Read source ↗</a></li></ol></section><p class="missing-photo">No image authorized for publication yet</p><section class="research-section" id="highlights"><h2>Highlights to see</h2><div class="research-cards"><article class="research-note"><h3>Steel structure about 200 metres long</h3><span class="fact-status unknown">Not verified</span><p>The bridge spans the Takua Pa river and connects the main road area with the old ore dredger site.</p><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Traces of the mining industry</h3><span class="fact-status unknown">Not verified</span><p>Built with steel from a decommissioned tin dredger, and the old dredger can be seen at the end of the bridge.</p><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Fields and mountain views</h3><span class="fact-status unknown">Not verified</span><p>From the bridge, green fields, trees, and mountain ranges are visible, making it suitable for sightseeing and photography.</p><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><h3>Community transit route</h3><span class="fact-status unknown">Not verified</span><p>The bridge is still a route used by villagers, so one should be careful of vehicles while visiting.</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="news"><h2>News and updates</h2><div class="research-cards"><article class="research-note"><p class="muted">2026-01-30 · NBT2HD</p><h3>Inviting check-ins at Boon Soong iron bridge, mining heritage of Takua Pa town</h3><p>NBT presented the bridge as a mining heritage site and historical landmark, noting its temporary closure for a foreign film production.</p><a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="did_you_know"><h2>Did you know</h2><div class="research-cards"><article class="research-note"><span class="fact-status confirmed">Verified</span><p>The iron bridge structure was built using steel from a decommissioned tin dredger, not new steel produced specifically for the bridge.</p><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><span class="fact-status confirmed">Verified</span><p>Before the iron bridge, workers and villagers had to use rowboats to cross the canal, and there used to be a wooden bridge for walking and cycling.</p><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">Read source ↗</a></article><article class="research-note"><span class="fact-status unverified">Not verified</span><p>The bridge appeared in a location tracking article for the film Wonderful Town (2007).</p><a href="https://th.readme.me/p/40233" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="getting_there"><h2>Getting there</h2><div class="research-cards"><article class="research-note"><h3>Takua Pa Town</h3><span class="fact-status unknown">Not verified</span><p>Travel along Rat Bamrung Road towards Takua Pa old town; the bridge is on the left, about 2 kilometres from the town centre.</p><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">Read source ↗</a></article></div></section><section class="research-section" id="nearby"><h2>Nearby and similar places</h2><ul class="nearby-links"><li><a href="/en/places/governor-wall/">Governor’s Residence Wall</a></li><li><a href="/en/places/khun-in/">Khun In House</a></li><li><a href="/en/places/tao-ming/">Tao Ming School</a></li></ul></section><section class="research-section" id="faq"><h2>FAQ</h2><details><summary>Opening hours</summary><p>Information not verified · Open to visitors all day (information from a secondary tourism source)</p></details><details><summary>Is parking available?</summary><p>Reviews state that roadside parking is available with limited space, but this is not verified by official sources</p></details><details><summary>Getting there from Takua Pa Town</summary><p>Travel along Rat Bamrung Road towards Takua Pa old town; the bridge is on the left, about 2 kilometres from the town centre.</p></details><details><summary>What is the history of this place?</summary><p>In 1968 (B.E. 2511), steel from a mining dredger was used to build the Khok Khanun Iron Bridge, more than 200 metres long, across the Takua Pa River. The initiative came from Juti Boonsung, owner of Juti Boonsung Mining Dredger Co., Ltd., founded in 1960 (B.E. 2503).</p></details><details><summary>What are the highlights to see?</summary><p>The bridge crosses the Takua Pa River, linking the main road area with the former mining plant. It uses steel from a decommissioned mining dredger, and the old plant is still visible at the far end. From the bridge, you can see green fields, trees, and mountain ranges, making it suitable for views and photography.</p></details></section><section class="research-section" id="sources"><h2>Data Sources</h2><div class="source-table"><table><thead><tr><th>Name</th><th>Type</th><th>Date accessed</th><th>Link</th></tr></thead><tbody><tr><th scope="row">Office of Natural Resources and Environmental Policy and Planning (ONEP): Iron Bridge (Khok Khanun)</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">ฐานข้อมูลท้องถิ่นภาคใต้ มหาวิทยาลัยสงขลานครินทร์ (Southern Thai Local Database, Prince of Songkla University)</th><td>Other resources</td><td>2026-09-07</td><td><a href="https://clib.psu.ac.th/southerninfo/content/1/de645890" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">TrueID Travel: Boonsung Iron Bridge</th><td>Blog</td><td>2026-09-07</td><td><a href="https://travel.trueid.net/detail/BmRGGWx9g1P7" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">TAT Media Assets: Boon Soong Iron Bridge</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://tatmediaassets.com/file/1098453" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">เทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality): Tourist attractions</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/travel" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Wongnai: Boonsung Iron Bridge</th><td>Other resources</td><td>2026-09-07</td><td><a href="https://www.wongnai.com/attractions/583288JQ-%E0%B8%9E%E0%B8%B2%E0%B8%99%E0%B9%80%E0%B8%AB%E0%B8%A5%E0%B9%87%E0%B8%81-%E0%B8%9A%E0%B8%B8%E0%B8%8D%E0%B8%AA%E0%B8%B9%E0%B8%87" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (Office of Natural Resources and Environmental Policy and Planning)</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://culturalenvi.onep.go.th/site/detail/4421" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">เทศบัญญัติงบประมาณเทศบาลเมืองตะกั่วป่า (Takua Pa Town Municipality Budget Ordinance)</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://www.takuapacity.go.th/files/com_news_form/2020-07_bc4d766e789d542.pdf" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">NBT2HD Morning News</th><td>News</td><td>2026-09-07</td><td><a href="https://www.youtube.com/watch?v=QUZ54DTc0LQ" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">TAT Media Assets: Image file 1594919</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://tatmediaassets.com/file/1594919" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">TAT Media Assets: Image file 1098453</th><td>Official agency</td><td>2026-09-07</td><td><a href="https://tatmediaassets.com/file/1098453" target="_blank" rel="noopener">Open source ↗</a></td></tr><tr><th scope="row">Wonderful Town filming locations</th><td>Blog</td><td>2026-09-07</td><td><a href="https://th.readme.me/p/40233" target="_blank" rel="noopener">Open source ↗</a></td></tr></tbody></table></div><details class="unknowns"><summary>Missing data</summary><ul><li>Phone number, Facebook page, website, or official LINE of the location not found.</li><li>Admission fee from checked sources not found.</li><li>Official data regarding restrooms, parking, and wheelchair access not found.</li><li>Verified distance or route data from Phuket, Khao Lak, or the airport not found.</li><li>Festival data specific to the bridge not found.</li><li>Evidence verifying the year and designer of the wooden or iron bridge, aside from the 1968 data and Mr Chuti Boon Soong, not found.</li><li>Evidence of historical site registration by the Fine Arts Department not verified yet.</li><li>Evidence that the bridge features Sino-Portuguese or Chinese architecture not found, so it cannot be concluded as such.</li><li>Nearby places with a verified walking distance from read sources not found.</li><li>Evidence verifying the year the mine closed or changes in ownership after the dredging company era not found.</li><li>Evidence verifying the year and details of the bridge restoration not found.</li><li>Evidence confirming direct impact from the 2004 tsunami not found.</li><li>Registration as a historical site by the Fine Arts Department not found.</li><li>Name of the agency or person directly responsible for the bridge structure in 2026 not found.</li><li>Announcements for opening hours, admission fees, restrooms, parking, or latest safety standards not found.</li><li>Historical photos with a public URL and clear sources not found.</li><li>Photos from TAT have a file listing page, but usage rights are unknown and require permission before use.</li><li>News from the past 5 years confirming restoration projects, traditional events, or awards specific to the bridge not found.</li></ul></details></section></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/en/" class="footer-name">Takua Pa <em>101</em></a><p>One city<br>Stories to get to know</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">Created by Baan Siwara, Takua Pa</a><span>Old Town Guide · Phang Nga Province</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">Original Brochure ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/en/"><span class="tb-glyph" aria-hidden="true">⌂</span>Home</a><a href="/en/map/"><span class="tb-glyph" aria-hidden="true">◈</span>Map</a><a href="/en/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>Eat</a><a href="/en/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>Trip<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>

### site/en/stories/city/index.html
1:<!doctype html><html lang="en" data-base="" data-news-api=""><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>History of Takua Pa: The Town That Moved · Takua Pa 101</title><meta name="description" content="From an ancient settlement on the trans-peninsular route to a market and mining town · Verified facts and questions waiting to be answered."><meta name="robots" content="index,follow,max-image-preview:large"><meta property="og:title" content="History of Takua Pa: The Town That Moved"><meta property="og:description" content="From an ancient settlement on the trans-peninsular route to a market and mining town · Verified facts and questions waiting to be answered."><meta property="og:url" content="https://takuapa101.com/stories/city/"><meta property="og:type" content="website"><meta property="og:image" content="https://takuapa101.com/assets/og/default.png"><meta property="og:locale" content="en_US"><meta property="og:site_name" content="ตะกั่วป่า 101"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://takuapa101.com/assets/og/default.png"><meta name="generator" content="ตะกั่วป่า 101"><link rel="canonical" href="https://takuapa101.com/en/stories/city/"><link rel="preload" href="/assets/NotoSerifThai.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/IBMPlexSansThaiLooped-Regular.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/design.css"><script type="application/ld+json">[{"@context": "https://schema.org", "inLanguage": "en", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://takuapa101.com/"}, {"@type": "ListItem", "position": 2, "name": "The History of Takua Pa, a Town That Moved with the River", "item": "https://takuapa101.com/stories/city/"}]}]</script><script src="/assets/design.js" defer></script><script src="/assets/trip.js" defer></script><link rel="stylesheet" href="/assets/ui.css"><link rel="stylesheet" href="/assets/theme.css"><script src="/assets/theme.js"></script><script src="/assets/search.js" defer></script><script src="/assets/live-news.js" defer></script><meta name="theme-color" content="#203f39"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="alternate" hreflang="th" href="https://takuapa101.com/stories/city/"><link rel="alternate" hreflang="en" href="https://takuapa101.com/en/stories/city/"><link rel="alternate" hreflang="x-default" href="https://takuapa101.com/stories/city/"></head><body class="inner-page"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/en/" aria-label="ตะกั่วป่า 101 หน้าแรก"><span class="brand-mark">101</span><span>Takua Pa<small>TAKUA PA FIELD NOTES</small></span></a><nav id="main-nav" aria-label="เมนูหลัก"><a href="/en/places/">Places</a><a href="/en/stories/" aria-current="page">Stories</a><a href="/en/map/">Map</a><a href="/en/rest/">Eat and explore</a><a href="/en/news/">Updates</a><a href="/en/trip/">Your trip</a><a href="/en/traditions/" class="nav-more">Traditions</a><a href="/en/eat/" class="nav-more">Eat & Souvenirs</a><a href="/en/routes/" class="nav-more">Walking Routes</a><a href="/en/leaflet/" class="nav-more">Leaflet</a><a href="/en/about/" class="nav-more">About</a></nav><div class="header-tools"><a class="lang-switch" href="/stories/city/" hreflang="th" lang="th">ไทย</a><button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="สลับเป็นโหมดกลางคืน"><span class="tt-night" aria-hidden="true">☾</span><span class="tt-day" aria-hidden="true">☀</span></button><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="เปิดเมนู"><span class="ib-glyph" aria-hidden="true">☰</span></button><button class="icon-button" type="button" data-open-search aria-label="ค้นหาในเว็บไซต์ (กด Ctrl+K)"><span class="ib-glyph" aria-hidden="true">⌕</span></button><a class="icon-button" href="/en/trip/" aria-label="ทริปของคุณ"><span class="ib-glyph" aria-hidden="true">◫</span><span class="qs-badge" data-trip-count hidden>0</span></a><a class="header-map" href="/en/map/">Open map ↗</a></div></header><main id="main"><div class="story-article-v2"><header class="story-hero-v2"><div class="breadcrumbs"><a href="/en/">Home</a><span>/</span><a href="/en/stories/">Takua Pa Stories</a><span>/</span><span>Know the city</span></div><span class="eyebrow">Takua Pa Stories · About the Town</span><h1>Takua Pa: The Town That Moved with the River</h1><p class="lead">From an ancient settlement on the trans-peninsular route to a market and mining town · Verified facts and questions waiting to be answered.</p><p class="story-meta">Updated on 2026-09-07 · 6-minute read</p></header><figure class="hero-photo-v2 is-illustration"><img src="/assets/riverwalk.webp" alt="ตลาดริมน้ำตะกั่วป่า" loading="eager"><figcaption><span>Takuapa Riverwalk</span><span class="credit">Illustration · No licensed photo available for this subject yet</span></figcaption></figure><div class="story-layout-v2"><div class="story-main-v2"><div class="story-lede-v2"><p>If you have a chance to take a walk in Takua Pa old town on a holiday afternoon, you will see old houses, long streets, and a quiet, charming atmosphere. But deep beneath the cracks in the old walls and the slow-flowing river, this town hides a story of major transformation.</p><p>Takua Pa was not located here from the beginning, and it did not always look like this. The town is a living entity that grew, expanded, and moved in rhythm with its resources and the river. From a stopover point on the trans-peninsular route, it became a bustling major market town, and later a town that had to find a new home when the river was no longer favorable.</p><p>We will take you to read Takua Pa through what remains: the governor's residence wall that tells a story of wealth, the old temple by the canal, and the river that was once its main artery. This is a town with more than one version of history.</p></div><section class="story-section-v2"><h2 id="section-0">The Ongoing Debate Over the Town's Name</h2><figure class="section-photo-v2"><img src="/assets/wat-kongkha.webp" alt="วัดคงคาภิมุข (วัดคงคา)" loading="lazy"><figcaption><span>Wat Kongkha Phimuk (the riverside temple)</span><span class="credit">Illustration</span></figcaption></figure><p>When speaking of Takua Pa, the first question many people wonder is where the town's name came from. Official sources and historians still offer different explanations, and to date, there is no evidence that can bring this to a single, settled conclusion.</p><p>The first explanation links the town's name to the word "Takola", which appears in ancient records as a major port on the trans-peninsular route. This word is interpreted as a possible root that gradually changed in pronunciation to the current name over several centuries.</p><p>Another explanation is based on local geography and resources. It suggests that the name comes from combining the word "Takua" (which means tin, a mineral abundantly found in the area) and "Pa" (which means forest, reflecting the rich natural environment surrounding the town).</p><p>Although documents from the Office of Natural Resources and Environmental Policy and Planning (ONEP) list both explanations as basic information, they clearly emphasize that there is no definitive evidence to confirm either one. The town's name remains the first mystery greeting visitors, leaving us to imagine the past through different explanations.</p><div class="story-flags-v2"><span class="story-flag-v2 flag-unverified">The origin of the town's name is not settled</span></div></section><blockquote class="pull-quote-v2"><p>Takua Pa was not located here from the beginning, and it did not always look like this. The town is a living entity that grew, expanded, and moved in rhythm with its resources and the river.</p></blockquote><section class="story-section-v2"><h2 id="section-1">The Governor's Residence Wall and Town Defense</h2><figure class="section-photo-v2"><img src="/assets/governor-wall.webp" alt="กำแพงจวนเจ้าเมืองตะกั่วป่า" loading="lazy"><figcaption><span>Governor’s Residence Wall</span><span class="credit">Illustration</span></figcaption></figure><p>The image of Takua Pa's past wealth is inextricably linked to the tin mining business. One of the structures that most clearly reflects the power and context of that era is the Takua Pa governor's residence wall, which stands as a historical witness to this day.</p><p>Scholars have suggested, not settled, that this wall was built during the time of Phraya Senanuchit (Nuch Na Nakhon) while he was the governor between 1840 (2383 BE) and 1881. The wall surrounding the residence was designed as a defensive camp. During an era when the town faced conflicts among Chinese groups linked to the massive benefits from tin mining, the wall served as both a home for the ruler and a fortress to maintain peace.</p><p>The wall's structure is highly stable, constructed with layers of mortar mixed with gravel and sand. The base was designed to be wider than the wall itself. The parts that remain intact today reach a height of about 5 meters. Inside the wall, the area was divided into the front palace, the main hall, and the rear palace, with connecting doors well-proportioned throughout.</p><p>The significance of this governor's residence also appears in historical records when King Chulalongkorn (Rama V) came to inspect the residence on May 28, 1890 (109 RS or 2433 BE). During the excavation by the Fine Arts Department in 1999, Chinese ceramics from the Qing Dynasty and European ceramics were found, providing evidence of Takua Pa's international trade connections.</p><div class="story-flags-v2"><span class="story-flag-v2 ">The construction year is suggested, not settled, based on the governor's tenure</span></div></section><section class="story-section-v2"><h2 id="section-2">A Town That Grew with the River</h2><p>The Takua Pa River is not just a backdrop for the town, but the main artery that has nourished life and trade since the pioneering era. Official documents explain that Takua Pa old town is an ancient settlement located by the river, and it prospered as a trade center on the trans-peninsular route.</p><p>The bustling water trade and tin mining led to the expansion of an area called Talat Yai (the big market) during the reign of King Rama III, which became an important economic center. Near the hustle and bustle of trade, Wat Kongkha Phimuk (the town's temple) or Wat Kongkha, is situated on the west bank of the Takua Pa canal, serving as the spiritual center for the townspeople.</p><p>The history of Wat Kongkha reflects the complexity of the old town's information. The cultural environment data states that this temple was built in 1762, while the archaeological database uses 1936 as the construction year for the beautiful southern style ordination hall. This hall is decorated with stucco floral patterns and Buddha images, which are still preserved today.</p><p>The differences in these sets of numbers are something we often find in local history. Explaining the town's antiquity through official documents only provides an overview of the settlement in the entire area. It does not mean that every building, every bridge, or every location in the present town has the same age dating back to the town's founding era.</p><div class="story-flags-v2"><span class="story-flag-v2 ">The age of the location and the age of the building might not be the same year</span></div></section><section class="story-section-v2"><h2 id="section-3">The Day the River Grew Shallow and the Town Had to Move</h2><p>But nature never stays still, and the river is always ready to change. As time passed, the river that built the town began to change its role. ONEP reports note the end of the golden age of Talat Yai, which was primarily caused by geography and changes in resources.</p><p>Long and continuous tin mining caused a massive amount of sand and sediment to flow down and accumulate in the river. The Takua Pa River, which used to be deep enough for cargo ships and passenger boats to navigate easily, gradually became shallower until large-scale navigation declined and became difficult.</p><p>Eventually, when the river was no longer favorable as a center for trade and transportation, moving the town's administrative center was inevitable. Official reports state that Takua Pa had to move its town center to an area called Yan Yao in 1913.</p><p>That relocation marked the end of Talat Yai's prosperity as a center, turning this area into an old town stopped in time with the past. It left behind Sino-Portuguese architecture and traces of development for future generations to experience and study.</p><div class="story-flags-v2"><span class="story-flag-v2 ">Reasons for the town relocation are based on ONEP reports</span></div></section><section class="story-section-v2"><h2 id="section-4">Reading the Town Today</h2><p>Today, Takua Pa old town has come back to life in a different form from the past. The waterfront by the canal, which used to be a port for transporting tin, has now been revived into the area of the Takua Pa riverside market. It becomes lively again from Saturday afternoon to evening, filled with smiles, the aroma of local food, and the chatter of locals.</p><p>The governor's residence wall, once strong, is no longer used to defend against enemies. Instead, it has become a public space open to visitors and is often used as a venue for traditional festivals or major town events. Meanwhile, Wat Kongkha Phimuk continues to function as an active temple with residing monks. It is a peaceful place for meditation and a historical site that is still breathing.</p><p>If you have the chance to walk along the cultural street and the river, what surrounds you are not just stagnant ruins of the past, but evidence of adaptation for survival. The town that moved with the river back then continues to flow and change along with the people today.</p><p>Before fully believing any numbers or legends of the town, we would like to invite you to read and observe this town carefully. The history of Takua Pa is a charming large book. Some pages might be missing due to time, and some pages are still being written by all of us.</p></section><section class="story-places-v2"><h2>Where to visit in person</h2><div class="mini-cards-v2"><div class="place-card-mini"><div><h3>Takuapa Riverwalk</h3><button class="button button-outline" data-trip-add="riverwalk">Add to trip</button></div></div><div class="place-card-mini"><div><h3>Wat Kongkha Phimuk (the riverside temple)</h3><button class="button button-outline" data-trip-add="wat-kongkha">Add to trip</button></div></div><div class="place-card-mini"><div><h3>Governor’s Residence Wall</h3><button class="button button-outline" data-trip-add="governor-wall">Add to trip</button></div></div></div></section><details class="unknowns-box-v2"><summary>Missing data</summary><ul><li>The exact construction year of the governor's residence wall</li><li>Definitive evidence confirming the origin of Takua Pa's name</li><li>The reasons and builders of Wat Kongkha in its early days</li></ul></details><section class="story-sources-v2"><h2>Sources</h2><ol><li><cite>Takua Pa Old Town</cite> · สำนักงานนโยบายและแผนทรัพยากรธรรมชาติและสิ่งแวดล้อม (Office of Natural Resources and Environmental Policy and Planning) · Takua Pa Old Town webpage · <a href="https://culturalenvi.onep.go.th/site/detail/4428" target="_blank" rel="noopener">View sources</a> (Accessed 2026-09-07)</li><li><cite>Takua Pa Old Town Documents</cite> · สผ. (ONEP) · PDF pages 11-13, 55-56, 58 · <a href="https://nced.onep.go.th/opendata/2568/oldtown36_announce/takuapa.pdf" target="_blank" rel="noopener">View sources</a> (Accessed 2026-09-07)</li><li><cite>Archaeological Site Database: Takua Pa Town</cite> · ศูนย์มานุษยวิทยาสิรินธร (Princess Maha Chakri Sirindhorn Anthropology Centre) · List of archaeological sites and suggested city walls · <a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">View sources</a> (Accessed 2026-09-07)</li></ol></section></div><div class="story-sidebar-v2"><aside class="evidence-box-v2"><h3>Where is the evidence?</h3><ul class="ev-items-v2"><li><div class="ev-claim">The town's name originated from 'Takola' or 'Takua and Pa'</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">ONEP documents list both explanations, but emphasize that there is no definitive evidence to confirm either one. <a href="https://culturalenvi.onep.go.th/site/detail/4428" target="_blank" rel="noopener">References ↗</a></div></li><li><div class="ev-claim">The governor's residence wall was built between 1840 and 1881</div><div class="ev-status unverified">UNVERIFIED</div><div class="ev-explain">This is suggested, not settled, based on the tenure of Governor Phraya Senanuchit (Nuch Na Nakhon), and is not an exact year of construction. <a href="https://archaeology.sac.or.th/archaeology/874" target="_blank" rel="noopener">References ↗</a></div></li><li><div class="ev-claim">Wat Kongkha Phimuk was built in 1762</div><div class="ev-status disputed">DISPUTED</div><div class="ev-explain">The cultural environment data states 1762, while the archaeological database uses 1936 as the construction year for the ordination hall. The age of the location and the remaining building might not align. <a href="https://archaeology.sac.or.th/archaeology/881" target="_blank" rel="noopener">References ↗</a></div></li></ul></aside><nav class="story-toc-v2 scrollspy" id="story-toc"><h2>In this article</h2><ul class="scrollspy-nav"><li><a href="#section-0">The Ongoing Debate Over the Town's Name</a></li><li><a href="#section-1">The Governor's Residence Wall and Town Defense</a></li><li><a href="#section-2">A Town That Grew with the River</a></li><li><a href="#section-3">The Day the River Grew Shallow and the Town Had to Move</a></li><li><a href="#section-4">Reading the Town Today</a></li></ul></nav></div></div></div></main><footer class="site-footer"><div class="footer-top"><a href="/en/" class="footer-name">Takua Pa <em>101</em></a><p>One city<br>Stories to get to know</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">Created by Baan Siwara, Takua Pa</a><span>Old Town Guide · Phang Nga Province</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">Original Brochure ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/en/"><span class="tb-glyph" aria-hidden="true">⌂</span>Home</a><a href="/en/map/"><span class="tb-glyph" aria-hidden="true">◈</span>Map</a><a href="/en/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>Eat</a><a href="/en/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>Trip<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>

