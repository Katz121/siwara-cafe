taurant (Bang Nai Si)", "url": "https://maps.google.com/?q=%E0%B8%A3%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%9B%E0%B8%B9%E0%B8%94%E0%B8%B3%20%E0%B8%9A%E0%B8%B2%E0%B8%87%E0%B8%99%E0%B8%B2%E0%B8%A2%E0%B8%AA%E0%B8%B5"}}, {"@type": "ListItem", "position": 7, "item": {"@type": "Place", "name": "Kae Pad Thai (Takua Pa Old Market)", "url": "https://maps.google.com/?q=%E0%B9%80%E0%B8%81%E0%B9%8B%E0%B8%9C%E0%B8%B1%E0%B8%94%E0%B9%84%E0%B8%97%E0%B8%A2%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2"}}, {"@type": "ListItem", "position": 8, "item": {"@type": "Place", "name": "Jae Uan Talay Sod (Baan Nam Kem)", "url": "https://maps.google.com/?q=%E0%B9%80%E0%B8%88%E0%B9%8A%E0%B8%AD%E0%B9%89%E0%B8%A7%E0%B8%99%20%E0%B8%9A%E0%B9%89%E0%B8%B2%E0%B8%99%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B9%80%E0%B8%84%E0%B9%87%E0%B8%A1"}}, {"@type": "ListItem", "position": 9, "item": {"@type": "Place", "name": "Thanon Si Takua Pa & Old Building Street Art", "url": "https://maps.google.com/?q=%E0%B8%96%E0%B8%99%E0%B8%99%E0%B8%A8%E0%B8%A3%E0%B8%B5%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2"}}, {"@type": "ListItem", "position": 10, "item": {"@type": "Place", "name": "Namtok Tam Nang (Si Phang-nga National Park)", "url": "https://maps.google.com/?q=%E0%B8%99%E0%B9%89%E0%B8%B3%E0%B8%95%E0%B8%81%E0%B8%95%E0%B8%B3%E0%B8%AB%E0%B8%99%E0%B8%B1%E0%B8%87"}}, {"@type": "ListItem", "position": 11, "item": {"@type": "Place", "name": "Saphan Lek Bun Sung (Khok Khanun Bridge)", "url": "https://maps.google.com/?q=%E0%B8%AA%E0%B8%B0%E0%B8%9E%E0%B8%B2%E0%B8%99%E0%B9%80%E0%B8%AB%E0%B8%A5%E0%B9%87%E0%B8%81%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2"}}, {"@type": "ListItem", "position": 12, "item": {"@type": "Place", "name": "Lard Yai, Old Town Cultural Walking Street", "url": "https://maps.google.com/?q=%E0%B8%AB%E0%B8%A5%E0%B8%B2%E0%B8%94%E0%B9%83%E0%B8%AB%E0%B8%8D%E0%B9%88%20%E0%B8%95%E0%B8%B0%E0%B8%81%E0%B8%B1%E0%B9%88%E0%B8%A7%E0%B8%9B%E0%B9%88%E0%B8%B2"}}, {"@type": "ListItem", "position": 13, "item": {"@type": "Place", "name": "Tao Sor Tuang Rat (100-Year Original Recipe)", "url": "https://maps.google.com/?q=%E0%B9%80%E0%B8%95%E0%B9%89%E0%B8%B2%E0%B8%AA%E0%B9%89%E0%B8%AD%E0%B8%95%E0%B8%A7%E0%B8%87%E0%B8%A3%E0%B8%B1%E0%B8%95%E0%B8%99%E0%B9%8C"}}]}]</script></main><footer class="site-footer"><div class="footer-top"><a href="/en/" class="footer-name">Takua Pa <em>101</em></a><p>One city<br>Stories to get to know</p><a class="round-link" href="#main" aria-label="กลับขึ้นด้านบน">↑</a></div><div class="footer-bottom"><a href="https://siwaracafe.com/">Created by Baan Siwara, Takua Pa</a><span>Old Town Guide · Phang Nga Province</span><a href="https://www.takuapacity.go.th/pdf/travel-preview.pdf">Original Brochure ↗</a></div></footer><nav class="tabbar" aria-label="เมนูด่วน"><a href="/en/"><span class="tb-glyph" aria-hidden="true">⌂</span>Home</a><a href="/en/map/"><span class="tb-glyph" aria-hidden="true">◈</span>Map</a><a href="/en/eat/"><span class="tb-glyph" aria-hidden="true">◉</span>Eat</a><a href="/en/trip/"><span class="tb-glyph" aria-hidden="true">◫</span>Trip<span class="qs-badge" data-trip-count hidden>0</span></a></nav></body></html>

