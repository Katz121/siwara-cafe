  25: function salvage(text) {
  26:   const verdict = (text.match(/(publish|hold|drop)/i) || [])[1];
  27:   if (!verdict) return null;
  28:   const conf = (text.match(/confidence["'\s:]+(\d{1,3})/i) || [])[1];
  29:   const place = (text.match(/place_id["'\s:]+["']([a-z0-9-]+)["']/i) || [])[1];
  30:   const reason = (text.match(/reason_th["'\s:]+["']([^"']{2,120})["']/i) || [])[1];
  31:   const title = (text.match(/clean_title_th["'\s:]+["']([^"']{2,120})["']/i) || [])[1];
  32:   const summary = (text.match(/summary_th["'\s:]+["']([^"']{2,300})["']/i) || [])[1];
  33:   return {
  34:     verdict: verdict.toLowerCase(),
  35:     confidence: conf ? Number(conf) : 60,
  36:     place_id: place || null,
  37:     reason_th: reason || '',
  38:     clean_title_th: title || '',
  39:     summary_th: summary || '',
  40:   };
  41: }
  42: 
  43: function parseVerdict(text) {
  44:   try {
  45:     // Small models wrap JSON in prose or code fences, and sometimes emit the
  46:     // fields without braces at all. Try the strict read first, then salvage.
  47:     const cleaned = String(text || '').replace(/```json|```/g, ' ');
  48:     const m = cleaned.match(/\{[\s\S]*\}/);
  49:     if (!m) return salvage(cleaned);
  50:     let v;
  51:     try {
  52:       v = JSON.parse(m[0]);
  53:     } catch (e) {
  54:       v = salvage(cleaned);
  55:       if (!v) return null;
  56:     }
  57:     if (!['publish', 'hold', 'drop'].includes(v.verdict)) return null;
  58:     v.confidence = Math.max(0, Math.min(100, Number(v.confidence) || 0));
  59:     return v;
  60:   } catch (e) {
  61:     return null;
  62:   }
  63: }
