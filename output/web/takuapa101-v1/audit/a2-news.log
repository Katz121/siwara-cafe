 137: export async function runHarvest(env) {
 138:   const started = new Date().toISOString();
 139:   const minConf = Number(env.MIN_CONFIDENCE || 75);
 140:   const maxItems = Number(env.MAX_ITEMS || 60);
 141:   const maxReviews = Number(env.MAX_REVIEWS_PER_RUN || 20);
 142: 
 143:   const raw = (await harvestSearch())
 144:     .concat(await harvestOutlets())
 145:     .concat(await harvestDirect());
 146: 
 147:   const seen = new Set(await readJSON(env, KEY_SEEN, []));
 148:   const stats = { fetched: raw.length, rule_rejected: 0, already_seen: 0, reviewed: 0, live: 0, held: 0, dropped: 0 };
 149: 
 150:   const candidates = [];
 151:   const liveNow = await readJSON(env, KEY_LIVE, []);
 152:   const titlesSeen = new Set(liveNow.map((r) => titleKey(r.title_th || '')));
 153:   const urlsSeen = new Set(liveNow.map((r) => urlKey(r.url || '')));
 154:   for (const item of raw) {
 155:     const fp = await fingerprint(item);
 156:     if (seen.has(fp)) { stats.already_seen++; continue; }
 157:     const verdict = ruleFilter(item);
 158:     if (!verdict.ok) { stats.rule_rejected++; seen.add(fp); continue; }
 159:     const ukey = urlKey(item.link);
 160:     if (ukey && urlsSeen.has(ukey)) { stats.duplicate = (stats.duplicate || 0) + 1; seen.add(fp); continue; }
 161:     const tkey = titleKey(item.title);
 162:     if (tkey && titlesSeen.has(tkey)) { stats.duplicate = (stats.duplicate || 0) + 1; seen.add(fp); continue; }
 163:     if (ukey) urlsSeen.add(ukey);
 164:     if (tkey) titlesSeen.add(tkey);
 165:     candidates.push({ ...item, id: fp, place_id: verdict.place_id, rule_score: verdict.score });
 166:   }
 167:   candidates.sort((a, b) => b.rule_score - a.rule_score);
 168: 
 169:   const live = await readJSON(env, KEY_LIVE, []);
 170:   const held = await readJSON(env, KEY_HELD, []);
 171: 
 172:   for (const c of candidates.slice(0, maxReviews)) {
 173:     const reviewed = await recheck(env, c);
 174:     stats.reviewed++;
 175:     const bucket = bucketOf(reviewed, minConf);
 176:     seen.add(c.id);
 177:     const record = {
 178:       id: reviewed.id,
 179:       date: reviewed.date,
 180:       title_th: reviewed.title,
 181:       summary_th: reviewed.summary,
 182:       outlet: reviewed.outlet,
 183:       url: reviewed.link,
 184:       place_id: reviewed.place_id,
 185:       confidence: reviewed.confidence,
 186:       reason_th: reviewed.review_reason_th || '',
 187:       source: reviewed.source,
 188:       auto: true,
 189:       checked_at: started,
 190:     };
 191:     if (bucket === 'live') {
 192:       // The reviewer rewrites the headline, so check once more against what is
 193:       // already published before adding it.
 194:       const finalKey = titleKey(record.title_th || '');
 195:       if (finalKey && live.some((r) => titleKey(r.title_th || '') === finalKey)) {
 196:         stats.duplicate = (stats.duplicate || 0) + 1;
 197:       } else {
 198:         live.unshift(record);
 199:         stats.live++;
 200:       }
 201:     }
 202:     else if (bucket === 'held') { held.unshift({ ...record, verdict: reviewed.verdict, review_error: reviewed.review_error || '' }); stats.held++; }
 203:     else { stats.dropped++; }
 204:   }
 205: 
 206:   const byDate = (a, b) => String(b.date || '').localeCompare(String(a.date || ''));
 207:   const trimmedLive = live.sort(byDate).slice(0, maxItems);
 208:   const trimmedHeld = held.sort(byDate).slice(0, 80);
 209: 
 210:   await env.NEWS.put(KEY_LIVE, JSON.stringify(trimmedLive));
 211:   await env.NEWS.put(KEY_HELD, JSON.stringify(trimmedHeld));
 212:   await env.NEWS.put(KEY_SEEN, JSON.stringify([...seen].slice(-4000)));
 213:   await env.NEWS.put(KEY_RUN, JSON.stringify({ started, finished: new Date().toISOString(), stats }));
 214:   return stats;
 215: }
