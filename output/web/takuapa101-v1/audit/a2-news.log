  65: async function viaClaude(env, prompt) {
  66:   const r = await fetch('https://api.anthropic.com/v1/messages', {
  67:     method: 'POST',
  68:     headers: {
  69:       'content-type': 'application/json',
  70:       'x-api-key': env.ANTHROPIC_API_KEY,
  71:       'anthropic-version': '2023-06-01',
  72:     },
  73:     body: JSON.stringify({
  74:       model: env.RECHECK_MODEL || 'claude-haiku-4-5-20251001',
  75:       max_tokens: 700,
  76:       system: SYSTEM,
  77:       messages: [{ role: 'user', content: prompt }],
  78:     }),
  79:   });
  80:   if (!r.ok) throw new Error('claude ' + r.status);
  81:   const d = await r.json();
  82:   return (d.content || []).map((c) => c.text || '').join('');
  83: }
  84: 
  85: async function viaWorkersAI(env, prompt) {
  86:   const out = await env.AI.run(env.WORKERS_AI_MODEL || '@cf/meta/llama-3.3-70b-instruct-fp8-fast', {
  87:     messages: [
  88:       { role: 'system', content: SYSTEM },
  89:       { role: 'user', content: prompt + '\n\nReply with JSON only, no other text.' },
  90:     ],
  91:     max_tokens: 700,
  92:     temperature: 0.1,
  93:   });
  94:   // Workers AI answers in two shapes depending on the model: a bare
  95:   // {response} or an OpenAI style {choices:[{message:{content}}]}.
  96:   if (typeof out === 'string') return out;
  97:   if (out && typeof out.response === 'string') return out.response;
  98:   const choice = out && out.choices && out.choices[0];
  99:   if (choice && choice.message && typeof choice.message.content === 'string') {
 100:     return choice.message.content;
 101:   }
 102:   if (choice && typeof choice.text === 'string') return choice.text;
 103:   return JSON.stringify(out);
 104: }
