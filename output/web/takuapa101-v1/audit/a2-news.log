  61: /* Returns {ok, reason, place_id, score}. score 0-100 is a rough relevance hint,
  62:    not a truth claim: stage 2 decides whether the item is publishable. */
  63: export function ruleFilter(item) {
  64:   const text = normalise(item.title + ' ' + (item.summary || ''));
  65:   if (!text) return { ok: false, reason: 'ไม่มีข้อความ' };
  66:   if (!REQUIRE_ANY.some((w) => text.includes(w))) {
  67:     return { ok: false, reason: 'ไม่พบชื่อเมืองในข่าว' };
  68:   }
  69:   const blocked = BLOCK_PATTERNS.find((re) => re.test(text));
  70:   if (blocked) return { ok: false, reason: 'อยู่ในหมวดที่ไม่รับ: ' + blocked.source.slice(0, 28) };
  71:   if (!outletAllowed(item.outlet, item.link)) {
  72:     return { ok: false, reason: 'สำนักข่าวไม่อยู่ในรายการที่รับ: ' + (item.outlet || '?') };
  73:   }
  74:   const place_id = guessPlace(text);
  75:   let score = 40;
  76:   if (text.includes('เมืองเก่า')) score += 20;
  77:   if (place_id) score += 20;
  78:   if (/เทศกาล|ประเพณี|งาน|จัดขึ้น|เปิดตัว|บูรณะ|ขึ้นทะเบียน|นิทรรศการ|เดินเมือง/.test(text)) score += 15;
  79:   if (/เทศบาล|ททท\.|กรมศิลปากร|จังหวัดพังงา/.test(text)) score += 10;
  80:   return { ok: true, reason: 'ผ่านกฎ', place_id, score: Math.min(score, 100) };
  81: }
  82: 
  83: /* Stable id so the same story is never published twice. */
  84: export async function fingerprint(item) {
  85:   const base = (item.link || '') + '|' + normalise(item.title).slice(0, 90);
  86:   const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(base));
  87:   return [...new Uint8Array(buf)].slice(0, 10).map((b) => b.toString(16).padStart(2, '0')).join('');
  88: }
  89: 
  90: 
  91: /* Two outlets carrying the same story should appear once. Compare on a stripped
  92:    title rather than the link, since each outlet has its own URL. */
  93: export function titleKey(title) {
  94:   return normalise(title)
  95:     .replace(/[\s฀-๿]*(สยามรัฐ|มติชน|ข่าวสด|ไทยรัฐ|แนวหน้า|ผู้จัดการ|NBT|MGR).*/i, '')
  96:     .replace(/[^0-9a-zA-Z฀-๿]/g, '')
  97:     .slice(0, 48)
  98:     .toLowerCase();
  99: }

