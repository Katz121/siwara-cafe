  89: async function harvestDirect() {
  90:   const out = [];
  91:   for (const s of DIRECT_SOURCES.concat(FIRST_PARTY)) {
  92:     try {
  93:       if (s.kind === 'json') {
  94:         const d = JSON.parse(await fetchText(s.url));
  95:         const events = Array.isArray(d) ? d : (d.events || []);
  96:         for (const e of events) {
  97:           if (!e.title) continue;
  98:           out.push({
  99:             title: e.title,
 100:             link: e.url || s.url,
 101:             date: (e.date || '').slice(0, 10),
 102:             outlet: s.name,
 103:             summary: e.summary || '',
 104:             source: s.id,
 105:             authority: s.authority,
 106:           });
 107:         }
 108:       } else {
 109:         const html = await fetchText(s.url);
 110:         const seen = new Set();
 111:         const re = /<a[^>]+href="([^"]+)"[^>]*>([\s\S]{6,160}?)<\/a>/gi;
 112:         let m;
 113:         while ((m = re.exec(html))) {
 114:           const text = normalise(m[2]);
 115:           if (text.length < 14 || seen.has(text)) continue;
 116:           if (!/ตะกั่วป่า|ตะโกลา/.test(text)) continue;
 117:           seen.add(text);
 118:           let href = m[1];
 119:           if (href.startsWith('/')) href = new URL(s.url).origin + href;
 120:           if (!/^https?:/.test(href)) continue;
 121:           out.push({ title: text, link: href, date: '', outlet: s.name, summary: '', source: s.id, authority: s.authority });
 122:           if (seen.size >= 20) break;
 123:         }
 124:       }
 125:     } catch (e) {
 126:       // one bad source must not stop the run
 127:     }
 128:   }
 129:   return out;
 130: }
