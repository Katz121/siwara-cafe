 106: /* Returns the item annotated with the review, or null when it should be dropped. */
 107: export async function recheck(env, item) {
 108:   const prompt = `หัวข้อ: ${item.title}\nสำนักข่าว: ${item.outlet || 'ไม่ทราบ'}\nวันที่: ${item.date || 'ไม่ทราบ'}\nลิงก์: ${item.link}\nเนื้อหาย่อ: ${item.summary || '(ไม่มี)'}\nสถานที่ที่ตัวกรองเดาไว้: ${item.place_id || 'ไม่ทราบ'}`;
 109:   let text = '';
 110:   try {
 111:     text = env.ANTHROPIC_API_KEY ? await viaClaude(env, prompt) : await viaWorkersAI(env, prompt);
 112:   } catch (e) {
 113:     // A failed review must never publish an unreviewed item.
 114:     return { ...item, verdict: 'hold', confidence: 0, review_error: String(e).slice(0, 120) };
 115:   }
 116:   const v = parseVerdict(text);
 117:   if (!v) {
 118:     return { ...item, verdict: 'hold', confidence: 0,
 119:              review_error: 'อ่านคำตอบไม่ได้', raw_reply: String(text).slice(0, 400) };
 120:   }
 121:   return {
 122:     ...item,
 123:     verdict: v.verdict,
 124:     confidence: v.confidence,
 125:     place_id: v.place_id || item.place_id || null,
 126:     review_reason_th: v.reason_th || '',
 127:     title: v.clean_title_th || item.title,
 128:     summary: v.summary_th || item.summary || '',
 129:   };
 130: }
 131: 
 132: /* Only a confident pass reaches the public feed. */
 133: export function bucketOf(item, minConfidence) {
 134:   if (item.verdict === 'publish' && item.confidence >= minConfidence) return 'live';
 135:   if (item.verdict === 'drop') return 'dropped';
 136:   return 'held';
 137: }



