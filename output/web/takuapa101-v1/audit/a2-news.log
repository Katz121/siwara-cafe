  14: function cors(env, request) {
  15:   const origin = request.headers.get('Origin') || '';
  16:   const allowed = (env.ALLOWED_ORIGINS || '').split(',').map((s) => s.trim()).filter(Boolean);
  17:   const ok = allowed.some((a) => origin === a || origin.startsWith(a));
  18:   return {
  19:     'Access-Control-Allow-Origin': ok ? origin : (allowed[0] || '*'),
  20:     'Access-Control-Allow-Methods': 'GET,OPTIONS',
  21:     'Access-Control-Allow-Headers': 'content-type',
  22:     'Cache-Control': 'public, max-age=600',
  23:   };
  24: }
  25: 
  26: function tag(xml, name) {
  27:   const m = xml.match(new RegExp('<' + name + '[^>]*>([\\s\\S]*?)</' + name + '>'));
  28:   return m ? normalise(m[1].replace(/<!\[CDATA\[|\]\]>/g, '')) : '';
  29: }
  30: 
  31: function toISO(d) {
  32:   const t = Date.parse(d);
  33:   return Number.isNaN(t) ? '' : new Date(t).toISOString().slice(0, 10);
  34: }
  35: 
  36: async function fetchText(url) {
  37:   const r = await fetch(url, { headers: { 'User-Agent': UA, 'Accept-Language': 'th,en' }, cf: { cacheTtl: 300 } });
  38:   if (!r.ok) throw new Error(url.slice(0, 60) + ' -> ' + r.status);
  39:   return r.text();
  40: }
  41: 
  42: function parseRss(xml, meta) {
  43:   const out = [];
  44:   for (const raw of xml.split(/<item[\s>]/).slice(1)) {
  45:     const block = raw.split('</item>')[0];
  46:     const title = tag(block, 'title');
  47:     const link = unwrapLink(tag(block, 'link') || tag(block, 'guid'));
  48:     if (!title || !/^https?:\/\//i.test(link)) continue;
  49:     out.push({
  50:       title,
  51:       link,
  52:       date: toISO(tag(block, 'pubDate') || tag(block, 'dc:date')),
  53:       outlet: tag(block, 'source') || meta.outlet || '',
  54:       summary: normalise(tag(block, 'description')).slice(0, 400),
  55:       source: meta.source,
  56:       query: meta.query,
  57:     });
  58:   }
  59:   return out;
  60: }
  61: 
  62: async function harvestSearch() {
  63:   const out = [];
  64:   for (const q of NEWS_QUERIES) {
  65:     const url = 'https://www.bing.com/news/search?q=' + encodeURIComponent(q) + '&format=RSS&setmkt=th-TH';
  66:     try {
  67:       const xml = await fetchText(url);
  68:       out.push(...parseRss(xml, { source: 'bing-news', query: q }));
  69:     } catch (e) {
  70:       continue;
  71:     }
  72:   }
  73:   return out;
  74: }
