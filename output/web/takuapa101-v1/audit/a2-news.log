---FILTER---
   1: /* Stage 1: rule filter. Cheap, deterministic, runs on every fetched item. */
   2: import { REQUIRE_ANY, BLOCK_PATTERNS, OUTLET_ALLOWLIST, PLACE_KEYWORDS } from './sources.js';
   3: 
   4: const ENTITIES = { amp: '&', lt: '<', gt: '>', quot: '"', apos: "'", nbsp: ' ' };
   5: 
   6: export function decodeEntities(s) {
   7:   return String(s || '').replace(/&(#x?[0-9a-f]+|[a-z]+);/gi, function (m, code) {
   8:     if (code[0] === '#') {
   9:       const n = code[1] === 'x' || code[1] === 'X'
  10:         ? parseInt(code.slice(2), 16)
  11:         : parseInt(code.slice(1), 10);
  12:       return Number.isFinite(n) ? String.fromCodePoint(n) : m;
  13:     }
  14:     const hit = ENTITIES[code.toLowerCase()];
  15:     return hit === undefined ? m : hit;
  16:   });
  17: }
  18: 
  19: export function normalise(s) {
  20:   return decodeEntities((s || '').replace(/<[^>]*>/g, ' ')).replace(/\s+/g, ' ').trim();
  21: }
  22: 
  23: /* Bing hands back a click tracker, not the article. The real address sits in
  24:    the url= parameter, percent encoded. */
  25: export function unwrapLink(link) {
  26:   const raw = decodeEntities(String(link || '')).trim();
  27:   const m = raw.match(/[?&]url=([^&\s]+)/i);
  28:   if (m) {
  29:     try {
  30:       const inner = decodeURIComponent(m[1]);
  31:       if (/^https?:\/\//i.test(inner)) return inner;
  32:     } catch (e) {
  33:       // fall through to the raw link
  34:     }
  35:   }
  36:   return raw;
  37: }
  38: 
  39: /* Same article from two outlets, or the same outlet twice, is one story. */
  40: export function urlKey(u) {
  41:   try {
  42:     const parsed = new URL(unwrapLink(u));
  43:     return (parsed.hostname.replace(/^www\./, '') + parsed.pathname.replace(/\/+$/, '')).toLowerCase();
  44:   } catch (e) {
  45:     return String(u || '').slice(0, 90).toLowerCase();
  46:   }
  47: }
  48: 
  49: export function outletAllowed(outlet, link) {
  50:   const hay = ((outlet || '') + ' ' + (link || '')).toLowerCase();
  51:   return OUTLET_ALLOWLIST.some((o) => hay.includes(o.toLowerCase()));
  52: }
  53: 
  54: export function guessPlace(text) {
  55:   for (const [id, words] of Object.entries(PLACE_KEYWORDS)) {
  56:     if (words.some((w) => text.includes(w))) return id;
  57:   }
